{
  "name": "pac-quote-pdf-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pac Technologies quote PDF renderer (Fastify + Puppeteer)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p . && node scripts/copy-templates.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@sparticuz/chromium": "^131.0.0",
    "fastify": "^5.1.0",
    "handlebars": "^4.7.8",
    "puppeteer-core": "^23.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^2.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
