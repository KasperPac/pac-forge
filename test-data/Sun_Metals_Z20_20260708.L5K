		ROUTINE R008_DO_SOLENOIDS 
				RC: "DO SOLENOIDS FAULTS";
				N: GRT(TOP.CTRL.Fault[7].F,0)OTE(TOP.CTRL.Fault[7].MinorFault);
				RC: "Gripper 1 Solenoid";
				N: FB_D_Solenoid(FB_DO_SolenoidData[1],FB_DI_SensorData[1].OutSignal,FB_DI_SensorData[2].OutSignal,TOP.CTRL.Run,TOP.CTRL.Automatic_Request,TOP.CTRL.Manual_Request,TOP.CTRL.Fault_Reset_Request,TOP.CTRL.Fault[0].MajorFault,TOP.CTRL.Fault[8].F.1,TOP.CTRL.Fault[8].F.2,0,0,1,TOP.CTRL.Fault[7].F.1);
				N: NEQ(FB_AI_SensorData[1].OutSignal,0)LES(FB_AI_SensorData[1].OutSignal,100)OTE(FB_DO_SolenoidData[1].InSol_FeedbackGripping);
				N: XIC(FB_AI_SensorData[1].InSensorFault)OTE(FB_DO_SolenoidData[1].InSolFault_GrippingFB);
				N: XIO(Always_Off)[XIC(FB_DO_SolenoidData[1].OutRetract) MOV(0,KUKA_HMI.OUT_GRIPPER1_STATUS) ,XIO(FB_DO_SolenoidData[1].InSol_FeedbackExtend) XIO(FB_DO_SolenoidData[1].InSol_FeedbackRetract) XIO(FB_DO_SolenoidData[1].OutRetract) MOV(1,KUKA_HMI.OUT_GRIPPER1_STATUS) ,XIC(FB_DO_SolenoidData[1].OutExtend) XIC(FB_DO_SolenoidData[1].InSol_FeedbackExtend) MOV(2,KUKA_HMI.OUT_GRIPPER1_STATUS) ];
				N: XIC(FB_DO_SolenoidData[1].InManual_Mode)[XIC(KUKA_HMI.IN_MANUAL_OPEN_G1) OTE(FB_DO_SolenoidData[1].InExtend_Manual) ,XIC(KUKA_HMI.IN_MANUAL_CLOSE_G1) OTE(FB_DO_SolenoidData[1].InRetract_Manual) ];
				RC: "Gripper 2 Solenoid";
				N: FB_D_Solenoid(FB_DO_SolenoidData[2],FB_DI_SensorData[3].OutSignal,FB_DI_SensorData[4].OutSignal,TOP.CTRL.Run,TOP.CTRL.Automatic_Request,TOP.CTRL.Manual_Request,TOP.CTRL.Fault_Reset_Request,TOP.CTRL.Fault[0].MajorFault,TOP.CTRL.Fault[8].F.3,TOP.CTRL.Fault[8].F.4,0,0,1,TOP.CTRL.Fault[7].F.2);
				N: NEQ(FB_AI_SensorData[2].OutSignal,0)LES(FB_AI_SensorData[2].OutSignal,100)OTE(FB_DO_SolenoidData[2].InSol_FeedbackGripping);
				N: XIC(FB_AI_SensorData[2].InSensorFault)OTE(FB_DO_SolenoidData[2].InSolFault_GrippingFB);
				N: XIO(Always_Off)[XIC(FB_DO_SolenoidData[2].OutRetract) MOV(0,KUKA_HMI.OUT_GRIPPER2_STATUS) ,XIO(FB_DO_SolenoidData[2].InSol_FeedbackRetract) XIO(FB_DO_SolenoidData[2].InSol_FeedbackExtend) XIO(FB_DO_SolenoidData[2].OutRetract) MOV(1,KUKA_HMI.OUT_GRIPPER2_STATUS) ,XIC(FB_DO_SolenoidData[2].OutExtend) XIC(FB_DO_SolenoidData[2].InSol_FeedbackExtend) MOV(2,KUKA_HMI.OUT_GRIPPER2_STATUS) ];
				N: XIC(FB_DO_SolenoidData[2].InManual_Mode)[XIC(KUKA_HMI.IN_MANUAL_OPEN_G2) OTE(FB_DO_SolenoidData[2].InExtend_Manual) ,XIC(KUKA_HMI.IN_MANUAL_CLOSE_G2) OTE(FB_DO_SolenoidData[2].InRetract_Manual) ];
				RC: "Gripper 3 Solenoid";
				N: FB_D_Solenoid(FB_DO_SolenoidData[3],FB_DI_SensorData[5].OutSignal,FB_DI_SensorData[6].OutSignal,TOP.CTRL.Run,TOP.CTRL.Automatic_Request,TOP.CTRL.Manual_Request,TOP.CTRL.Fault_Reset_Request,TOP.CTRL.Fault[0].MajorFault,TOP.CTRL.Fault[8].F.5,TOP.CTRL.Fault[8].F.6,0,0,1,TOP.CTRL.Fault[7].F.3);
				N: NEQ(FB_AI_SensorData[3].OutSignal,0)LES(FB_AI_SensorData[3].OutSignal,100)OTE(FB_DO_SolenoidData[3].InSol_FeedbackGripping);
				N: XIC(FB_AI_SensorData[3].InSensorFault)OTE(FB_DO_SolenoidData[3].InSolFault_GrippingFB);
				N: XIO(Always_Off)[XIC(FB_DO_SolenoidData[3].OutRetract) MOV(0,KUKA_HMI.OUT_GRIPPER3_STATUS) ,XIO(FB_DO_SolenoidData[3].InSol_FeedbackRetract) XIO(FB_DO_SolenoidData[3].InSol_FeedbackExtend) XIO(FB_DO_SolenoidData[3].OutRetract) MOV(1,KUKA_HMI.OUT_GRIPPER3_STATUS) ,XIC(FB_DO_SolenoidData[3].OutExtend) XIC(FB_DO_SolenoidData[3].InSol_FeedbackExtend) MOV(2,KUKA_HMI.OUT_GRIPPER3_STATUS) ];
				N: XIC(FB_DO_SolenoidData[3].InManual_Mode)[XIC(KUKA_HMI.IN_MANUAL_OPEN_G3) OTE(FB_DO_SolenoidData[3].InExtend_Manual) ,XIC(KUKA_HMI.IN_MANUAL_CLOSE_G3) OTE(FB_DO_SolenoidData[3].InRetract_Manual) ];
				RC: "Gripper 4 Solenoid";
				N: FB_D_Solenoid(FB_DO_SolenoidData[4],FB_DI_SensorData[7].OutSignal,FB_DI_SensorData[8].OutSignal,TOP.CTRL.Run,TOP.CTRL.Automatic_Request,TOP.CTRL.Manual_Request,TOP.CTRL.Fault_Reset_Request,TOP.CTRL.Fault[0].MajorFault,TOP.CTRL.Fault[8].F.7,TOP.CTRL.Fault[8].F.8,0,0,1,TOP.CTRL.Fault[7].F.4);
				N: NEQ(FB_AI_SensorData[4].OutSignal,0)LES(FB_AI_SensorData[4].OutSignal,100)OTE(FB_DO_SolenoidData[4].InSol_FeedbackGripping);
				N: XIC(FB_AI_SensorData[4].InSensorFault)OTE(FB_DO_SolenoidData[4].InSolFault_GrippingFB);
				N: XIO(FB_DO_SolenoidData[5].InExtend_Auto)OTE(FB_DO_SolenoidData[5].InRetract_Auto);
				N: XIO(Always_Off)[XIC(FB_DO_SolenoidData[4].OutRetract) MOV(0,KUKA_HMI.OUT_GRIPPER4_STATUS) ,XIO(FB_DO_SolenoidData[4].InSol_FeedbackRetract) XIO(FB_DO_SolenoidData[4].InSol_FeedbackExtend) XIO(FB_DO_SolenoidData[4].OutRetract) MOV(1,KUKA_HMI.OUT_GRIPPER4_STATUS) ,XIC(FB_DO_SolenoidData[4].OutExtend) XIC(FB_DO_SolenoidData[4].InSol_FeedbackExtend) MOV(2,KUKA_HMI.OUT_GRIPPER4_STATUS) ];
				N: XIC(FB_DO_SolenoidData[4].InManual_Mode)[XIC(KUKA_HMI.IN_MANUAL_OPEN_G4) OTE(FB_DO_SolenoidData[4].InExtend_Manual) ,XIC(KUKA_HMI.IN_MANUAL_CLOSE_G4) OTE(FB_DO_SolenoidData[4].InRetract_Manual) ];
				RC: "Laser Airblast Solenoid";
				N: FB_D_Solenoid(FB_DO_SolenoidData[5],0,0,TOP.CTRL.Run,TOP.CTRL.Automatic_Request,TOP.CTRL.Manual_Request,TOP.CTRL.Fault_Reset_Request,TOP.CTRL.Fault[0].MajorFault,TOP.CTRL.Fault[8].F.7,TOP.CTRL.Fault[8].F.8,0,0,0,TOP.CTRL.Fault[7].F.4);
				N: XIO(Always_Off)[[XIC(FB_DO_SolenoidData[5].OutRetract) ,XIO(FB_DO_SolenoidData[5].OutExtend) ] MOV(0,KUKA_HMI.OUT_LASE_AIRBLAST_STATUS) ,XIC(FB_DO_SolenoidData[5].OutExtend) MOV(2,KUKA_HMI.OUT_LASE_AIRBLAST_STATUS) ];
				N: XIC(FB_DO_SolenoidData[5].InManual_Mode)[XIC(KUKA_HMI.IN_MANUAL_OPEN_LAS) OTE(FB_DO_SolenoidData[5].InExtend_Manual) ,XIO(KUKA_HMI.IN_MANUAL_OPEN_LAS) OTE(FB_DO_SolenoidData[5].InRetract_Manual) ];
		END_ROUTINE

