		BIT IPDiag4 ZZZZZZZZZZArmorBlock9 : 4 (Description := "OW-A (Input off wire fault)");
		BIT IPDiag5 ZZZZZZZZZZArmorBlock9 : 5 (Description := "OW-B (Input off wire fault)");
		BIT IPDiag6 ZZZZZZZZZZArmorBlock9 : 6 (Description := "OW-C (Input off wire fault)");
		BIT IPDiag7 ZZZZZZZZZZArmorBlock9 : 7 (Description := "OW-D (Input off wire fault)");
		SINT ZZZZZZZZZZArmorBlock18 (Hidden := 1);
		BIT OPDiag0 ZZZZZZZZZZArmorBlock18 : 0 (Description := "OFLT0 (Output no load or overload fault)");
		BIT OPDiag1 ZZZZZZZZZZArmorBlock18 : 1 (Description := "OFLT1 (Output no load or overload fault)");
		BIT OPDiag2 ZZZZZZZZZZArmorBlock18 : 2 (Description := "OFLT2 (Output no load or overload fault)");
		BIT OPDiag3 ZZZZZZZZZZArmorBlock18 : 3 (Description := "OFLT3 (Output no load or overload fault)");
		BIT OPDiag4 ZZZZZZZZZZArmorBlock18 : 4 (Description := "OFLT4 (Output no load or overload fault)");
		BIT OPDiag5 ZZZZZZZZZZArmorBlock18 : 5 (Description := "OFLT5 (Output no load or overload fault)");
		BIT OPDiag6 ZZZZZZZZZZArmorBlock18 : 6 (Description := "OFLT6 (Output no load or overload fault)");
		BIT OPDiag7 ZZZZZZZZZZArmorBlock18 : 7 (Description := "OFLT7 (Output no load or overload fault)");
		SINT ZZZZZZZZZZArmorBlock27 (Hidden := 1);
		BIT RSVD0 ZZZZZZZZZZArmorBlock27 : 0 (Description := "Reserverd");
		BIT RSVD1 ZZZZZZZZZZArmorBlock27 : 1 (Description := "Reserverd");
		BIT RSVD2 ZZZZZZZZZZArmorBlock27 : 2 (Description := "Reserverd");
		BIT RSVD3 ZZZZZZZZZZArmorBlock27 : 3 (Description := "Reserverd");
		BIT RSVD4 ZZZZZZZZZZArmorBlock27 : 4 (Description := "Reserverd");
		BIT RSVD5 ZZZZZZZZZZArmorBlock27 : 5 (Description := "Reserverd");
		BIT OPWR ZZZZZZZZZZArmorBlock27 : 6 (Description := "OPWR (Auxilary Output Power fault)");
		BIT RSVD7 ZZZZZZZZZZArmorBlock27 : 7 (Description := "Reserverd");
