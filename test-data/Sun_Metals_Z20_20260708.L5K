		LOCAL_TAGS
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: XIC(Raw_SOLV_Status)OTE(Mapped.SOLV_Status);
				N: XIC(Raw_InputAreaHighByte.3)OTE(Mapped.SOLV_Undervoltage_Error);
				RC: "Byte 0";
