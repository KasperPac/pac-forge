		ROUTINE R204_EXECUTE_ROBOT_TASK 
				RC: "INPUT";
				N: XIC(LOGIC_TEMP[6])OTE(EXECUT_Robot_Step_Actions.IN_SensorTrigger);
				N: NEQ(Task_Request,0)ONS(Insert_Request_Log)[GEQ(index_Request_Log,100) MOV(0,index_Request_Log) ,LES(index_Request_Log,100) ADD(index_Request_Log,1,index_Request_Log) ][MOV(Task_Request,Task_Request_Log[index_Request_Log]) ,OTL(CESAR_TEST.0) ];
				N: NEQ(Task_Request,0)XIO(KUKA_ROBOT.In.WAFER_DETECTED)XIC(KUKA_ROBOT.In.PGNO_REQ)XIO(STOP_TRIGGER)[OTE(EXECUT_Robot_Step_Actions.IN_ExecuteSeqTrigger) ,OTL(STOP_TRIGGER) ];
				N: NEQ(Task_Request,0)OTE(EXECUT_Robot_Step_Actions.IN_TaskSelected);
				N: XIC(KUKA_ROBOT.In.PRO_ACT)XIC(KUKA_ROBOT.In.PGNO_REQ)OTE(EXECUT_Robot_Step_Actions.IN_Robot_OK);
				N: XIC(RobotControllerReadyToStart)EQU(Task_Request,Last_Run_Task)OTE(EXECUT_Robot_Step_Actions.IN_Condition_Ready);
				N: MOV(Last_Run_Task,EXECUT_Robot_Step_Actions.IN_FB_CurreniTaskRobot);
				N: FB_EXECUTE_R_STEPS_ACTIONS(EXECUT_Robot_Step_Actions,TOP.CTRL,ExecuteTaskSetepAction);
				N: XIC(ExecuteTaskSetepAction.ACTIONS.6)MOV(0,Task_Request);
				N: XIO(KUKA_ROBOT.In.PGNO_REQ)XIC(KUKA_ROBOT.In.APPL_RUN)OTE(EXECUT_Robot_Step_Actions.IN_Task_Completed);
				N: XIC(ExecuteTaskSetepAction.ACTIONS.2)OTE(EXECUT_Robot_CheckCondition);
				N: XIC(ExecuteTaskSetepAction.ACTIONS.3)OTE(EXECUT_Robot_SelectTask);
		END_ROUTINE

		ROUTINE R301_STACKS_MGMT 
				N: [OTE(STACKS.STACK[1].Enabled) ,OTE(MAKEUP_TABLE.Enabled) ];
				N: [XIC(FOOT_SAS.ACTIVE_STACK_1) ,XIC(REGULAR_SAS.ACTIVE_STACK_1) ,XIC(TOP_SAS.ACTIVE_STACK_1) ]OTE(STACKS.STACK[1].Active);
				N: [XIC(FOOT_SAS.ACTIVE_STACK_2) ,XIC(REGULAR_SAS.ACTIVE_STACK_2) ,XIC(TOP_SAS.ACTIVE_STACK_2) ]OTE(STACKS.STACK[2].Active);
				N: [XIC(FOOT_SAS.ACTIVE_STACK_3) ,XIC(REGULAR_SAS.ACTIVE_STACK_3) ,XIC(TOP_SAS.ACTIVE_STACK_3) ]OTE(STACKS.STACK[3].Active);
				N: XIC(FOOT_SAS.ACTIVE_MAKEUP)OTE(MAKEUP_TABLE.Active);
				N: XIC(FOOT_SECTION.ACTIONS.7)NEQ(Last_Run_Task,3)NEQ(Last_Run_Task,4)XIO(Ingot_Dropped)[XIC(STACKS.STACK[1].Active) OTE(STACK_1.FootLayerComplete) ,XIC(STACKS.STACK[2].Active) OTE(STACK_2.FootLayerComplete) ,XIC(STACKS.STACK[3].Active) OTE(STACK_3.FootLayerComplete) ];
				N: XIC(REGULAR_SECTION.ACTIONS.7)NEQ(Last_Run_Task,3)NEQ(Last_Run_Task,4)XIO(Ingot_Dropped)[XIC(STACKS.STACK[1].Active) OTE(STACK_1.RegLayerComplete) ,XIC(STACKS.STACK[2].Active) OTE(STACK_2.RegLayerComplete) ,XIC(STACKS.STACK[3].Active) OTE(STACK_3.RegLayerComplete) ];
				N: XIC(TOP_SECTION.ACTIONS.7)NEQ(Last_Run_Task,4)XIO(Ingot_Dropped)[XIC(STACKS.STACK[1].Active) OTE(STACK_1.TopLayerComplete) ,XIC(STACKS.STACK[2].Active) OTE(STACK_2.TopLayerComplete) ,XIC(STACKS.STACK[3].Active) OTE(STACK_3.TopLayerComplete) ];
				N: NEQ(Last_Run_Task,1)OTU(Ingot_Dropped);
				N: STACK_COUNT(STACK_1,1,4,1,Always_Off,9,4,32,4,STACKS.STACK[1],STACKS.STACK[0]);
				N: STACK_COUNT(STACK_2,1,4,1,Always_Off,9,4,32,4,STACKS.STACK[2],STACKS.STACK[0]);
				N: STACK_COUNT(STACK_3,1,4,1,Always_Off,9,4,32,4,STACKS.STACK[3],STACKS.STACK[0]);
				N: EQU(MAKEUP_TABLE.Option,1)[MOV(11,MAKEUP_1.RequiredFeet) ,MOV(3,MAKEUP_1.RequiredRegular) ];
				N: EQU(MAKEUP_TABLE.Option,2)[MOV(4,MAKEUP_1.RequiredFeet) ,MOV(10,MAKEUP_1.RequiredRegular) ];
				N: XIC(STACKS.STACK[1].StackOffConeyor)ONS(StackOffConv_ONS_1)[COP(STACKS.STACK[2],STACKS.STACK[1],1) ,COP(STACKS.STACK[3],STACKS.STACK[2],1) ,COP(STACKS.STACK[0],STACKS.STACK[3],1) ,ADD(TempVar,1,TempVar) ];
				N: [MOV(850,STACK1_INDEX_TRACK.IndexDistance) ,MOV(850,STACK1_INDEX_TRACK.IndexDistance) ,MOV(850,STACK2_INDEX_TRACK.IndexDistance) ];
				N: XIO(STACKS.STACK[1].In_Progress)XIO(STACKS.STACK[2].In_Progress)XIO(STACKS.STACK[3].In_Progress)OTE(STACK1_INDEX_TRACK.ResetError);
				N: MOV(0,STACKS.STACK[1].X_Pos_Initial);
				N: FB_OUTFEED_ENC_TRACK(STACK1_INDEX_TRACK,IndexInProgress,SickAFX_Enc1_xyz:I1.Data[1],STACKS.STACK[1].X_Pos_Initial,STACKS.STACK[1].X_Position_Act);
				N: [ADD(STACKS.STACK[1].X_Position_Act,STACK1_INDEX_TRACK.IndexDistance,STACKS.STACK[2].X_Position_Act) ,ADD(STACKS.STACK[2].X_Position_Act,STACK1_INDEX_TRACK.IndexDistance,STACKS.STACK[3].X_Position_Act) ];
				N: [MUL(STACK1_INDEX_TRACK.IndexDistance,1,STACKS.STACK[2].X_Pos_Initial) ,MUL(STACK1_INDEX_TRACK.IndexDistance,2,STACKS.STACK[3].X_Pos_Initial) ];
		END_ROUTINE

		ROUTINE R302_FOOT_INGOTS 
				N: OTE(STACKS.STACK[1].Enabled);
				N: GEQ(STACKS.STACK[1].NextLayer,STACKS.STACK[1].Required_Layers)OTE(STACKS.STACK[2].Enabled);
				N: GEQ(STACKS.STACK[2].NextLayer,STACKS.STACK[2].Required_Layers)XIC(Always_Off)OTE(STACKS.STACK[3].Enabled);
				N: EQU(CONVEYOR_D_TotalIngotToBeTakenConveyo,4)OTE(FOOT_SAS.QUEUE_FULL);
				N: XIC(FOOT_SAS.QUEUE_FULL)[MOV(1,Task_Request) ,OTL(CESAR_TEST.1) ];
				N: FB_FOOT_INGOTS_STEPS_ACTIONS(FOOT_SAS,FOOT_ACTIVE,TOP.CTRL,STACKS,MAKEUP_TABLE,STACKS.STACK[1].Enabled,STACKS.STACK[2].Enabled,Always_Off,Always_On,FOOT_SECTION,CONVEYOR_D_IngotLogicDetection[1].OUT_FootDetected,CONVEYOR_D_IngotLogicDetection[2].OUT_FootDetected,CONVEYOR_D_IngotLogicDetection[3].OUT_FootDetected,CONVEYOR_D_IngotLogicDetection[4].OUT_FootDetected,Robot_IN_Task_completed,Last_Run_Task,Robot_IN_Current_Task,260,100,FB_AI_SensorData[1].OutSignal,FB_AI_SensorData[2].OutSignal,FB_AI_SensorData[3].OutSignal,FB_AI_SensorData[4].OutSignal,MAKEUP_1.UpdateComplete);
				N: XIC(FOOT_ACTIVE)[XIC(STACKS.STACK[1].Active) OTE(STACKS.STACK[1].Feet_Active) ,XIC(STACKS.STACK[2].Active) OTE(STACKS.STACK[2].Feet_Active) ,XIC(STACKS.STACK[3].Active) OTE(STACKS.STACK[3].Feet_Active) ];
				N: AFI()XIC(FOOT_SECTION.ACTIONS.4)[XIC(STACKS.STACK[1].Active) MOV(STACKS.STACK[1].NextLayer,STACKS.STACK[1].CurrentLayer) ,XIC(STACKS.STACK[2].Active) MOV(STACKS.STACK[2].NextLayer,STACKS.STACK[2].CurrentLayer) ,XIC(STACKS.STACK[3].Active) MOV(STACKS.STACK[3].NextLayer,STACKS.STACK[3].CurrentLayer) ];
				N: AFI()XIC(FOOT_SECTION.ACTIONS.6)MOV(FOOT_SAS.PICKED_INGOTS,INFEED_IngotsTakenFromTheConveyor);
				RC: "Increase Next Layer Index";
				N: AFI()XIC(FOOT_SECTION.ACTIONS.6)[XIC(FOOT_SAS.ACTIVE_STACK_1) ADD(STACKS.STACK[1].CurrentLayer,1,TEMP_NEXT_LAYER_STK_1) LES(STACKS.STACK[1].NextLayer,TEMP_NEXT_LAYER_STK_1) ADD(STACKS.STACK[1].NextLayer,1,STACKS.STACK[1].NextLayer) ,XIC(FOOT_SAS.ACTIVE_STACK_2) ADD(STACKS.STACK[2].CurrentLayer,1,TEMP_NEXT_LAYER_STK_2) LES(STACKS.STACK[2].NextLayer,TEMP_NEXT_LAYER_STK_2) ADD(STACKS.STACK[2].NextLayer,1,STACKS.STACK[2].NextLayer) ,XIC(FOOT_SAS.ACTIVE_STACK_3) ADD(STACKS.STACK[3].CurrentLayer,1,TEMP_NEXT_LAYER_STK_3) LES(STACKS.STACK[3].NextLayer,TEMP_NEXT_LAYER_STK_3) ADD(STACKS.STACK[3].NextLayer,1,STACKS.STACK[3].NextLayer) ];
		END_ROUTINE

