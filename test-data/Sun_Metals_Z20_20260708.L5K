			                       DefaultData := 0);
			IndexDistance : DINT (Usage := Input,
			                         RADIX := Decimal,
			                         Required := No,
			                         Visible := Yes,
			                         DefaultData := 0);
			ResetError : BOOL (Usage := Input,
			                      RADIX := Decimal,
			                      Required := No,
			                      Visible := Yes,
			                      DefaultData := 0);
			StackX : DINT (Usage := Output,
			                  RADIX := Decimal,
			                  Required := Yes,
			                  Visible := Yes,
			                  ExternalAccess := Read Only,
			                  DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			ActualDistance : DINT (RADIX := Decimal,
			                         ExternalAccess := None,
			                         DefaultData := 0);
			EncoderEnd : DINT (RADIX := Decimal,
			                     ExternalAccess := None,
			                     DefaultData := 0);
			EncoderStart : DINT (RADIX := Decimal,
