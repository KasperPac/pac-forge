				N: AFI()XIC(REGULAR_SECTION.ACTIONS.4)[XIC(STACKS.STACK[1].Active) MOV(STACKS.STACK[1].NextLayer,STACKS.STACK[1].CurrentLayer) ,XIC(STACKS.STACK[2].Active) MOV(STACKS.STACK[2].NextLayer,STACKS.STACK[2].CurrentLayer) ,XIC(STACKS.STACK[3].Active) MOV(STACKS.STACK[3].NextLayer,STACKS.STACK[3].CurrentLayer) ];
