			                          RADIX := Float,
			                          Required := Yes,
			                          Visible := Yes,
			                          ExternalAccess := Read Only,
			                          DefaultData := 0.00000000e+000);
			START_BYTE : INT (Description := "Processdata offset; MOVIDRIVE: 0; GATEWAY: dependand on configuration; MOVIFIT: dependand on configuration, but at least 4; CCU: dependand on configuration, but at least 4; PLEASE FINDE MORE INFORMATION INSIDE THE AOI",
			                      Usage := Input,
			                      RADIX := Decimal,
			                      Required := Yes,
			                      Visible := Yes,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			FAULT_OF_AOI : BOOL (Description := "TRUE:= there is an error while initialization of the instruction",
			                        Usage := Output,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        ExternalAccess := Read Only,
			                        DefaultData := 0);
			AOI_FAULT_NO : INT (Description := "1: Wrong start BYTE number",
			                        Usage := Output,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			COMMUNICATION_FAULT : BOOL (Description := "TRUE :=  Communcation is faulted",
			                               Usage := InOut,
			                               RADIX := Decimal,
			                               Required := Yes,
			                               Visible := Yes);
		END_PARAMETERS

		LOCAL_TAGS
			L_Actual_Speed : INT (Description := "Actual Speed",
