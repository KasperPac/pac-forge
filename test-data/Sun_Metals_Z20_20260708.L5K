		DINT DO[30] (Description := "Digital Outputs TO the HMI Devices (single bit output data)");
		DINT AI[30] (Description := "Analog Inputs FROM the HMI Devices (32 bit words for numeric input)");
		DINT AO[100] (Description := "Analog Outputs TO the HMI Devices (32 bit words for displays values)");
		SINT STATUS[100] (Description := "Status Bits TO the HMI Devices (for Multistate indicator values)");
		DINT ALARM[30] (Description := "Alarms TO the HMI Devices (alarm messages)");
		Recipe_Data RECIPE (Description := "Recipe Data from VersaView");
	END_DATATYPE

