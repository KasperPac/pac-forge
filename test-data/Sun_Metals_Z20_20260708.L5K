		ROUTINE R_F_STOPPER 
				RC: "Stopper Control$N"
				    "manual control while in auto";
				N: [[XIC(R_I_1_6) ,XIC(R_B3[1].13) ] XIC(R_I_2_13) ,XIC(R_B3[1].5) ]XIO(R_I_1_7)XIO(R_T4_14.DN)XIO(R_B3[1].12)OTE(R_B3[1].5);
				RC: "manual control while in manual";
				N: [XIC(R_I_1_6) ,XIC(R_B3[1].13) ,XIC(R_B3[1].10) ]XIO(R_I_1_7)XIO(R_I_2_13)XIO(R_B3[1].12)OTE(R_B3[1].10);
				N: XIC(R_I_3_2)TON(R_T4_12,?,?);
				N: [XIC(R_T4_12.DN) ,XIC(R_T4_12.DN) ]OTE(R_B3[1].1);
				RC: "Foot mould coming";
				N: [XIC(R_B3[1].14) ,XIC(R_B3[2].1) ]XIO(R_B3[2].10)[OTE(R_B3[2].1) ,TON(R_T4_20,?,?) ];
				RC: "foot mould has gone past first sensor and normal mould resting at stopper";
				N: [XIC(R_T4_20.DN) XIC(R_I_1_12) ,XIC(R_T4_27.DN) ]XIO(R_B3[2].10)[XIC(R_T4_27.DN) OTE(R_B3[2].2) ,TON(R_T4_27,?,?) ];
				N: [XIC(R_T4_27.DN) XIC(R_I_1_11) ,XIC(R_B3[2].3) ]XIO(R_B3[2].10)OTE(R_B3[2].3);
				N: XIC(R_B3[2].3)XIO(R_I_1_11)XIO(R_I_1_12)OTE(R_B3[2].10);
				N: XIC(R_B3[1].5)XIC(R_B3[1].14)TON(R_T4_14,?,?);
				N: [XIC(R_T4_14.DN) ,XIC(R_B3[4].1) ]XIO(R_T4_30.DN)[OTE(R_B3[4].1) ,TON(R_T4_30,?,?) ];
				RC: "foot mould coming while normal mould is at stopper ";
				N: [XIC(R_B3[1].14) XIC(R_I_1_12) [XIO(R_I_1_13) XIO(R_I_1_1) ,XIO(R_B3[2].3) XIC(R_I_1_1) ] XIO(R_I_1_11) [XIO(R_I_1_14) XIO(R_I_1_1) ,XIO(R_B3[2].2) XIC(R_I_1_1) ] ,XIC(R_T4_15.DN) ]XIO(R_T4_16.DN)XIO(R_B3[1].12)XIO(R_I_1_7)[TON(R_T4_15,?,?) ,OTE(R_B3[1].4) ];
				N: XIC(R_T4_15.DN)TON(R_T4_16,?,?);
				RC: "LINE1- foot mould on stopper normal mould behind, robot healthy$N"
				    "LINE2- Normal mould at stopper and foot mould behind, robot healthy$N"
				    "LINE3- 2 normal moulds waiting when normal moulds are not needed, robot healthy";
				N: [XIC(R_I_1_11) XIC(R_I_1_12) [XIO(R_I_1_13) XIO(R_I_1_1) ,XIO(R_B3[2].3) XIC(R_I_1_1) ] [XIC(R_I_1_14) XIO(R_I_1_1) ,XIC(R_B3[2].2) XIC(R_I_1_1) ] ,[XIC(R_I_1_11) XIC(R_I_1_12) [XIC(R_I_1_13) XIO(R_I_1_1) ,XIC(R_B3[2].3) XIC(R_I_1_1) ] [XIO(R_I_1_14) XIO(R_I_1_1) ,XIO(R_B3[2].2) XIC(R_I_1_1) ] ,XIC(R_I_1_11) XIC(R_I_1_12) XIC(Foot_Moulds_Needed) [XIO(R_I_1_13) XIO(R_I_1_1) ,XIO(R_B3[2].3) XIC(R_I_1_1) ] [XIO(R_I_1_14) XIO(R_I_1_1) ,XIO(R_B3[2].2) XIC(R_I_1_1) ] ] ][TON(R_T4_17,?,?) ,XIC(R_T4_17.DN) XIO(R_I_1_13) XIC(R_I_1_14) XIO(R_I_1_1) CTU(R_C5_9,?,?) ,XIC(R_T4_17.DN) XIC(R_I_1_13) XIO(R_I_1_14) XIO(R_I_1_1) CTU(R_C5_10,?,?) ,XIC(R_T4_17.DN) XIO(R_I_1_13) XIO(R_I_1_14) XIO(R_I_1_1) CTU(R_C5_11,?,?) ];
				N: [XIO(R_C5_1.DN) XIC(R_T4_17.DN) ,XIC(R_B3[3].4) ]XIO(R_B3[3].5)XIO(R_I_1_7)XIO(R_B3[1].12)OTE(R_B3[3].4);
				N: [XIC(R_T4_26.DN) ,XIC(R_O_4_4) XIC(R_I_2_13) ]RES(R_C5_1);
				N: XIC(R_C5_1.DN)[TON(R_T4_26,?,?) ,OTE(R_B3[3].6) ];
				N: [XIO(R_B3[4].5) XIC(R_B3[1].14) ,XIC(R_B3[3].3) ]XIO(R_B3[3].4)XIO(R_B3[3].6)XIC(R_I_2_13)OTE(R_B3[3].3);
				N: XIC(R_B3[3].3)ONS(R_T4_29.DN)CTU(R_C5_1,?,?);
				RC: "2 foot mould at stopper and robot healthy";
				N: XIC(R_I_1_11)XIC(R_I_1_12)[XIC(R_I_1_13) XIO(R_I_1_1) ,XIC(R_B3[2].3) XIC(R_I_1_1) ][XIC(R_I_1_14) XIO(R_I_1_1) ,XIC(R_B3[2].2) XIC(R_I_1_1) ]TON(R_T4_29,?,?);
				N: EQU(bundle_counter.ACC,18)[XIC(R_T4_40.DN) XIO(R_T4_41.DN) OTE(R_B3[2].9) ,TON(R_T4_40,?,?) ,TON(R_T4_41,?,?) ];
				RC: "If robot has just finished layer 9 and the Lidar beam is broken, stopper down to allow last 4 ingots to reject so overheight doesnt occur";
				N: [XIO(B3[4].3) XIC(R_I_7_7) XIC(R_B3[2].0) XIC(R_B3[2].9) ,XIC(R_B3[2].11) ]XIO(R_B3[1].14)XIO(R_I_1_7)XIO(R_B3[1].12)[OTE(R_B3[2].11) ,CTU(R_C5_8,?,?) ];
				N: [XIO(B3[4].3) XIC(R_I_7_8) XIO(R_B3[2].0) XIC(R_B3[2].9) ,XIC(R_B3[3].7) ]XIO(R_B3[1].14)XIO(R_I_1_7)XIO(R_B3[1].12)[OTE(R_B3[3].7) ,CTU(R_C5_12,?,?) ];
				RC: "Bank up timer";
				N: [XIC(R_I_1_11) ,XIC(R_T4_45.DN) ]XIO(R_I_1_14)XIO(R_I_1_7)XIO(R_B3[1].12)TON(R_T4_45,?,?);
				RC: "Bank up timer for if foot moulds ";
				N: [XIC(R_I_1_13) ,XIC(R_T4_47.TT) ]XIO(R_I_1_7)XIO(R_B3[1].12)XIC(Casting_Conv_Run)[TON(R_T4_46,?,?) ,XIC(R_T4_46.DN) TON(R_T4_47,?,?) ];
				N: XIC(R_T4_46.DN)OTL(R_B3[0].10);
				N: XIO(R_T4_47.TT)XIC(R_B3[1].14)OTU(R_B3[0].10);
				N: [XIC(R_T4_15.DN) ,XIC(R_B3[0].10) ,XIC(R_B3[3].4) ,XIC(R_B3[1].10) ,XIC(R_B3[1].1) ,XIC(R_B3[1].5) ,XIC(R_T4_45.DN) ,XIC(R_B3[2].11) ,XIC(R_B3[3].7) ]XIO(R_I_1_7)XIO(R_B3[1].12)[OTE(R_O_4_4) ,OTE(R_B3[4].11) ];
				N: XIC(R_O_4_4)[TON(R_T4_51,?,?) ,XIC(R_T4_51.DN) CTU(R_C5_0,?,?) ,XIC(R_T4_51.DN) CTU(R_C5_13,?,?) ,XIC(R_T4_51.DN) CTU(R_C5_14,?,?) ];
				N: [EQU(PLC_Clock[3],6) ,EQU(PLC_Clock[3],18) ]ONS(R_B3[8].0)[MOV(R_C5_13.ACC,R_N7[40]) ,RES(R_C5_13) ];
				N: EQU(PLC_Clock[3],6)ONS(R_B3[8].1)[MOV(R_C5_14.ACC,R_N7[41]) ,RES(R_C5_14) ];
				N: LES(R_C5_0.ACC,0)RES(R_C5_0);
				N: XIC(R_T4_15.DN)CTU(R_C5_3,?,?);
				N: XIC(R_B3[3].4)CTU(R_C5_4,?,?);
				N: XIC(R_B3[1].10)CTU(R_C5_5,?,?);
				N: XIC(R_B3[1].1)CTU(R_C5_6,?,?);
				N: XIC(R_B3[1].5)CTU(R_C5_7,?,?);
		END_ROUTINE

		ROUTINE Statistics 
				RC: "Complete build integer$N"
				    "works out if the robot has built a complete bundle, then indexes the integer down conveyor";
				N: [XIC(Complete_Bundle) ONS(integer_ons) XIC(R_B3[2].0) [XIC(R_I_3_9) ,] ,XIC(Bundle_Status1[0].0) ]XIO(Bitshift_delay.DN)OTE(Bundle_Status1[0].0);
				N: [[XIC(Complete_Bundle) ONS(integer_ons_1) XIO(R_B3[2].0) [XIC(R_I_3_9) ,] ,XIC(Bundle_Status1[0].1) ] [XIO(Bitshift_delay.DN) ,XIC(Bitshift_delay.DN) XIC(North_Built) ] ,XIC(Integer_bypass) ]OTE(Bundle_Status1[0].1);
				N: [XIC(Bitshift_delay.TT) XIC(Bundle_Status1[0].0) OTL(North_Built) ,XIO(Bitshift_delay.DN) XIO(Bitshift_delay.EN) OTU(North_Built) ];
				N: XIC(B3[4].3)[TON(Bitshift_delay,?,?) ,XIC(Bitshift_delay.DN) BSL(Bundle_Status1,BSL_Control,Bundle_Status1[0].0,?) ];
				N: XIC(R_O_4_3)CTU(bundle_counter,?,?);
				N: XIC(bundle_counter.DN)OTE(Complete_Bundle);
				N: LEQ(bundle_counter.ACC,1)OTE(Foot_Moulds_Needed);
				N: XIC(R_I_3_9)[XIC(reset_delay.DN) RES(bundle_counter) ,TON(reset_delay,?,?) ];
				RC: "3 layer integer$N"
				    "works out if the robot has built atleast 3 layers of bundle, then indexes the integer down conveyor";
				N: [XIC(bundle_build_GT3) ONS(integer_ons_2) XIC(R_B3[2].0) [XIC(R_I_3_9) ,] ,XIC(Bundle_Status_GT3_array[0].0) ]XIO(Bitshift_delay1.DN)OTE(Bundle_Status_GT3_array[0].0);
				N: [[XIC(bundle_build_GT3) ONS(integer_ons_3) XIO(R_B3[2].0) [XIC(R_I_3_9) ,] ,XIC(Bundle_Status_GT3_array[0].1) ] [XIO(Bitshift_delay1.DN) ,XIC(Bitshift_delay1.DN) XIC(North_GT3) ] ,XIC(Integer_bypass) ]OTE(Bundle_Status_GT3_array[0].1);
				N: [XIC(Bitshift_delay1.TT) XIC(Bundle_Status_GT3_array[0].0) OTL(North_GT3) ,XIO(Bitshift_delay1.DN) XIO(Bitshift_delay1.EN) OTU(North_GT3) ];
				N: XIC(B3[4].3)[TON(Bitshift_delay1,?,?) ,XIC(Bitshift_delay1.DN) BSL(Bundle_Status_GT3_array,BSL_Control1,Bundle_Status_GT3_array[0].0,?) ];
				N: GRT(bundle_counter.ACC,6)OTE(bundle_build_GT3);
				N: OTU(IngotCnt_Failed);
				RC: "Successful turnover Integer$N"
				    "works out if the robot has successfully turned over the top ingots, then indexes the integer down conveyor";
				N: [XIC(Turnover_counter.DN) XIC(R_B3[2].0) [XIC(R_I_3_9) ,] XIC(Complete_Bundle) ,XIC(Bundle_Status_Turnover_complete[0].0) ]XIO(IngotCnt_Failed)XIO(Bitshift_delay2.DN)OTE(Bundle_Status_Turnover_complete[0].0);
				N: [[XIC(Turnover_counter.DN) XIO(R_B3[2].0) [XIC(R_I_3_9) ,] XIC(Complete_Bundle) ,XIC(Bundle_Status_Turnover_complete[0].1) ] XIO(IngotCnt_Failed) [XIO(Bitshift_delay2.DN) ,XIC(Bitshift_delay2.DN) XIC(North_TOVER) ] ,XIC(Integer_bypass) ]OTE(Bundle_Status_Turnover_complete[0].1);
				N: [XIC(Bitshift_delay2.TT) XIC(Bundle_Status_Turnover_complete[0].0) OTL(North_TOVER) ,XIO(Bitshift_delay2.DN) XIO(Bitshift_delay2.EN) OTU(North_TOVER) ];
				N: XIC(B3[4].3)[TON(Bitshift_delay2,?,?) ,XIC(Bitshift_delay2.DN) BSL(Bundle_Status_Turnover_complete,BSL_Control2,Bundle_Status_Turnover_complete[0].0,?) ,OTU(IngotCnt_Failed) ];
				N: XIC(Turn_Over_Flipper)[XIC(positive_sig.DN) CTU(Turnover_counter,?,?) ,TON(positive_sig,?,?) ];
				N: XIC(R_I_3_9)[XIC(reset_delay_turnover.DN) RES(Turnover_counter) ,TON(reset_delay_turnover,?,?) ];
				RC: "Ingot Dropped Detect";
				N: [XIC(Clamp1_Close) XIC(Clamp2_Close) [XIO(R_I_2_8) ,XIO(R_I_2_9) ] XIC(swap_position) XIC(R_I_2_13) ,XIC(Bundle_Status_Dropped_Ingot[0].0) ]XIO(Bitshift_delay_drop.DN)OTE(Bundle_Status_Dropped_Ingot[0].0);
				N: [XIC(Clamp1_Close) XIC(Clamp2_Close) [XIO(R_I_2_8) ,XIO(R_I_2_9) ] XIO(swap_position) XIC(R_I_2_13) ,XIC(Bundle_Status_Dropped_Ingot[0].1) ][XIO(Bitshift_delay_drop.DN) ,XIC(Bitshift_delay_drop.DN) XIC(North_Drop) ]XIO(Integer_bypass)[TON(Drop_delay,?,?) ,XIC(Drop_delay.DN) OTE(Bundle_Status_Dropped_Ingot[0].1) ];
				N: [XIC(Bitshift_delay_drop.TT) XIC(Bundle_Status_Dropped_Ingot[0].0) OTL(North_Drop) ,XIO(Bitshift_delay_drop.DN) XIO(Bitshift_delay_drop.EN) OTU(North_Drop) ];
				N: XIC(B3[4].3)[TON(Bitshift_delay_drop,?,?) ,XIC(Bitshift_delay_drop.DN) BSL(Bundle_Status_Dropped_Ingot,BSL_Control_drop,Bundle_Status_Dropped_Ingot[0].0,?) ];
				N: XIO(Big_Kev)MOV(0,Bundle_Status_Dropped_Ingot[0]);
		END_ROUTINE

		ROUTINE Statistics_2 
				RC: "60 MINUTE TIMER WITH INCREMENTING INDEX";
				N: XIO(Cuddy_King_Timer.DN)TON(Cuddy_King_Timer,?,?);
				N: XIC(Cuddy_King_Timer.DN)[CTU(Cuddy_Count,?,?) ,XIC(Cuddy_Count.DN) RES(Cuddy_Count) ];
				N: XIC(B3[2].2)ONS(Weight_Store_ONS)[MOV(N7[2],Weight_Storage) ,MOV(N7[2],Weight_Storage_webpage) ,MOV(N7[2],Bundle_Weight[0]) ,OTU(Weigher_Went_Up) ,OTU(QA_Analysis_Done) ];
				RC: "Bundle Weight Array$N"
				    " ";
				N: XIC(Sunmetals_to_Signode.0)[TON(BundleShift_Delay,?,?) ,XIC(BundleShift_Delay.DN) ONS(Bundle_weight_ons) [MOV(Bundle_Weight[3],Bundle_Weight[4]) ,MOV(Bundle_Weight[2],Bundle_Weight[3]) ,MOV(Bundle_Weight[1],Bundle_Weight[2]) ,MOV(Bundle_Weight[0],Bundle_Weight[1]) ,MOV(-1,Bundle_Weight[0]) ] ];
				N: XIC(Cuddy_King_Timer.DN)[EQU(Weight_Storage,0) [MOV(Weight_Storage,Tons_Hour_Array[Cuddy_Count.ACC]) ,MOV(0,Bundle_Present_Minute_Array[Cuddy_Count.ACC]) ,MOV(Weight_Storage,Tons_Reject_Weights_Array[Cuddy_Count.ACC]) ,MOV(0,Bundle_Reject_Array[Cuddy_Count.ACC]) ,MOV(0,Tons_Out_Weights[Cuddy_Count.ACC]) ,MOV(0,Bundle_Out_Weight_Array[Cuddy_Count.ACC]) ,MOV(0,Tons_Remelt[Cuddy_Count.ACC]) ,MOV(0,Bundle_Remelt_Array[Cuddy_Count.ACC]) ] ,NEQ(Weight_Storage,0) [MOV(Weight_Storage,Tons_Hour_Array[Cuddy_Count.ACC]) ,MOV(1,Bundle_Present_Minute_Array[Cuddy_Count.ACC]) ,XIC(QA_Reject_Latch) GRT(Weight_Storage,950) LES(Weight_Storage,1050) [MOV(Weight_Storage,Tons_Reject_Weights_Array[Cuddy_Count.ACC]) ,MOV(1,Bundle_Reject_Array[Cuddy_Count.ACC]) ,OTU(QA_Reject_Latch) ] ] ,NEQ(Weight_Storage,0) [GRT(Weight_Storage,1050) LES(Weight_Storage,1065) ,GRT(Weight_Storage,935) LES(Weight_Storage,950) ] [MOV(Weight_Storage,Tons_Out_Weights[Cuddy_Count.ACC]) ,MOV(1,Bundle_Out_Weight_Array[Cuddy_Count.ACC]) ] ,NEQ(Weight_Storage,0) [GRT(Weight_Storage,1065) ,LES(Weight_Storage,935) ] [MOV(Weight_Storage,Tons_Remelt[Cuddy_Count.ACC]) ,MOV(1,Bundle_Remelt_Array[Cuddy_Count.ACC]) ] ,MOV(0,Weight_Storage) ,XIC(N7[11].0) OTL(QA_Reject_Latch) ];
				N: XIO(Sum_Timer.DN)XIO(Incrementer.DN)TON(Sum_Timer,?,?);
				N: XIC(Sum_Timer.DN)[ADD(Tons_Hour_Array[Incrementer.ACC],Total_Tonnes,Total_Tonnes) ,ADD(Bundle_Present_Minute_Array[Incrementer.ACC],Total_Bundles,Total_Bundles) ,ADD(Tons_Reject_Weights_Array[Incrementer.ACC],Total_Reject_Weight,Total_Reject_Weight) ,ADD(Bundle_Reject_Array[Incrementer.ACC],Total_Reject_Bundles,Total_Reject_Bundles) ,ADD(Tons_Out_Weights[Incrementer.ACC],Total_OOW_Weight,Total_OOW_Weight) ,ADD(Bundle_Out_Weight_Array[Incrementer.ACC],Total_OOW_Bundles,Total_OOW_Bundles) ,ADD(Tons_Remelt[Incrementer.ACC],Total_Remelt_Weight,Total_Remelt_Weight) ,ADD(Bundle_Remelt_Array[Incrementer.ACC],Total_Remelt_Bundles,Total_Remelt_Bundles) ];
				N: XIC(Cuddy_King_Timer.DN)[DIV(Total_Tonnes,Total_Bundles,Slab1_Average_Bundle_Weight_Hour) ,DIV(Total_Tonnes,1000,Slab1_Tons_Hour_Total_Float) ,DIV(Total_Reject_Weight,Total_Reject_Bundles,Slab1_Average_Reject_Weight_Hour) ,DIV(Total_Reject_Weight,1000,Slab1_Reject_Tons_Hour_Total_Float) ,DIV(Total_OOW_Weight,Total_OOW_Bundles,Slab1_Average_Bundle_OOW_Weight_Hour) ,DIV(Total_OOW_Weight,1000,Slab1_OOW_Tons_Hour_Total_Float) ,DIV(Total_Remelt_Weight,Total_Remelt_Bundles,Slab1_Average_Remelt_Weight_Hour) ,DIV(Total_Remelt_Weight,1000,Slab1_Remelt_Tons_Hour_Total_Float) ,CPT(Slab1_Quality_Tonnes_Weight_Hour,(Total_Tonnes-Total_Reject_Weight-Total_OOW_Weight-Total_Remelt_Weight)/1000) ,CPT(Slab1_Rework_Tonnes_Weight_Hour,(Total_Reject_Weight+Total_OOW_Weight)/1000) ];
				N: XIC(Sum_Timer.DN)CTU(Incrementer,?,?);
				N: XIC(Cuddy_King_Timer.DN)[RES(Incrementer) ,MOV(0,Total_Tonnes) ,MOV(0,Total_Bundles) ,MOV(0,Total_Reject_Weight) ,MOV(0,Total_Reject_Bundles) ,MOV(0,Total_OOW_Weight) ,MOV(0,Total_OOW_Bundles) ,MOV(0,Total_Remelt_Weight) ,MOV(0,Total_Remelt_Bundles) ];
				N: MOV(Swap_To_North_Counter.ACC,Goal_Keeper_Statistic);
				RC: "Statistics for webpage and Crew KPI Total tons";
				N: XIC(B3[2].2)XIC(A_CREW)ADD(Weight_Storage_webpage,Total_Kg_Yearly_A_Crew,Total_Kg_Yearly_A_Crew);
				N: XIC(B3[2].2)XIC(B_CREW)ADD(Weight_Storage_webpage,Total_Kg_Yearly_B_Crew,Total_Kg_Yearly_B_Crew);
				N: XIC(B3[2].2)XIC(C_CREW)ADD(Weight_Storage_webpage,Total_Kg_Yearly_C_Crew,Total_Kg_Yearly_C_Crew);
				N: XIC(B3[2].2)XIC(D_CREW)ADD(Weight_Storage_webpage,Total_Kg_Yearly_D_Crew,Total_Kg_Yearly_D_Crew);
				N: XIC(B3[2].2)ADD(Weight_Storage_webpage,Total_Kg_Yearly,Total_Kg_Yearly);
				RC: "Yearly reset of Statistics";
				N: EQU(Wall_Clock.Month,1)EQU(Wall_Clock.Hour,6)ONS(Year_End)[MOV(0,Total_Kg_Yearly_A_Crew) ,MOV(0,Total_Kg_Yearly_B_Crew) ,MOV(0,Total_Kg_Yearly_C_Crew) ,MOV(0,Total_Kg_Yearly_D_Crew) ,MOV(0,Total_Kg_Yearly) ,MOV(0,Swap_To_North_Counter.ACC) ,MOV(0,Reject_Kg_Year[1]) ,MOV(0,Reject_Kg_Year[2]) ,MOV(0,Reject_Kg_Year[3]) ,MOV(0,Reject_Kg_Year[4]) ,MOV(0,Out_Weight_Kg_Year[1]) ,MOV(0,Out_Weight_Kg_Year[2]) ,MOV(0,Out_Weight_Kg_Year[3]) ,MOV(0,Out_Weight_Kg_Year[4]) ,MOV(0,Remelt_Kg[1]) ,MOV(0,Remelt_Kg[2]) ,MOV(0,Remelt_Kg[3]) ,MOV(0,Remelt_Kg[4]) ,MOV(0,Reject_Kg_All_Crew_Year) ,MOV(0,Out_Weight_Kg_All_Crew_Year) ,MOV(0,Remelt_Kg_All_Crew_Year) ];
				N: XIC(B3[2].2)XIC(A_CREW)ADD(Weight_Storage_webpage,Total_Kg_Month_A_Crew[Wall_Clock.Month],Total_Kg_Month_A_Crew[Wall_Clock.Month]);
				N: XIC(B3[2].2)XIC(B_CREW)ADD(Weight_Storage_webpage,Total_Kg_Month_B_Crew[Wall_Clock.Month],Total_Kg_Month_B_Crew[Wall_Clock.Month]);
				N: XIC(B3[2].2)XIC(C_CREW)ADD(Weight_Storage_webpage,Total_Kg_Month_C_Crew[Wall_Clock.Month],Total_Kg_Month_C_Crew[Wall_Clock.Month]);
				N: XIC(B3[2].2)XIC(D_CREW)ADD(Weight_Storage_webpage,Total_Kg_Month_D_Crew[Wall_Clock.Month],Total_Kg_Month_D_Crew[Wall_Clock.Month]);
				N: XIC(B3[2].2)ADD(Weight_Storage_webpage,Total_Kg_Month_All_Crew[Wall_Clock.Month],Total_Kg_Month_All_Crew[Wall_Clock.Month]);
				RC: "Clears a 3 month gap for website Statistics";
				N: EQU(Wall_Clock.Day,1)EQU(Wall_Clock.Hour,6)LES(Wall_Clock.Month,10)ONS(Month_End)[MOV(0,Total_Kg_Month_A_Crew[Wall_Clock.Month+3]) ,MOV(0,Total_Kg_Month_B_Crew[Wall_Clock.Month+3]) ,MOV(0,Total_Kg_Month_C_Crew[Wall_Clock.Month+3]) ,MOV(0,Total_Kg_Month_D_Crew[Wall_Clock.Month+3]) ,MOV(0,Total_Kg_Month_All_Crew[Wall_Clock.Month+3]) ,MOV(0,Reject_Kg_Month_A_Crew[Wall_Clock.Month+3]) ,MOV(0,Reject_Kg_Month_B_Crew[Wall_Clock.Month+3]) ,MOV(0,Reject_Kg_Month_C_Crew[Wall_Clock.Month+3]) ,MOV(0,Reject_Kg_Month_D_Crew[Wall_Clock.Month+3]) ,MOV(0,Reject_Kg_Month_All_Crew[Wall_Clock.Month+3]) ,MOV(0,Out_Weight_Kg_Month_A_Crew[Wall_Clock.Month+3]) ,MOV(0,Out_Weight_Kg_Month_B_Crew[Wall_Clock.Month+3]) ,MOV(0,Out_Weight_Kg_Month_C_Crew[Wall_Clock.Month+3]) ,MOV(0,Out_Weight_Kg_Month_D_Crew[Wall_Clock.Month+3]) ,MOV(0,Out_Weight_Kg_Month_All_Crew[Wall_Clock.Month+3]) ,MOV(0,Remelt_Kg_Month_A_Crew[Wall_Clock.Month+3]) ,MOV(0,Remelt_Kg_Month_B_Crew[Wall_Clock.Month+3]) ,MOV(0,Remelt_Kg_Month_C_Crew[Wall_Clock.Month+3]) ,MOV(0,Remelt_Kg_Month_D_Crew[Wall_Clock.Month+3]) ,MOV(0,Remelt_Kg_Month_All_Crew[Wall_Clock.Month+3]) ];
				RC: "Clears a 3 month gap for website Statistics$N"
				    "$N"
				    "To prevent controller Fault Loop around array$N"
				    "$N"
				    "October + 3 months = January";
				N: EQU(Wall_Clock.Day,1)EQU(Wall_Clock.Hour,6)EQU(Wall_Clock.Month,10)ONS(Month_End1)[MOV(0,Total_Kg_Month_A_Crew[1]) ,MOV(0,Total_Kg_Month_B_Crew[1]) ,MOV(0,Total_Kg_Month_C_Crew[1]) ,MOV(0,Total_Kg_Month_D_Crew[1]) ,MOV(0,Total_Kg_Month_All_Crew[1]) ,MOV(0,Reject_Kg_Month_A_Crew[1]) ,MOV(0,Reject_Kg_Month_B_Crew[1]) ,MOV(0,Reject_Kg_Month_C_Crew[1]) ,MOV(0,Reject_Kg_Month_D_Crew[1]) ,MOV(0,Reject_Kg_Month_All_Crew[1]) ,MOV(0,Out_Weight_Kg_Month_A_Crew[1]) ,MOV(0,Out_Weight_Kg_Month_B_Crew[1]) ,MOV(0,Out_Weight_Kg_Month_C_Crew[1]) ,MOV(0,Out_Weight_Kg_Month_D_Crew[1]) ,MOV(0,Out_Weight_Kg_Month_All_Crew[1]) ,MOV(0,Remelt_Kg_Month_A_Crew[1]) ,MOV(0,Remelt_Kg_Month_B_Crew[1]) ,MOV(0,Remelt_Kg_Month_C_Crew[1]) ,MOV(0,Remelt_Kg_Month_D_Crew[1]) ,MOV(0,Remelt_Kg_Month_All_Crew[1]) ];
				RC: "Clears a 3 month gap for website Statistics$N"
				    "$N"
				    "To prevent controller Fault Loop around array$N"
				    "$N"
				    "November + 3 months = Febuary";
				N: EQU(Wall_Clock.Day,1)EQU(Wall_Clock.Hour,6)EQU(Wall_Clock.Month,11)ONS(Month_End2)[MOV(0,Total_Kg_Month_A_Crew[2]) ,MOV(0,Total_Kg_Month_B_Crew[2]) ,MOV(0,Total_Kg_Month_C_Crew[2]) ,MOV(0,Total_Kg_Month_D_Crew[2]) ,MOV(0,Total_Kg_Month_All_Crew[2]) ,MOV(0,Reject_Kg_Month_A_Crew[2]) ,MOV(0,Reject_Kg_Month_B_Crew[2]) ,MOV(0,Reject_Kg_Month_C_Crew[2]) ,MOV(0,Reject_Kg_Month_D_Crew[2]) ,MOV(0,Reject_Kg_Month_All_Crew[2]) ,MOV(0,Out_Weight_Kg_Month_A_Crew[2]) ,MOV(0,Out_Weight_Kg_Month_B_Crew[2]) ,MOV(0,Out_Weight_Kg_Month_C_Crew[2]) ,MOV(0,Out_Weight_Kg_Month_D_Crew[2]) ,MOV(0,Out_Weight_Kg_Month_All_Crew[2]) ,MOV(0,Remelt_Kg_Month_A_Crew[2]) ,MOV(0,Remelt_Kg_Month_B_Crew[2]) ,MOV(0,Remelt_Kg_Month_C_Crew[2]) ,MOV(0,Remelt_Kg_Month_D_Crew[2]) ,MOV(0,Remelt_Kg_Month_All_Crew[2]) ];
				RC: "Clears a 3 month gap for website Statistics$N"
				    "$N"
				    "To prevent controller Fault Loop around array$N"
				    "$N"
				    "December + 3 months = March";
				N: EQU(Wall_Clock.Day,1)EQU(Wall_Clock.Hour,6)EQU(Wall_Clock.Month,12)ONS(Month_End3)[MOV(0,Total_Kg_Month_A_Crew[3]) ,MOV(0,Total_Kg_Month_B_Crew[3]) ,MOV(0,Total_Kg_Month_C_Crew[3]) ,MOV(0,Total_Kg_Month_D_Crew[3]) ,MOV(0,Total_Kg_Month_All_Crew[3]) ,MOV(0,Reject_Kg_Month_A_Crew[3]) ,MOV(0,Reject_Kg_Month_B_Crew[3]) ,MOV(0,Reject_Kg_Month_C_Crew[3]) ,MOV(0,Reject_Kg_Month_D_Crew[3]) ,MOV(0,Reject_Kg_Month_All_Crew[3]) ,MOV(0,Out_Weight_Kg_Month_A_Crew[3]) ,MOV(0,Out_Weight_Kg_Month_B_Crew[3]) ,MOV(0,Out_Weight_Kg_Month_C_Crew[3]) ,MOV(0,Out_Weight_Kg_Month_D_Crew[3]) ,MOV(0,Out_Weight_Kg_Month_All_Crew[3]) ,MOV(0,Remelt_Kg_Month_A_Crew[3]) ,MOV(0,Remelt_Kg_Month_B_Crew[3]) ,MOV(0,Remelt_Kg_Month_C_Crew[3]) ,MOV(0,Remelt_Kg_Month_D_Crew[3]) ,MOV(0,Remelt_Kg_Month_All_Crew[3]) ];
				RC: "Live shift total acc";
				N: XIC(B3[2].2)ADD(Weight_Storage_webpage,Total_Shift_Kg,Total_Shift_Kg);
				N: [EQU(Wall_Clock.Hour,6) ,EQU(Wall_Clock.Hour,18) ]ONS(Shift_End)[MOV(0,Total_Shift_Kg) ,MOV(0,Remelt_Shift_Kg) ,MOV(0,Out_Weight_Shift_Kg) ,MOV(0,Reject_Shift_Kg) ,MOV(0,Quality_Tons_Shift) ];
				N: XIC(B3[2].2)[XIC(QA_Reject_Latch) GRT(Weight_Storage_webpage,950) LES(Weight_Storage_webpage,1050) [ADD(Weight_Storage_webpage,Reject_Kg_Year[Crew_count],Reject_Kg_Year[Crew_count]) ,XIC(A_CREW) ADD(Weight_Storage_webpage,Reject_Kg_Month_A_Crew[Wall_Clock.Month],Reject_Kg_Month_A_Crew[Wall_Clock.Month]) ,XIC(B_CREW) ADD(Weight_Storage_webpage,Reject_Kg_Month_B_Crew[Wall_Clock.Month],Reject_Kg_Month_B_Crew[Wall_Clock.Month]) ,XIC(C_CREW) ADD(Weight_Storage_webpage,Reject_Kg_Month_C_Crew[Wall_Clock.Month],Reject_Kg_Month_C_Crew[Wall_Clock.Month]) ,XIC(D_CREW) ADD(Weight_Storage_webpage,Reject_Kg_Month_D_Crew[Wall_Clock.Month],Reject_Kg_Month_D_Crew[Wall_Clock.Month]) ,ADD(Weight_Storage_webpage,Reject_Kg_Month_All_Crew[Wall_Clock.Month],Reject_Kg_Month_All_Crew[Wall_Clock.Month]) ,ADD(Weight_Storage_webpage,Reject_Shift_Kg,Reject_Shift_Kg) ,ADD(Weight_Storage_webpage,Reject_Kg_All_Crew_Year,Reject_Kg_All_Crew_Year) ] ,[GRT(Weight_Storage_webpage,1050) LES(Weight_Storage_webpage,1065) ,GRT(Weight_Storage_webpage,935) LES(Weight_Storage_webpage,950) ] [ADD(Weight_Storage_webpage,Out_Weight_Kg_Year[Crew_count],Out_Weight_Kg_Year[Crew_count]) ,XIC(A_CREW) ADD(Weight_Storage_webpage,Out_Weight_Kg_Month_A_Crew[Wall_Clock.Month],Out_Weight_Kg_Month_A_Crew[Wall_Clock.Month]) ,XIC(B_CREW) ADD(Weight_Storage_webpage,Out_Weight_Kg_Month_B_Crew[Wall_Clock.Month],Out_Weight_Kg_Month_B_Crew[Wall_Clock.Month]) ,XIC(C_CREW) ADD(Weight_Storage_webpage,Out_Weight_Kg_Month_C_Crew[Wall_Clock.Month],Out_Weight_Kg_Month_C_Crew[Wall_Clock.Month]) ,XIC(D_CREW) ADD(Weight_Storage_webpage,Out_Weight_Kg_Month_D_Crew[Wall_Clock.Month],Out_Weight_Kg_Month_D_Crew[Wall_Clock.Month]) ,ADD(Weight_Storage_webpage,Out_Weight_Kg_Month_All_Crew[Wall_Clock.Month],Out_Weight_Kg_Month_All_Crew[Wall_Clock.Month]) ,ADD(Weight_Storage_webpage,Out_Weight_Shift_Kg,Out_Weight_Shift_Kg) ,ADD(Weight_Storage_webpage,Out_Weight_Kg_All_Crew_Year,Out_Weight_Kg_All_Crew_Year) ] ,NEQ(Weight_Storage_webpage,0) [GRT(Weight_Storage_webpage,1065) ,LES(Weight_Storage_webpage,935) ] [ADD(Weight_Storage_webpage,Remelt_Kg[Crew_count],Remelt_Kg[Crew_count]) ,XIC(A_CREW) ADD(Weight_Storage_webpage,Remelt_Kg_Month_A_Crew[Wall_Clock.Month],Remelt_Kg_Month_A_Crew[Wall_Clock.Month]) ,XIC(B_CREW) ADD(Weight_Storage_webpage,Remelt_Kg_Month_B_Crew[Wall_Clock.Month],Remelt_Kg_Month_B_Crew[Wall_Clock.Month]) ,XIC(C_CREW) ADD(Weight_Storage_webpage,Remelt_Kg_Month_C_Crew[Wall_Clock.Month],Remelt_Kg_Month_C_Crew[Wall_Clock.Month]) ,XIC(D_CREW) ADD(Weight_Storage_webpage,Remelt_Kg_Month_D_Crew[Wall_Clock.Month],Remelt_Kg_Month_D_Crew[Wall_Clock.Month]) ,ADD(Weight_Storage_webpage,Remelt_Kg_Month_All_Crew[Wall_Clock.Month],Remelt_Kg_Month_All_Crew[Wall_Clock.Month]) ,ADD(Weight_Storage_webpage,Remelt_Shift_Kg,Remelt_Shift_Kg) ,ADD(Weight_Storage_webpage,Remelt_Kg_All_Crew_Year,Remelt_Kg_All_Crew_Year) ] ,MOV(0,Weight_Storage_webpage) ,CPT(Quality_Tons_Year_Total_A_CREW,(Total_Kg_Yearly_A_Crew-Reject_Kg_Year[1]-Out_Weight_Kg_Year[1]-Remelt_Kg[1])/1000) ,CPT(Quality_Tons_Year_Total_B_CREW,(Total_Kg_Yearly_B_Crew-Reject_Kg_Year[2]-Out_Weight_Kg_Year[2]-Remelt_Kg[2])/1000) ,CPT(Quality_Tons_Year_Total_C_CREW,(Total_Kg_Yearly_C_Crew-Reject_Kg_Year[3]-Out_Weight_Kg_Year[3]-Remelt_Kg[3])/1000) ,CPT(Quality_Tons_Year_Total_D_CREW,(Total_Kg_Yearly_D_Crew-Reject_Kg_Year[4]-Out_Weight_Kg_Year[4]-Remelt_Kg[4])/1000) ,CPT(Quality_Tons_Year_Total_All_CREW,(Total_Kg_Yearly-Reject_Kg_All_Crew_Year-Out_Weight_Kg_All_Crew_Year-Remelt_Kg_All_Crew_Year)/1000) ,CPT(Quality_Tons_Month_Total_A_CREW[Wall_Clock.Month],(Total_Kg_Month_A_Crew[Wall_Clock.Month]-Reject_Kg_Month_A_Crew[Wall_Clock.Month]-Out_Weight_Kg_Month_A_Crew[Wall_Clock.Month]-Remelt_Kg_Month_A_Crew[Wall_Clock.Month])/1000) ,CPT(Quality_Tons_Month_Total_B_CREW[Wall_Clock.Month],(Total_Kg_Month_B_Crew[Wall_Clock.Month]-Reject_Kg_Month_B_Crew[Wall_Clock.Month]-Out_Weight_Kg_Month_B_Crew[Wall_Clock.Month]-Remelt_Kg_Month_B_Crew[Wall_Clock.Month])/1000) ,CPT(Quality_Tons_Month_Total_C_CREW[Wall_Clock.Month],(Total_Kg_Month_C_Crew[Wall_Clock.Month]-Reject_Kg_Month_C_Crew[Wall_Clock.Month]-Out_Weight_Kg_Month_C_Crew[Wall_Clock.Month]-Remelt_Kg_Month_C_Crew[Wall_Clock.Month])/1000) ,CPT(Quality_Tons_Month_Total_D_CREW[Wall_Clock.Month],(Total_Kg_Month_D_Crew[Wall_Clock.Month]-Reject_Kg_Month_D_Crew[Wall_Clock.Month]-Out_Weight_Kg_Month_D_Crew[Wall_Clock.Month]-Remelt_Kg_Month_D_Crew[Wall_Clock.Month])/1000) ,CPT(Quality_Tons_Month_Total_All_CREW[Wall_Clock.Month],(Total_Kg_Month_All_Crew[Wall_Clock.Month]-Reject_Kg_Month_All_Crew[Wall_Clock.Month]-Out_Weight_Kg_Month_All_Crew[Wall_Clock.Month]-Remelt_Kg_Month_All_Crew[Wall_Clock.Month])/1000) ,CPT(Quality_Tons_Shift,(Total_Shift_Kg-Reject_Shift_Kg-Out_Weight_Shift_Kg-Remelt_Shift_Kg)/1000) ];
				RC: "shift counter=0, day shift D Crew first day";
				N: [EQU(6,Wall_Clock.Hour) EQU(0,Wall_Clock.Minute) EQU(0,Wall_Clock.Second) ONS(crew_ONS) ,EQU(18,Wall_Clock.Hour) EQU(0,Wall_Clock.Minute) EQU(0,Wall_Clock.Second) ONS(crew_ONS1) ]CTU(Shift_Counter,?,?);
				N: XIC(Shift_Counter.DN)RES(Shift_Counter);
				RC: "Current Crew on shift";
				N: [EQU(Shift_Counter.ACC,4) ,EQU(Shift_Counter.ACC,6) ,EQU(Shift_Counter.ACC,9) ,EQU(Shift_Counter.ACC,11) ][OTE(A_CREW) ,MOV(1,Crew_count) ];
				N: [EQU(Shift_Counter.ACC,8) ,EQU(Shift_Counter.ACC,10) ,EQU(Shift_Counter.ACC,13) ,EQU(Shift_Counter.ACC,15) ][OTE(B_CREW) ,MOV(2,Crew_count) ];
				N: [EQU(Shift_Counter.ACC,1) ,EQU(Shift_Counter.ACC,3) ,EQU(Shift_Counter.ACC,12) ,EQU(Shift_Counter.ACC,14) ][OTE(C_CREW) ,MOV(3,Crew_count) ];
				N: [EQU(Shift_Counter.ACC,0) ,EQU(Shift_Counter.ACC,2) ,EQU(Shift_Counter.ACC,5) ,EQU(Shift_Counter.ACC,7) ][OTE(D_CREW) ,MOV(4,Crew_count) ];
				N: GRT(Wall_Clock.Microsecond,500000)[CTU(Total_Shift_Seconds,?,?) ,XIC(Ingots_Producing.DN) XIO(R_O_4_4) CTU(Total_Stacked_Production_Shift_Seconds,?,?) ,CPT(Stacked_Line_Utilisation_Shift,(Total_Stacked_Production_Shift_Seconds.ACC/Total_Shift_Seconds.ACC)*100) ,CPT(Stopped_Shift,((Total_Shift_Seconds.ACC-Total_Stacked_Production_Shift_Seconds.ACC-Stopper_Down_Shift_Seconds.ACC)/Total_Shift_Seconds.ACC)*100) ,CPT(Stopper_Down_Shift,(Stopper_Down_Shift_Seconds.ACC/Total_Shift_Seconds.ACC)*100) ,XIC(R_O_4_4) XIC(Ingots_Producing.DN) CTU(Stopper_Down_Shift_Seconds,?,?) ];
				N: XIC(R_O_4_4)XIC(Ingots_Producing.DN)CTU(Stopper_Down_Event_Shift,?,?);
				N: XIO(Ingots_Producing.DN)CTU(Stopped_Event_Shift,?,?);
				N: XIC(R_I_1_10)TOF(Ingots_Producing,?,?);
				N: [MOV(Stopped_Shift,Stopped_Shift1) ,MOV(Stacked_Line_Utilisation_Shift,Stacked_Line_Utilisation_Shift1) ,MOV(Stopper_Down_Shift,Stopper_Down_Shift1) ];
				N: [EQU(Wall_Clock.Hour,6) ,EQU(Wall_Clock.Hour,18) ]ONS(Shift_End1)[MOV(Stopped_Shift,Stopped_Last_Shift) ,MOV(Stacked_Line_Utilisation_Shift,Stacked_Line_Utilisation_Last_Shift) ,MOV(Stopper_Down_Shift,Stopper_Down_Last_Shift) ,MOV(Stopper_Down_Event_Shift.ACC,Stopper_Down_Event_Last_Shift) ,MOV(Stopped_Event_Shift.ACC,Stopped_Event_Last_Shift) ,RES(Stopper_Down_Shift_Seconds) RES(Total_Stacked_Production_Shift_Seconds) RES(Total_Shift_Seconds) RES(Stopped_Event_Shift) RES(Stopper_Down_Event_Shift) ];
