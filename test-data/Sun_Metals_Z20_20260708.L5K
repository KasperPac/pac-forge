		ROUTINE Logic 
				RC: "Input";
				N: XIC(InForcedLogic)OTE(ForcedLogic);
				N: XIC(InSensorFault)OTE(SensorFault);
				N: XIC(InResetAlarm)OTE(ResetAlarm);
				N: XIC(InSensorFault)OTE(SensorFault);
				N: XIC(InHH_AlarmSP_Disable)OTE(HH_AlarmSP_Disable);
				N: XIC(InH_AlarmSP_Disable)OTE(H_AlarmSP_Disable);
				N: XIC(InL_AlarmSP_Disable)OTE(L_AlarmSP_Disable);
				N: XIC(InLL_AlarmSP_Disable)OTE(LL_AlarmSP_Disable);
				N: XIC(InDisable_Filter)OTE(Disable_Filter);
				RC: "Input Scale Decimal";
				N: MOV(InAI_Signal_Dec,AI_Signal_Dec)CPT(Signal_Dec,((1/65535)*AI_Signal_Dec));
				RC: "Input Scale Integer";
				N: MOV(InAI_Signal_Int,AI_Signal_Int)CPT(X_Raw,InRawMax-InRawMin)[NEQ(X_Raw,0) CPT(M,(InScaleMax-InScaleMin)/X_Raw) CPT(B,(InScaleMax-(InRawMax*M))) ,EQU(X_Raw,0) MOV(0,M) MOV(0,B) ]CPT(Signal_Int,(AI_Signal_Int*M)+B);
				RC: "Input Offset";
				N: CPT(Signal,Signal_Int+Signal_Dec+InOffset);
				RC: "Input Filter";
				N: XIC(Disable_Filter)JMP(JumpFilter);
				N: LES(InSampling1Number_F,1)MOV(0,Sampling1Number_F);
				N: GEQ(InSampling1Number_F,1)MOV(InSampling1Number_F,Sampling1Number_F);
				N: LES(InSampling2Number_F,1)MOV(0,Sampling2Number_F);
				N: GEQ(InSampling2Number_F,1)MOV(InSampling2Number_F,Sampling2Number_F);
				N: LES(InSampling3Number_F,1)MOV(0,Sampling3Number_F);
				N: GEQ(InSampling3Number_F,1)MOV(InSampling3Number_F,Sampling3Number_F);
				N: ADD(Signal,Accumulated1,Accumulated1)ADD(Sampling1,1,Sampling1);
				N: GEQ(Sampling1,Sampling1Number_F)DIV(Accumulated1,Sampling1,Value1)ADD(Value1,Accumulated2,Accumulated2)ADD(Sampling2,1,Sampling2)[MOV(0,Accumulated1) ,MOV(0,Sampling1) ];
				N: GEQ(Sampling2,Sampling2Number_F)DIV(Accumulated2,Sampling2,Value2)ADD(Value2,Accumulated3,Accumulated3)ADD(Sampling3,1,Sampling3)[MOV(0,Accumulated2) ,MOV(0,Sampling2) ];
				N: GEQ(Sampling3,Sampling3Number_F)DIV(Accumulated3,Sampling3,Average_Value)[MOV(0,Accumulated3) ,MOV(0,Sampling3) ];
				N: LBL(JumpFilter)XIO(Disable_Filter)XIO(ForcedLogic)MOV(Average_Value,FinalValue);
				RC: "Skip filter";
				N: XIC(Disable_Filter)XIO(ForcedLogic)MOV(Signal,FinalValue);
				RC: "Input Forced Signal";
				N: XIC(ForcedLogic)MOV(InForcedSignal,FinalValue);
				RC: "HH_Alarm";
				N: XIO(HH_AlarmSP_Disable)[CPT(HH_AlarmDB_SP,InHH_AlarmSP+InAlarm_DeadBand) GEQ(FinalValue,HH_AlarmDB_SP) ,XIC(HH_Alarm) XIO(ResetAlarm) ][XIO(SensorFault) ,XIC(ForcedLogic) ]OTE(HH_Alarm);
				RC: "H_Alarm";
				N: XIO(H_AlarmSP_Disable)[CPT(H_AlarmDB_SP,InH_AlarmSP+InAlarm_DeadBand) GEQ(FinalValue,H_AlarmDB_SP) ,XIC(H_Alarm) XIO(ResetAlarm) ][XIO(SensorFault) ,XIC(ForcedLogic) ]OTE(H_Alarm);
				RC: "L_Alarm";
				N: XIO(L_AlarmSP_Disable)[CPT(L_AlarmDB_SP,InL_AlarmSP-InAlarm_DeadBand) LEQ(FinalValue,L_AlarmDB_SP) ,XIC(L_Alarm) XIO(ResetAlarm) ][XIO(SensorFault) ,XIC(ForcedLogic) ]OTE(L_Alarm);
				RC: "LL_Alarm";
				N: XIO(LL_AlarmSP_Disable)[CPT(LL_AlarmDB_SP,InLL_AlarmSP-InAlarm_DeadBand) LEQ(FinalValue,LL_AlarmDB_SP) ,XIC(LL_Alarm) XIO(ResetAlarm) ][XIO(SensorFault) ,XIC(ForcedLogic) ]OTE(LL_Alarm);
				RC: "Sensor in Alarma";
				N: [XIC(SensorFault) ,XIC(HH_Alarm) ,XIC(H_Alarm) ,XIC(L_Alarm) ,XIC(LL_Alarm) ]OTE(SensorInAlarm);
				RC: "A Sensor Status: 0=Error, 1=Ok, 2=Forced Ok, 3=HH Alarm, 4=Forced HH Alarm, 5=H Alarm, 6=Forced H Alarm, 7=L Alarm, 8=Forced L Alarm, 9=LL Alarm, 10=Forced LL Alarm,  11=Sensor in Fault";
				N: MOV(0,OutSensorStatus);
				N: XIO(SensorFault)XIO(HH_Alarm)XIO(H_Alarm)XIO(L_Alarm)XIO(LL_Alarm)[XIO(ForcedLogic) MOV(1,OutSensorStatus) ,XIC(ForcedLogic) MOV(2,OutSensorStatus) ];
				N: XIC(HH_Alarm)[XIO(ForcedLogic) MOV(3,OutSensorStatus) ,XIC(ForcedLogic) MOV(4,OutSensorStatus) ];
				N: XIC(H_Alarm)[XIO(ForcedLogic) MOV(5,OutSensorStatus) ,XIC(ForcedLogic) MOV(6,OutSensorStatus) ];
				N: XIC(L_Alarm)[XIO(ForcedLogic) MOV(7,OutSensorStatus) ,XIC(ForcedLogic) MOV(8,OutSensorStatus) ];
				N: XIC(LL_Alarm)[XIO(ForcedLogic) MOV(9,OutSensorStatus) ,XIC(ForcedLogic) MOV(10,OutSensorStatus) ];
				N: XIC(SensorFault)XIO(ForcedLogic)MOV(11,OutSensorStatus);
				RC: "Output";
				N: MOV(FinalValue,OutSignal)MOV(Signal,OutNoFilteredSignal);
				N: XIC(HH_Alarm)OTE(OutHH_Alarm);
				N: XIC(H_Alarm)OTE(OutH_Alarm);
				N: XIC(L_Alarm)OTE(OutL_Alarm);
				N: XIC(LL_Alarm)OTE(OutLL_Alarm);
				N: XIC(SensorInAlarm)OTE(OutSensor_In_Alarm);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION FB_DI_PushButton (Revision := "1.0",
	                                                ExecutePrescan := No,
	                                                ExecutePostscan := No,
	                                                ExecuteEnableInFalse := No,
	                                                CreatedDate := "2025-07-14T10:16:12.242Z",
	                                                CreatedBy := "DESKTOP-DBPRR6T\admin",
	                                                EditedDate := "2025-07-14T10:54:36.413Z",
	                                                EditedBy := "DESKTOP-DBPRR6T\admin",
	                                                SoftwareRevision := "v33.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			InInput : BOOL (Usage := Input,
			                   RADIX := Decimal,
			                   Required := No,
			                   Visible := Yes,
			                   DefaultData := 0);
			InShortHold_Time : DINT (Usage := Input,
			                            RADIX := Decimal,
			                            Required := No,
			                            Visible := Yes,
			                            DefaultData := 0);
			InLongHold_Time : DINT (Usage := Input,
			                           RADIX := Decimal,
			                           Required := No,
			                           Visible := Yes,
			                           DefaultData := 0);
			InInputOff_Delay : DINT (Usage := Input,
			                            RADIX := Decimal,
			                            Required := No,
			                            Visible := Yes,
			                            DefaultData := 0);
			OutPushButton_On : BOOL (Usage := Output,
			                            RADIX := Decimal,
			                            Required := No,
			                            Visible := Yes,
			                            ExternalAccess := Read Only,
			                            DefaultData := 0);
			OutPushButton_Short_On : BOOL (Usage := Output,
			                                  RADIX := Decimal,
			                                  Required := No,
			                                  Visible := Yes,
			                                  ExternalAccess := Read Only,
			                                  DefaultData := 0);
			OutPushButton_Long_On : BOOL (Usage := Output,
			                                 RADIX := Decimal,
			                                 Required := No,
			                                 Visible := Yes,
			                                 ExternalAccess := Read Only,
			                                 DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			PushButton_Out_Long_OnOff : BOOL (RADIX := Decimal,
			                                    ExternalAccess := None,
			                                    DefaultData := 0);
			PushButton_Out_Short_OnOff : BOOL (RADIX := Decimal,
			                                     ExternalAccess := None,
			                                     DefaultData := 0);
			PushButton_Out_Long : BOOL (RADIX := Decimal,
			                              ExternalAccess := None,
			                              DefaultData := 0);
			PushButton_Out_Short : BOOL (RADIX := Decimal,
			                               ExternalAccess := None,
			                               DefaultData := 0);
			PushButton_Off : BOOL (RADIX := Decimal,
			                         ExternalAccess := None,
			                         DefaultData := 0);
			InputOff_Delay : TIMER (ExternalAccess := None,
			                         DefaultData := "[0,0,0]");
			Input_Long : TIMER (ExternalAccess := None,
			                     DefaultData := "[0,0,0]");
			Input_Short : TIMER (ExternalAccess := None,
			                      DefaultData := "[0,0,0]");
			Input : BOOL (RADIX := Decimal,
			                ExternalAccess := None,
			                DefaultData := 0);
			PushButton_Input : BOOL (RADIX := Decimal,
			                           ExternalAccess := None,
			                           DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: XIC(InInput)OTE(PushButton_Input);
				N: MOV(InShortHold_Time,Input_Short.PRE);
				N: XIC(PushButton_Input)TON(Input_Short,?,?);
				N: XIC(Input_Short.DN)OTE(PushButton_Out_Short);
				N: MOV(InLongHold_Time,Input_Long.PRE);
				N: XIC(PushButton_Input)TON(Input_Long,?,?);
				N: XIC(Input_Long.DN)OTE(PushButton_Out_Long);
				N: MOV(InInputOff_Delay,InputOff_Delay.PRE);
				N: XIO(PushButton_Input)TON(InputOff_Delay,?,?);
				N: XIC(InputOff_Delay.DN)OTE(PushButton_Off);
				N: [XIC(PushButton_Out_Short) ,XIC(PushButton_Out_Short_OnOff) ]XIO(PushButton_Off)OTE(PushButton_Out_Short_OnOff);
				N: [XIC(PushButton_Out_Long) ,XIC(PushButton_Out_Long_OnOff) ]XIO(PushButton_Off)OTE(PushButton_Out_Long_OnOff);
				N: XIC(PushButton_Input)OTE(OutPushButton_On);
				N: XIC(PushButton_Out_Short_OnOff)OTE(OutPushButton_Short_On);
				N: XIC(PushButton_Out_Long_OnOff)OTE(OutPushButton_Long_On);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION FB_DI_Sensor (Revision := "1.0",
	                                            ExecutePrescan := No,
	                                            ExecutePostscan := No,
	                                            ExecuteEnableInFalse := No,
	                                            CreatedDate := "2025-07-07T10:12:03.385Z",
	                                            CreatedBy := "NTE-PC\NTE",
	                                            EditedDate := "2025-07-14T09:15:37.845Z",
	                                            EditedBy := "DESKTOP-DBPRR6T\admin",
	                                            SoftwareRevision := "v33.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			InSignal : BOOL (Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := Yes,
			                    DefaultData := 0);
			InDelayOn : DINT (Usage := Input,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     DefaultData := 0);
			InDelayOFF : DINT (Usage := Input,
			                      RADIX := Decimal,
			                      Required := No,
			                      Visible := Yes,
			                      DefaultData := 0);
			InForcedSignal : BOOL (Description := "HMI Forced signal simulation or maintenance",
			                          Usage := Input,
			                          RADIX := Decimal,
			                          Required := No,
			                          Visible := Yes,
			                          DefaultData := 0);
			InForecedLogic : BOOL (Description := "HMI Activate forced simulation or maintenance",
			                          Usage := Input,
			                          RADIX := Decimal,
			                          Required := No,
			                          Visible := Yes,
			                          DefaultData := 0);
			InSensorFault : BOOL (Usage := Input,
			                         RADIX := Decimal,
			                         Required := No,
			                         Visible := Yes,
			                         DefaultData := 0);
			OutSignal : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read/Write,
			                     DefaultData := 0);
			OutSensor_In_Fault : BOOL (Usage := Output,
			                              RADIX := Decimal,
			                              Required := Yes,
			                              Visible := Yes,
			                              ExternalAccess := Read/Write,
			                              DefaultData := 0);
			OutSensorStatus : INT (Description := "HMI 0=Off, 1=On, 2=Forced Off, 3=Forced On, 4=Fault Off, 5=Fault On",
			                           Usage := Output,
			                           RADIX := Decimal,
			                           Required := No,
			                           Visible := Yes,
			                           ExternalAccess := Read/Write,
			                           DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			Signal : BOOL (RADIX := Decimal,
			                 ExternalAccess := None,
			                 DefaultData := 0);
			ForecedLogic : BOOL (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			ForceSignal : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			DelayON_Timer : TIMER (ExternalAccess := None,
			                        DefaultData := "[0,0,0]");
			DelayOFF_Timer : TIMER (ExternalAccess := None,
			                         DefaultData := "[0,0,0]");
			SensorStatus : INT (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			ProcessedSignal : BOOL (RADIX := Decimal,
			                          ExternalAccess := None,
			                          DefaultData := 0);
			SensorFault : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				RC: "INPUT";
				N: XIC(EnableIn)OTE(EnableOut);
				N: XIC(InForecedLogic)OTE(ForecedLogic);
				N: XIC(InForcedSignal)OTE(ForceSignal);
				N: [XIC(InSignal) XIO(ForecedLogic) ,XIC(ForceSignal) XIC(ForecedLogic) ]OTE(Signal);
				N: XIC(InSensorFault)OTE(SensorFault);
				RC: "TIMER DELAYON";
				N: MOV(InDelayOn,DelayON_Timer.PRE);
				N: XIC(Signal)TON(DelayON_Timer,?,?);
				RC: "TIMER DELAYOFF";
				N: MOV(InDelayOFF,DelayOFF_Timer.PRE);
				N: XIC(DelayON_Timer.DN)TOF(DelayOFF_Timer,?,?);
				RC: "Processed Signal";
				N: [XIC(DelayON_Timer.DN) ,XIC(DelayOFF_Timer.DN) ]OTE(ProcessedSignal);
				RC: "Sensor Status: 0=Off, 1=On, 2=Forced Off, 3=Forced On, 4=Fault Off, 5=Fault On";
				N: XIO(ProcessedSignal)XIO(ForecedLogic)XIO(SensorFault)MOV(0,SensorStatus);
				N: XIC(ProcessedSignal)XIO(ForecedLogic)XIO(SensorFault)MOV(1,SensorStatus);
				N: XIO(ProcessedSignal)XIC(ForecedLogic)MOV(2,SensorStatus);
				N: XIC(ProcessedSignal)XIC(ForecedLogic)MOV(3,SensorStatus);
				N: XIO(ProcessedSignal)XIO(ForecedLogic)XIC(SensorFault)MOV(4,SensorStatus);
				N: XIC(ProcessedSignal)XIO(ForecedLogic)XIC(SensorFault)MOV(5,SensorStatus);
				RC: "OUTPUT";
				N: XIC(ProcessedSignal)OTE(OutSignal);
				N: MOV(SensorStatus,OutSensorStatus);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

