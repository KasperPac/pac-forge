			            COMMENT[0].1 := "Strapping Machine:$NApply Strap at$NMiddle Position$NSTART",
			            COMMENT[0].2 := "Strapping Machine:$NApply Strap at$NMiddle Position$NCOMPLETED",
			            COMMENT[0].3 := "Strapping Machine:$NApply Strap at$NSouth Position$NSTART",
			            COMMENT[0].4 := "Strapping Machine:$NApply Strap at$NSouth Position$NCOMPLETED",
			            COMMENT[0].5 := "Strapping Machine:$NApply Strap at$NNorth Position$NSTART",
