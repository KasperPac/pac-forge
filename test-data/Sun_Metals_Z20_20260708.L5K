		LOCAL_TAGS
			SolenoidFault : BOOL (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			Sol_FeedbackRetract : BOOL (RADIX := Decimal,
			                              ExternalAccess := None,
			                              DefaultData := 0);
			Sol_FeedbackExtend : BOOL (RADIX := Decimal,
			                             ExternalAccess := None,
			                             DefaultData := 0);
			RetractSafePosition : BOOL (RADIX := Decimal,
			                              ExternalAccess := None,
			                              DefaultData := 0);
			Retract_Manual : BOOL (RADIX := Decimal,
			                         ExternalAccess := None,
			                         DefaultData := 0);
			Retract_Auto : BOOL (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			Manual_Mode : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			ExtendSafePosition : BOOL (RADIX := Decimal,
			                             ExternalAccess := None,
			                             DefaultData := 0);
			Extend_Manual : BOOL (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			Extend_Auto : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			Healthy : BOOL (RADIX := Decimal,
			                  ExternalAccess := None,
			                  DefaultData := 0);
			Auto_Mode : BOOL (RADIX := Decimal,
			                    ExternalAccess := None,
			                    DefaultData := 0);
			AlarmReset : BOOL (RADIX := Decimal,
			                     ExternalAccess := None,
			                     DefaultData := 0);
			SolStatus : INT (RADIX := Decimal,
			                    ExternalAccess := None,
			                    DefaultData := 0);
			Sol_In_Fault : BOOL (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			Retract : BOOL (RADIX := Decimal,
			                  ExternalAccess := None,
			                  DefaultData := 0);
			Extend : BOOL (RADIX := Decimal,
			                 ExternalAccess := None,
			                 DefaultData := 0);
			Hold_Last_State : BOOL (RADIX := Decimal,
			                          ExternalAccess := None,
			                          DefaultData := 0);
			SystemRunning : BOOL (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			EnableRetractFeedback : BOOL (RADIX := Decimal,
			                                ExternalAccess := None,
			                                DefaultData := 0);
			EnableExtendFeedback : BOOL (RADIX := Decimal,
			                               ExternalAccess := None,
			                               DefaultData := 0);
			ManualRun : BOOL (RADIX := Decimal,
			                    ExternalAccess := None,
			                    DefaultData := 0);
			AutoRun : BOOL (RADIX := Decimal,
			                  ExternalAccess := None,
			                  DefaultData := 0);
			ExtendLogic : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			RetractLogic : BOOL (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			Feedback_Timer : TIMER (ExternalAccess := None,
			                         DefaultData := "[0,0,0]");
			Aux_NoFeedback : BOOL (RADIX := Decimal,
			                         ExternalAccess := None,
			                         DefaultData := 0);
			AlarmExtendFB_Error : BOOL (RADIX := Decimal,
			                              ExternalAccess := None,
			                              DefaultData := 0);
			AlarmRetractFB_Error : BOOL (RADIX := Decimal,
			                               ExternalAccess := None,
			                               DefaultData := 0);
			AlarmNoFB_Error : BOOL (RADIX := Decimal,
			                          ExternalAccess := None,
			                          DefaultData := 0);
			GeneralAlarmError : BOOL (RADIX := Decimal,
			                            ExternalAccess := None,
			                            DefaultData := 0);
			ExtendStatus : BOOL (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			RetractStatus : BOOL (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			SolFault_RetractFB : BOOL (RADIX := Decimal,
			                             ExternalAccess := None,
			                             DefaultData := 0);
			SolFault_ExtendFB : BOOL (RADIX := Decimal,
			                            ExternalAccess := None,
			                            DefaultData := 0);
			Sol_FeedbackGripping : BOOL (RADIX := Decimal,
			                               ExternalAccess := None,
			                               DefaultData := 0);
			SolFault_GrippingFB : BOOL (RADIX := Decimal,
			                              ExternalAccess := None,
			                              DefaultData := 0);
			EnableGrippingFeedback : BOOL (RADIX := Decimal,
			                                 ExternalAccess := None,
			                                 DefaultData := 0);
			GrippingStatus : BOOL (RADIX := Decimal,
			                         ExternalAccess := None,
			                         DefaultData := 0);
			AlarmGrippingFB_Error : BOOL (RADIX := Decimal,
			                                ExternalAccess := None,
			                                DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				RC: "INPUT Feedback";
				N: XIC(InSol_FeedbackRetract)OTE(Sol_FeedbackRetract);
				N: XIC(InSol_FeedbackExtend)OTE(Sol_FeedbackExtend);
				N: XIC(InSol_FeedbackGripping)OTE(Sol_FeedbackGripping);
				RC: "INPUT System";
				N: XIC(InSystemRunning)OTE(SystemRunning);
				N: XIC(InAuto_Mode)OTE(Auto_Mode);
				N: XIC(InManual_Mode)OTE(Manual_Mode);
				N: XIC(InAlarmReset)OTE(AlarmReset);
				RC: "INPUT Control";
				N: XIC(InExtend_Auto)OTE(Extend_Auto);
				N: XIC(InRetract_Auto)OTE(Retract_Auto);
				N: XIC(InExtend_Manual)OTE(Extend_Manual);
				N: XIC(InRetract_Manual)OTE(Retract_Manual);
				RC: "INPUT Fault";
				N: XIO(InEStop)OTE(Healthy);
				N: XIC(InSolenoidFault)OTE(SolenoidFault);
				N: XIC(InSolFault_RetractFB)OTE(SolFault_RetractFB);
				N: XIC(InSolFault_ExtendFB)OTE(SolFault_ExtendFB);
				N: XIC(InSolFault_GrippingFB)OTE(SolFault_GrippingFB);
				RC: "INPUT Configuration";
				N: XIC(InEnableExtendFeedback)OTE(EnableExtendFeedback);
				N: XIC(InEnableRetractFeedback)OTE(EnableRetractFeedback);
				N: XIC(InEnableGrippingFeedback)OTE(EnableGrippingFeedback);
				N: XIC(InRetractSafePosition)OTE(RetractSafePosition);
				N: XIC(InExtendSafePosition)OTE(ExtendSafePosition);
				N: XIC(InHold_Last_State)OTE(Hold_Last_State);
				RC: "System mode";
				N: XIC(SystemRunning)[XIC(Auto_Mode) OTE(AutoRun) ,XIC(Manual_Mode) OTE(ManualRun) ];
				RC: "Solenoid Logic";
				N: [XIC(Extend_Auto) XIO(Retract_Auto) XIC(AutoRun) ,XIC(Extend_Manual) XIO(Retract_Manual) XIC(ManualRun) ]XIC(Healthy)[OTL(ExtendLogic) ,OTU(RetractLogic) ];
				N: [XIC(Retract_Auto) XIO(Extend_Auto) XIC(AutoRun) ,XIC(Retract_Manual) XIO(Extend_Manual) XIC(ManualRun) ]XIC(Healthy)[OTL(RetractLogic) ,OTU(ExtendLogic) ];
				N: [XIO(Healthy) ,XIC(Sol_In_Fault) ,XIO(AutoRun) XIO(ManualRun) ]XIO(Hold_Last_State)[XIC(ExtendSafePosition) [OTL(ExtendLogic) ,OTU(RetractLogic) ] ,XIC(RetractSafePosition) [OTL(RetractLogic) ,OTU(ExtendLogic) ] ,XIO(ExtendSafePosition) XIO(RetractSafePosition) [OTU(ExtendLogic) ,OTU(RetractLogic) ] ];
				N: XIC(ExtendLogic)[XIO(EnableExtendFeedback) ,XIC(Sol_FeedbackExtend) XIC(EnableExtendFeedback) ]OTE(ExtendStatus);
				N: XIC(RetractLogic)[XIO(EnableRetractFeedback) ,XIC(Sol_FeedbackRetract) XIC(EnableRetractFeedback) ]OTE(RetractStatus);
				N: XIC(RetractLogic)XIC(Sol_FeedbackGripping)XIC(EnableGrippingFeedback)XIO(ExtendStatus)XIO(RetractStatus)OTE(GrippingStatus);
				RC: "Alarm Logic";
				N: XIO(ExtendStatus)XIO(GrippingStatus)XIO(RetractStatus)[XIC(Healthy) XIO(Hold_Last_State) ,XIC(Hold_Last_State) ]OTE(Aux_NoFeedback);
				RC: "TIMER";
				N: MOV(InFault_Time,Feedback_Timer.PRE);
				N: [XIC(ExtendLogic) XIO(ExtendStatus) XIC(EnableExtendFeedback) ,XIC(RetractLogic) XIO(RetractStatus) [XIO(GrippingStatus) ,XIO(EnableGrippingFeedback) ] XIC(EnableRetractFeedback) ,XIC(RetractLogic) XIC(Sol_FeedbackRetract) XIC(GrippingStatus) XIC(EnableGrippingFeedback) XIC(EnableRetractFeedback) ,XIC(Aux_NoFeedback) ]XIO(GeneralAlarmError)GRT(InFault_Time,0)TON(Feedback_Timer,?,?);
				RC: "Alarm Logic";
				N: XIC(Feedback_Timer.DN)[XIC(ExtendLogic) OTL(AlarmExtendFB_Error) ,XIC(RetractLogic) [XIO(RetractStatus) [XIO(GrippingStatus) ,XIO(EnableGrippingFeedback) ] XIC(EnableRetractFeedback) OTL(AlarmRetractFB_Error) ,XIC(Sol_FeedbackRetract) XIC(GrippingStatus) XIC(EnableGrippingFeedback) XIC(EnableRetractFeedback) OTL(AlarmGrippingFB_Error) ] ,XIC(Aux_NoFeedback) OTL(AlarmNoFB_Error) ];
				N: [XIC(AlarmExtendFB_Error) ,XIC(AlarmRetractFB_Error) ,XIC(AlarmNoFB_Error) ,XIC(AlarmGrippingFB_Error) ]OTE(GeneralAlarmError);
				N: [XIC(SolenoidFault) ,XIC(SolFault_RetractFB) XIC(EnableRetractFeedback) ,XIC(SolFault_ExtendFB) XIC(EnableExtendFeedback) ,XIC(SolFault_GrippingFB) XIC(EnableGrippingFeedback) ,XIC(GeneralAlarmError) ]OTE(Sol_In_Fault);
				RC: "Alarm Reset Logic";
				N: XIC(AlarmReset)[OTU(AlarmExtendFB_Error) ,OTU(AlarmRetractFB_Error) ,OTU(AlarmNoFB_Error) ,OTU(AlarmGrippingFB_Error) ];
				RC: "STATUS";
				N: MOV(0,SolStatus);
				N: XIO(Manual_Mode)XIO(Auto_Mode)XIC(Healthy)[XIC(RetractStatus) MOV(1,SolStatus) ,XIC(ExtendStatus) MOV(2,SolStatus) ,XIC(GrippingStatus) MOV(3,SolStatus) ,XIO(GrippingStatus) XIO(ExtendStatus) XIO(RetractStatus) MOV(4,SolStatus) ];
				N: XIC(Manual_Mode)XIC(Healthy)[XIC(RetractStatus) MOV(5,SolStatus) ,XIC(ExtendStatus) MOV(6,SolStatus) ,XIC(GrippingStatus) MOV(7,SolStatus) ,XIO(GrippingStatus) XIO(ExtendStatus) XIO(RetractStatus) MOV(8,SolStatus) ];
				N: XIC(Auto_Mode)XIC(Healthy)[XIC(RetractStatus) MOV(9,SolStatus) ,XIC(ExtendStatus) MOV(10,SolStatus) ,XIC(GrippingStatus) MOV(11,SolStatus) ,XIO(GrippingStatus) XIO(ExtendStatus) XIO(RetractStatus) MOV(12,SolStatus) ];
				N: XIO(Healthy)[XIC(RetractStatus) MOV(13,SolStatus) ,XIC(ExtendStatus) MOV(14,SolStatus) ,XIC(GrippingStatus) MOV(15,SolStatus) ,XIO(GrippingStatus) XIO(ExtendStatus) XIO(RetractStatus) MOV(16,SolStatus) ];
				N: XIC(AlarmExtendFB_Error)MOV(17,SolStatus);
				N: XIC(AlarmRetractFB_Error)MOV(18,SolStatus);
				N: XIC(AlarmGrippingFB_Error)MOV(19,SolStatus);
				N: XIC(AlarmNoFB_Error)MOV(20,SolStatus);
				N: XIC(SolFault_ExtendFB)XIC(EnableExtendFeedback)MOV(21,SolStatus);
				N: XIC(SolFault_RetractFB)XIC(EnableRetractFeedback)MOV(22,SolStatus);
				N: XIC(SolFault_GrippingFB)XIC(EnableGrippingFeedback)MOV(23,SolStatus);
				N: XIC(SolenoidFault)MOV(24,SolStatus);
				RC: "OUTPUT";
				N: XIC(ExtendLogic)OTE(OutExtend);
				N: XIC(RetractLogic)OTE(OutRetract);
				N: XIC(Sol_In_Fault)OTE(OutSol_In_Fault);
				N: MOV(SolStatus,OutSolStatus);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION FB_EXECUTE_R_STEPS_ACTIONS (Revision := "1.0",
	                                                          ExecutePrescan := No,
	                                                          ExecutePostscan := No,
	                                                          ExecuteEnableInFalse := No,
	                                                          CreatedDate := "2025-07-20T08:22:18.091Z",
	                                                          CreatedBy := "DESKTOP-DBPRR6T\admin",
	                                                          EditedDate := "2026-07-08T05:16:47.520Z",
	                                                          EditedBy := "DESKTOP-DBPRR6T\admin",
	                                                          SoftwareRevision := "v33.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			TOP_CTRL : BASE_CONTROL (Usage := InOut,
			                    Required := Yes,
			                    Visible := Yes);
			EXCUTE_TASK_STEPS : SECTION (Usage := InOut,
			                             Required := Yes,
			                             Visible := Yes);
			IN_SensorTrigger : BOOL (Usage := Input,
			                            RADIX := Decimal,
			                            Required := No,
			                            Visible := Yes,
			                            ExternalAccess := None,
			                            DefaultData := 0);
			IN_ExecuteSeqTrigger : BOOL (Usage := Input,
			                                RADIX := Decimal,
			                                Required := No,
			                                Visible := Yes,
			                                ExternalAccess := None,
			                                DefaultData := 0);
			IN_Condition_Ready : BOOL (Usage := Input,
			                              RADIX := Decimal,
			                              Required := No,
			                              Visible := Yes,
			                              ExternalAccess := None,
			                              DefaultData := 0);
			IN_Condition_Ready_Timeout : DINT (Usage := Input,
			                                      RADIX := Decimal,
			                                      Required := No,
			                                      Visible := Yes,
			                                      ExternalAccess := None,
			                                      DefaultData := 10000);
			IN_TaskSelected : BOOL (Usage := Input,
			                           RADIX := Decimal,
			                           Required := No,
			                           Visible := Yes,
			                           ExternalAccess := None,
			                           DefaultData := 0);
			IN_TaskSelected_Timeout : DINT (Usage := Input,
			                                   RADIX := Decimal,
			                                   Required := No,
			                                   Visible := Yes,
			                                   ExternalAccess := None,
			                                   DefaultData := 10000);
			IN_FB_CurreniTaskRobot : SINT (Usage := Input,
			                                  RADIX := Decimal,
			                                  Required := No,
			                                  Visible := Yes,
			                                  ExternalAccess := None,
			                                  DefaultData := 0);
			IN_FBCurrentTaskRobotTimeout : DINT (Usage := Input,
			                                        RADIX := Decimal,
			                                        Required := No,
			                                        Visible := Yes,
			                                        ExternalAccess := None,
			                                        DefaultData := 10000);
			IN_Task_Completed : BOOL (Usage := Input,
			                             RADIX := Decimal,
			                             Required := No,
			                             Visible := Yes,
			                             ExternalAccess := None,
			                             DefaultData := 0);
			IN_RobotExecutingTaskTimeout : DINT (Usage := Input,
			                                        RADIX := Decimal,
			                                        Required := No,
			                                        Visible := Yes,
			                                        ExternalAccess := None,
			                                        DefaultData := 55000000);
			IN_Robot_OK : BOOL (Usage := Input,
			                       RADIX := Decimal,
			                       Required := No,
			                       Visible := Yes,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			SP_CounterRetrySequence : INT (Usage := Input,
			                                   RADIX := Decimal,
			                                   Required := No,
			                                   Visible := Yes,
			                                   ExternalAccess := None,
			                                   DefaultData := 2);
		END_PARAMETERS

		LOCAL_TAGS
			Run_SYS : BOOL (RADIX := Decimal,
			                  ExternalAccess := None,
			                  DefaultData := 0);
			NextStep : BOOL (RADIX := Decimal,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			StepByStepEnable : BOOL (RADIX := Decimal,
			                           ExternalAccess := None,
			                           DefaultData := 0);
			Condition_ReadyTimer : TIMER (ExternalAccess := None,
			                               DefaultData := "[0,0,0]");
			TaskSelectedTimer : TIMER (ExternalAccess := None,
			                            DefaultData := "[0,0,0]");
			FBCurrentTaskRobotTimer : TIMER (ExternalAccess := None,
			                                  DefaultData := "[0,0,0]");
			RobotExecutingTaskTimer : TIMER (ExternalAccess := None,
			                                  DefaultData := "[0,0,0]");
			DelayUdateDataFromRobot : TIMER (ExternalAccess := None,
			                                  DefaultData := "[0,0,0]");
			CounterRetrySequence : INT (RADIX := Decimal,
			                               ExternalAccess := None,
			                               DefaultData := 0);
			ONS : BOOL (RADIX := Decimal,
			              ExternalAccess := None,
			              DefaultData := 0);
			Enable_Retry_Secuence_Alarm : BOOL (RADIX := Decimal,
			                                      ExternalAccess := None,
			                                      DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: XIC(TOP_CTRL.Automatic_Run)XIC(TOP_CTRL.Run)OTE(Run_SYS);
				RC: "STEP 0: System Stop";
				N: XIO(Run_SYS)MOV(0,EXCUTE_TASK_STEPS.STEPS_INT);
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,0)OTE(EXCUTE_TASK_STEPS.STEPS.0)XIC(EXCUTE_TASK_STEPS.ACTIONS.0)XIC(Run_SYS)XIO(TOP_CTRL.Paused)MOV(1,EXCUTE_TASK_STEPS.STEPS_INT);
				RC: "STEP 1: System Running";
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,1)OTE(EXCUTE_TASK_STEPS.STEPS.1)XIC(EXCUTE_TASK_STEPS.ACTIONS.1)[XIC(IN_SensorTrigger) ,XIC(IN_ExecuteSeqTrigger) ]EQU(IN_FB_CurreniTaskRobot,0)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]XIO(TOP_CTRL.Paused)MOV(2,EXCUTE_TASK_STEPS.STEPS_INT);
				RC: "STEP 2:Analiaise Condition";
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,2)OTE(EXCUTE_TASK_STEPS.STEPS.2)XIC(EXCUTE_TASK_STEPS.ACTIONS.2)[XIC(IN_Robot_OK) [XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ] XIO(TOP_CTRL.Paused) MOV(3,EXCUTE_TASK_STEPS.STEPS_INT) ,XIO(StepByStepEnable) XIO(TOP_CTRL.Paused) [MOV(IN_Condition_Ready_Timeout,Condition_ReadyTimer.PRE) TON(Condition_ReadyTimer,?,?) ,XIC(Condition_ReadyTimer.DN) MOV(8,EXCUTE_TASK_STEPS.STEPS_INT) OTL(TOP_CTRL.Fault[10].F.3) ] ];
				RC: "STEP 3:Selection Task";
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,3)OTE(EXCUTE_TASK_STEPS.STEPS.3)XIC(EXCUTE_TASK_STEPS.ACTIONS.3)[XIC(IN_TaskSelected) [XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ] XIO(TOP_CTRL.Paused) MOV(4,EXCUTE_TASK_STEPS.STEPS_INT) ,XIO(StepByStepEnable) XIC(Enable_Retry_Secuence_Alarm) XIO(TOP_CTRL.Paused) [MOV(IN_TaskSelected_Timeout,TaskSelectedTimer.PRE) TON(TaskSelectedTimer,?,?) ,XIC(TaskSelectedTimer.DN) MOV(8,EXCUTE_TASK_STEPS.STEPS_INT) OTL(TOP_CTRL.Fault[10].F.4) ] ];
				RC: "STEP 4:Send Task to Robot";
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,4)OTE(EXCUTE_TASK_STEPS.STEPS.4)XIC(EXCUTE_TASK_STEPS.ACTIONS.4)[XIC(IN_Condition_Ready) NEQ(IN_FB_CurreniTaskRobot,0) XIO(TOP_CTRL.Paused) MOV(5,EXCUTE_TASK_STEPS.STEPS_INT) ,XIO(StepByStepEnable) XIO(TOP_CTRL.Paused) [MOV(IN_FBCurrentTaskRobotTimeout,FBCurrentTaskRobotTimer.PRE) TON(FBCurrentTaskRobotTimer,?,?) ,XIC(FBCurrentTaskRobotTimer.DN) MOV(9,EXCUTE_TASK_STEPS.STEPS_INT) OTL(TOP_CTRL.Fault[10].F.5) ] ];
				RC: "STEP 5:Robot Executing Task";
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,5)OTE(EXCUTE_TASK_STEPS.STEPS.5)XIC(EXCUTE_TASK_STEPS.ACTIONS.5)[NEQ(IN_FB_CurreniTaskRobot,0) XIC(IN_Task_Completed) XIO(TOP_CTRL.Paused) MOV(6,EXCUTE_TASK_STEPS.STEPS_INT) ,XIO(StepByStepEnable) XIO(TOP_CTRL.Paused) [MOV(IN_RobotExecutingTaskTimeout,RobotExecutingTaskTimer.PRE) TON(RobotExecutingTaskTimer,?,?) ,XIC(RobotExecutingTaskTimer.DN) MOV(9,EXCUTE_TASK_STEPS.STEPS_INT) OTL(TOP_CTRL.Fault[10].F.6) ] ];
				RC: "STEP 6: Update data drom Robot";
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,6)OTE(EXCUTE_TASK_STEPS.STEPS.6)XIC(EXCUTE_TASK_STEPS.ACTIONS.6)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]XIO(TOP_CTRL.Paused)[XIC(DelayUdateDataFromRobot.DN) MOV(7,EXCUTE_TASK_STEPS.STEPS_INT) ,TON(DelayUdateDataFromRobot,?,?) ];
				RC: "STEP 7: Check if Robot is OK";
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,7)OTE(EXCUTE_TASK_STEPS.STEPS.7)XIC(EXCUTE_TASK_STEPS.ACTIONS.7)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]XIO(TOP_CTRL.Paused)[XIC(IN_Robot_OK) MOV(1,EXCUTE_TASK_STEPS.STEPS_INT) ,XIC(IN_Robot_OK) XIO(IN_Robot_OK) MOV(9,EXCUTE_TASK_STEPS.STEPS_INT) OTL(TOP_CTRL.Fault[10].F.7) ];
				RC: "STEP 8: Retry Secuence";
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,8)OTE(EXCUTE_TASK_STEPS.STEPS.8)XIC(EXCUTE_TASK_STEPS.ACTIONS.8)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]XIO(TOP_CTRL.Paused)[LEQ(CounterRetrySequence,SP_CounterRetrySequence) [MOV(2,EXCUTE_TASK_STEPS.STEPS_INT) ,ADD(CounterRetrySequence,1,CounterRetrySequence) ] ,XIC(Enable_Retry_Secuence_Alarm) GRT(CounterRetrySequence,SP_CounterRetrySequence) MOV(9,EXCUTE_TASK_STEPS.STEPS_INT) OTL(TOP_CTRL.Fault[10].F.2) ];
				RC: "STEP 9: Stop and in fault";
				N: EQU(EXCUTE_TASK_STEPS.STEPS_INT,9)OTE(EXCUTE_TASK_STEPS.STEPS.9)XIC(EXCUTE_TASK_STEPS.ACTIONS.9)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ][XIC(TOP_CTRL.Fault_Reset_Request) ONS(ONS) XIO(TOP_CTRL.Paused) MOV(1,EXCUTE_TASK_STEPS.STEPS_INT) ,OTL(TOP_CTRL.Fault[10].F.1) ];
				RC: "ACTIONS";
				N: MOV(EXCUTE_TASK_STEPS.STEPS,EXCUTE_TASK_STEPS.ACTIONS);
				RC: "Reset Alarm";
				N: XIC(TOP_CTRL.Fault_Reset_Request)[MOV(0,TOP_CTRL.Fault[10].F) ,GRT(CounterRetrySequence,SP_CounterRetrySequence) MOV(0,CounterRetrySequence) ];
				N: XIC(NextStep)OTU(NextStep);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION FB_FOOT_INGOTS_STEPS_ACTIONS (Revision := "1.0",
