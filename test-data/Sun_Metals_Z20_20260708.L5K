				N: XIC(Mapped.Point[9].Solenoid_On_Side_B)OTE(Raw_OutputArea[2].1);
				N: XIC(Mapped.Point[10].Solenoid_On_Side_A)OTE(Raw_OutputArea[2].2);
				N: XIC(Mapped.Point[10].Solenoid_On_Side_B)OTE(Raw_OutputArea[2].3);
