			SM_STRAP_8KG_MIDDLE_VARIABLE : DINT (Description := "Strapping Machine:$NMiddle Strap Position$Nfor 8kg Ingot Bundles",
			            RADIX := Decimal) := 260;
			SM_STRAP_CONTROL : DINT[1] (Description := "Strapping Machine:$NControl File",
