				N: XIC(Z20_PSM_A.TW[31].DN)NEQ(Z20_PSM_A.SP,0)ADD(Z20_PSM_A.SP,0,Alarm_Fault);
				N: XIC(Z20_PSM_A.TW[32].DN)NEQ(Z20_PSM_A.SP,0)ADD(Z20_PSM_A.SP,0,Alarm_Fault);
				N: [XIC(ON_A) ONS(GEN_BOOL[16]) ,XIC(ALARM_FAULT_RST) ]MOV(0,Alarm_Fault);
				N: XIC(Z20_RESET_A.TW[1].DN)NEQ(Z20_RESET_A.SP,0)ADD(Z20_RESET_A.SP,100,Alarm_Fault);
				N: XIC(Z20_RESET_A.TW[2].DN)NEQ(Z20_RESET_A.SP,0)ADD(Z20_RESET_A.SP,100,Alarm_Fault);
				N: XIC(Z20_RESET_A.TW[3].DN)NEQ(Z20_RESET_A.SP,0)ADD(Z20_RESET_A.SP,100,Alarm_Fault);
				N: XIC(Z20_RESET_A.TW[4].DN)NEQ(Z20_RESET_A.SP,0)ADD(Z20_RESET_A.SP,100,Alarm_Fault);
				N: XIC(Z20_RESET_A.TW[5].DN)NEQ(Z20_RESET_A.SP,0)ADD(Z20_RESET_A.SP,100,Alarm_Fault);
				N: XIC(Z20_RESET_A.TW[6].DN)NEQ(Z20_RESET_A.SP,0)ADD(Z20_RESET_A.SP,100,Alarm_Fault);
				N: EQU(Alarm_Fault,1)OTE(Fault_Head_Step_001);
				N: EQU(Alarm_Fault,2)OTE(Fault_Head_Step_002);
				N: EQU(Alarm_Fault,3)OTE(Fault_Head_Step_003);
