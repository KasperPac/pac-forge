	DATATYPE BASE (FamilyType := NoFamily)
		BASE_CONTROL CTRL;
		BASE_CONTROL HMI;
	END_DATATYPE

	DATATYPE BASE_CONTROL (FamilyType := NoFamily)
		SINT ZZZZZZZZZZBASE_CONTR0 (Hidden := 1);
		BIT Start_Request ZZZZZZZZZZBASE_CONTR0 : 0;
		BIT Stop_Request ZZZZZZZZZZBASE_CONTR0 : 1;
		BIT Robot_Enable ZZZZZZZZZZBASE_CONTR0 : 2;
		BIT Run ZZZZZZZZZZBASE_CONTR0 : 3;
		BIT Pause_Req ZZZZZZZZZZBASE_CONTR0 : 4;
		BIT Paused ZZZZZZZZZZBASE_CONTR0 : 5;
		BIT Yes ZZZZZZZZZZBASE_CONTR0 : 6;
		BIT No ZZZZZZZZZZBASE_CONTR0 : 7;
		SYSTEM_FAULT Fault[14];
		SINT ZZZZZZZZZZBASE_CONTR10 (Hidden := 1);
		BIT Fault_Exists ZZZZZZZZZZBASE_CONTR10 : 0;
		BIT Fault_Reset_Request ZZZZZZZZZZBASE_CONTR10 : 1;
		BIT Automatic_Request ZZZZZZZZZZBASE_CONTR10 : 2;
		BIT Maintenance_Request ZZZZZZZZZZBASE_CONTR10 : 3;
		INT Maintenance_State;
		SINT ZZZZZZZZZZBASE_CONTR16 (Hidden := 1);
		BIT Manual_Request ZZZZZZZZZZBASE_CONTR16 : 0;
		BIT Automatic_Run ZZZZZZZZZZBASE_CONTR16 : 1;
		BIT Manual_Run ZZZZZZZZZZBASE_CONTR16 : 2;
		SECTION STEPS;
		INT SYS_Status;
		TIMER SystemBootDelay;
	END_DATATYPE

