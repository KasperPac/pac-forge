			L_Actual_Position_OUT : INT[2] (Description := "Actual position Output --> words are switched, compared to input",
			                                RADIX := Decimal,
			                                ExternalAccess := None,
			                                DefaultData := "[0,0]");
			L_Actual_Position_High : DINT (Description := "Temporary Viariable for switching words in position variable",
			                                 RADIX := Decimal,
			                                 ExternalAccess := None,
			                                 DefaultData := 0);
			L_Actual_Position_Low : DINT (Description := "Temporary Viariable for switching words in position variable",
			                                RADIX := Decimal,
