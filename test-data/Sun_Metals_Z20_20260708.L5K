		ROUTINE A_PLC_COMMS 
				N: [COP(N20[0],Slab_1_M580:0:O.Data[0],20) ,COP(Slab_1_M580:0:I.Data[0],N20[20],20) ];
				N: XIO(T4_41.EN)XIO(T4_40.DN)TON(T4_40,?,?);
				N: XIO(T4_40.EN)XIO(T4_41.DN)TON(T4_41,?,?);
				RC: "Read";
				N: XIC(N20[20].0)OTE(B3[4].3);
				N: XIC(N20[20].1)OTE(R_B3[2].8);
				N: XIC(N20[20].2)OTE(R_B3[2].6);
				N: XIC(N20[20].3)OTE(R_B3[2].7);
				N: XIC(N20[20].4)[XIC(R_T4_48.DN) OTE(R_B3[3].1) ,TON(R_T4_48,?,?) ];
				N: XIC(N20[20].5)OTE(R_B3[3].12);
				N: XIC(N20[20].7)OTE(Four_Foot_Moulds);
				N: XIC(N20[20].8)OTE(Casting_Conv_Run);
				RC: "needed";
				N: XIC(N20[20].10)OTE(Turn_Over_Flipper);
				RC: "needed";
				N: XIC(N20[20].11)OTE(Slab1_ALARM);
				RC: "Write";
				N: XIC(T4_40.EN)OTE(N20[0].0);
				N: XIC(R_B3[5].0)OTE(N20[0].1);
				RC: "not needed";
				N: XIC(B3[2].2)OTE(N20[0].2);
				RC: "not needed";
				N: XIC(B3[1].2)OTE(N20[0].3);
				N: XIC(R_B3[4].0)OTE(N20[0].4);
				N: XIC(R_B3[2].0)OTE(N20[0].5);
				N: XIC(R_T4_52.TT)OTE(N20[0].6);
				N: XIC(Bundle_Status1[0].4)OTE(N20[0].7);
				N: XIC(Foot_Count_Reset)OTE(N20[0].8);
				N: MOV(N7[2],N20[1]);
		END_ROUTINE

		ROUTINE B_LASERAX 
				N: XIC(B3[61].0)XIC(B3[61].1)XIC(B3[61].2)XIC(B3[61].3)XIC(B3[61].4)XIC(B3[61].5)XIC(B3[61].6)XIC(B3[61].7)XIC(B3[61].8)XIC(B3[61].9)XIC(B3[61].10)XIC(B3[61].11)XIC(B3[61].12)XIC(B3[61].13)XIC(B3[61].14)XIC(B3[61].15)NOP();
				N: XIC(B3[62].0)XIC(B3[62].1)XIC(B3[62].2)XIC(B3[62].3)XIC(B3[62].4)XIC(B3[62].5)XIC(B3[62].6)XIC(B3[62].7)XIC(B3[62].8)XIC(B3[62].9)XIC(B3[62].10)XIC(B3[62].11)XIC(B3[62].12)XIC(B3[62].13)XIC(B3[62].14)XIC(B3[62].15)NOP();
				N: XIC(B3[63].0)XIC(B3[63].1)XIC(B3[63].2)XIC(B3[63].3)XIC(B3[63].4)XIC(B3[63].5)XIC(B3[63].6)XIC(B3[63].7)XIC(B3[63].8)XIC(B3[63].9)XIC(B3[63].10)XIC(B3[63].11)XIC(B3[63].12)XIC(B3[63].13)XIC(B3[63].14)XIC(B3[63].15)NOP();
				N: XIC(B3[61].0)TON(T4_7,?,?);
				N: XIO(B3[61].0)TON(T4_8,?,?);
				N: XIC(T4_1.EN)OTE(B3[64].0);
				N: XIO(T4_2.EN)XIO(T4_1.DN)TON(T4_1,?,?);
				N: XIO(T4_1.EN)XIO(T4_2.DN)TON(T4_2,?,?);
				N: XIC(Sunmetals_to_Signode.0)TON(T4_9,?,?);
				N: XIC(T4_9.DN)OTE(B3[64].1);
				N: XIC(T4_9.DN)TON(T4_10,?,?);
				N: XIC(T4_9.DN)XIO(T4_10.DN)OTE(B3[64].3);
				RC: "Package positioned";
				N: XIO(Sunmetals_to_Signode.0)[TON(T4_20,?,?) ,XIO(T4_20.DN) OTE(B3[64].5) ,OTE(B3[0].0) ];
				N: [XIC(B3[61].12) CTU(LSX_OK_CNT,?,?) ,XIC(B3[61].10) CTU(LSX_dn_CNT,?,?) ,XIC(B3[61].13) CTU(LSX_bad_CNT,?,?) ,EQU(Wall_Clock.Hour,6) ONS(ggg) [RES(LSX_OK_CNT) ,RES(LSX_dn_CNT) ,RES(LSX_bad_CNT) ] ];
				N: XIC(B3[0].10)OTE(B3[64].15);
				N: [ONS(FIRST) ,XIC(T4_39.TT) ,XIC(B9[0].12) ]TON(T4_39,?,?);
				N: XIC(T4_39.TT)[EQU(T4_39.ACC,3) OTE(B3[3].5) ,EQU(T4_39.ACC,4) OTE(B3[64].11) ];
				N: [XIC(B3[3].5) ,XIC(B3[3].4) ]OTE(B3[64].5);
				N: XIC(N20[20].0)OTE(B3[64].12);
				N: DIV(Laserax_DINT_Read,1000.0,F8[6]);
				RC: "Latch when Marking done has been recieved from the LaserAx";
				N: XIC(B3[61].10)OTL(B3[17].5);
				RC: "Catch status of incoming bundle.";
				N: XIC(B3[64].3)ONS(Hold_Last_ONS)XIC(N7[11].2)OTL(Last_Pos_Latch);
				RC: "Initialise Laser position status as SKIPPED MARKING status if not already Rejected on Laserax start pulse";
				N: XIC(Big_Kev)XIC(B3[64].3)XIO(N7[11].2)[COP(ST12[38],ST12[29],1) ,OTL(N7[11].2) ,CTU(lsx_CT1,?,?) ];
				RC: "If inspection result OK and last position was not a reject, restore to ALL PASSED";
				N: XIC(B3[61].12)XIC(N7[11].2)[XIO(Last_Pos_Latch) ,XIC(Reject_Integer_changeover) ][COP(ST12[30],ST12[29],1) ,OTU(N7[11].2) ,CTU(lsx_CT2,?,?) ];
				RC: "Reset last position reject latch on conveyor index";
				N: XIO(Sunmetals_to_Signode.0)OTU(Last_Pos_Latch);
				RC: "If the result from the marking inspection from the LaserAx is bad and the bundle is not already reject, reject block for mbard marking";
				N: [XIC(B3[61].13) XIO(B3[61].7) TON(LSX_BAD_TMR,?,?) ,XIC(LSX_BAD_TMR.DN) XIO(N7[11].2) ONS(B3[17].3) [COP(ST12[37],ST12[29],1) ,OTL(N7[11].2) ,CTU(BAD_COUNTS,?,?) ] ];
				RC: "If the marking from LaserAx was skipped and the bundle is not already rejected, reject for marking skipped";
				N: XIC(B3[62].0)XIO(N7[11].2)ONS(B3[17].4)[COP(ST12[38],ST12[29],1) ,OTL(N7[11].2) ];
				N: XIC(B3[61].13)XIC(B3[61].14)OTL(Inspect_latch);
				RC: "conveyor has indexed without a completion signal from the LaserAx$N"
				    " $N"
				    "reject bundle for MARKING SKIPPED if not already rejected";
				N: XIO(Sunmetals_to_Signode.0)ONS(B3[17].6)[XIO(B3[17].5) XIO(N7[11].2) [XIC(Big_Kev) COP(ST12[38],ST12[29],1) ,XIC(Big_Kev) OTL(N7[11].2) ] ,OTU(B3[17].5) ];
		END_ROUTINE

		ROUTINE C_A_WEIGHING 
				N: XIC(Sunmetals_to_Signode.0)XIC(S_I_7_1)XIO(S_I_7_0)XIC(S_I_7_2)ONS(B3[3].14)OTE(B3[0].12);
				N: [XIC(B3[0].12) ,XIC(B3[0].13) ]XIO(S_I_7_3)XIC(S_I_7_2)XIC(Bundle_Status_GT3_array[0].7)OTE(B3[0].13);
				N: XIC(B3[0].13)TON(T4_36,?,?);
				N: [XIC(T4_36.DN) XIO(S_I_7_3) XIO(B3[11].0) XIO(B3[11].1) ,XIC(B3[11].0) XIO(B3[11].1) ]OTE(S_O_6_9);
				N: XIC(S_I_7_2)XIC(S_I_7_3)TON(T4_37,?,?);
				N: [[XIC(T4_37.DN) ,XIC(S_O_6_10) ] XIO(S_I_7_4) XIO(B3[11].1) XIO(B3[11].0) ,XIC(B3[11].1) XIO(B3[11].0) ]OTE(S_O_6_10);
				N: XIC(Sunmetals_to_Signode.0)XIC(S_I_7_1)[XIC(S_I_7_2) ,]ONS(B3[3].13)CTU(C5_0,?,?);
		END_ROUTINE

		ROUTINE D_AGV 
				RC: "Communication Read Data from AGV (B3:71/0~B3:72/15)";
				N: XIC(Slab1_Request_To_Enter_PLC)XIC(Slab1_AGV_In_Zone_PLC)XIC(B3[71].3)XIC(B3[71].4)XIC(B3[71].5)XIC(B3[71].6)XIC(B3[71].7)XIC(B3[71].8)XIC(B3[71].9)XIC(B3[71].10)XIC(B3[71].11)XIC(B3[71].12)XIC(B3[71].13)XIC(B3[71].14)XIC(B3[71].15)XIC(B3[72].0)XIC(B3[72].1)XIC(B3[72].2)XIC(B3[72].3)XIC(B3[72].4)XIC(B3[72].5)XIC(B3[72].6)XIC(B3[72].7)XIC(B3[72].8)XIC(B3[72].9)XIC(B3[72].10)XIC(B3[72].11)XIC(B3[72].12)XIC(B3[72].13)XIC(B3[72].14)XIC(B3[72].15)NOP();
