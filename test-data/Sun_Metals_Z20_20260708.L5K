		ROUTINE R101_SYS_Process 
				RC: "SYS CONTROL";
				N: [XIC(TOP.CTRL.Run) XIC(TOP.CTRL.Automatic_Run) ,XIC(Simulation[20]) ]OTE(RunSYS);
				N: [XIC(TOP.HMI.Automatic_Request) ,XIC(KUKA_HMI.IN_CTRL_AUTO_MANUAL) ]ONS(ModeChng)OTL(AutoLatch);
				N: XIC(AutoLatch)XIO(AutoReq)[OTL(AutoReq) ,OTU(AutoLatch) ];
				N: XIC(AutoLatch)XIC(AutoReq)[OTU(AutoReq) ,OTU(AutoLatch) ];
				RC: "SYSTEM HMI CONTROL INPUT";
				N: XIC(AutoReq)[OTE(TOP.CTRL.Automatic_Request) ,OTE(KUKA_HMI.OUT_AUTO_STATUS) ];
				N: XIO(AutoReq)OTE(TOP.CTRL.Manual_Request);
				N: [[XIC(TOP.HMI.Start_Request) ,XIC(KUKA_HMI.IN_START) ] ,XIC(FB_DI_PushButtonData[2].OutPushButton_On) ]OTE(TOP.CTRL.Start_Request);
				N: [[XIC(TOP.HMI.Stop_Request) ,XIC(KUKA_HMI.IN_STOP) ] ,XIC(FB_DI_PushButtonData[3].OutPushButton_On) ,XIC(TOP.CTRL.Fault[0].F.10) ,XIC(TOP.CTRL.Fault[0].F.1) ,XIC(TOP.CTRL.Fault[0].F.3) ,XIC(TOP.CTRL.Fault[0].F.4) ,XIC(TOP.CTRL.Fault[0].F.5) XIC(Always_Off) ,XIO(K_RIO1.PORT_1.IO_Link_Device_Connected) ,XIO(K_RIO1.PORT_2.IO_Link_Device_Connected) ,XIO(K_RIO1.PORT_3.IO_Link_Device_Connected) ,XIO(K_RIO1.PORT_4.IO_Link_Device_Connected) ,XIC(KUKA_ROBOT.In.WAFER_DETECTED) XIC(Always_Off) ]OTE(TOP.CTRL.Stop_Request);
				N: [XIC(TOP.HMI.Pause_Req) ,XIC(FB_DI_PushButtonData[4].OutPushButton_On) ]OTE(TOP.CTRL.Pause_Req);
				N: XIC(TOP.HMI.Maintenance_Request)ONS(Maintenance_ONS)OTL(Maintenance_Latch);
				N: XIC(Maintenance_Latch)XIC(TOP.CTRL.Robot_Enable)XIC(TOP.CTRL.Automatic_Run)XIO(Maintenance_Request)ONS(Maintenance_Request_ONS)OTL(Maintenance_Request);
				N: XIC(Maintenance_Latch)XIC(Maintenance_Request)ONS(Maintenance_Request_OFF_ONS)OTU(Maintenance_Request);
				N: XIO(TOP.HMI.Maintenance_Request)XIO(Maintenance_Latch)MOV(0,TOP.CTRL.Maintenance_State);
				N: XIO(TOP.CTRL.Maintenance_Request)XIC(Maintenance_Latch)MOV(1,TOP.CTRL.Maintenance_State);
				N: XIC(TOP.CTRL.Maintenance_Request)EQU(Last_Run_Task,0)MOV(2,TOP.CTRL.Maintenance_State);
				N: XIC(TOP.HMI.Robot_Enable)ONS(RobotEnableONS)OTL(RobotEnable_Toggle);
				N: XIC(RobotEnable_Toggle)XIO(TOP.CTRL.Robot_Enable)[OTL(TOP.CTRL.Robot_Enable) ,OTU(RobotEnable_Toggle) ];
				N: XIC(RobotEnable_Toggle)XIC(TOP.CTRL.Robot_Enable)[OTU(TOP.CTRL.Robot_Enable) ,OTU(RobotEnable_Toggle) ];
				N: [XIC(TOP.HMI.Fault_Reset_Request) ,XIC(KUKA_HMI.IN_RESET) ]OTE(TOP.CTRL.Fault_Reset_Request);
				RC: "SYSTEM CONTROL IN AUTOMATIC";
				N: [XIC(TOP.CTRL.Start_Request) ,XIC(TOP.CTRL.Automatic_Run) ]XIO(TOP.CTRL.Stop_Request)XIC(TOP.CTRL.Automatic_Request)XIO(TOP.CTRL.Fault[0].MajorFault)OTE(TOP.CTRL.Automatic_Run);
				RC: "SYSTEM CONTROL IN MANUAL";
				N: [XIC(TOP.CTRL.Start_Request) ,XIC(TOP.CTRL.Manual_Run) ]XIO(TOP.CTRL.Stop_Request)XIC(TOP.CTRL.Manual_Request)XIO(TOP.CTRL.Fault[0].MajorFault)OTE(TOP.CTRL.Manual_Run);
				RC: "SYSTEM RUNNING";
				N: [XIC(TOP.CTRL.Automatic_Run) ,XIC(TOP.CTRL.Manual_Run) ]TON(TOP.CTRL.SystemBootDelay,?,?);
				N: XIC(TOP.CTRL.SystemBootDelay.DN)[OTE(TOP.CTRL.Run) ,OTE(KUKA_HMI.OUT_STARTED) ];
				RC: "SYSTEM PAUSED";
				N: XIC(TOP.CTRL.Pause_Req)XIC(TOP.CTRL.Automatic_Run)XIC(TOP.CTRL.Run)OTE(TOP.CTRL.Paused);
				N: [XIO(TOP.CTRL.Automatic_Run) ,XIO(TOP.CTRL.Run) ]OTU(TOP.HMI.Pause_Req);
				RC: "SYSTEM STATUS $N"
				    "0=No Status, 1=Stop-NoMode, 2=Stop-AutoMode, 3=Starting-AutoMode, 4=Running-AutoMode, 5=Paused-AutoMode, 6=Stop-ManualMode, 7=Starting-ManualMode, 8=Running-ManualMode, 9=Major Fault$N"
				    "11=Stop-NoMode-MinorFault, 12=Stop-AutoMode-MinorFault, 13=Starting-AutoMode-MinorFault, 14=Running-AutoMode-MinorFault, 15=Paused-AutoMode-MinorFault, 16=Stop-ManualMode-MinorFault, 17=Starting-ManualMode-MinorFault, 18=Running-ManualMode-MinorFault";
				N: MOV(0,TOP.CTRL.SYS_Status);
				N: XIO(TOP.CTRL.Automatic_Request)XIO(TOP.CTRL.Manual_Request)XIO(TOP.CTRL.Fault[0].MajorFault)[XIO(TOP.CTRL.Fault[0].MinorFault) MOV(1,TOP.CTRL.SYS_Status) ,XIC(TOP.CTRL.Fault[0].MinorFault) MOV(11,TOP.CTRL.SYS_Status) ];
				N: XIC(TOP.CTRL.Automatic_Request)XIO(TOP.CTRL.Automatic_Run)XIO(TOP.CTRL.Run)XIO(TOP.CTRL.Paused)XIO(TOP.CTRL.Fault[0].MajorFault)[XIO(TOP.CTRL.Fault[0].MinorFault) MOV(2,TOP.CTRL.SYS_Status) ,XIC(TOP.CTRL.Fault[0].MinorFault) MOV(12,TOP.CTRL.SYS_Status) ];
				N: XIC(TOP.CTRL.Automatic_Request)XIC(TOP.CTRL.Automatic_Run)XIO(TOP.CTRL.Run)XIO(TOP.CTRL.Paused)XIO(TOP.CTRL.Fault[0].MajorFault)[XIO(TOP.CTRL.Fault[0].MinorFault) MOV(3,TOP.CTRL.SYS_Status) ,XIC(TOP.CTRL.Fault[0].MinorFault) MOV(13,TOP.CTRL.SYS_Status) ];
				N: XIC(TOP.CTRL.Automatic_Request)XIC(TOP.CTRL.Automatic_Run)XIC(TOP.CTRL.Run)XIO(TOP.CTRL.Paused)XIO(TOP.CTRL.Fault[0].MajorFault)[XIO(TOP.CTRL.Fault[0].MinorFault) MOV(4,TOP.CTRL.SYS_Status) ,XIC(TOP.CTRL.Fault[0].MinorFault) MOV(14,TOP.CTRL.SYS_Status) ];
				N: XIC(TOP.CTRL.Automatic_Request)XIC(TOP.CTRL.Automatic_Run)XIC(TOP.CTRL.Run)XIC(TOP.CTRL.Paused)XIO(TOP.CTRL.Fault[0].MajorFault)[XIO(TOP.CTRL.Fault[0].MinorFault) MOV(5,TOP.CTRL.SYS_Status) ,XIC(TOP.CTRL.Fault[0].MinorFault) MOV(15,TOP.CTRL.SYS_Status) ];
				N: XIC(TOP.CTRL.Manual_Request)XIO(TOP.CTRL.Manual_Run)XIO(TOP.CTRL.Run)XIO(TOP.CTRL.Fault[0].MajorFault)[XIO(TOP.CTRL.Fault[0].MinorFault) MOV(6,TOP.CTRL.SYS_Status) ,XIC(TOP.CTRL.Fault[0].MinorFault) MOV(16,TOP.CTRL.SYS_Status) ];
				N: XIC(TOP.CTRL.Manual_Request)XIC(TOP.CTRL.Manual_Run)XIO(TOP.CTRL.Run)XIO(TOP.CTRL.Fault[0].MajorFault)[XIO(TOP.CTRL.Fault[0].MinorFault) MOV(7,TOP.CTRL.SYS_Status) ,XIC(TOP.CTRL.Fault[0].MinorFault) MOV(17,TOP.CTRL.SYS_Status) ];
				N: XIC(TOP.CTRL.Manual_Request)XIC(TOP.CTRL.Manual_Run)XIC(TOP.CTRL.Run)XIO(TOP.CTRL.Fault[0].MajorFault)[XIO(TOP.CTRL.Fault[0].MinorFault) MOV(8,TOP.CTRL.SYS_Status) ,XIC(TOP.CTRL.Fault[0].MinorFault) MOV(18,TOP.CTRL.SYS_Status) ];
				N: XIC(TOP.CTRL.Fault[0].MajorFault)MOV(9,TOP.CTRL.SYS_Status);
				RC: "SYSTEM HMI CONTROL OUTPUT$N"
				    "";
				N: XIC(TOP.CTRL.Run)OTE(TOP.HMI.Run);
				N: XIC(TOP.CTRL.Paused)OTE(TOP.HMI.Paused);
				N: XIC(TOP.CTRL.Fault_Exists)OTE(TOP.HMI.Fault_Exists);
				N: XIC(TOP.CTRL.Automatic_Run)OTE(TOP.HMI.Automatic_Run);
				N: XIC(TOP.CTRL.Manual_Run)OTE(TOP.CTRL.Manual_Run);
				N: COP(TOP.CTRL.STEPS,TOP.HMI.STEPS,1);
				N: COP(TOP.CTRL.Fault[0],TOP.HMI.Fault[0],1)COP(TOP.CTRL.Fault[1],TOP.HMI.Fault[1],1)COP(TOP.CTRL.Fault[2],TOP.HMI.Fault[2],1)COP(TOP.CTRL.Fault[3],TOP.HMI.Fault[3],1)COP(TOP.CTRL.Fault[4],TOP.HMI.Fault[4],1)COP(TOP.CTRL.Fault[5],TOP.HMI.Fault[5],1)COP(TOP.CTRL.Fault[6],TOP.HMI.Fault[6],1);
				N: COP(TOP.CTRL.Fault[7],TOP.HMI.Fault[7],1)COP(TOP.CTRL.Fault[8],TOP.HMI.Fault[8],1)COP(TOP.CTRL.Fault[9],TOP.HMI.Fault[9],1)COP(TOP.CTRL.Fault[10],TOP.HMI.Fault[10],1)COP(TOP.CTRL.Fault[11],TOP.HMI.Fault[11],1)COP(TOP.CTRL.Fault[12],TOP.HMI.Fault[12],1)COP(TOP.CTRL.Fault[13],TOP.HMI.Fault[13],1);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_TOP_CUR_QTY,KUKA_HMI.OUT_MAKEUP_TOP_QTY);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_MID_CUR_QTY,KUKA_HMI.OUT_MAKEUP_MID_QTY);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_BTM_CUR_QTY,KUKA_HMI.OUT_MAKEUP_BTM_QTY);
				N: MOV(KUKA_ROBOT.In.CHAIN_HEIGHT,KUKA_HMI.CHAIN_HEIGHT);
		END_ROUTINE

		ROUTINE R102_SYS_Fault 
				N: [XIC(TOP.CTRL.Fault[0].F.30) ,XIC(TOP.CTRL.Fault[0].F.31) ]OTE(TOP.CTRL.Fault[0].MajorFault);
				N: [XIC(TOP.CTRL.Fault[6].MinorFault) ,XIC(TOP.CTRL.Fault[7].MinorFault) ,XIC(TOP.CTRL.Fault[8].MinorFault) ]OTE(TOP.CTRL.Fault[0].MinorFault);
				RC: "EIP K_RIO1 Fault";
				N: [XIC(K_RIO1.BNI006A_ConnectionFaulted) ,XIC(TOP.CTRL.Fault[0].F.1) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.1);
				RC: "EIP K_RIO2 Fault";
				N: [XIC(K_RIO2.BNI006A_ConnectionFaulted) ,XIC(TOP.CTRL.Fault[0].F.2) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.2);
				RC: "EIP KUKA_ROBOT Fault";
				N: XIC(KUKA_ROBOT.ConnectionFaulted)OTE(TOP.CTRL.Fault[0].F.3);
				RC: "EIP VALVE MANIFOLD Fault";
				N: [XIC(K_VALVE_MANIFOLD.SOLV_Status) ,XIC(TOP.CTRL.Fault[0].F.4) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.4);
				RC: "EIP Encoder Fault";
				N: [XIC(SickAFX_Enc1_xyz:I1.ConnectionFaulted) ,XIC(TOP.CTRL.Fault[0].F.5) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.5);
				RC: " K_RIO1 Fault";
				N: [[XIC(K_RIO1.BNI006A_UA_Fault) ,XIC(K_RIO1.BNI006A_US_Fault) ] ,XIC(TOP.CTRL.Fault[0].F.6) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.6);
				RC: " K_RIO2 Fault";
				N: [[XIC(K_RIO2.BNI006A_UA_Fault) ,XIC(K_RIO2.BNI006A_US_Fault) ] ,XIC(TOP.CTRL.Fault[0].F.7) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.7);
				RC: "KUKA_ROBOT Fault";
				N: [XIO(KUKA_ROBOT.In.ALARM_STOP) ,XIC(TOP.CTRL.Fault[0].F.8) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.8);
				RC: "VALVE MANIFOLD Fault";
				N: [XIC(K_VALVE_MANIFOLD.SOLV_Undervoltage_Error) ,XIC(TOP.CTRL.Fault[0].F.9) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.9);
				N: [XIC(FB_DI_SensorData[23].OutSignal) ,XIC(TOP.CTRL.Fault[0].F.10) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.10);
				RC: "EStop 1 Fault";
				N: [XIC(FB_DI_PushButtonData[1].OutPushButton_On) ,XIC(TOP.CTRL.Fault[0].F.30) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.30);
				RC: "EStop 1 Fault";
				N: [XIC(FB_DI_SensorData[23].OutSignal) ,XIC(TOP.CTRL.Fault[0].F.31) XIO(TOP.CTRL.Fault_Reset_Request) ]OTE(TOP.CTRL.Fault[0].F.31);
		END_ROUTINE

		ROUTINE R200_SEQUENCES_LOGIC 
				N: OTE(NoOp);
		END_ROUTINE

		ROUTINE R201_INFEED_QUEUE 
				RC: "Turn Over Control";
				N: [XIC(Turn_Over_Flipper) XIC(INFEED_KUKA_TurnOverControl_Off) ,[XIC(INFEED_KUKA_Turn_Over_Flipper) ,XIC(Simulation[4]) ] XIO(INFEED_KUKA_TurnOverControl_Off) ]OTL(INFEED_FlipControl_Active);
				RC: "SENSOR INPUT";
				N: [XIC(FB_DI_SensorData[21].OutSignal) ,XIC(Simulation[2]) ,XIC(Simulation[3]) ]OTE(INFEED_TopSensor);
				N: [XIC(FB_DI_SensorData[22].OutSignal) ,XIC(Simulation[2]) ]OTE(INFEED_LowerSensor);
				N: XIC(INFEED_FlipControl_Active)XIC(INFEED_TopSensor)OTE(INFEED_Flip_Ingot);
				RC: "Insert trigger";
				N: XIC(INFEED_TopSensor)ONS(INFEED_ONS[0])XIC(RunSYS)OTL(INFEED_TopSensor_Active);
				N: XIC(INFEED_LowerSensor)ONS(INFEED_ONS[1])XIC(RunSYS)OTL(INFEED_LowerSensor_Active);
				N: XIC(INFEED_TopSensor)ONS(INFEED_ONS[2])XIC(RunSYS)XIC(INFEED_FlipControl_Active)OTL(INFEED_Flip_Ingot_Active);
				N: [XIC(INFEED_TopSensor_Active) ,XIC(INFEED_LowerSensor_Active) ]TON(INFEED_Detection_delay,?,?);
				N: XIC(INFEED_Detection_delay.DN)ONS(INFEED_ONS[3])XIC(RunSYS)OTE(INFEED_Insert_InfeedQueue);
				RC: "Insert Infeed Logic JMP (INFEED_Insert_InFeedQueue_JMP)";
				N: XIO(INFEED_Insert_InfeedQueue)JMP(INFEED_Insert_InFeedQueue_JMP);
				N: ADD(INFEED_Insert_Index,1,INFEED_Insert_Index)XIC(INFEED_TopSensor_Active)[XIO(INFEED_LowerSensor_Active) XIO(INFEED_Flip_Ingot_Active) MOV(2,INFEED_Queue[INFEED_Insert_Index]) MOV(1,INFEED_Queue[0]) ,XIC(INFEED_LowerSensor_Active) MOV(1,INFEED_Queue[INFEED_Insert_Index]) MOV(2,INFEED_Queue[0]) ,XIO(INFEED_LowerSensor_Active) XIO(INFEED_LowerSensor_Active) XIC(INFEED_Flip_Ingot_Active) MOV(3,INFEED_Queue[INFEED_Insert_Index]) MOV(3,INFEED_Queue[0]) ];
				N: [OTU(INFEED_TopSensor_Active) ,OTU(INFEED_LowerSensor_Active) ,OTU(INFEED_Flip_Ingot_Active) ,OTU(INFEED_FlipControl_Active) ];
				N: [GEQ(INFEED_Traking_Index,4) EQU(INFEED_Queue[0],2) ,GRT(INFEED_Traking_Index,41) ]MOV(0,INFEED_Traking_Index)COP(INFEED_INGOT_TRAKING_CLEAR[0],INFEED_INGOT_TRAKING[0],42)OTU(INFEED_Alarm_Ingot_unexpected);
				N: ADD(INFEED_Traking_Index,1,INFEED_Traking_Index)MOV(INFEED_Queue[0],INFEED_INGOT_TRAKING[INFEED_Traking_Index])NEQ(INFEED_Queue[0],INFEED_INGOT_TRAKING_EXPECTED[INFEED_Traking_Index])MOV(INFEED_Traking_Index,INFEED_Alarm_Ingot_unexpected_Index)OTL(INFEED_Alarm_Ingot_unexpected);
				N: GEQ(INFEED_Traking_Index,36)OTL(INFEED_KUKA_Turn_Over_Flipper);
				N: EQU(INFEED_Queue[0],3)ADD(INFEED_Traking_Top,1,INFEED_Traking_Top);
				N: GEQ(INFEED_Traking_Top,4)[OTU(INFEED_KUKA_Turn_Over_Flipper) ,MOV(0,INFEED_Traking_Top) ];
				RC: "End JMP (INFEED_Insert_InFeedQueue_JMP)";
				N: LBL(INFEED_Insert_InFeedQueue_JMP)XIO(RunSYS)[OTU(INFEED_TopSensor_Active) ,OTU(INFEED_LowerSensor_Active) ,OTU(INFEED_Flip_Ingot_Active) ,OTU(INFEED_FlipControl_Active) ,MOV(0,INFEED_Traking_Index) COP(INFEED_INGOT_TRAKING_CLEAR[0],INFEED_INGOT_TRAKING[0],42) ];
				RC: "INPUT Delete data from Queue";
				N: [XIO(LOGIC_TEMP[1]) ,XIC(LOGIC_TEMP[1]) ]MOV(INFEED_IngotsTakenFromTheConveyor,INFEED_Nu_Ingot_Deleted_Queue);
				RC: "Input (1=Taken)";
				N: XIO(Always_Off)[[XIC(FOOT_SAS.LOC1_PICK) ,XIC(REGULAR_SAS.LOC1_PICK) ,XIC(TOP_SAS.LOC1_PICK) ] OTE(INFEED_PosicionIngotsTakenFromTheConveyo[1]) ,[XIC(FOOT_SAS.LOC2_PICK) ,XIC(REGULAR_SAS.LOC2_PICK) ,XIC(TOP_SAS.LOC2_PICK) ] OTE(INFEED_PosicionIngotsTakenFromTheConveyo[2]) ,[XIC(FOOT_SAS.LOC3_PICK) ,XIC(REGULAR_SAS.LOC3_PICK) ,XIC(TOP_SAS.LOC3_PICK) ] OTE(INFEED_PosicionIngotsTakenFromTheConveyo[3]) ,[XIC(FOOT_SAS.LOC4_PICK) ,XIC(REGULAR_SAS.LOC4_PICK) ,XIC(TOP_SAS.LOC4_PICK) ] OTE(INFEED_PosicionIngotsTakenFromTheConveyo[4]) ];
				N: [XIC(FOOT_SECTION.ACTIONS.7) ,XIC(REGULAR_SECTION.ACTIONS.7) ,XIC(TOP_SECTION.ACTIONS.7) ]OTE(INFEED_ExecuteDelete_InfeedQueue);
				N: [XIC(INFEED_ExecuteDelete_InfeedQueue) ,XIC(LOGIC_TEMP[1]) ]ONS(INFEED_ONS[4])XIC(RunSYS)GRT(INFEED_Nu_Ingot_Deleted_Queue,0)OTE(INFEED_Delete_InfeedQueue);
				RC: "Delete data from Queue";
				N: XIO(INFEED_Delete_InfeedQueue)JMP(INFEED_Delete_InFeedQueue_JMP);
				N: CPT(INFEED_FoorL_TerminalValue,100-INFEED_Nu_Ingot_Deleted_Queue)CPT(INFEED_FoorL_TOTAL,100-INFEED_Nu_Ingot_Deleted_Queue+1);
				N: XIC(INFEED_Delete_InfeedQueue)FOR(R202_FOR_LOOP_DELETE_INFEED_QUEUE,INFEED_Delete_Forloop_Index,1,INFEED_FoorL_TerminalValue,1);
				N: LBL(INFEED_Delete_InFeedQueue_JMP)XIC(CESAR[1])[COP(INFEED_INGOT_TRAKING_CLEAR[0],INFEED_Queue[0],43) ,MOV(0,INFEED_Insert_Index) ];
		END_ROUTINE

		ROUTINE R202_FOR_LOOP_DELETE_INFEED_QUEUE 
				N: SUB(INFEED_FoorL_TOTAL,INFEED_Delete_Forloop_Index,INFEED_Delete_Index);
				N: EQU(INFEED_QueueHistory[INFEED_Delete_Index],0)JMP(DeleteLoopJMP_1);
				N: ADD(INFEED_Delete_Index,INFEED_Nu_Ingot_Deleted_Queue,INFEED_Delete_Index_Move)MOV(INFEED_QueueHistory[INFEED_Delete_Index],INFEED_QueueHistory[INFEED_Delete_Index_Move]);
				N: LBL(DeleteLoopJMP_1)EQU(INFEED_Delete_Index,1)SUB(INFEED_Insert_Index,INFEED_Nu_Ingot_Deleted_Queue,INFEED_Insert_Index)[GEQ(INFEED_Nu_Ingot_Deleted_Queue,1) MOV(INFEED_Queue_Aux[1],INFEED_QueueHistory[1]) ,GEQ(INFEED_Nu_Ingot_Deleted_Queue,2) MOV(INFEED_Queue_Aux[2],INFEED_QueueHistory[2]) ,GEQ(INFEED_Nu_Ingot_Deleted_Queue,3) MOV(INFEED_Queue_Aux[3],INFEED_QueueHistory[3]) ,GEQ(INFEED_Nu_Ingot_Deleted_Queue,4) MOV(INFEED_Queue_Aux[4],INFEED_QueueHistory[4]) ];
				N: EQU(INFEED_Delete_Forloop_Index,1)MOV(1,INFEED_Aux_Index)MOV(1,INFEED_Aux_QueueIndex);
				N: GRT(INFEED_Delete_Forloop_Index,44)JMP(DeleteLoopJMP_2);
				N: LEQ(INFEED_Delete_Forloop_Index,4)[XIC(INFEED_PosicionIngotsTakenFromTheConveyo[INFEED_Delete_Forloop_Index]) MOV(INFEED_Queue[INFEED_Delete_Forloop_Index],INFEED_Queue_Aux[INFEED_Aux_Index]) MOV(0,INFEED_Queue[INFEED_Delete_Forloop_Index]) ADD(INFEED_Aux_Index,1,INFEED_Aux_Index) ,XIO(INFEED_PosicionIngotsTakenFromTheConveyo[INFEED_Delete_Forloop_Index]) MOV(INFEED_Queue[INFEED_Delete_Forloop_Index],INFEED_Queue[INFEED_Aux_QueueIndex]) ADD(INFEED_Aux_QueueIndex,1,INFEED_Aux_QueueIndex) ];
				N: GRT(INFEED_Delete_Forloop_Index,4)SUB(INFEED_Delete_Forloop_Index,INFEED_Nu_Ingot_Deleted_Queue,INFEED_Delete_Index_Move1)MOV(INFEED_Queue[INFEED_Delete_Forloop_Index],INFEED_Queue[INFEED_Delete_Index_Move1])MOV(0,INFEED_Queue[INFEED_Delete_Forloop_Index]);
				N: LBL(DeleteLoopJMP_2)OTE(INFEED_Delete_Forloop_End);
		END_ROUTINE

		ROUTINE R203_INGOT_CONVEYOR_DETEC 
				N: [GRT(Task_Request,1) ,XIC(CONVEYOR_D_IngotLogicDetection[1].IN_RobotInPositionHoldType) XIO(FOOT_SECTION.ACTIONS.7) XIO(REGULAR_SECTION.ACTIONS.7) XIO(TOP_SECTION.ACTIONS.7) ][OTE(CONVEYOR_D_IngotLogicDetection[1].IN_RobotInPositionHoldType) ,OTE(CONVEYOR_D_IngotLogicDetection[2].IN_RobotInPositionHoldType) ,OTE(CONVEYOR_D_IngotLogicDetection[3].IN_RobotInPositionHoldType) ,OTE(CONVEYOR_D_IngotLogicDetection[4].IN_RobotInPositionHoldType) ,OTU(Simulation[6]) ,OTU(Simulation[8]) ,OTU(Simulation[10]) ,OTU(Simulation[12]) ,OTU(Simulation[5]) ,OTU(Simulation[7]) ,OTU(Simulation[9]) ,OTU(Simulation[11]) ];
				N: [XIC(Simulation[5]) ,XIC(Simulation[6]) ,XIC(FB_DI_SensorData[13].OutSignal) XIC(EnableDetectionSensors) ]OTE(CONVEYOR_D_IngotLogicDetection[1].IN_TopSensor);
				N: [XIC(Simulation[6]) ,XIC(FB_DI_SensorData[17].OutSignal) XIC(EnableDetectionSensors) ]OTE(CONVEYOR_D_IngotLogicDetection[1].IN_FootSensor);
				RC: "CONVEYOR SENSOR INGOT DETECTION POSITION 1";
				N: FB_INGOT_DETECTION(CONVEYOR_D_IngotLogicDetection[1],RunSYS,CONVEYOR_D_IngotLogicDetection[1].IN_TopSensor,CONVEYOR_D_IngotLogicDetection[1].IN_FootSensor,INFEED_Queue[1]);
				N: [XIC(Simulation[7]) ,XIC(Simulation[8]) ,XIC(FB_DI_SensorData[14].OutSignal) XIC(EnableDetectionSensors) ]OTE(CONVEYOR_D_IngotLogicDetection[2].IN_TopSensor);
