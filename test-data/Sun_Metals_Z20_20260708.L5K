				N: XIC(Z20_PSM_A.TW[19].DN)NEQ(Z20_PSM_A.SP,0)ADD(Z20_PSM_A.SP,0,Alarm_Fault);
				N: XIC(Z20_PSM_A.TW[20].DN)NEQ(Z20_PSM_A.SP,0)ADD(Z20_PSM_A.SP,0,Alarm_Fault);
