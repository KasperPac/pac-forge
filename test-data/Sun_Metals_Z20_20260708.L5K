				N: [XIC(STACKS.STACK[1].Active) EQU(STACKS.STACK[1].CurrentLayer,9) ,XIC(STACKS.STACK[2].Active) EQU(STACKS.STACK[2].CurrentLayer,9) ,XIC(STACKS.STACK[3].Active) EQU(STACKS.STACK[3].CurrentLayer,9) ,XIC(MAKEUP_TABLE.Active) ][XIO(CONVEYOR_D_IngotLogicDetection[1].OUT_FootDetected) FB_IngotDetect_Scan(IngotLaserScan_1,KUKA_ROBOT.Out.LASER_A_VAL,IngotType_Slot1,KUKA_ROBOT.Out.IngutTypeDefined,KUKA_ROBOT.In.RobotStartedScan,KUKA_ROBOT.In.RobotEndedScan) ,XIO(CONVEYOR_D_IngotLogicDetection[2].OUT_FootDetected) FB_IngotDetect_Scan(IngotLaserScan_2,KUKA_ROBOT.Out.LASER_B_VAL,IngotType_Slot2,KUKA_ROBOT.Out.IngutTypeDefined,KUKA_ROBOT.In.RobotStartedScan,KUKA_ROBOT.In.RobotEndedScan) ,XIO(CONVEYOR_D_IngotLogicDetection[3].OUT_FootDetected) FB_IngotDetect_Scan(IngotLaserScan_3,KUKA_ROBOT.Out.LASER_C_VAL,IngotType_Slot3,KUKA_ROBOT.Out.IngutTypeDefined,KUKA_ROBOT.In.RobotStartedScan,KUKA_ROBOT.In.RobotEndedScan) ,XIO(CONVEYOR_D_IngotLogicDetection[4].OUT_FootDetected) FB_IngotDetect_Scan(IngotLaserScan_4,KUKA_ROBOT.Out.LASER_D_VAL,IngotType_Slot4,KUKA_ROBOT.Out.IngutTypeDefined,KUKA_ROBOT.In.RobotStartedScan,KUKA_ROBOT.In.RobotEndedScan) ,XIO(CONVEYOR_D_IngotLogicDetection[1].OUT_FootDetected) OTE(KUKA_ROBOT.Out.IngotScanEnable) ];
