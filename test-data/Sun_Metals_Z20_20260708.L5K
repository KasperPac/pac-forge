				N: MOV(KUKA_ROBOT.In.R_BKUPSTCK1_STACK_HEIGHT,KUKA_ROBOT.Out.BKUPSTCK1_STACK_HEIGHT);
				N: MOV(KUKA_ROBOT.In.R_BKUPSTCK2_CUR_LAYERS,KUKA_ROBOT.Out.BKUPSTCK2_CUR_LAYERS);
				N: MOV(KUKA_ROBOT.In.R_BKUPSTCK2_STACK_HEIGHT,KUKA_ROBOT.Out.BKUPSTCK2_STACK_HEIGHT);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_TOP_CUR_QTY,KUKA_ROBOT.Out.MKUP_TBL_TOP_CUR_QTY_Max_7);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_MID_CUR_QTY,KUKA_ROBOT.Out.MKUP_TBL_MID_CUR_QTY_Max_3);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_BTM_CUR_QTY,KUKA_ROBOT.Out.MKUP_TBL_BTM_CUR_QTY_Max_4);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_TOP_CUR_QTY,KUKA_ROBOT.Out.MKUP_TBL_TOP_CUR_QTY_Max_7);
				N: MOV(3,KUKA_ROBOT.Out.MKUP_TBL_TOP_TYPE);
				N: MOV(2,KUKA_ROBOT.Out.MKUP_TBL_MID_TYPE_Only_STD_or_TOP);
				N: MOV(1,KUKA_ROBOT.Out.MKUP_TBL_BTM_TYPE)MOV(KUKA_ROBOT.Out.MKUP_TBL_BTM_TYPE,KUKA_HMI.IN_MAKEUP_BTM_TYPE);
				N: MOV(KUKA_ROBOT.In.PGNO_FBIT_REFL,Last_Run_Task);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_TOP_CUR_QTY,KUKA_ROBOT.Out.MKUP_TBL_TOP_CUR_QTY_Max_7);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_MID_CUR_QTY,KUKA_ROBOT.Out.MKUP_TBL_MID_CUR_QTY_Max_3);
				N: MOV(KUKA_ROBOT.In.R_MKUP_TBL_BTM_CUR_QTY,KUKA_ROBOT.Out.MKUP_TBL_BTM_CUR_QTY_Max_4);
				RC: "INPUT ROBOT TO PLC AND HMI -  KUKA_HMI.MAINTENANCE_STATUS";
				N: XIC(KUKA_ROBOT.In.ROBOT_AT_MAINT_POS)OTE(KUKA_HMI.MAINTENANCE_STATUS);
				RC: "INPUT ROBOT TO PLC AND HMI - KUKA_HMI.BIN_COUNTER";
				N: MOV(KUKA_ROBOT.In.R_GOOD_DISC_CUR_QTY,KUKA_HMI.BIN_COUNTER);
				RC: "OUTPUT TO ROBOT FROM PLC AND HMI  -  KUKA_HMI.RESET_BIN";
				N: XIC(KUKA_HMI.IN_RESET_BIN)OTL(KUKA_ROBOT.Out.RESET_BIN_COUNT);
				N: XIC(KUKA_ROBOT.Out.RESET_BIN_COUNT)TON(Timer_off_ResetBin,?,?);
				N: XIC(KUKA_ROBOT.Out.RESET_BIN_COUNT)[LEQ(KUKA_ROBOT.In.R_GOOD_DISC_CUR_QTY,0) ,XIC(Timer_off_ResetBin.DN) ]OTU(KUKA_ROBOT.Out.RESET_BIN_COUNT);
				N: MOV(KUKA_HMI.IN_GOOD_DISCARD_BIN_MAX,KUKA_ROBOT.Out.GOOD_DISCARD_BIN_MAX);
				N: MOV(KUKA_ROBOT.In.R_GOOD_DISC_CUR_QTY,KUKA_ROBOT.Out.GOOD_DISC_CUR_QTY_Max_GOOD_DISCARD_BIN_M);
				N: XIC(KUKA_HMI.IN_ENABLE_BIN)ONS(BINENABLE)OTL(BinEnableLatch);
				N: XIC(BinEnableLatch)XIO(KUKA_HMI.BIN_ENABLED)[OTL(KUKA_HMI.BIN_ENABLED) ,OTU(BinEnableLatch) ];
				N: XIC(BinEnableLatch)XIC(KUKA_HMI.BIN_ENABLED)[OTU(KUKA_HMI.BIN_ENABLED) ,OTU(BinEnableLatch) ];
				N: XIC(KUKA_HMI.BIN_ENABLED)OTE(KUKA_ROBOT.Out.GOOD_DISCARD_ENABLED);
				RC: "OUTPUT TO ROBOT FROM PLC AND HMI  -  KUKA_HMI.WAFER_OFFSET";
				N: MOV(KUKA_HMI.IN_WAFER_OFFSET,KUKA_ROBOT.Out.FRM_PLC_WAF_HEIGHT);
				RC: "OUTPUT TO ROBOT FROM PLC AND HMI  - KUKA_HMI.FOOT_MAX_HEIGHT";
				N: MOV(KUKA_HMI.IN_FOOT_MAX_HEIGHT,KUKA_ROBOT.Out.FRM_PLC_FOOT_MAX_HEIGHT);
				RC: "OUTPUT TO ROBOT FROM PLC AND HMI  -  KUKA_HMI.FOOT_MIN_HEIGHT";
				N: MOV(KUKA_HMI.IN_FOOT_MIN_HEIGHT,KUKA_ROBOT.Out.FRM_PLC_FOOT_MIN_HEIGHT);
				RC: "OUTPUT TO ROBOT FROM PLC AND HMI  -  KUKA_HMI.STD_MAX_HEIGHT";
				N: MOV(KUKA_HMI.IN_STD_MAX_HEIGHT,KUKA_ROBOT.Out.FRM_PLC_STD_MAX_HEIGHT);
				RC: "OUTPUT TO ROBOT FROM PLC AND HMI  -  KUKA_HMI.STD_MIN_HEIGHT";
				N: MOV(KUKA_HMI.IN_STD_MIN_HEIGHT,KUKA_ROBOT.Out.FRM_PLC_STD_MIN_HEIGHT);
				RC: "OUTPUT TO ROBOT FROM PLC AND HMI  - KUKA_HMI.TOP_MAX_HEIGHT";
				N: MOV(KUKA_HMI.IN_TOP_MAX_HEIGHT,KUKA_ROBOT.Out.FRM_PLC_TOP_MAX_HEIGHT);
				RC: "OUTPUT TO ROBOT FROM PLC AND HMI  - KUKA_HMI.TOP_MIN_HEIGHT";
				N: MOV(KUKA_HMI.IN_TOP_MIN_HEIGHT,KUKA_ROBOT.Out.FRM_PLC_TOP_MIN_HEIGHT);
				N: MOV(KUKA_HMI.IN_MAKEUP_TOP_TYPE,KUKA_ROBOT.Out.MKUP_TBL_TOP_TYPE);
				N: MOV(KUKA_HMI.IN_MAKEUP_MID_TYPE,KUKA_ROBOT.Out.MKUP_TBL_MID_TYPE_Only_STD_or_TOP);
				N: MOV(STACKS.STACK[3].CurrentLayer,KUKA_HMI.OUT_STACK_BCK2_CUR_LAYER);
				N: MOV(STACKS.STACK[2].CurrentLayer,KUKA_HMI.OUT_STACK_BCK1_CUR_LAYER);
				N: MOV(KUKA_ROBOT.In.R_PRIMSTCK_STACK_HEIGHT,KUKA_HMI.OUT_STACK_PRIM_HEIGHT);
				N: MOV(KUKA_ROBOT.In.R_BKUPSTCK1_STACK_HEIGHT,KUKA_HMI.OUT_STACK_BCK1_HEIGHT);
				N: MOV(KUKA_ROBOT.In.R_BKUPSTCK2_STACK_HEIGHT,KUKA_HMI.OUT_STACK_BCK2_HEIGHT);
				N: MOV(STACKS.STACK[1].CurrentLayer,KUKA_HMI.OUT_STACK_PRIM_CUR_LAYER);
				N: MOV(KUKA_ROBOT.In.INGOT_HEIGHT_G1,KUKA_HMI.OUT_INGOT_1_HEIGHT);
				N: MOV(KUKA_ROBOT.In.INGOT_HEIGHT_G2,KUKA_HMI.OUT_INGOT_2_HEIGHT);
				N: MOV(KUKA_ROBOT.In.INGOT_HEIGHT_G3,KUKA_HMI.OUT_INGOT_3_HEIGHT);
				N: MOV(KUKA_ROBOT.In.INGOT_HEIGHT_G4,KUKA_HMI.OUT_INGOT_4_HEIGHT);
				N: MOV(KUKA_ROBOT.In.PLC_ErrorCode,KUKA_HMI.OUT_ERR_CODE);
				N: MOV(KUKA_ROBOT.In.PLC_RobotMsgCode,KUKA_HMI.OUT_MSG_CODE);
				N: XIC(KUKA_ROBOT.In.WAFER_DETECTED)OTE(KUKA_HMI.OUT_WAFER_DETECTED);
				N: XIC(STACKS.STACK[1].Active)OTE(KUKA_HMI.OUT_STACK_PRIM_ACTIVE);
				N: XIC(STACKS.STACK[2].Active)OTE(KUKA_HMI.OUT_STACK_BCK1_ACTIVE);
				N: XIC(STACKS.STACK[3].Active)OTE(KUKA_HMI.OUT_STACK_BCK2_ACTIVE);
				N: XIC(MAKEUP_TABLE.Active)OTE(KUKA_HMI.OUT_MAKEUP_TABLE_ACTIVE);
				N: XIC(KUKA_HMI.IN_WAFER_CLEARED)OTE(KUKA_ROBOT.Out.WAFER_CLEARED);
				N: OTE(test.0);
		END_ROUTINE

