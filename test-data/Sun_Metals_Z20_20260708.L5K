IE_VER := 2.24;

CONTROLLER Sun_Metals_Z20 (Description := "Strapping Machine",
                           ProcessorType := "5069-L310ERM",
                           Major := 33,
                           RedundancyEnabled := 0,
                           KeepTestEditsOnSwitchOver := 0,
                           SecurityCode := 0,
                           ChangesToDetect := 16#ffff_ffff_ffff_ffff,
                           SFCExecutionControl := "CurrentActive",
                           SFCRestartPosition := "MostRecent",
                           SFCLastScan := "DontScan",
                           SerialNumber := 16#d05b_1267,
                           MatchProjectToController := No,
                           CanUseRPIFromProducer := No,
                           InhibitAutomaticFirmwareUpdate := 0,
                           PassThroughConfiguration := EnabledWithAppend,
                           DownloadProjectDocumentationAndExtendedProperties := Yes,
                           ReportMinorOverflow := 0,
                           EtherNetIPMode := "A1/A2: Dual-IP",
                           AutoDiagsEnabled := 0,
                           WebServerEnabled := 1)
	DATATYPE AGV_Bundle_Data (FamilyType := NoFamily)
		STRING Bundle_Destination (Description := "Destination: Warehouse or Recycle");
		STRING Cast_Number (Description := "Cast Number: Eg: A51179");
		STRING Cast_Alloy_Code (Description := "Cast Alloy Code: Eg: AC601P");
		STRING Cast_Date (Description := "Cast Date: As printed on label");
		DINT Cast_Ingot_Size (Description := "Cast Ingot Size: Expressed as kg. Eg: 8 or 12");
		DINT Bundle_Number (Description := "Cast Bundle Number: Eg: 004");
		DINT Bundle_Weight (Description := "Cast Bundle Weight: Expressed as kg.  Eg: 962");
		SINT ZZZZZZZZZZAGV_Bundle7 (Hidden := 1);
		BIT Bundle_Stack_Config ZZZZZZZZZZAGV_Bundle7 : 0 (Description := "Bundle Configuration Expressed as Single or Double. 0 = Single (normal) 1 = Double (half)");
		BIT Rework_Required ZZZZZZZZZZAGV_Bundle7 : 1 (Description := "If the bundle is to be taken to the rework area then this will equal 1. 0 = Nothing 1 = Rework");
		BIT Bundle_8Kg_7_Layer ZZZZZZZZZZAGV_Bundle7 : 2 (Description := "8Kg half bundle 7 layer configuration 1 = Selected");
		BIT Bundle_8Kg_9_Layer ZZZZZZZZZZAGV_Bundle7 : 3 (Description := "8Kg half bundle 9 layer configuration 1 = Selected");
		BIT Bundle_12Kg_5_Layer ZZZZZZZZZZAGV_Bundle7 : 4 (Description := "12Kg half bundle 5 layer configuration 1 = Selected");
		BIT Bundle_12Kg_7_Layer ZZZZZZZZZZAGV_Bundle7 : 5 (Description := "12Kg half bundle 7 layer configuration 1 = Selected");
	END_DATATYPE

	DATATYPE AGV_Interface (FamilyType := NoFamily)
		AGV_IO IO;
		AGV_Bundle_Data Scale;
		AGV_Bundle_Data Scale_1;
		AGV_Bundle_Data Strapper;
		AGV_Bundle_Data Strapper_1;
		AGV_Bundle_Data Strapper_2;
		AGV_Bundle_Data Pickup_1;
		AGV_Bundle_Data Pickup_2;
		AGV_Bundle_Data Pickup_3;
		AGV_Bundle_Data Pickup_4;
	END_DATATYPE

	DATATYPE AGV_IO (FamilyType := NoFamily)
		SINT ZZZZZZZZZZAGV_IO0 (Hidden := 1);
		BIT System_Enable ZZZZZZZZZZAGV_IO0 : 0 (Description := "Enables the AGV System: If this is OFF then Ignore all Signals from CLX and STOP");
		INT Call_Pickup_1 (Description := "Call the AGV to Pickup Position No.1");
		INT Call_Pickup_2 (Description := "Call the AGV to Pickup Position No.2");
		INT Call_Pickup_3 (Description := "Call the AGV to Pickup Position No.3");
		INT Call_Pickup_4 (Description := "Call the AGV to Pickup Position No.4");
		SINT ZZZZZZZZZZAGV_IO6 (Hidden := 1);
		BIT Call_Test_Weigh ZZZZZZZZZZAGV_IO6 : 0 (Description := "Call the AGV to Perform a Test Weigh");
		BIT Call_Remove_Test_Weigh ZZZZZZZZZZAGV_IO6 : 1 (Description := "Call AGV to Remove Test Weigh");
		BIT Call_Pickup_at_Rework ZZZZZZZZZZAGV_IO6 : 2 (Description := "Call AGV to Pickup the Bundle in the Rework Area and transport to Warehouse");
		BIT Call_Continue_Pickup ZZZZZZZZZZAGV_IO6 : 3 (Description := "Continue to Pickup Product");
		BIT Call_Pickup_at_Warehouse ZZZZZZZZZZAGV_IO6 : 4 (Description := "Call AGV to Pickup the Bundle in the Warehouse and transport to Recycle");
		BIT Do_NOT_Pickup ZZZZZZZZZZAGV_IO6 : 5 (Description := "Do NOT Pickup Product. Return to Park Position");
		BIT Do_NOT_Stack ZZZZZZZZZZAGV_IO6 : 6 (Description := "Do NOT Stack the current Half Bundle. WAIT above Conveyor for next Bundle (Double Stacking)");
		BIT Continue_to_Stack ZZZZZZZZZZAGV_IO6 : 7 (Description := "Continue to Place Top Bundle on the Bottom Bundle (Double Stacking)");
		SINT ZZZZZZZZZZAGV_IO15 (Hidden := 1);
		BIT Continue_to_Transport ZZZZZZZZZZAGV_IO15 : 0 (Description := "Continue to Transport a Single Stack to the Warehouse (Double Stacking)");
		BIT Conveyor_Disabled ZZZZZZZZZZAGV_IO15 : 1 (Description := "Stack Conveyor is Disabled. Ok for AGV to Approach.");
		BIT Reject_Skip_Pos1 ZZZZZZZZZZAGV_IO15 : 2 (Description := "Empty Reject Skip Detected in Position No.1");
		BIT Reject_Skip_Pos2 ZZZZZZZZZZAGV_IO15 : 3 (Description := "Empty Reject Skip Detected in Position No.2");
		BIT Reject_Skip_Pos3 ZZZZZZZZZZAGV_IO15 : 4 (Description := "Full Reject Skip Detected in Position No.3");
		BIT Reject_Skip_Pos4 ZZZZZZZZZZAGV_IO15 : 5 (Description := "Full Reject Skip Detected in Position No.4");
		BIT Reject_Skip_Rotate ZZZZZZZZZZAGV_IO15 : 6 (Description := "Rotate the Reject Skip");
		BIT Reject_Skip_Replace ZZZZZZZZZZAGV_IO15 : 7 (Description := "Replace the Reject Skip with an Empty one");
		SINT ZZZZZZZZZZAGV_IO24 (Hidden := 1);
		BIT Reject_Skip_Continue ZZZZZZZZZZAGV_IO24 : 0 (Description := "Continue to remove the Reject Skip (Disable Stop 7)");
		BIT Reject_Skip_Pause ZZZZZZZZZZAGV_IO24 : 1 (Description := "Pause Reject Function (Stop AGV Movement)");
		BIT Rapid_Door_Fully_Open ZZZZZZZZZZAGV_IO24 : 2 (Description := "VSI Rapid Door Fully Open Status");
		BIT Charger_1_Current_Less_Limit ZZZZZZZZZZAGV_IO24 : 3 (Description := "AGV Charging Circuit 1 Loop Closed Detection");
		BIT Charger_1_OK ZZZZZZZZZZAGV_IO24 : 4 (Description := "AGV Charger 1 OK");
		BIT Charger_2_Current_Less_Limit ZZZZZZZZZZAGV_IO24 : 5 (Description := "AGV Charging Circuit 2 Loop Closed Detection");
		BIT Charger_2_OK ZZZZZZZZZZAGV_IO24 : 6 (Description := "AGV Charger 2 OK");
		STRING NDC_Manage_Lane_Reset (Description := "Clear this lane ONLY if NDC Manage indicates that it is full.");
		SINT ZZZZZZZZZZAGV_IO33 (Hidden := 1);
		BIT In_Red_Zone ZZZZZZZZZZAGV_IO33 : 0 (Description := "AGV is in Red Zone. System Can NOT be Disabled");
		BIT In_Pickup_Pos_1 ZZZZZZZZZZAGV_IO33 : 1 (Description := "AGV is in Pickup Position 1");
		BIT In_Pickup_Pos_2 ZZZZZZZZZZAGV_IO33 : 2 (Description := "AGV is in Pickup Position 2");
		BIT In_Pickup_Pos_3 ZZZZZZZZZZAGV_IO33 : 3 (Description := "AGV is in Pickup Position 3");
		BIT In_Pickup_Pos_4 ZZZZZZZZZZAGV_IO33 : 4 (Description := "AGV is in Pickup Position 4");
		BIT Data_Invalid_Pickup_1 ZZZZZZZZZZAGV_IO33 : 5 (Description := "Data Read for Bundle Destination is Invalid. 0 = Valid 1 = Invalid");
		BIT Data_Invalid_Pickup_2 ZZZZZZZZZZAGV_IO33 : 6 (Description := "Data Read for Bundle Destination is Invalid. 0 = Valid 1 = Invalid");
		BIT Data_Invalid_Pickup_3 ZZZZZZZZZZAGV_IO33 : 7 (Description := "Data Read for Bundle Destination is Invalid. 0 = Valid 1 = Invalid");
		SINT ZZZZZZZZZZAGV_IO42 (Hidden := 1);
		BIT Data_Invalid_Pickup_4 ZZZZZZZZZZAGV_IO42 : 0 (Description := "Data Read for Bundle Destination is Invalid. 0 = Valid 1 = Invalid");
		BIT Data_Invalid_Pickup_Rework ZZZZZZZZZZAGV_IO42 : 1 (Description := "Data Read for Bundle Destination is Invalid. 0 = Valid 1 = Invalid");
		BIT At_Approach_To_Pickup ZZZZZZZZZZAGV_IO42 : 2 (Description := "AGV is approaching Pickup Position. Stays ON until the product is clear of the conveyor");
		BIT In_Pickup_Zone ZZZZZZZZZZAGV_IO42 : 3 (Description := "AGV is in Pickup Zone.  Disable Bundle conveyor from indexing");
		BIT At_Test_Weigh ZZZZZZZZZZAGV_IO42 : 4 (Description := "AGV is approaching the Test Weigh Area. Stays ON until AGV is clear of conveyor");
		BIT Pickup_Check_Feet ZZZZZZZZZZAGV_IO42 : 5 (Description := "AGV Requesting  PLC to Check Feet. Broken Strap Detection");
		BIT Double_Stack_Pos ZZZZZZZZZZAGV_IO42 : 6 (Description := "AGV is WAITING in the Double Stack Position Above the Conveyor. OK to Index");
		BIT Pickup_1_Empty ZZZZZZZZZZAGV_IO42 : 7 (Description := "AGV has Removed Product from Pickup Position No.1 (Reset Data)");
		SINT ZZZZZZZZZZAGV_IO51 (Hidden := 1);
		BIT Pickup_2_Empty ZZZZZZZZZZAGV_IO51 : 0 (Description := "AGV has Removed Product from Pickup Position No.2  (Reset Data)");
		BIT Pickup_3_Empty ZZZZZZZZZZAGV_IO51 : 1 (Description := "AGV has Removed Product from Pickup Position No.3  (Reset Data)");
		BIT Pickup_4_Empty ZZZZZZZZZZAGV_IO51 : 2 (Description := "AGV has Removed Product from Pickup Position No.4  (Reset Data)");
		BIT Pickup_Rework_Empty ZZZZZZZZZZAGV_IO51 : 3 (Description := "AGV has Removed Product from Rework Area");
		BIT Pickup_Rework_Full ZZZZZZZZZZAGV_IO51 : 4 (Description := "AGV has Placed Product in Rework Area");
		BIT At_Reject_Skip ZZZZZZZZZZAGV_IO51 : 5 (Description := "AGV at Reject Skip - Waiting on Confirmation");
		BIT Reject_Skip_Removed ZZZZZZZZZZAGV_IO51 : 6 (Description := "AGV has Picked up the Reject Skip");
		BIT Reject_Skip_Returned ZZZZZZZZZZAGV_IO51 : 7 (Description := "AGV has Placed the Reject Skip back in Position (Reset Stop 7)");
		SINT ZZZZZZZZZZAGV_IO60 (Hidden := 1);
		BIT Traffic_F_West_East ZZZZZZZZZZAGV_IO60 : 0 (Description := "AGV Travelling From West To East (F Bins)");
		BIT Traffic_F_East_West ZZZZZZZZZZAGV_IO60 : 1 (Description := "AGV Travelling From East To West (F Bins)");
		BIT Traffic_T_West_East ZZZZZZZZZZAGV_IO60 : 2 (Description := "AGV Travelling From West To East (T Bins)");
		BIT Traffic_T_East_West ZZZZZZZZZZAGV_IO60 : 3 (Description := "AGV Travelling From East To West (T Bins)");
		BIT Rapid_Door_Open_Request ZZZZZZZZZZAGV_IO60 : 4 (Description := "VSI Rapid Door Open Request Command");
		BIT Charger_1_Enable ZZZZZZZZZZAGV_IO60 : 5 (Description := "AGV Charger 1 Enabled");
		BIT Charger_2_Enable ZZZZZZZZZZAGV_IO60 : 6 (Description := "AGV Charger 2 Enabled");
		BIT Fault_General_AGV1_Alarm ZZZZZZZZZZAGV_IO60 : 7 (Description := "AGV1 has encounted an issue which requires an operator input. Check NDC Manage (Fault)");
		SINT ZZZZZZZZZZAGV_IO69 (Hidden := 1);
		BIT Fault_General_AGV2_Alarm ZZZZZZZZZZAGV_IO69 : 0 (Description := "AGV2 has encounted an issue which requires an operator input. Check NDC Manage (Fault)");
		BIT Fault_Carwash_Alarm ZZZZZZZZZZAGV_IO69 : 1 (Description := "AGV Unknown Load Detected - To be Delivered to AGV Load Fault Area (East of Rework Area)");
	END_DATATYPE

	DATATYPE ArmorBlock8BVT8D_Inputs (Description := "ArmorBlock MaXum 1792D-8BVT8D Inputs and Diagnostics",
	                                  FamilyType := NoFamily)
		SINT ZZZZZZZZZZArmorBlock0 (Hidden := 1);
