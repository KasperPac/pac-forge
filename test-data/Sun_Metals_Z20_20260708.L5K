				N: EQU(Alarm_Fault,17)OTE(Fault_Head_Step_017);
				N: EQU(Alarm_Fault,18)OTE(Fault_Head_Step_018);
				N: EQU(Alarm_Fault,19)OTE(Fault_Head_Step_019);
				N: EQU(Alarm_Fault,20)OTE(Fault_Head_Step_020);
				N: EQU(Alarm_Fault,21)OTE(Fault_Head_Step_021);
				N: EQU(Alarm_Fault,22)OTE(Fault_Head_Step_022);
				N: EQU(Alarm_Fault,23)OTE(Fault_Head_Step_023);
				N: EQU(Alarm_Fault,24)OTE(Fault_Head_Step_024);
				N: EQU(Alarm_Fault,25)OTE(Fault_Head_Step_025);
				N: EQU(Alarm_Fault,26)OTE(Fault_Head_Step_026);
				N: EQU(Alarm_Fault,27)OTE(Fault_Head_Step_027);
				N: EQU(Alarm_Fault,28)OTE(Fault_Head_Step_028);
				N: EQU(Alarm_Fault,29)OTE(Fault_Head_Step_029);
