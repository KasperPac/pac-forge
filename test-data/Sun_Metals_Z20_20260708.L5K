			_Time_in_Seconds : REAL (RADIX := Float) := 1.00000000e-001;
		END_TAG

		ROUTINE MainRoutine 
				N: JSR(MAOC_Routine_Channel1,0);
		END_ROUTINE

		ROUTINE MAOC_Routine_Channel1 
				RC: "////////////////////////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "This routine is to create the Waveform of frrequeny rannge 0.1 Hz to 12 Hz & duty cycle from between 0 to 100 %$N"
				    "$N"
				    "//////////////////////////////////////////////////////////////////////////////////////////////////////////////////";
				N: DIV(1,FREQUENCY,_Time_in_Seconds)DIV(100,_Time_in_Seconds,Par_Speed);
				RC: "//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    " - SECTION AXIS JOG$N"
				    "$N"
				    "/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////$N"
				    "$N"
				    "Procedure to start the Instruction :$N"
				    "$N"
				    "1- First MAOC Instruction should be on , after that taking in progress ( MI_MAOC.IP ) of MAOC as an interlock , switch on MAJ Instruction $N"
				    "///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////";
				N: XIC(Cmd_Run)XIC(MI_MAOC.IP)[XIO(MI_MAJ.IP) MAJ(Axis_Virtual_01,MI_MAJ,0,Par_Speed,Units per sec,100,% of Maximum,100,% of Maximum,Trapezoidal,0,0,% of Time,Disabled,0,0,None) ,NEQ(Par_Speed,SpeedMirror) MCD(Axis_Virtual_01,MI_ChangeJog,Jog,Yes,Par_Speed,No,0,No,0,No,100.0,No,100.0,Units per sec,% of Maximum,% of Maximum,% of Maximum) ,MOV(Par_Speed,SpeedMirror) ];
				N: XIC(Stop_Virtual)[MAS(Axis_Virtual_01,MI_MAS,All,Yes,100,% of Maximum,Yes,100,% of Maximum) ,XIC(MI_MAS.IP) OTU(Stop_Virtual) ,OTU(Cmd_Run) ];
				RC: "******************************************************************************$N"
				    "DUTY CYCLE  : - MIN : 0 MAX : 100 $N"
				    "Contolled TRAIC Output $N"
				    "**********************************************************************************";
				N: XIC(TENSION)MOV(HMI_Duty_Cycle,DUTY_CYCLE)MOV(0.0,Output_Cam_Array[0].Left)MOV(DUTY_CYCLE,Output_Cam_Array[0].Right)XIC(PWM_INPUT.0)OTE(PWM_INPUT.1)NOP();
				RC: "******************************************************************************$N"
				    "Max TRAIC Output ..Max Duty Cycle$N"
				    "**********************************************************************************";
				N: XIO(TENSION)MOV(100,DUTY_CYCLE)MOV(0.0,Output_Cam_Array[0].Left)MOV(DUTY_CYCLE,Output_Cam_Array[0].Right)XIC(PWM_INPUT.0)OTE(PWM_INPUT.2)NOP();
				N: [XIO(PWM_INPUT.0) XIC(MI_MAOC.IP) XIO(Local:8:O.Pt00.Data) OTL(Stop_MAOC) ,XIC(PWM_INPUT.0) XIO(MI_MAOC.IP) [OTL(Start_MAOC) ,CTU(jjj,?,?) ] ];
				N: [XIC(Start_MAOC) ,XIC(O_MACHINE_ON) ONS(MAOC_Trig) ][XIO(MI_MAOC.IP) MAOC(Axis_Virtual_01,0,MI_MAOC,Local:8:O,PWM_INPUT,Output_Cam_Array[0],Cam_Start_Position,Cam_End_Position,Output_Compensation_Array[0],Continuous,Forward Only,Axis_Arm_Position,Cam_Arm_Position,Command) ,XIC(MI_MAOC.IP) OTU(Start_MAOC) ];
				N: XIC(All_Cycle_Reset)XIC(MI_MAOC.ER)OTU(Start_MAOC);
				N: XIC(Stop_MAOC)[MDOC(Axis_Virtual_01,0,MI_MDOC,All) ,XIC(MI_MDOC.DN) OTU(Stop_MAOC) ];
				N: XIO(MI_MAOC.ER)OTE(PWM_Status_healthy);
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

