	DATATYPE Motor_Drive (FamilyType := NoFamily)
		DINT OL_Data;
		INT Time_To_Reset;
		INT Motor_Current;
		SINT ZZZZZZZZZZMotor_Driv3 (Hidden := 1);
		BIT In_1_Contactor_Confirmation ZZZZZZZZZZMotor_Driv3 : 0;
		BIT In_2_Isolator_Aux_Relay ZZZZZZZZZZMotor_Driv3 : 1;
