	ADD_ON_INSTRUCTION_DEFINITION AOI_130 (Revision := "1.3",
	                                       RevisionNote := "Implementation of CCU and MOVIFIT- functionality. It is possible to select the START-BYTE of the Processdata for each conntected drive. Using MOVIFIT, no DI/DO of the MOVIPLC are available.$N$NLiability exclusion:$NFor faulty program function and their concequences SEW EURODRIVE will not inherit juridical or any other liability.",
	                                       ExecutePrescan := No,
	                                       ExecutePostscan := No,
	                                       ExecuteEnableInFalse := No,
	                                       CreatedDate := "2013-08-19T07:54:57.859Z",
	                                       CreatedBy := "VMXPBRU_BASIS\Administrator",
	                                       EditedDate := "2014-05-15T10:13:18.813Z",
	                                       EditedBy := "VMXPBRU_BASIS\Administrator",
	                                       SoftwareRevision := "v20.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			PD_INPUT : SINT[6] (Description := "Processdata input; to be linked with xxxxxxx.Data; The array size has to match the size of the SINT - processdata array",
			                    Usage := InOut,
			                    RADIX := Decimal,
			                    Required := Yes,
			                    Visible := Yes);
			PD_OUTPUT : SINT[6] (Description := "Processdata output; to be linked with xxxxxxx.Data",
			                     Usage := InOut,
			                     RADIX := Decimal,
			                     Required := Yes,
			                     Visible := Yes);
			ENABLE_RAPID_STOP : BOOL (Description := "Enable/rapid stop",
			                             Usage := Input,
			                             RADIX := Decimal,
			                             Required := Yes,
			                             Visible := Yes,
			                             DefaultData := 0);
			ENABLE : BOOL (Description := "Enable",
			                  Usage := Input,
			                  RADIX := Decimal,
			                  Required := Yes,
			                  Visible := Yes,
			                  DefaultData := 0);
			RESET : BOOL (Description := "Reset",
			                 Usage := Input,
			                 RADIX := Decimal,
			                 Required := Yes,
			                 Visible := Yes,
			                 DefaultData := 0);
			SETPOINT_SPEED : INT (Description := "Setpoint Speed, Scaled with 1/5, 0.2 rpm per digit",
			                          Usage := Input,
			                          RADIX := Decimal,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0);
			RAMP : INT (Description := "Ramp UP/DOWN",
			                Usage := Input,
			                RADIX := Decimal,
			                Required := Yes,
			                Visible := Yes,
			                DefaultData := 0);
			INVERTER_READY : BOOL (Description := "Inverter ready: TRUE := Inverter is ready to operate",
			                          Usage := Output,
			                          RADIX := Decimal,
			                          Required := Yes,
			                          Visible := Yes,
			                          ExternalAccess := Read Only,
			                          DefaultData := 0);
			FAULT_OF_AXIS : BOOL (Description := "TRUE := Axis has fault",
			                         Usage := Output,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         ExternalAccess := Read Only,
			                         DefaultData := 0);
			AXIS_FAULT_NO : INT (Description := "Fault number",
			                         Usage := Output,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         ExternalAccess := Read Only,
			                         DefaultData := 0);
			ACTUAL_SPEED : INT (Description := "Actual Speed; $NScaled with 1/5, 0.2 rpm per digit",
			                        Usage := Output,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			OUTPUT_CURRENT : REAL (Description := "Output current; scaled with 1/10",
			                          Usage := Output,
			                          RADIX := Float,
			                          Required := Yes,
			                          Visible := Yes,
			                          ExternalAccess := None,
			                          DefaultData := 0.00000000e+000);
			START_BYTE : INT (Description := "Processdata offset; MOVIDRIVE: 0; GATEWAY: dependand on configuration; MOVIFIT: dependand on configuration, but at least 4; MOVIPRO: dependand on configuration; PLEASE FINDE MORE INFORMATION INSIDE THE AOI",
			                      Usage := Input,
			                      RADIX := Decimal,
			                      Required := Yes,
			                      Visible := Yes,
			                      DefaultData := 0);
			FAULT_OF_AOI : BOOL (Usage := Output,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        ExternalAccess := Read Only,
			                        DefaultData := 0);
			AOI_FAULT_NO : INT (Usage := Output,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        ExternalAccess := Read Only,
			                        DefaultData := 0);
			COMMUNICATION_FAULT : BOOL (Description := "TRUE :=  communication error",
			                               Usage := InOut,
			                               RADIX := Decimal,
			                               Required := Yes,
			                               Visible := Yes);
		END_PARAMETERS

		LOCAL_TAGS
			L_Status_Low : SINT (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			L_Status_High : SINT (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			L_Actual_Speed_IN : INT (RADIX := Decimal,
			                            ExternalAccess := None,
			                            DefaultData := 0);
			L_Output_Current_IN : INT (RADIX := Decimal,
			                              ExternalAccess := None,
			                              DefaultData := 0);
			L_Setpoint_Speed : INT (RADIX := Decimal,
			                           ExternalAccess := None,
			                           DefaultData := 0);
			L_Fault_No : INT (RADIX := Decimal,
			                     ExternalAccess := None,
			                     DefaultData := 0);
			L_Actual_Speed_OUT : INT (RADIX := Decimal,
			                             ExternalAccess := None,
			                             DefaultData := 0);
			L_Control : INT (RADIX := Decimal,
			                    ExternalAccess := None,
			                    DefaultData := 0);
			L_Ramp : INT (RADIX := Decimal,
			                 ExternalAccess := None,
			                 DefaultData := 0);
			L_Reset_Fault : BOOL (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			L_Enable_Rapid_Stop : BOOL (RADIX := Decimal,
			                              ExternalAccess := None,
			                              DefaultData := 0);
			L_Output_Current_OUT : REAL (RADIX := Float,
			                               ExternalAccess := None,
			                               DefaultData := 0.00000000e+000);
			L_Enable : BOOL (RADIX := Decimal,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			L_Inverter_Ready : BOOL (RADIX := Decimal,
			                           ExternalAccess := None,
			                           DefaultData := 0);
			L_Error : BOOL (RADIX := Decimal,
			                  ExternalAccess := None,
			                  DefaultData := 0);
			L_ByteMod : INT (RADIX := Decimal,
			                    ExternalAccess := None,
			                    DefaultData := 0);
			L_AOI_Fault_No : INT (RADIX := Decimal,
			                         ExternalAccess := None,
			                         DefaultData := 0);
			L_bInit : BOOL (Description := "TRUE := Initialization of AOI completed",
			                  RADIX := Decimal,
			                  ExternalAccess := None,
			                  DefaultData := 0);
			L_AOI_Fault : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
		END_LOCAL_TAGS

		ST_ROUTINE Logic 
			'//===================================================================================================================================================
			'//
			'//	SAFETY NOTES
			'//	------------
			'//	This sample program shows the basic approach only. 
			'//	For defective program functions and their consequences whether judical or any other accountability will be assumed.
			'//
			'//
			'//	PROGRAM DESCRIPTION
			'//	-------------------
			'//	This add on instruction (AOI) allows the user to control the velocity control via single input bits. 
			'//	He only has to link the processdata input/output of the AOI to the ethernet input.data/output.data of the device.
			'//	The process data input is copied consitently (cps-command) into internal (local) variables. The local variables are processed
			'//	and copied consistently to the processdata output.
			'//
			'//	Due to the fact, that SINT (Byte) ist used as varaible type, it doesn't matter, if a generic ethernet device is used or the .eds file is used
			'//	directly. To run this sample, select SINT as datatype in the configuration.
			'//	The direct use of the .eds file is only possible, if the version of the controller and the RSLogix software is newer the V19 (from V20 on).	
			'//	
			'//===================================================================================================================================================
			'
			'if not(L_bInit) then
			'	//Uneven byte selected
			'	L_ByteMod := START_BYTE mod 2;
			'	if L_ByteMod = 0 then
			'		L_AOI_Fault := 0;
			'		L_bInit := 1;
			'	else
			'		L_AOI_Fault := 1;
			'		L_AOI_Fault_No := 1;
			'		L_bInit := 0;
			'	end_if;	
			'end_if;
			'
			'if L_bInit then
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Copying processdata input interface into local variables. 
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	CPS(PD_INPUT[0 + START_BYTE], L_Status_Low, 1); 				//Statusword Low Byte
			'	CPS(PD_INPUT[1 + START_BYTE], L_Status_High, 1);				//Statusword High Byte ==> Fault Number
			'	CPS(PD_INPUT[2 + START_BYTE], L_Actual_Speed_IN, 2);			//Actual Speed
			'	CPS(PD_INPUT[4 + START_BYTE], L_Output_Current_IN, 2);			//Output current --> unscaled
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Error Handling while in operation
			'	//--------------------------------------------------------------------------------------------------------------------------------------------------
			'	if COMMUNICATION_FAULT then		//Communication Error
			'		L_AOI_Fault := 1;
			'		L_AOI_Fault_No := 2;
			'	else
			'		L_AOI_Fault := 0;
			'		L_AOI_Fault_No := 0;
			'	end_if;
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Copying control data into local variables
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Setpoint_Speed := SETPOINT_SPEED;				//Setpoint Speed
			'	L_Ramp := RAMP;									//Ramp UP/DOWN
			'	L_Enable_Rapid_Stop := ENABLE_RAPID_STOP;		//Enable Rapod Stop
			'	L_Reset_Fault := RESET;							//Reset fault
			'	L_Enable := ENABLE;								//Enable
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Deviding the Status word into the single status bits. 
			'	//	Storing the bits into local variables.
			'	//	Getting the Error Code using L_Status_High
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Inverter_Ready := L_Status_Low.1;				//Inverter is ready to operate
			'	L_Error := L_Status_Low.5;						//Error bit of inverter
			'	L_Fault_No := L_Status_High;					//Fault Number
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Processing error number. --> setting L_Error_No to zero, if no error occures
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	if not(L_Error) then
			'		L_Fault_No := 0;
			'	end_if;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Scaling input values after converting INT to REAL
			'	//	--> it is possible this way, because INT := 16bit, non floating and REAl := 32bit, floating (the other way round would not work out)
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Output_Current_OUT := L_Output_Current_IN;				//Output current
			'	L_Output_Current_OUT := L_Output_Current_OUT/10;
			'
			'	L_Actual_Speed_OUT := L_Actual_Speed_IN;					//Actual Speed
			'	L_Actual_Speed_OUT := L_Actual_Speed_OUT/5;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Processing the control/input bits
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Control.1 := L_Enable_Rapid_Stop;				//Control bit "Enable/rapid stop"
			'	L_Control.2 := L_Enable;						//Control bit "Enable"
			'	L_Control.6 := L_Reset_Fault;					//Control bit "Reset"
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Resetting all unused/unnecessary bits of the control word
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Control.0 := 0;				//Controller Inhibit --> Controller always enabled
			'	L_Control.3 := 0;				//Halt regulation --> always disabled
			'	L_Control.4 := 0;				//Integrator 1
			'	L_Control.5 := 0;				//Parameterset switchover --> always disabled
			'	L_Control.7 := 0;				//reserved --> always disabled
			'	L_Control.8 := 0;				//Direction motor poti --> always disabled
			'	L_Control.9 := 0;				//Motor poti UP --> always disabled
			'	L_Control.10 := 0;				//Motor poti DOWN --> always disabled
			'	L_Control.11 := 0;				//Internal fix values --> setpoint speed always via PD output 2
			'	L_Control.12 := 0;				//Internal fix values --> setpoint speed always via PD output 2
			'	L_Control.13 := 0;				//Reserved --> always disabled
			'	L_Control.14 := 0;				//Ramp 2 --> always disabled
			'	L_Control.15 := 0;				//not(SEWS) --> always disabled	
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Scaling setpoint values --> setpoint speed
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Setpoint_Speed := L_Setpoint_Speed * 5;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Setting Output variables
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	FAULT_OF_AXIS := L_Error;
			'	AXIS_FAULT_NO := L_Fault_No;
			'	INVERTER_READY := L_Inverter_Ready;
			'	OUTPUT_CURRENT := L_Output_Current_OUT;
			'	ACTUAL_SPEED := L_Actual_Speed_OUT;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Resetting all processdata output variable to "0"
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	if L_AOI_Fault then
			'		L_Control := 0;
			'		L_Setpoint_Speed := 0;
			'		L_Ramp := 0;
			'	end_if;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Copying local variables to processdata output interface 
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	cps(L_Control, PD_OUTPUT[0 + START_BYTE], 2);
			'	cps(L_Setpoint_Speed, PD_OUTPUT[2 + START_BYTE],2);	
			'	cps(L_Ramp, PD_OUTPUT[4 + START_BYTE], 2);
			'end_if;
			'FAULT_OF_AOI := L_AOI_Fault;
			'AOI_FAULT_NO := L_AOI_Fault_No;
		END_ST_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION AOI_140 (Revision := "1.3",
	                                       RevisionNote := "Implementation of CCU - functionality. It is possible to select the START-BYTE of the Processdata for each conntected drive.$N$NLiability exclusion:$NFor faulty program function and their concequences SEW EURODRIVE will not inherit juridical or any other liability.$N",
