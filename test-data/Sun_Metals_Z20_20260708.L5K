			                        DefaultData := 0);
			SERIAL_NO : DINT (RADIX := Decimal,
			                    ExternalAccess := Read Only,
			                    DefaultData := 0);
			goto_iStep : DINT (RADIX := Decimal,
			                     ExternalAccess := None,
			                     DefaultData := 0);
		END_LOCAL_TAGS

		ST_ROUTINE Logic 
			'(*=================================================================================
			'Name:	AFX60 WebServer AOI 
			'Author:	SICK STEGMANN GMBH
			'-----------------------------------------------------------------------------------
			'Description: 
			'The routine supports the explicit data messaging between the Rockwell PLC and the 
			'SICK AFx60 encoder via EtherNet/IP. This routine makes it possible to equalize
			'(read and write) a defined set of configuration parameters via EtherNet/IP.
			'
			'Version history:
			'Date        | Version  | created under Logix V. | Author     | Remark
			'-----------------------------------------------------------------------------------
			'2015.05.21  | 1.0.0    | V21.00.00 CPR 9 SR 5.1 | SICK STD RP| Release version
			'2015.06.03  | 1.0.1    | V21.00.00 CPR 9 SR 5.1 | SICK STD RP| AutoSave on Encoder change
			'2015.07.06  | 1.0.2    | V21.00.00 CPR 9 SR 5.1 | SICK STD RP| Changed Param Update order
