	                                                    EditedBy := "DESKTOP-DBPRR6T\admin",
	                                                    SoftwareRevision := "v33.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			IndexingInProgress : BOOL (Usage := Input,
			                              RADIX := Decimal,
			                              Required := Yes,
			                              Visible := Yes,
			                              DefaultData := 0);
			EncoderPosition : DINT (Usage := Input,
			                           RADIX := Decimal,
			                           Required := Yes,
