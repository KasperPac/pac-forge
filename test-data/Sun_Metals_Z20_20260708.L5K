	ADD_ON_INSTRUCTION_DEFINITION FB_REG_INGOTS_STEPS_ACTIONS (Revision := "1.0",
	                                                           ExecutePrescan := No,
	                                                           ExecutePostscan := No,
	                                                           ExecuteEnableInFalse := No,
	                                                           CreatedDate := "2025-07-29T08:02:02.822Z",
	                                                           CreatedBy := "DESKTOP-DBPRR6T\admin",
	                                                           EditedDate := "2025-08-20T21:19:28.212Z",
	                                                           EditedBy := "DESKTOP-DBPRR6T\admin",
	                                                           SoftwareRevision := "v33.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			Top : BASE_CONTROL (Usage := InOut,
			               Required := Yes,
			               Visible := Yes);
			Enable : BOOL (Usage := Input,
			                  RADIX := Decimal,
			                  Required := Yes,
			                  Visible := Yes,
			                  DefaultData := 0);
			Step : LINT (Usage := Output,
			                RADIX := Decimal,
			                Required := No,
			                Visible := Yes,
			                ExternalAccess := Read Only,
			                DefaultData := 0);
			Action : LINT (Usage := Output,
			                  RADIX := Decimal,
			                  Required := No,
			                  Visible := Yes,
			                  ExternalAccess := Read/Write,
			                  DefaultData := 0);
			STACKS : STACKS (Usage := InOut,
			                  Required := Yes,
			                  Visible := Yes);
			MAKEUP_TABLE : MAKEUP_TABLE (Usage := InOut,
			                        Required := Yes,
			                        Visible := Yes);
			QUEUE_FULL : BOOL (Usage := Input,
			                      RADIX := Decimal,
			                      Required := No,
			                      Visible := No,
			                      DefaultData := 0);
			ENABLE_STACK_1 : BOOL (Usage := Input,
			                          RADIX := Decimal,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0);
			ENABLE_STACK_2 : BOOL (Usage := Input,
			                          RADIX := Decimal,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0);
			ENABLE_STACK_3 : BOOL (Usage := Input,
			                          RADIX := Decimal,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0);
			ENABLE_MAKEUP : BOOL (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			ACTIVE_STACK_1 : BOOL (Usage := Output,
			                          RADIX := Decimal,
			                          Required := No,
			                          Visible := Yes,
			                          ExternalAccess := Read Only,
			                          DefaultData := 0);
			ACTIVE_STACK_2 : BOOL (Usage := Output,
			                          RADIX := Decimal,
			                          Required := No,
			                          Visible := Yes,
			                          ExternalAccess := Read/Write,
			                          DefaultData := 0);
			ACTIVE_STACK_3 : BOOL (Usage := Output,
			                          RADIX := Decimal,
			                          Required := No,
			                          Visible := Yes,
			                          ExternalAccess := Read Only,
			                          DefaultData := 0);
			ACTIVE_MAKEUP : BOOL (Usage := Output,
			                         RADIX := Decimal,
			                         Required := No,
			                         Visible := Yes,
			                         ExternalAccess := Read/Write,
			                         DefaultData := 0);
			INGOT_SECTION : SECTION (Usage := InOut,
			                         Required := Yes,
			                         Visible := Yes);
			INGOT1_DETECT : BOOL (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			INGOT2_DETECT : BOOL (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			INOT3_DETECT : BOOL (Usage := Input,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        DefaultData := 0);
			INGOT4_DETECT : BOOL (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			ROBOT_TASK_COMPLETE : BOOL (Usage := Input,
			                               RADIX := Decimal,
			                               Required := Yes,
			                               Visible := Yes,
			                               DefaultData := 0);
			CURRENT_ROBOT_TASK : INT (Usage := Input,
			                              RADIX := Decimal,
			                              Required := Yes,
			                              Visible := Yes,
			                              DefaultData := 0);
			NOT_REQUIRED : BOOL (Usage := Output,
			                        RADIX := Decimal,
			                        Required := No,
			                        Visible := Yes,
			                        ExternalAccess := Read Only,
			                        DefaultData := 0);
			SP_INGOT_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			SP_INGOT_TOL : REAL (Usage := Input,
			                        RADIX := Float,
			                        Required := Yes,
			                        Visible := Yes,
			                        DefaultData := 0.00000000e+000);
			GRIPPER1_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			GRIPPER2_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			GRIPPER3_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			GRIPPER4_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			PICKED_INGOTS : SINT (Usage := Output,
			                         RADIX := Decimal,
			                         Required := No,
			                         Visible := Yes,
			                         ExternalAccess := Read/Write,
			                         DefaultData := 0);
			LOC1_PICK : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read/Write,
			                     DefaultData := 0);
			LOC2_PICK : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read/Write,
			                     DefaultData := 0);
			LOC3_PICK : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read/Write,
			                     DefaultData := 0);
			LOC4_PICK : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read/Write,
			                     DefaultData := 0);
			LAST_ROBOT_TASK : DINT (Usage := Input,
			                           RADIX := Decimal,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0);
			COUNT_UPDATE_COMPLETE : BOOL (Usage := Input,
			                                 RADIX := Decimal,
			                                 Required := Yes,
			                                 Visible := Yes,
			                                 DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			INGOT_MIN : REAL (RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			INGOT_MAX : REAL (RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			StepByStepEnable : BOOL (RADIX := Decimal,
			                           ExternalAccess := None,
			                           DefaultData := 1);
			NextStep : BOOL (RADIX := Decimal,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			TempTotalFeet : DINT (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			TempTotalReg : DINT (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			REJECT_LOC1 : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			REJECT_LOC2 : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			REJECT_LOC3 : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			REJECT_LOC4 : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			REJECT : BOOL (RADIX := Decimal,
			                 ExternalAccess := None,
			                 DefaultData := 0);
			TempRemainReg : DINT (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: XIO(Top.Automatic_Run)OTU(LOC1_PICK)OTU(LOC2_PICK)OTU(LOC3_PICK)OTU(LOC4_PICK)OTU(REJECT)OTU(REJECT_LOC1)OTU(REJECT_LOC2)OTU(REJECT_LOC3)OTU(REJECT_LOC4)MOV(0,INGOT_SECTION.STEPS_INT);
				RC: "Claculate Max and Min Distance for Gripper Lazer Detection";
				N: [ADD(SP_INGOT_HEIGHT,SP_INGOT_TOL,INGOT_MAX) ,SUB(SP_INGOT_HEIGHT,SP_INGOT_TOL,INGOT_MIN) ];
				RC: "Check if Stack 1 Layer 0 is Required";
				N: [GRT(STACKS.STACK[1].NextLayer,0) LES(STACKS.STACK[1].NextLayer,STACKS.STACK[1].Required_Layers) ,XIC(ACTIVE_STACK_1) ]XIC(STACKS.STACK[1].Enabled)XIC(Enable)[OTE(ACTIVE_STACK_1) ,OTL(STACKS.STACK[1].In_Progress) ];
				RC: "Check if Stack 2 Layer 0 is Required";
				N: [XIO(ACTIVE_STACK_1) GRT(STACKS.STACK[2].NextLayer,0) LES(STACKS.STACK[2].NextLayer,STACKS.STACK[2].Required_Layers) ,XIC(ACTIVE_STACK_2) ]XIC(STACKS.STACK[2].Enabled)XIC(Enable)[OTE(ACTIVE_STACK_2) ,OTL(STACKS.STACK[2].In_Progress) ];
				RC: "Check if Stack 3 Layer 0 is Required";
				N: [XIO(ACTIVE_STACK_1) XIO(ACTIVE_STACK_2) GRT(STACKS.STACK[3].NextLayer,0) LES(STACKS.STACK[3].NextLayer,STACKS.STACK[3].Required_Layers) ,XIC(ACTIVE_STACK_3) ]XIC(STACKS.STACK[3].Enabled)XIC(Enable)[OTE(ACTIVE_STACK_3) ,OTL(STACKS.STACK[3].In_Progress) ];
				RC: "Activate Makeup Table if No Feet Required on Stacks";
				N: XIC(MAKEUP_TABLE.Enabled)XIO(ACTIVE_STACK_1)XIO(ACTIVE_STACK_2)XIO(ACTIVE_STACK_3)XIC(Enable)OTE(ACTIVE_MAKEUP);
				RC: "Feet Not Required";
				N: XIO(ACTIVE_MAKEUP)XIO(ACTIVE_STACK_1)XIO(ACTIVE_STACK_2)XIO(ACTIVE_STACK_3)XIC(Enable)OTE(NOT_REQUIRED);
				N: XIO(ACTIVE_MAKEUP)XIO(ACTIVE_STACK_1)XIO(ACTIVE_STACK_2)XIO(ACTIVE_STACK_3)OTU(LOC1_PICK)OTU(LOC2_PICK)OTU(LOC3_PICK)OTU(LOC4_PICK)OTU(REJECT)OTU(REJECT_LOC1)OTU(REJECT_LOC2)OTU(REJECT_LOC3)OTU(REJECT_LOC4);
				RC: "Check if Feet are for Stack or Makeup";
				N: EQU(INGOT_SECTION.STEPS_INT,0)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]XIC(Enable)[[XIC(ACTIVE_STACK_1) ,XIC(ACTIVE_STACK_2) ,XIC(ACTIVE_STACK_3) ,XIC(ACTIVE_MAKEUP) ] MOV(1,INGOT_SECTION.STEPS_INT) ,[MOV(0,PICKED_INGOTS) ,OTU(LOC1_PICK) ,OTU(LOC2_PICK) ,OTU(LOC3_PICK) ,OTU(LOC4_PICK) ,OTU(REJECT) ,OTU(REJECT_LOC1) ,OTU(REJECT_LOC2) ,OTU(REJECT_LOC3) ,OTU(REJECT_LOC4) ] ];
				RC: "Chcek if All 4 Ingots are Feet";
				N: EQU(INGOT_SECTION.STEPS_INT,1)OTE(INGOT_SECTION.STEPS.1)XIC(INGOT_SECTION.ACTIONS.1)XIC(QUEUE_FULL)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]MOV(2,INGOT_SECTION.STEPS_INT);
				RC: "Check if Task 1 has been Completed";
				N: EQU(INGOT_SECTION.STEPS_INT,2)OTE(INGOT_SECTION.STEPS.2)XIC(INGOT_SECTION.ACTIONS.2)[EQU(LAST_ROBOT_TASK,1) XIC(ROBOT_TASK_COMPLETE) MOV(3,INGOT_SECTION.STEPS_INT) ,EQU(CURRENT_ROBOT_TASK,5) MOV(5,INGOT_SECTION.STEPS_INT) ];
				RC: "Check Heights (Future)";
				N: EQU(INGOT_SECTION.STEPS_INT,3)OTE(INGOT_SECTION.STEPS.3)XIC(INGOT_SECTION.ACTIONS.3)EQU(CURRENT_ROBOT_TASK,0)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ][XIC(INGOT1_DETECT) LEQ(GRIPPER1_HEIGHT,INGOT_MAX) GRT(GRIPPER1_HEIGHT,INGOT_MIN) ADD(PICKED_INGOTS,1,PICKED_INGOTS) OTL(LOC1_PICK) ,XIC(LOC1_PICK) XIC(INGOT2_DETECT) LEQ(GRIPPER2_HEIGHT,INGOT_MAX) GRT(GRIPPER2_HEIGHT,INGOT_MIN) ADD(PICKED_INGOTS,1,PICKED_INGOTS) OTL(LOC2_PICK) ,XIC(LOC1_PICK) XIC(LOC2_PICK) XIC(INOT3_DETECT) LEQ(GRIPPER3_HEIGHT,INGOT_MAX) GRT(GRIPPER3_HEIGHT,INGOT_MIN) ADD(PICKED_INGOTS,1,PICKED_INGOTS) OTL(LOC3_PICK) ,XIC(LOC1_PICK) XIC(LOC2_PICK) XIC(LOC3_PICK) XIC(INGOT4_DETECT) LEQ(GRIPPER3_HEIGHT,INGOT_MAX) GRT(GRIPPER4_HEIGHT,INGOT_MIN) ADD(PICKED_INGOTS,1,PICKED_INGOTS) OTL(LOC4_PICK) ,[[GEQ(GRIPPER1_HEIGHT,INGOT_MAX) ,LEQ(GRIPPER1_HEIGHT,INGOT_MIN) ] OTL(REJECT_LOC1) ,[GEQ(GRIPPER2_HEIGHT,INGOT_MAX) ,LEQ(GRIPPER2_HEIGHT,INGOT_MIN) ] OTL(REJECT_LOC2) ,[GEQ(GRIPPER3_HEIGHT,INGOT_MAX) ,LEQ(GRIPPER3_HEIGHT,INGOT_MIN) ] OTL(REJECT_LOC3) ,[GEQ(GRIPPER4_HEIGHT,INGOT_MAX) ,LEQ(GRIPPER4_HEIGHT,INGOT_MIN) ] OTL(REJECT_LOC4) ] OTL(REJECT) ][XIO(REJECT) MOV(4,INGOT_SECTION.STEPS_INT) ,XIC(REJECT) MOV(25,INGOT_SECTION.STEPS_INT) ];
				N: EQU(INGOT_SECTION.STEPS_INT,4)OTE(INGOT_SECTION.STEPS.4)XIC(INGOT_SECTION.ACTIONS.4)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ][EQU(PICKED_INGOTS,4) MOV(5,INGOT_SECTION.STEPS_INT) ,LES(PICKED_INGOTS,4) MOV(10,INGOT_SECTION.STEPS_INT) ,XIC(ACTIVE_MAKEUP) MOV(20,INGOT_SECTION.STEPS_INT) ];
				RC: "Check if Task 5 Has been Completed";
				N: EQU(INGOT_SECTION.STEPS_INT,5)OTE(INGOT_SECTION.STEPS.5)XIC(INGOT_SECTION.ACTIONS.5)EQU(LAST_ROBOT_TASK,5)XIC(ROBOT_TASK_COMPLETE)MOV(6,INGOT_SECTION.STEPS_INT);
				RC: "Check that Layer Index has been increased";
				N: EQU(INGOT_SECTION.STEPS_INT,6)OTE(INGOT_SECTION.STEPS.6)XIC(INGOT_SECTION.ACTIONS.6)[XIC(STACKS.STACK[1].Active) NEQ(STACKS.STACK[1].CurrentLayer,STACKS.STACK[1].NextLayer) ,XIC(STACKS.STACK[2].Active) NEQ(STACKS.STACK[2].CurrentLayer,STACKS.STACK[2].NextLayer) ,XIC(STACKS.STACK[3].Active) NEQ(STACKS.STACK[3].CurrentLayer,STACKS.STACK[3].NextLayer) ][XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]MOV(7,INGOT_SECTION.STEPS_INT);
				N: EQU(INGOT_SECTION.STEPS_INT,10)OTE(INGOT_SECTION.STEPS.10)XIC(INGOT_SECTION.ACTIONS.10)[EQU(MAKEUP_TABLE.Option,2) [GRT(MAKEUP_TABLE.Total_Regular_R3,MAKEUP_TABLE.Total_Regular_R1) ADD(MAKEUP_TABLE.Total_Regular_R3,PICKED_INGOTS,TempTotalReg) ,GEQ(MAKEUP_TABLE.Total_Regular_R1,MAKEUP_TABLE.Total_Regular_R3) ADD(MAKEUP_TABLE.Total_Regular_R1,PICKED_INGOTS,TempTotalReg) ] ,EQU(MAKEUP_TABLE.Option,1) ADD(MAKEUP_TABLE.Total_Regular_R3,PICKED_INGOTS,TempTotalReg) ][[XIC(STACKS.STACK[1].Active) GEQ(TempTotalReg,4) ,XIC(STACKS.STACK[2].Active) GEQ(TempTotalReg,4) ,XIC(STACKS.STACK[3].Active) GEQ(TempTotalReg,4) ] [XIO(StepByStepEnable) ,XIC(StepByStepEnable) XIC(NextStep) ] MOV(11,INGOT_SECTION.STEPS_INT) ,[XIC(STACKS.STACK[1].Active) LES(TempTotalReg,4) ,XIC(STACKS.STACK[2].Active) LES(TempTotalReg,4) ,XIC(STACKS.STACK[3].Active) LES(TempTotalReg,4) ] [XIO(StepByStepEnable) ,XIC(StepByStepEnable) XIC(NextStep) ] MOV(20,INGOT_SECTION.STEPS_INT) ];
				RC: "Check if Task 2 has been completed";
				N: EQU(INGOT_SECTION.STEPS_INT,11)OTE(INGOT_SECTION.STEPS.11)XIC(INGOT_SECTION.ACTIONS.11)EQU(LAST_ROBOT_TASK,2)XIC(ROBOT_TASK_COMPLETE)MOV(6,INGOT_SECTION.STEPS_INT);
				RC: "Check if Task 3 has been completed";
				N: EQU(INGOT_SECTION.STEPS_INT,20)OTE(INGOT_SECTION.STEPS.20)XIC(INGOT_SECTION.ACTIONS.20)EQU(LAST_ROBOT_TASK,3)XIC(ROBOT_TASK_COMPLETE)MOV(7,INGOT_SECTION.STEPS_INT);
				N: EQU(INGOT_SECTION.STEPS_INT,7)OTE(INGOT_SECTION.STEPS.7)XIC(INGOT_SECTION.ACTIONS.7)XIC(COUNT_UPDATE_COMPLETE)[OTU(LOC1_PICK) ,OTU(LOC2_PICK) ,OTU(LOC3_PICK) ,OTU(LOC4_PICK) ,OTU(REJECT) ,OTU(REJECT_LOC1) ,OTU(REJECT_LOC2) ,OTU(REJECT_LOC3) ,OTU(REJECT_LOC4) ,MOV(8,INGOT_SECTION.STEPS_INT) ];
				N: EQU(INGOT_SECTION.STEPS_INT,8)OTE(INGOT_SECTION.STEPS.8)XIC(INGOT_SECTION.ACTIONS.8)MOV(0,INGOT_SECTION.STEPS_INT);
				N: EQU(INGOT_SECTION.STEPS_INT,25)OTE(INGOT_SECTION.STEPS.25)XIC(INGOT_SECTION.ACTIONS.25)MOV(0,PICKED_INGOTS)[OTU(LOC1_PICK) ,OTU(LOC2_PICK) ,OTU(LOC3_PICK) ,OTU(LOC4_PICK) ][XIC(REJECT_LOC1) OTL(LOC1_PICK) ADD(PICKED_INGOTS,1,PICKED_INGOTS) ,XIC(REJECT_LOC2) OTL(LOC2_PICK) ADD(PICKED_INGOTS,1,PICKED_INGOTS) ,XIC(REJECT_LOC3) OTL(LOC3_PICK) ADD(PICKED_INGOTS,1,PICKED_INGOTS) ,XIC(REJECT_LOC4) OTL(LOC4_PICK) ADD(PICKED_INGOTS,1,PICKED_INGOTS) ]MOV(26,INGOT_SECTION.STEPS_INT);
				N: EQU(INGOT_SECTION.STEPS_INT,26)OTE(INGOT_SECTION.STEPS.26)XIC(INGOT_SECTION.ACTIONS.26)EQU(LAST_ROBOT_TASK,4)XIC(ROBOT_TASK_COMPLETE)MOV(27,INGOT_SECTION.STEPS_INT);
				N: EQU(INGOT_SECTION.STEPS_INT,27)OTE(INGOT_SECTION.STEPS.27)XIC(INGOT_SECTION.ACTIONS.27)MOV(7,INGOT_SECTION.STEPS_INT);
				N: XIC(NextStep)OTU(NextStep);
				N: MOV(INGOT_SECTION.STEPS,INGOT_SECTION.ACTIONS);
				N: MOV(INGOT_SECTION.STEPS_INT,Step);
				N: MOV(INGOT_SECTION.STEPS_INT,Action);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION FB_TOP_INGOTS_STEPS_ACTIONS (Revision := "1.0",
	                                                           ExecutePrescan := No,
	                                                           ExecutePostscan := No,
	                                                           ExecuteEnableInFalse := No,
	                                                           CreatedDate := "2025-07-29T08:02:02.822Z",
	                                                           CreatedBy := "DESKTOP-DBPRR6T\admin",
	                                                           EditedDate := "2025-08-20T21:20:01.950Z",
	                                                           EditedBy := "DESKTOP-DBPRR6T\admin",
	                                                           SoftwareRevision := "v33.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			Top : BASE_CONTROL (Usage := InOut,
			               Required := Yes,
			               Visible := Yes);
			Enable : BOOL (Usage := Input,
			                  RADIX := Decimal,
			                  Required := Yes,
			                  Visible := Yes,
			                  DefaultData := 0);
			Step : LINT (Usage := Output,
			                RADIX := Decimal,
			                Required := No,
			                Visible := Yes,
			                ExternalAccess := Read Only,
			                DefaultData := 0);
			Action : LINT (Usage := Output,
			                  RADIX := Decimal,
			                  Required := No,
			                  Visible := Yes,
			                  ExternalAccess := Read/Write,
			                  DefaultData := 0);
			STACKS : STACKS (Usage := InOut,
			                  Required := Yes,
			                  Visible := Yes);
			MAKEUP_TABLE : MAKEUP_TABLE (Usage := InOut,
			                        Required := Yes,
			                        Visible := Yes);
			QUEUE_FULL : BOOL (Usage := Input,
			                      RADIX := Decimal,
			                      Required := No,
			                      Visible := No,
			                      DefaultData := 0);
			ENABLE_STACK_1 : BOOL (Usage := Input,
			                          RADIX := Decimal,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0);
			ENABLE_STACK_2 : BOOL (Usage := Input,
			                          RADIX := Decimal,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0);
			ENABLE_STACK_3 : BOOL (Usage := Input,
			                          RADIX := Decimal,
			                          Required := Yes,
			                          Visible := Yes,
			                          DefaultData := 0);
			ENABLE_MAKEUP : BOOL (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			ACTIVE_STACK_1 : BOOL (Usage := Output,
			                          RADIX := Decimal,
			                          Required := No,
			                          Visible := Yes,
			                          ExternalAccess := Read Only,
			                          DefaultData := 0);
			ACTIVE_STACK_2 : BOOL (Usage := Output,
			                          RADIX := Decimal,
			                          Required := No,
			                          Visible := Yes,
			                          ExternalAccess := Read/Write,
			                          DefaultData := 0);
			ACTIVE_STACK_3 : BOOL (Usage := Output,
			                          RADIX := Decimal,
			                          Required := No,
			                          Visible := Yes,
			                          ExternalAccess := Read Only,
			                          DefaultData := 0);
			ACTIVE_MAKEUP : BOOL (Usage := Output,
			                         RADIX := Decimal,
			                         Required := No,
			                         Visible := Yes,
			                         ExternalAccess := Read/Write,
			                         DefaultData := 0);
			INGOT_SECTION : SECTION (Usage := InOut,
			                         Required := Yes,
			                         Visible := Yes);
			INGOT1_DETECT : BOOL (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			INGOT2_DETECT : BOOL (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			INOT3_DETECT : BOOL (Usage := Input,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        DefaultData := 0);
			INGOT4_DETECT : BOOL (Usage := Input,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes,
			                         DefaultData := 0);
			ROBOT_TASK_COMPLETE : BOOL (Usage := Input,
			                               RADIX := Decimal,
			                               Required := Yes,
			                               Visible := Yes,
			                               DefaultData := 0);
			CURRENT_ROBOT_TASK : INT (Usage := Input,
			                              RADIX := Decimal,
			                              Required := Yes,
			                              Visible := Yes,
			                              DefaultData := 0);
			NOT_REQUIRED : BOOL (Usage := Output,
			                        RADIX := Decimal,
			                        Required := No,
			                        Visible := Yes,
			                        ExternalAccess := Read Only,
			                        DefaultData := 0);
			SP_INGOT_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			SP_INGOT_TOL : REAL (Usage := Input,
			                        RADIX := Float,
			                        Required := Yes,
			                        Visible := Yes,
			                        DefaultData := 0.00000000e+000);
			GRIPPER1_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			GRIPPER2_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			GRIPPER3_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			GRIPPER4_HEIGHT : REAL (Usage := Input,
			                           RADIX := Float,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0.00000000e+000);
			PICKED_INGOTS : SINT (Usage := Output,
			                         RADIX := Decimal,
			                         Required := No,
			                         Visible := Yes,
			                         ExternalAccess := Read/Write,
			                         DefaultData := 0);
			LOC1_PICK : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read/Write,
			                     DefaultData := 0);
			LOC2_PICK : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read/Write,
			                     DefaultData := 0);
			LOC3_PICK : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read/Write,
			                     DefaultData := 0);
			LOC4_PICK : BOOL (Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := Yes,
			                     ExternalAccess := Read/Write,
			                     DefaultData := 0);
			LAST_ROBOT_TASK : DINT (Usage := Input,
			                           RADIX := Decimal,
			                           Required := No,
			                           Visible := No,
			                           DefaultData := 0);
			COUNT_UPDATE_COMPLETE : BOOL (Usage := Input,
			                                 RADIX := Decimal,
			                                 Required := Yes,
			                                 Visible := Yes,
			                                 DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			INGOT_MIN : REAL (RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			INGOT_MAX : REAL (RADIX := Float,
			                    ExternalAccess := None,
			                    DefaultData := 0.00000000e+000);
			StepByStepEnable : BOOL (RADIX := Decimal,
			                           ExternalAccess := None,
			                           DefaultData := 1);
			NextStep : BOOL (RADIX := Decimal,
			                   ExternalAccess := None,
			                   DefaultData := 0);
			TempTotalFeet : DINT (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			REJECT : BOOL (RADIX := Decimal,
			                 ExternalAccess := None,
			                 DefaultData := 0);
			REJECT_LOC1 : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			REJECT_LOC2 : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			REJECT_LOC4 : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			REJECT_LOC3 : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			TempTotalTop : DINT (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: XIO(Top.Automatic_Run)OTU(LOC1_PICK)OTU(LOC2_PICK)OTU(LOC3_PICK)OTU(LOC4_PICK)OTU(REJECT)OTU(REJECT_LOC1)OTU(REJECT_LOC2)OTU(REJECT_LOC3)OTU(REJECT_LOC4)MOV(0,INGOT_SECTION.STEPS_INT);
				RC: "Claculate Max and Min Distance for Gripper Lazer Detection";
				N: [ADD(SP_INGOT_HEIGHT,SP_INGOT_TOL,INGOT_MAX) ,SUB(SP_INGOT_HEIGHT,SP_INGOT_TOL,INGOT_MIN) ];
				RC: "Check if Stack 1 Layer 0 is Required";
				N: [XIC(STACKS.STACK[1].Enabled) EQU(STACKS.STACK[1].NextLayer,STACKS.STACK[1].Required_Layers) GEQ(STACKS.STACK[1].Remaining_Top,4) ,XIC(ACTIVE_STACK_1) ]XIC(Enable)[OTE(ACTIVE_STACK_1) ,OTL(STACKS.STACK[1].In_Progress) ];
				RC: "Check if Stack 2 Layer 0 is Required";
				N: [XIO(ACTIVE_STACK_1) XIC(STACKS.STACK[2].Enabled) EQU(STACKS.STACK[2].NextLayer,STACKS.STACK[2].Required_Layers) GEQ(STACKS.STACK[2].Remaining_Top,4) ,XIC(ACTIVE_STACK_2) ]XIC(Enable)[OTE(ACTIVE_STACK_2) ,OTL(STACKS.STACK[2].In_Progress) ];
				RC: "Check if Stack 2 Layer 0 is Required";
				N: [XIO(ACTIVE_STACK_1) XIO(ACTIVE_STACK_2) XIC(STACKS.STACK[3].Enabled) EQU(STACKS.STACK[3].NextLayer,STACKS.STACK[3].Required_Layers) GEQ(STACKS.STACK[3].Remaining_Top,4) ,XIC(ACTIVE_STACK_3) ]XIC(Enable)[OTE(ACTIVE_STACK_3) ,OTL(STACKS.STACK[3].In_Progress) ];
				RC: "Feet Not Required";
				N: XIO(ACTIVE_MAKEUP)XIO(ACTIVE_STACK_1)XIO(ACTIVE_STACK_2)XIC(Enable)OTE(NOT_REQUIRED);
				RC: "Check if Feet are for Stack or Makeup";
				N: EQU(INGOT_SECTION.STEPS_INT,0)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]XIC(Enable)[[XIC(ACTIVE_STACK_1) ,XIC(ACTIVE_STACK_2) ,XIC(ACTIVE_STACK_3) ] MOV(1,INGOT_SECTION.STEPS_INT) ,[MOV(0,PICKED_INGOTS) ,OTU(LOC1_PICK) ,OTU(LOC2_PICK) ,OTU(LOC3_PICK) ,OTU(LOC4_PICK) ,OTU(REJECT) ,OTU(REJECT_LOC1) ,OTU(REJECT_LOC2) ,OTU(REJECT_LOC3) ,OTU(REJECT_LOC4) ] ];
				RC: "Chcek if All 4 Ingots are Feet";
				N: EQU(INGOT_SECTION.STEPS_INT,1)OTE(INGOT_SECTION.STEPS.1)XIC(INGOT_SECTION.ACTIONS.1)XIC(QUEUE_FULL)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]MOV(2,INGOT_SECTION.STEPS_INT);
				RC: "Check if Task 1 has been Completed";
				N: EQU(INGOT_SECTION.STEPS_INT,2)OTE(INGOT_SECTION.STEPS.2)XIC(INGOT_SECTION.ACTIONS.2)[EQU(LAST_ROBOT_TASK,1) XIC(ROBOT_TASK_COMPLETE) MOV(3,INGOT_SECTION.STEPS_INT) ,EQU(CURRENT_ROBOT_TASK,5) MOV(5,INGOT_SECTION.STEPS_INT) ];
				RC: "Check Heights (Future)";
				N: EQU(INGOT_SECTION.STEPS_INT,3)OTE(INGOT_SECTION.STEPS.3)XIC(INGOT_SECTION.ACTIONS.3)EQU(CURRENT_ROBOT_TASK,0)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ][XIC(INGOT1_DETECT) LEQ(GRIPPER1_HEIGHT,INGOT_MAX) GRT(GRIPPER1_HEIGHT,INGOT_MIN) ADD(PICKED_INGOTS,1,PICKED_INGOTS) OTL(LOC1_PICK) ,XIC(LOC1_PICK) XIC(INGOT2_DETECT) LEQ(GRIPPER2_HEIGHT,INGOT_MAX) GRT(GRIPPER2_HEIGHT,INGOT_MIN) ADD(PICKED_INGOTS,1,PICKED_INGOTS) OTL(LOC2_PICK) ,XIC(LOC1_PICK) XIC(LOC2_PICK) XIC(INOT3_DETECT) LEQ(GRIPPER3_HEIGHT,INGOT_MAX) GRT(GRIPPER3_HEIGHT,INGOT_MIN) ADD(PICKED_INGOTS,1,PICKED_INGOTS) OTL(LOC3_PICK) ,XIC(LOC1_PICK) XIC(LOC2_PICK) XIC(LOC3_PICK) XIC(INGOT4_DETECT) LEQ(GRIPPER3_HEIGHT,INGOT_MAX) GRT(GRIPPER4_HEIGHT,INGOT_MIN) ADD(PICKED_INGOTS,1,PICKED_INGOTS) OTL(LOC4_PICK) ,[[GEQ(GRIPPER1_HEIGHT,INGOT_MAX) ,LEQ(GRIPPER1_HEIGHT,INGOT_MIN) ] OTL(REJECT_LOC1) ,[GEQ(GRIPPER2_HEIGHT,INGOT_MAX) ,LEQ(GRIPPER2_HEIGHT,INGOT_MIN) ] OTL(REJECT_LOC2) ,[GEQ(GRIPPER3_HEIGHT,INGOT_MAX) ,LEQ(GRIPPER3_HEIGHT,INGOT_MIN) ] OTL(REJECT_LOC3) ,[GEQ(GRIPPER4_HEIGHT,INGOT_MAX) ,LEQ(GRIPPER4_HEIGHT,INGOT_MIN) ] OTL(REJECT_LOC4) ] OTL(REJECT) ][XIO(REJECT) MOV(4,INGOT_SECTION.STEPS_INT) ,XIC(REJECT) MOV(25,INGOT_SECTION.STEPS_INT) ];
				N: EQU(INGOT_SECTION.STEPS_INT,4)OTE(INGOT_SECTION.STEPS.4)XIC(INGOT_SECTION.ACTIONS.4)[XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ][EQU(PICKED_INGOTS,4) MOV(5,INGOT_SECTION.STEPS_INT) ,LES(PICKED_INGOTS,4) MOV(10,INGOT_SECTION.STEPS_INT) ];
				RC: "Check if Task 5 Has been Completed";
				N: EQU(INGOT_SECTION.STEPS_INT,5)OTE(INGOT_SECTION.STEPS.5)XIC(INGOT_SECTION.ACTIONS.5)EQU(LAST_ROBOT_TASK,5)XIC(ROBOT_TASK_COMPLETE)MOV(6,INGOT_SECTION.STEPS_INT);
				RC: "Check that Layer Index has been increased";
				N: EQU(INGOT_SECTION.STEPS_INT,6)OTE(INGOT_SECTION.STEPS.6)XIC(INGOT_SECTION.ACTIONS.6)[XIC(STACKS.STACK[1].Active) NEQ(STACKS.STACK[1].CurrentLayer,STACKS.STACK[1].NextLayer) ,XIC(STACKS.STACK[2].Active) NEQ(STACKS.STACK[2].CurrentLayer,STACKS.STACK[2].NextLayer) ,XIC(STACKS.STACK[3].Active) NEQ(STACKS.STACK[3].CurrentLayer,STACKS.STACK[3].NextLayer) ][XIO(StepByStepEnable) ,XIC(NextStep) XIC(StepByStepEnable) ]MOV(7,INGOT_SECTION.STEPS_INT);
				N: EQU(INGOT_SECTION.STEPS_INT,7)OTE(INGOT_SECTION.STEPS.7)XIC(INGOT_SECTION.ACTIONS.7)XIC(COUNT_UPDATE_COMPLETE)[OTU(LOC1_PICK) ,OTU(LOC2_PICK) ,OTU(LOC3_PICK) ,OTU(LOC4_PICK) ,OTU(REJECT) ,OTU(REJECT_LOC1) ,OTU(REJECT_LOC2) ,OTU(REJECT_LOC3) ,OTU(REJECT_LOC4) ,MOV(8,INGOT_SECTION.STEPS_INT) ];
				N: EQU(INGOT_SECTION.STEPS_INT,8)OTE(INGOT_SECTION.STEPS.8)XIC(INGOT_SECTION.ACTIONS.8)MOV(0,INGOT_SECTION.STEPS_INT);
				N: EQU(INGOT_SECTION.STEPS_INT,25)OTE(INGOT_SECTION.STEPS.25)XIC(INGOT_SECTION.ACTIONS.25)MOV(0,PICKED_INGOTS)[OTU(LOC1_PICK) ,OTU(LOC2_PICK) ,OTU(LOC3_PICK) ,OTU(LOC4_PICK) ][XIC(REJECT_LOC1) OTL(LOC1_PICK) ADD(PICKED_INGOTS,1,PICKED_INGOTS) ,XIC(REJECT_LOC2) OTL(LOC2_PICK) ADD(PICKED_INGOTS,1,PICKED_INGOTS) ,XIC(REJECT_LOC3) OTL(LOC3_PICK) ADD(PICKED_INGOTS,1,PICKED_INGOTS) ,XIC(REJECT_LOC4) OTL(LOC4_PICK) ADD(PICKED_INGOTS,1,PICKED_INGOTS) ]MOV(26,INGOT_SECTION.STEPS_INT);
				N: EQU(INGOT_SECTION.STEPS_INT,26)OTE(INGOT_SECTION.STEPS.26)XIC(INGOT_SECTION.ACTIONS.26)EQU(LAST_ROBOT_TASK,4)XIC(ROBOT_TASK_COMPLETE)MOV(27,INGOT_SECTION.STEPS_INT);
				N: EQU(INGOT_SECTION.STEPS_INT,27)OTE(INGOT_SECTION.STEPS.27)MOV(7,INGOT_SECTION.STEPS_INT);
				N: XIC(NextStep)OTU(NextStep);
				N: MOV(INGOT_SECTION.STEPS,INGOT_SECTION.ACTIONS);
				N: MOV(INGOT_SECTION.STEPS_INT,Step);
				N: MOV(INGOT_SECTION.STEPS_INT,Action);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION Get_Timestamp (Revision := "1.0",
	                                             ExecutePrescan := No,
	                                             ExecutePostscan := No,
	                                             ExecuteEnableInFalse := No,
	                                             CreatedDate := "2023-11-19T23:01:09.260Z",
	                                             CreatedBy := "LPTP-ELCA-MNT\sunmetals",
	                                             EditedDate := "2023-11-19T23:11:53.249Z",
	                                             EditedBy := "LPTP-ELCA-MNT\sunmetals",
	                                             SoftwareRevision := "v33.02")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			LocalDateTime : DINT[7] (Usage := InOut,
			                         RADIX := Decimal,
			                         Required := Yes,
			                         Visible := Yes);
			Timestamp : STRING (Usage := InOut,
			                     Required := Yes,
			                     Visible := Yes);
		END_PARAMETERS

		LOCAL_TAGS
			timestamper : STRING (ExternalAccess := None,
