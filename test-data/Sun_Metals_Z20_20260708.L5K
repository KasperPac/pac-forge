			                     DefaultData := 0);
			OutRetract : BOOL (Usage := Output,
			                      RADIX := Decimal,
			                      Required := No,
			                      Visible := Yes,
			                      ExternalAccess := Read/Write,
			                      DefaultData := 0);
			OutSol_In_Fault : BOOL (Usage := Output,
			                           RADIX := Decimal,
