		SINT ZZZZZZZZZZMotor_Driv12 (Hidden := 1);
		BIT Motor_Status ZZZZZZZZZZMotor_Driv12 : 0;
		BIT Field_Isolator_1 ZZZZZZZZZZMotor_Driv12 : 1;
		BIT Field_Isolator_2 ZZZZZZZZZZMotor_Driv12 : 2;
		BIT Field_Isolator_3 ZZZZZZZZZZMotor_Driv12 : 3;
