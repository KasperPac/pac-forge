				N: XIC(KRC5_Raw_Input_Data[49].6)OTE(Mapped.In.R_PCKUP_DFLT_NEGHGT_ADST);
				N: XIC(KRC5_Raw_Input_Data[49].7)OTE(Mapped.In.R_PCKUP_DFLT_PICK_GRP);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 50 + 51";
				N: COP(KRC5_Raw_Input_Data[50],Mapped.In.R_TO_PLC_FOOT_MIN_HEIGHT,2);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 52 + 53";
				N: COP(KRC5_Raw_Input_Data[52],Mapped.In.R_TO_PLC_STD_MIN_HEIGHT,2);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 54 + 55";
				N: COP(KRC5_Raw_Input_Data[54],Mapped.In.R_TO_PLC_TOP_MIN_HEIGHT,2);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 56 + 57";
				N: COP(KRC5_Raw_Input_Data[56],Mapped.In.R_TO_PLC_FOOT_MAX_HEIGHT,2);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 58 + 59";
				N: COP(KRC5_Raw_Input_Data[58],Mapped.In.R_TO_PLC_STD_MAX_HEIGHT,2);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 60 + 61";
				N: COP(KRC5_Raw_Input_Data[60],Mapped.In.R_TO_PLC_TOP_MAX_HEIGHT,2);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 67";
				N: XIC(KRC5_Raw_Input_Data[67].0)OTE(Mapped.In.WAFER_DETECTED);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 75";
				N: MOV(KRC5_Raw_Input_Data[75],Mapped.In.R_MKUP_TBL_TOP_TYPE);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 76";
				N: MOV(KRC5_Raw_Input_Data[76],Mapped.In.R_MKUP_TBL_MID_TYPE);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 77";
				N: MOV(KRC5_Raw_Input_Data[77],Mapped.In.R_MKUP_TBL_BTM_TYPE);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 78";
				N: MOV(KRC5_Raw_Input_Data[78],Mapped.In.R_MKUP_TBL_TOP_CUR_QTY);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 79";
				N: MOV(KRC5_Raw_Input_Data[79],Mapped.In.R_MKUP_TBL_MID_CUR_QTY);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 80";
				N: MOV(KRC5_Raw_Input_Data[80],Mapped.In.R_MKUP_TBL_BTM_CUR_QTY);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 81";
				N: XIC(KRC5_Raw_Input_Data[80].0)OTE(Mapped.In.R_GOOD_DISCARD_ENABLED);
				N: XIC(KRC5_Raw_Input_Data[80].1)OTE(Mapped.In.R_GOOD_DISC_BLOCKED);
				N: XIC(KRC5_Raw_Input_Data[80].2)OTE(Mapped.In.gConvTestDone);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 82";
				N: MOV(KRC5_Raw_Input_Data[82],Mapped.In.R_GOOD_DISCARD_BIN_MAX);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 83";
				N: MOV(KRC5_Raw_Input_Data[83],Mapped.In.R_GOOD_DISC_CUR_QTY);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 87";
				N: MOV(KRC5_Raw_Input_Data[87],Mapped.In.R_PRIMSTCK_CUR_LAYERS);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 88 + 89";
				N: COP(KRC5_Raw_Input_Data[88],Mapped.In.R_PRIMSTCK_STACK_HEIGHT,2);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 92";
				N: XIC(KRC5_Raw_Input_Data[92].0)OTE(Mapped.In.R_PRIMSTCK_ERROR_STCK);
				N: XIC(KRC5_Raw_Input_Data[92].1)OTE(Mapped.In.R_PRIMSTCK_DO_NOT_STCK);
				N: XIC(KRC5_Raw_Input_Data[92].3)OTE(Mapped.In.R_PRIMSTCK_ENABLE);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 94";
				N: MOV(KRC5_Raw_Input_Data[94],Mapped.In.R_BKUPSTCK1_CUR_LAYERS);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 95 + 96";
				N: COP(KRC5_Raw_Input_Data[95],Mapped.In.R_BKUPSTCK1_STACK_HEIGHT,2);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 99";
				N: XIC(KRC5_Raw_Input_Data[99].0)OTE(Mapped.In.R_BKUPSTCK1_ERROR_STCK);
				N: XIC(KRC5_Raw_Input_Data[99].1)OTE(Mapped.In.R_BKUPSTCK1_DO_NOT_STCK);
				N: XIC(KRC5_Raw_Input_Data[99].2)OTE(Mapped.In.R_BKUPSTCK1_ENABLE);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 106";
				N: XIC(KRC5_Raw_Input_Data[106].0)OTE(Mapped.In.R_BKUPSTCK2_ERROR_STCK);
				N: XIC(KRC5_Raw_Input_Data[106].1)OTE(Mapped.In.R_BKUPSTCK2_DO_NOT_STCK);
				N: XIC(KRC5_Raw_Input_Data[106].2)OTE(Mapped.In.R_BKUPSTCK2_ENABLE);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 107";
				N: XIC(KRC5_Raw_Input_Data[107].0)OTE(Mapped.In.HOME_ZONE);
				N: XIC(KRC5_Raw_Input_Data[107].1)OTE(Mapped.In.INFEED_ZONE);
				N: XIC(KRC5_Raw_Input_Data[107].2)OTE(Mapped.In.STACK_1_ZONE);
				N: XIC(KRC5_Raw_Input_Data[107].3)OTE(Mapped.In.STACK_2_ZONE);
				N: XIC(KRC5_Raw_Input_Data[107].4)OTE(Mapped.In.STACK_3_ZONE);
				N: XIC(KRC5_Raw_Input_Data[107].5)OTE(Mapped.In.GOOD_BIN_ZONE);
				N: XIC(KRC5_Raw_Input_Data[107].6)OTE(Mapped.In.BAD_BIN_ZONE);
				N: XIC(KRC5_Raw_Input_Data[107].7)OTE(Mapped.In.RACK_TOP_ZONE_ZONE);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 108";
				N: XIC(KRC5_Raw_Input_Data[108].0)OTE(Mapped.In.RACK_MID_ZONE_ZONE);
				N: XIC(KRC5_Raw_Input_Data[108].1)OTE(Mapped.In.RACK_BTM_ZONE_ZONE);
				N: XIC(KRC5_Raw_Input_Data[108].2)OTE(Mapped.In.NONE_ZONE);
				N: XIC(KRC5_Raw_Input_Data[108].3)OTE(Mapped.In.ROBOT_AT_MAINT_POS);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 110";
				N: MOV(KRC5_Raw_Input_Data[110],Mapped.In.PLC_RobotMsgCode);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 112";
				N: MOV(KRC5_Raw_Input_Data[112],Mapped.In.PLC_ErrorCode);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 101";
				N: MOV(KRC5_Raw_Input_Data[101],Mapped.In.R_BKUPSTCK2_CUR_LAYERS);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 102 + 103";
				N: COP(KRC5_Raw_Input_Data[102],Mapped.In.R_BKUPSTCK2_STACK_HEIGHT,2);
				RC: " KUKA ROBOT TO PLC - INPUT BYTE 106";
				N: XIC(KRC5_Raw_Input_Data[99].0)OTE(Mapped.In.R_BKUPSTCK1_ERROR_STCK);
				RC: "PLC TO KUKA ROBOT OUTPUT";
				N: XIC(Always_On)MOV(Mapped.Out.PGNO,KRC5_Raw_Output_Data[0]);
				N: XIC(Mapped.Out.PGNO_PARITY)OTE(KRC5_Raw_Output_Data[1].0);
				N: XIC(Mapped.Out.PGNO_VALID)OTE(KRC5_Raw_Output_Data[1].1);
				N: XIC(Mapped.Out.EXT_START)OTE(KRC5_Raw_Output_Data[1].2);
				N: XIC(Mapped.Out.MOVE_ENABLE)OTE(KRC5_Raw_Output_Data[1].3);
				N: XIC(Mapped.Out.CONF_MESS)OTE(KRC5_Raw_Output_Data[1].4);
				N: XIC(Mapped.Out.DRIVES_OFF)OTE(KRC5_Raw_Output_Data[1].5);
				N: XIC(Mapped.Out.DRIVES_ON)OTE(KRC5_Raw_Output_Data[1].6);
				N: XIC(Mapped.Out.I_O_ACT)OTE(KRC5_Raw_Output_Data[1].7);
