				N: XIC(TOP.CTRL.Automatic_Run)XIC(KUKA_ROBOT.In.PERI_RDY)XIO(KUKA_ROBOT.In.STOPMESS)XIO(TOP.CTRL.Maintenance_Request)[XIC(CONVEYOR_D_IngotLogicDetection[1].OUT_FootDetected) OTE(FOOT_ACTIVE) ,XIC(CONVEYOR_D_IngotLogicDetection[1].OUT_StandartDetected) OTE(REGULAR_ACTIVE) ,[XIC(STACKS.STACK[1].Active) EQU(STACKS.STACK[1].CurrentLayer,9) ,XIC(STACKS.STACK[2].Active) EQU(STACKS.STACK[2].CurrentLayer,9) ,XIC(STACKS.STACK[3].Active) EQU(STACKS.STACK[3].CurrentLayer,9) ] EQU(IngotLaserScan_1.GRIPPER_SLOT,1) OTE(TOP_ACTIVE) ];
				RC: "Foot Ingot To Be Taken at the Conveyor";
