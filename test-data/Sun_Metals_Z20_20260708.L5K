		ROUTINE File00_Alarms 
				RC: "************************************************************$N"
				    "FAULT FEED MOTOR MPCB TRIPPED$N"
				    "************************************************************";
				N: [XIO(FEED_MOTOR_MPCB_HEALTHY) ,XIC(FAULT_FEED_MOTOR_MPCB_TRIP) ]XIO(All_Cycle_Reset)OTE(FAULT_FEED_MOTOR_MPCB_TRIP);
				RC: "************************************************************$N"
				    "FAULT INDEX TRANSFORMER MPCB TRIPPED$N"
				    "************************************************************";
				N: [XIO(INDEX_MOTOR_TRANSFORMER_MPCB_HEALTHY) ,XIC(FAULT_INDEX_TRANSFORMER_MPCB_TRIP) ]XIO(All_Cycle_Reset)OTE(FAULT_INDEX_TRANSFORMER_MPCB_TRIP);
				RC: "************************************************************$N"
				    "FAULT INDEX MOTOR MPCB TRIPPED$N"
				    "************************************************************";
				N: [XIO(INDEX_MOTOR_MPCB_HEALTHY) ,XIC(FAULT_INDEX_MOTOR_MPCB_TRIP) ]XIO(All_Cycle_Reset)OTE(FAULT_INDEX_MOTOR_MPCB_TRIP);
				RC: "************************************************************$N"
				    "FAULT Z20 WELD MOTOR MPCB TRIPPED$N"
				    "************************************************************";
				N: [XIO(WELD_MOT_MPCB_HEALTHY) ,XIC(FAULT_Z20_WELD_MOTOR_MPCB_TRIP) ]XIO(All_Cycle_Reset)OTE(FAULT_Z20_WELD_MOTOR_MPCB_TRIP);
				RC: "************************************************************$N"
				    "FAULT ESTOP PRESSED$N"
				    "************************************************************";
				N: [XIO(ESTOP_PILZ_OK) ,XIC(FAULT_ESTOP_PRESSED) ]XIO(All_Cycle_Reset)OTE(FAULT_ESTOP_PRESSED);
				RC: "************************************************************$N"
				    "FAULT SAFETY DOOR OPEN$N"
				    "************************************************************";
				N: XIO(SAFESTOP_PILZ_FB)OTE(FAULT_SAFETY_DOOR_OPEN);
				RC: "************************************************************$N"
				    "FAULT HEAD LOCKPIN REMOVED$N"
				    "************************************************************";
				N: [XIC(HEAD_LOCKED_IN_OPERATING_POSITION) ,XIC(FAULT_HEAD_LOCKPIN_REMOVED) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_HEAD_LOCKPIN_REMOVED);
				RC: "************************************************************$N"
				    "FAULT HEAD NOT AT OPERATING POSITION$N"
				    "************************************************************";
				N: [XIO(HEAD_IN_OPERATING_POSITION) ,XIC(FAULT_HEAD_NOT_IN_OPERATING_POSITION) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_HEAD_NOT_IN_OPERATING_POSITION);
				RC: "************************************************************$N"
				    "FAULT LOOPER 1 SENSOR FAULT / LOGIC ERROR$N"
				    "************************************************************";
				N: XIC(Always_On)[XIC(LOOPER_AT_TOP) XIC(LOOPER_AT_BOTTOM) ,XIC(FAULT_LOOPER_LS_FAULTY) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_LOOPER_LS_FAULTY);
				RC: "************************************************************$N"
				    "FAULT LOOPER 2 SENSOR FAULT / LOGIC ERROR$N"
				    "************************************************************";
				N: XIC(Always_On)[XIC(I_DISPENSER_2_AT_TOP) XIC(I_DISPENSER_2_AT_BOTTOM) ,XIC(FAULT_DISPENSER_2_LOOPER_LS_FAULTY) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_DISPENSER_2_LOOPER_LS_FAULTY);
				RC: "************************************************************$N"
				    "FAULT DISPESNER 1 CLUTCH MCB TRIPPED$N"
				    "************************************************************";
				N: XIC(Always_On)[XIO(DISPENSER_1_CLUTCH_MCB_FB) ,XIC(FAULT_DISPENSER_1_CLUTCH_MCB_TRIPPED) ]XIO(All_Cycle_Reset)OTE(FAULT_DISPENSER_1_CLUTCH_MCB_TRIPPED);
				RC: "************************************************************$N"
				    "FAULT DISPESNER 2 CLUTCH MCB TRIPPED$N"
				    "************************************************************";
				N: XIC(Always_On)[XIO(DISPENSER_2_CLUTCH_MCB_FB) ,XIC(FAULT_DISPENSER_2_CLUTCH_MCB_TRIPPED) ]XIO(All_Cycle_Reset)OTE(FAULT_DISPENSER_2_CLUTCH_MCB_TRIPPED);
				RC: "************************************************************$N"
				    "FAULT Z20 HEAD CLUTCH MCB TRIPPED$N"
				    "************************************************************";
				N: [XIO(Z20_CLUTCH_MCB_FB) ,XIC(FAULT_Z20_HEAD_CLUTCH_MCB_TRIPPED) ]XIO(All_Cycle_Reset)OTE(FAULT_Z20_HEAD_CLUTCH_MCB_TRIPPED);
				RC: "************************************************************$N"
				    "FAULT HOIST MOTOR MPCB TRIPPED$N"
				    "************************************************************";
				N: [XIO(HOIST_MOTOR_MPCB_HEALTHY) ,XIC(FAULT_HOIST_MOTOR_MPCB_TRIPPED) XIO(FAULT_RESET_ILPB) ]OTE(FAULT_HOIST_MOTOR_MPCB_TRIPPED);
				RC: "************************************************************$N"
				    "FAULT LINE PLC COMMNUNICATION MISSING$N"
				    "************************************************************";
				N: XIC(Always_On)[[XIC(Sunmetals_to_Signode_Life_Pulse) TON(Life_Pulse_On_Monitor,?,?) XIC(Life_Pulse_On_Monitor.DN) ,XIO(Sunmetals_to_Signode_Life_Pulse) TON(Life_Pulse_Off_Monitor,?,?) XIC(Life_Pulse_Off_Monitor.DN) ] ,XIC(FAULT_LINE_PLC_COMMUNICATION_MISSING) XIO(FAULT_RESET_ILPB) ]OTE(FAULT_LINE_PLC_COMMUNICATION_MISSING);
				RC: "************************************************************$N"
				    "FAULT PRODUCT PRESENCE MISSING FROM CUSTOMER $N"
				    "************************************************************";
				N: [XIC(Auto_Mode_Selected) XIC(Sunmetals_to_Signode_Cycle_Start) XIO(Sunmetals_to_Signode_Product_Present) ,XIC(FAULT_PROD_PRESENCE_MISSING_FROM_CUST) XIO(FAULT_RESET_ILPB) ]OTE(FAULT_PROD_PRESENCE_MISSING_FROM_CUST);
				RC: "************************************************************$N"
				    "FAULT DISPENSER 1 EMPTY $N"
				    "************************************************************";
				N: XIC(AUTO_MANUAL_SSW)XIC(Horizontial_Carriage_At_Home_POSITION)XIC(DISP1_STRAP_ALMOST_EMPTY)ONS(Disp_1_Count_Trig)ADD(Disp_1_Empty_Count,1,Disp_1_Empty_Count)GEQ(Disp_1_Empty_Count,Disp_1_Empty_Count_HMI)OTL(FAULT_DISPENSER_1_EMPTY);
				N: XIO(DISP1_STRAP_ALMOST_EMPTY)[OTU(FAULT_DISPENSER_1_EMPTY) ,MOV(0,Disp_1_Empty_Count) ];
				RC: "************************************************************$N"
				    "FAULT DISPENSER 1 EMPTY $N"
				    "************************************************************";
				N: XIC(AUTO_MANUAL_SSW)XIC(Horizontial_Carriage_At_Home_POSITION)XIC(DISP2_STRAP_ALMOST_EMPTY)ONS(Disp_2_Count_Trig)ADD(Disp_2_Empty_Count,1,Disp_2_Empty_Count)GEQ(Disp_2_Empty_Count,Disp_2_Empty_Count_HMI)OTL(FAULT_DISPENSER_2_EMPTY);
				N: XIO(DISP2_STRAP_ALMOST_EMPTY)[OTU(FAULT_DISPENSER_2_EMPTY) ,MOV(0,Disp_2_Empty_Count) ];
				N: XIO(Machine_Control_ON)XIO(All_Cycle_Reset)OTE(Fault_Control_ON_Absent);
				RC: "************************************************************$N"
				    "COOMMON FAULT $N"
				    "************************************************************";
				N: [XIC(FAULT_FEED_MOTOR_MPCB_TRIP) ,XIC(FAULT_INDEX_MOTOR_MPCB_TRIP) ,XIC(FAULT_INDEX_TRANSFORMER_MPCB_TRIP) ,XIC(FAULT_Z20_WELD_MOTOR_MPCB_TRIP) ,XIC(FAULT_ESTOP_PRESSED) ,XIC(FAULT_HEAD_LOCKPIN_REMOVED) ,XIC(FAULT_HEAD_NOT_IN_OPERATING_POSITION) ,XIC(FAULT_LOOPER_LS_FAULTY) ,XIC(FAULT_DISPENSER_2_LOOPER_LS_FAULTY) ,XIC(FAULT_DISPENSER_1_CLUTCH_MCB_TRIPPED) ,XIC(FAULT_DISPENSER_2_CLUTCH_MCB_TRIPPED) ,XIC(FAULT_Z20_HEAD_CLUTCH_MCB_TRIPPED) ,XIC(Bayonet_Fault) ,XIC(Fault_Feed_timedout) ,XIC(Hori_Carrige_Fault) ,XIC(Fault_SEW_Referancing) ,XIC(Fault_SEW_Axis) ,XIC(VERTICAL_CARRIAGE_FAULT) ,XIC(Fault_Bubble_Out) ,XIC(Fault_Control_ON_Absent) ,XIC(Fault_Module_communication) ,XIC(FAULT_HORZ_CARRIAGE_NOT_REFERENCED) ,XIC(FAULT_LINE_PLC_COMMUNICATION_MISSING) ,XIC(FAULT_PROD_PRESENCE_MISSING_FROM_CUST) ][OTE(Main_Fault) ,OTE(Alarm_Present) ];
				N: [XIC(Alarm_Present) ,XIC(FAULT_SAFETY_DOOR_OPEN) ]XIC(Flash_On.DN)OTE(O_FAULT_RESET);
				N: XIC(All_Cycle_Reset)OTU(Alarm_Present);
				N: [XIO(CYCLE_STOP_PB) ,XIC(FAULT_RESET_ILPB) ]OTE(All_Cycle_Reset);
				N: [XIC(Alarm_Present) ,XIC(Slab1_ALARM) ,XIC(R_B3[2].0) ,XIC(B3[61].3) ,XIC(R_I_3_2) ,XIC(fgt) ]OTE(Alarm_Siren_North);
		END_ROUTINE

		ROUTINE File01_Head_Alarms 
				N: XIC(Z20_PSM_A.TW[1].DN)NEQ(Z20_PSM_A.SP,0)ADD(Z20_PSM_A.SP,0,Alarm_Fault);
