		ROUTINE R305_CONVEYTECH_INT 
				N: XIC(in_Healthy_CONVE_INT)OTE(Healthy_CONVE_INT);
				N: XIO(Always_Off)XIC(EXECUT_Robot_Step_Actions.IN_Robot_OK)OTE(Enable_CONVE_INT);
				N: XIC(Healthy_CONVE_INT)MOV(0,Step_CONVE_INT);
				N: [XIO(KUKA_ROBOT.In.CONVEYOR_INT) ,XIC(STACKS.STACK[1].StackOffConeyor) ]OTE(Triger_CONVE_INT);
				RC: "Step 0 no traking - Start R";
				N: EQU(Step_CONVE_INT,0)EQU(Action_CONVE_INT,0)XIC(Triger_CONVE_INT)XIO(Healthy_CONVE_INT)XIC(Enable_CONVE_INT)MOV(1,Step_CONVE_INT);
				RC: "Step 1 no traking call Task 6 - Call Task 6";
				N: EQU(Step_CONVE_INT,1)EQU(Action_CONVE_INT,1)EQU(Task_Request,6)XIO(Healthy_CONVE_INT)MOV(2,Step_CONVE_INT);
				RC: "Step 2 call Task 6 FB bit exe - Call Task 6";
				N: EQU(Step_CONVE_INT,2)EQU(Action_CONVE_INT,2)XIC(KUKA_ROBOT.In.CONVEYOR_SIGNAL_REQ)XIO(Healthy_CONVE_INT)MOV(3,Step_CONVE_INT);
				RC: "Step 3 call Task 6 output on - Call Task 6";
				N: EQU(Step_CONVE_INT,3)EQU(Action_CONVE_INT,3)XIC(Output_CONVE_INT)XIO(Healthy_CONVE_INT)MOV(4,Step_CONVE_INT);
				RC: "Step 4 output on";
				N: EQU(Step_CONVE_INT,4)EQU(Action_CONVE_INT,4)XIO(KUKA_ROBOT.In.CONVEYOR_SIGNAL_REQ)XIO(Healthy_CONVE_INT)MOV(5,Step_CONVE_INT);
				RC: "Step 5 output off$N"
				    "";
				N: EQU(Step_CONVE_INT,5)EQU(Action_CONVE_INT,5)XIO(KUKA_ROBOT.In.CONVEYOR_SIGNAL_REQ)XIO(Output_CONVE_INT)XIO(Healthy_CONVE_INT)MOV(6,Step_CONVE_INT);
				RC: "Step 6 F$N"
				    "";
				N: EQU(Step_CONVE_INT,6)EQU(Action_CONVE_INT,6)XIO(Healthy_CONVE_INT)MOV(31,Step_CONVE_INT);
				RC: "Step 6 F$N"
				    "";
				N: EQU(Step_CONVE_INT,31)EQU(Action_CONVE_INT,31)XIO(Healthy_CONVE_INT)MOV(0,Step_CONVE_INT);
				N: MOV(Step_CONVE_INT,Action_CONVE_INT);
				RC: "Action 1 Call Task 6";
				N: EQU(Action_CONVE_INT,1)[MOV(6,Task_Request) ,OTL(CESAR_TEST.3) ];
				RC: "Action 2 Call Task 6";
				N: EQU(Action_CONVE_INT,2)[MOV(6,Task_Request) OTE(NO_Action_CONVE_INT.2) ,OTL(CESAR_TEST.4) ];
				RC: "Action 3 Call Task 6";
				N: EQU(Action_CONVE_INT,3)OTE(Output_CONVE_INT);
				RC: "Action 3 Call Task 6";
				N: EQU(Action_CONVE_INT,4)OTE(NO_Action_CONVE_INT.4);
				N: XIC(Output_CONVE_INT)OTE(Temp_Output);
		END_ROUTINE

		ROUTINE R401_ROBOT_ACTIONS 
				RC: "Excecute Robot Task 1 - Move to Position";
				N: AFI()[XIC(FOOT_SECTION.ACTIONS.2) ,XIC(REGULAR_SECTION.ACTIONS.2) ,XIC(TOP_SECTION.ACTIONS.2) ][MOV(1,Task_Request) ,MOV(FOOT_SAS.PICKED_INGOTS,Robot_Out_Picked_Conveyor) ];
				N: XIC(TOP.CTRL.Fault_Reset_Request)[MOV(0,Task_Request) ,OTU(STOP_TRIGGER) ];
				N: XIC(STACKS.STACK[1].Active)MOV(1,i_Stack);
				N: XIC(STACKS.STACK[2].Active)MOV(2,i_Stack);
				N: XIC(STACKS.STACK[3].Active)MOV(3,i_Stack);
				N: AFI()[XIC(FOOT_SECTION.ACTIONS.3) ,XIC(FOOT_SECTION.ACTIONS.7) ,XIC(REGULAR_SECTION.ACTIONS.3) ,XIC(REGULAR_SECTION.ACTIONS.7) ,XIC(TOP_SECTION.ACTIONS.3) ,XIC(TOP_SECTION.ACTIONS.7) ,XIC(TOP.CTRL.Stop_Request) ,XIC(TOP.CTRL.Maintenance_Request) ]MOV(0,Task_Request);
				RC: "Task 2 - Stack with Table";
				N: AFI()[XIC(FOOT_SECTION.ACTIONS.11) ,XIC(REGULAR_SECTION.ACTIONS.11) ]MOV(2,Task_Request);
				RC: "Task 3";
				N: AFI()[XIC(FOOT_SECTION.ACTIONS.20) ,XIC(REGULAR_SECTION.ACTIONS.20) ]MOV(3,Task_Request);
				RC: "Task 4";
				N: AFI()[XIC(FOOT_SECTION.ACTIONS.26) ,XIC(REGULAR_SECTION.ACTIONS.26) ,XIC(TOP_SECTION.ACTIONS.26) ]MOV(4,Task_Request);
				RC: "Task 5";
				N: AFI()[XIC(FOOT_SECTION.ACTIONS.5) ,XIC(REGULAR_SECTION.ACTIONS.5) ,XIC(TOP_SECTION.ACTIONS.5) ]MOV(5,Task_Request);
				N: AFI()XIC(TOP.CTRL.Maintenance_Request)MOV(7,Task_Request);
				RC: "Send Paramters to Robot";
				N: [XIC(FOOT_SECTION.ACTIONS.4) ,XIC(FOOT_SECTION.ACTIONS.10) ,XIC(FOOT_SECTION.ACTIONS.20) ,XIC(FOOT_SECTION.ACTIONS.26) ,XIC(REGULAR_SECTION.ACTIONS.4) ,XIC(REGULAR_SECTION.ACTIONS.10) ,XIC(REGULAR_SECTION.ACTIONS.20) ,XIC(REGULAR_SECTION.ACTIONS.26) ,XIC(TOP_SECTION.ACTIONS.4) ,XIC(TOP_SECTION.ACTIONS.26) ][XIC(FOOT_ACTIVE) [MOV(FOOT_SAS.PICKED_INGOTS,Robot_Out_Picked_Conveyor) ,MOV(FOOT_SAS.PICKED_INGOTS,ROBOT_VAR.Pick_Qty) ,MOV(1,ROBOT_VAR.Type_Of_Ingot) ] ,XIC(REGULAR_ACTIVE) [MOV(REGULAR_SAS.PICKED_INGOTS,Robot_Out_Picked_Conveyor) ,MOV(REGULAR_SAS.PICKED_INGOTS,ROBOT_VAR.Pick_Qty) ,MOV(2,ROBOT_VAR.Type_Of_Ingot) ] ,XIC(TOP_ACTIVE) [MOV(TOP_SAS.PICKED_INGOTS,Robot_Out_Picked_Conveyor) ,MOV(TOP_SAS.PICKED_INGOTS,ROBOT_VAR.Pick_Qty) ,MOV(3,ROBOT_VAR.Type_Of_Ingot) ] ,XIC(STACKS.STACK[i_Stack].Active) MOV(i_Stack,ROBOT_VAR.Active_Stack) ,XIC(STACKS.STACK[i_Stack].Active) MUL(STACKS.STACK[i_Stack].CurrentLayer,50,ROBOT_VAR.Stack_Height) GEQ(STACKS.STACK[i_Stack].CurrentLayer,1) SUB(ROBOT_VAR.Stack_Height,50,ROBOT_VAR.Stack_Height) ];
				RC: "Gripper Activation";
				N: [XIC(FOOT_SAS.LOC1_PICK) ,XIC(REGULAR_SAS.LOC1_PICK) ,XIC(TOP_SAS.LOC1_PICK) ]OTE(ROBOT_VAR.Gripper1_Activate);
				N: [XIC(FOOT_SAS.LOC2_PICK) ,XIC(REGULAR_SAS.LOC2_PICK) ,XIC(TOP_SAS.LOC2_PICK) ]OTE(ROBOT_VAR.Gripper2_Activate);
				N: [XIC(FOOT_SAS.LOC3_PICK) ,XIC(REGULAR_SAS.LOC3_PICK) ,XIC(TOP_SAS.LOC3_PICK) ]OTE(ROBOT_VAR.Gripper3_Activate);
				N: [XIC(FOOT_SAS.LOC4_PICK) ,XIC(REGULAR_SAS.LOC4_PICK) ,XIC(TOP_SAS.LOC4_PICK) ]OTE(ROBOT_VAR.Gripper4_Activate);
		END_ROUTINE

		ROUTINE ROBOT_CYCLE_TIME_TEMP 
				N: MOV(STACKS.STACK[1].CurrentLayer,TEMP_CURRENT_LAYER);
		END_ROUTINE

		ROUTINE SickAFx_A101WS_A103WS_FB_Enc1_GetSet 
				N: XIC(SickAFxWS_Enc1_Init_GetSet)OTL(SickAFxWS_Enc1_Cyclic_GetSet)OTL(SickAFxWS_Enc1_AOI.ManualGetData)OTU(SickAFxWS_Enc1_Init_GetSet);
				N: XIC(SickAFxWS_Enc1_Cyclic_GetSet)XIO(SickAFxWS_Enc1_Timer_GetSet.DN)TON(SickAFxWS_Enc1_Timer_GetSet,?,?);
				N: XIC(SickAFxWS_Enc1_Timer_GetSet.DN)SICK_AFX60_A101WS_A103WS_AOI(SickAFxWS_Enc1_AOI,SickAFX_Enc1_xyz:I1.Data,SickAFxWS_Enc1_msgGetData,SickAFxWS_Enc1_msgSetData,SickAFxWS_Enc1_GetData,SickAFxWS_Enc1_SetData)OTU(SickAFxWS_Enc1_AOI.ManualGetData);
		END_ROUTINE

