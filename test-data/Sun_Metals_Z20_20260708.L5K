	ADD_ON_INSTRUCTION_DEFINITION STACK_COUNT (Revision := "1.0",
	                                           ExecutePrescan := No,
	                                           ExecutePostscan := No,
	                                           ExecuteEnableInFalse := No,
	                                           CreatedDate := "2025-07-29T03:43:07.236Z",
	                                           CreatedBy := "DESKTOP-DBPRR6T\admin",
	                                           EditedDate := "2025-08-11T05:15:22.617Z",
	                                           EditedBy := "DESKTOP-DBPRR6T\admin",
	                                           SoftwareRevision := "v33.00")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			StackIndex : INT (Usage := Input,
			                      RADIX := Decimal,
			                      Required := Yes,
			                      Visible := Yes,
			                      DefaultData := 0);
			GripperQty : INT (Usage := Input,
			                      RADIX := Decimal,
			                      Required := Yes,
			                      Visible := Yes,
			                      DefaultData := 0);
			GripperType : INT (Usage := Input,
			                       RADIX := Decimal,
			                       Required := Yes,
			                       Visible := Yes,
			                       DefaultData := 0);
			GripperDropComplete : BOOL (Usage := Input,
			                               RADIX := Decimal,
			                               Required := Yes,
			                               Visible := Yes,
			                               DefaultData := 0);
			Required_Layers : INT (Usage := Input,
			                           RADIX := Decimal,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0);
			RequiredFeet : INT (Usage := Input,
			                        RADIX := Decimal,
			                        Required := Yes,
			                        Visible := Yes,
			                        DefaultData := 0);
			RequiredRegular : INT (Usage := Input,
			                           RADIX := Decimal,
			                           Required := Yes,
			                           Visible := Yes,
			                           DefaultData := 0);
			RequiredTop : INT (Usage := Input,
			                       RADIX := Decimal,
			                       Required := Yes,
			                       Visible := Yes,
			                       DefaultData := 0);
			STACK_UDT : STACK_CONTROL (Usage := InOut,
			                     Required := Yes,
			                     Visible := Yes);
			CLEAN_STACK : STACK_CONTROL (Usage := InOut,
			                       Required := Yes,
			                       Visible := Yes);
			NextRobotTask : INT (Usage := Output,
			                         RADIX := Decimal,
			                         Required := No,
			                         Visible := No,
			                         ExternalAccess := Read Only,
			                         DefaultData := 0);
			FootLayerComplete : BOOL (Usage := Input,
			                             RADIX := Decimal,
			                             Required := No,
			                             Visible := No,
			                             DefaultData := 0);
			RegLayerComplete : BOOL (Usage := Input,
			                            RADIX := Decimal,
			                            Required := No,
			                            Visible := No,
			                            DefaultData := 0);
			TopLayerComplete : BOOL (Usage := Input,
			                            RADIX := Decimal,
			                            Required := No,
			                            Visible := No,
			                            DefaultData := 0);
			ResetStack : BOOL (Usage := Input,
			                      RADIX := Decimal,
			                      Required := No,
			                      Visible := Yes,
			                      DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			FootLayerONS : BOOL (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			RegLayerONS : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			TopLayerONS : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				RC: "Create Totals Required for each type";
				N: [MOV(Required_Layers,STACK_UDT.Required_Layers) ,MOV(RequiredFeet,STACK_UDT.Required_Feet) ,MOV(RequiredRegular,STACK_UDT.Required_Regular) ,MOV(RequiredTop,STACK_UDT.Required_Top) ,CPT(STACK_UDT.Required_Qty,STACK_UDT.Required_Feet + STACK_UDT.Required_Regular + STACK_UDT.Required_Top) ];
				N: [SUB(STACK_UDT.Required_Feet,STACK_UDT.Total_Feet,STACK_UDT.Remaining_Feet) ,SUB(STACK_UDT.Required_Regular,STACK_UDT.Total_Regular,STACK_UDT.Remaining_Regular) ,SUB(STACK_UDT.Required_Top,STACK_UDT.Total_Top,STACK_UDT.Remaining_Top) ];
				N: XIC(FootLayerComplete)ONS(FootLayerONS)ADD(STACK_UDT.Total_Feet,4,STACK_UDT.Total_Feet);
				N: XIC(RegLayerComplete)ONS(RegLayerONS)ADD(STACK_UDT.Total_Regular,4,STACK_UDT.Total_Regular);
				N: XIC(TopLayerComplete)ONS(TopLayerONS)ADD(STACK_UDT.Total_Top,4,STACK_UDT.Total_Top);
				N: [CPT(STACK_UDT.Total_Count,STACK_UDT.Total_Feet + STACK_UDT.Total_Regular + STACK_UDT.Total_Top) ,SUB(STACK_UDT.Required_Qty,STACK_UDT.Total_Count,STACK_UDT.Remaining) ];
				N: EQU(STACK_UDT.Remaining,0)OTE(STACK_UDT.Complete);
				RC: "Reset Stack";
				N: XIC(ResetStack)COP(CLEAN_STACK,STACK_UDT,1);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

