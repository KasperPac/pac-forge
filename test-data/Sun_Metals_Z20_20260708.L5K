			                          ExternalAccess := None,
			                          DefaultData := 0);
			RegLayePickONS : BOOL (RADIX := Decimal,
			                         ExternalAccess := None,
			                         DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				RC: "Create Totals Required for each type";
				N: [MOV(RequiredFeet,MAKEUP_UDT.Required_Feet) ,MOV(RequiredRegular,MAKEUP_UDT.Required_Regular) ];
				N: [CPT(MAKEUP_UDT.Remaining_Feet,MAKEUP_UDT.Required_Feet - MAKEUP_UDT.Total_Feet_R1 - MAKEUP_UDT.Total_Feet_R2) ,CPT(MAKEUP_UDT.Remaining_Regular,MAKEUP_UDT.Required_Regular - MAKEUP_UDT.Total_Regular_R1 - MAKEUP_UDT.Total_Regular_R3) ];
				N: [[XIC(DropComplete) ONS(FootLayerONS) [ADD(MAKEUP_UDT.Total_Feet_R1,DropFeet_R1,MAKEUP_UDT.Total_Feet_R1) ,ADD(MAKEUP_UDT.Total_Feet_R2,DropFeet_R2,MAKEUP_UDT.Total_Feet_R2) ,ADD(MAKEUP_UDT.Total_Regular_R3,DropRegular_R3,MAKEUP_UDT.Total_Regular_R3) ,ADD(MAKEUP_UDT.Total_Regular_R1,DropRegular_R1,MAKEUP_UDT.Total_Regular_R1) ] ,XIC(PickupComplete) ONS(FootLayePickONS) [SUB(MAKEUP_UDT.Total_Feet_R1,PickFeetR1,MAKEUP_UDT.Total_Feet_R1) ,SUB(MAKEUP_UDT.Total_Feet_R2,PickFeet_R2,MAKEUP_UDT.Total_Feet_R2) ,SUB(MAKEUP_UDT.Total_Regular_R3,PickRegular_R3,MAKEUP_UDT.Total_Regular_R3) ,SUB(MAKEUP_UDT.Total_Regular_R1,PickRegular_R1,MAKEUP_UDT.Total_Regular_R1) ] ] ,XIC(UpdateComplete) [XIC(DropComplete) ,XIC(PickupComplete) ] ]OTE(UpdateComplete);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ADD_ON_INSTRUCTION_DEFINITION PWM (Description := "Pulse Width Modulation$N$N",
	                                   Revision := "1.0",
	                                   ExecutePrescan := No,
	                                   ExecutePostscan := No,
	                                   ExecuteEnableInFalse := No,
	                                   CreatedDate := "2008-01-17T20:43:00.720Z",
	                                   CreatedBy := "Not Available",
	                                   EditedDate := "2016-06-21T12:23:35.730Z",
	                                   EditedBy := "RA-INT\catrolli",
	                                   SoftwareRevision := "v16.04",
	                                   AdditionalHelpText := "This instruction can be used for Pulse Width Modulated output of a value (0...100). The tag is a DINT and only accepts whole numbers.$N$NA typical application might be a furnace using relay control for the heater (either ON or OFF). The CV output of a PID could be fed to the Input and will be converted to a BOOL output (OutputRelay), which could be tied to a discrete output module cycling a relay.$N$NThe instruction MUST be used in a Periodic Task, otherwise results will not be reliable. The actual length of the duty cycle is determined by the period of the task (lower period = faster cycle). Suggested task periods are 20ms...100ms.$N$NThe Invert input does what it says: when FALSE (0) an Input value of 85 into the PWM instruction will result in a duty cycle of 85% ON and 15% OFF. Setting Invert TRUE (1) will result in an output duty cycle of 85% OFF and 15% OFF. The inversion is linear throughout the range.$N$NInvert can be a tag or a constant (if you think this will never be used). OutputRelay can be defined as a module output tag.$N")
		PARAMETERS
			EnableIn : BOOL (Description := "Enable Input - System Defined Parameter",
			                    Usage := Input,
			                    RADIX := Decimal,
			                    Required := No,
			                    Visible := No,
			                    ExternalAccess := Read Only);
			EnableOut : BOOL (Description := "Enable Output - System Defined Parameter",
			                     Usage := Output,
			                     RADIX := Decimal,
			                     Required := No,
			                     Visible := No,
			                     ExternalAccess := Read Only);
			Input : DINT (Usage := Input,
			                 RADIX := Decimal,
			                 Required := Yes,
			                 Visible := Yes,
			                 DefaultData := 0);
			Invert : BOOL (Usage := Input,
			                  RADIX := Decimal,
			                  Required := Yes,
			                  Visible := Yes,
			                  DefaultData := 0);
			OutputRelay : BOOL (Usage := Output,
			                       RADIX := Decimal,
			                       Required := Yes,
			                       Visible := Yes,
			                       ExternalAccess := Read Only,
			                       DefaultData := 0);
		END_PARAMETERS

		LOCAL_TAGS
			DutyCycleOFF : DINT (RADIX := Decimal,
			                       ExternalAccess := Read/Write,
			                       DefaultData := 0);
			DutyCycleON : DINT (RADIX := Decimal,
			                      ExternalAccess := Read/Write,
			                      DefaultData := 0);
			CycleCounter : DINT (RADIX := Decimal,
			                       ExternalAccess := Read/Write,
			                       DefaultData := 0);
		END_LOCAL_TAGS

		ROUTINE Logic 
				N: GRT(Input,100)MOV(100,Input);
				N: LES(Input,0)MOV(0,Input);
				N: ADD(CycleCounter,1,CycleCounter)GRT(CycleCounter,100)CLR(CycleCounter);
				N: XIO(Invert)SUB(100,Input,DutyCycleOFF)MOV(Input,DutyCycleON);
				N: XIC(Invert)SUB(100,Input,DutyCycleON)MOV(Input,DutyCycleOFF);
				N: [XIO(Invert) LES(CycleCounter,DutyCycleON) ,XIC(Invert) GRT(CycleCounter,DutyCycleOFF) ]OTE(OutputRelay);
		END_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

