				N: XIC(Mapped.Point[13].Solenoid_On_Side_B)OTE(Raw_OutputArea[3].1);
				N: XIC(Mapped.Point[14].Solenoid_On_Side_A)OTE(Raw_OutputArea[3].2);
				N: XIC(Mapped.Point[14].Solenoid_On_Side_B)OTE(Raw_OutputArea[3].3);
				N: XIC(Mapped.Point[15].Solenoid_On_Side_A)OTE(Raw_OutputArea[3].4);
