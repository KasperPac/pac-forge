			            COMMENT[17] := "Strapping Machine$NFinal Tension Not able to be Reached, Continue Sequence Timer") := [[2322230,150,0],[2322736,500,0],[2322942,200,0],[2323274,350,0],[2327690,900,0],[2328686,250,0],[2335470,100,0],[2335975
					,500,0],[2336654,500,0],[2336760,100,0],[1898759,450,450],[2339714,2000,0],[2340940,500,0],[2349915,150,0],[2350121,200
					,0],[2350226,100,0],[2350733,500,0],[2335335,12000,0],[0,0,0],[0,0,0]];
			SM_STRAP_12KG_MIDDLE_VARIABLE : DINT (Description := "Strapping Machine:$NMiddle Strap Position$Nfor 12kg Ingot Bundles",
