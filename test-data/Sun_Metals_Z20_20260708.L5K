				    "FAULT BUBBLE OUT / STRAP JAM OR MISFEED$N"
				    "************************************************************";
				N: XIC(Machine_Control_ON)[[[XIC(Auto_Mode_Selected) ,XIC(Manual_Mode_Selected) ] XIO(BUBBLE_SENSOR) TON(Bubble_sensor_delay,?,?) XIC(Bubble_sensor_delay.DN) XIO(A01_IN00) XIC(O_Z20_FEED_O) ,XIC(Head_Service_Mode_Selected) XIO(BUBBLE_SENSOR) ] ,XIC(Fault_Bubble_Out) XIO(Head_Service_Mode_Selected) ]XIO(All_Cycle_Reset)OTE(Fault_Bubble_Out);
				RC: "************************************************************$N"
				    "FAULT FEED TIMEDOUT$N"
				    "************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Mode_Selected)[XIC(Max_Feed_A.DN) XIO(Head_Service_Mode_Selected) ,XIC(Fault_Feed_timedout) ]XIO(All_Cycle_Reset)OTE(Fault_Feed_timedout);
		END_ROUTINE

		ROUTINE File02_Head_Efficiency 
				N: [XIC(Z20_PSM_A.L[2]) ,XIC(EFF_A_ATT) ][ONS(EFF_A.OneShotAttempt) [ADD(EFF_A.Period_Cycle_Attempted,1,EFF_A.Period_Cycle_Attempted) ,ADD(EFF_A.Total_Cycle_Attempted,1,EFF_A.Total_Cycle_Attempted) ,MOV(EFF_A.Period_Cycle_Attempted,CYCLES_ATTEMPTED) ] ,XIO(Z20_PSM_A.L[7]) OTE(EFF_A_ATT) ];
				N: [XIC(Z20_PSM_A.L[30]) XIO(INTERLOCKS_IN[1].8) ,XIC(EFF_A_CMP) ][ONS(EFF_A.OneShotComplete) [ADD(EFF_A.Period_Cycle_Completed,1,EFF_A.Period_Cycle_Completed) ,[ADD(EFF_A.Total_Cycle_Completed,1,EFF_A.Total_Cycle_Completed) ,MOV(EFF_A.Total_Cycle_Completed,CYCLES_COMPLETED) ] ] ,XIO(Z20_PSM_A.L[7]) OTE(EFF_A_CMP) ];
				N: XIC(TIMEDATE[5].0)CPT(EFF_A.Period_Cycle_Efficiency,100*EFF_A.Period_Cycle_Completed/EFF_A.Period_Cycle_Attempted);
				N: XIC(TIMEDATE[5].0)CPT(EFF_A.Total_Cycle_Efficiency,100*EFF_A.Total_Cycle_Completed/EFF_A.Total_Cycle_Attempted);
				N: XIC(OFF)XIC(EFF_A.Total_Reset_PB)[CLR(EFF_A.Total_Cycle_Completed) ,CLR(EFF_A.Total_Cycle_Attempted) ];
				N: [XIC(EFF_A.Period_Reset_PB) ,XIC(HMI_CLEAR_CYCLE_TIMERS) ][CLR(EFF_A.Period_Cycle_Completed) ,CLR(EFF_A.Period_Cycle_Attempted) ];
				N: XIC(HMI_CLEAR_CYCLE_TIMERS)[MOV(0,CYCLES_COMPLETED) ,[MOV(0,CYCLES_ATTEMPTED) ,[MOV(0,EFF_A.Total_Cycle_Attempted) ,MOV(0,EFF_A.Period_Cycle_Completed) ,MOV(0,EFF_A.Total_Cycle_Completed) ] ] ];
				RC: "***********************************************$N"
				    "WELD COUNT VALUE$N"
				    "Note : Configured the first 4 inputs of IB16F Module as counter input & the remaining 12 inputs as point IOs.$N"
				    "***********************************************";
				N: MOV(Local:5:I.Counter00.Count,Local:5:I.Counter00.Count);
				RC: "***********************************************$N"
				    "Z20 HEAD WELD COUNT RESET$N"
				    "***********************************************";
				N: [XIC(WELD_COUNT_RESET) ,XIC(Manual_Mode_Selected) XIC(FAULT_RESET_ILPB) XIO(CYCLE_STOP_PB) ]OTE(Local:5:O.Counter00.Reset);
				RC: "***********************************************$N"
				    "Z20 HEAD POSITION STATUS $N"
				    "***********************************************";
				N: XIC(Z20_INDEX_POSITION)XIO(Z20_HOME_POSITION)MOV(1,Z20_Head_Position_Status);
				N: XIO(Z20_INDEX_POSITION)MOV(0,Z20_Head_Position_Status);
				N: XIC(Machine_Control_ON)[XIC(HMI_Vertical_Carrige_UP_Key) EQU(Z20_Head_Position_Status,1) ,XIC(Z20_Index_Open_Required) XIO(FAULT_RESET_ILPB) ]OTE(Z20_Index_Open_Required);
		END_ROUTINE

		ROUTINE File03_Z20_Head_IO 
				N: [XIC(Z20_PSM_A.L[5]) ,XIC(Z20_PSM_A.L[10]) ,XIC(Z20_PSM_A.L[12]) ,XIC(Z20_PSM_A.L[13]) ,XIC(Z20_PSM_A.L[14]) ,XIC(Z20_PSM_A.L[15]) ,XIC(Z20_PSM_A.L[16]) ,XIC(Z20_PSM_A.L[17]) ,XIC(Z20_PSM_A.L[32]) ,[[[XIC(MANUAL_A) ,XIC(Service_Mode_Selected) ] XIC(Head_Service_Mode_Selected) XIC(A01_IN14) ,XIC(Manual_Mode_Selected) XIC(HMI_TAKEUP) ] ,XIC(PV_data17) XIC(A05_01_Test_PB) ] XIC(A01_IN02) XIO(A01_IN01_Z20_Home) XIO(A01_IN05) ]XIC(A01_IN15)XIO(O_Z20_FEED_O)[XIO(MaxFeed_A) XIO(Max_Tkup_A.DN) OTE(O_Z20_TAKEUP_O) ,TON(Max_Tkup_A,?,?) ];
				N: [XIC(Z20_PSM_A.L[3]) ,XIC(Z20_PSM_A.L[29]) ,XIC(Z20_PSM_A.L[30]) ,XIC(Z20_RESET_A.L[6]) ,XIC(Z20_RESET_A.L[7]) ,[[[XIC(MANUAL_A) ,XIC(Head_Service_Mode_Selected) ] XIC(A01_IN13) XIC(Head_Service_Mode_Selected) ,XIC(Manual_Mode_Selected) XIC(HMI_FEED) ] XIO(A01_IN00) ,XIC(PV_data17) XIC(A05_00_Test_PB) ] XIC(A01_IN02) XIO(A01_IN01_Z20_Home) XIO(A01_IN05) ]XIC(A01_IN15)XIO(O_Z20_TAKEUP_O)[XIO(MaxFeed_A) XIO(Fault_Bubble_Out) OTE(O_Z20_FEED_O) ,TON(Max_Feed_A,?,?) ];
				N: [XIC(Z20_PSM_A.L[6]) ,XIC(Z20_PSM_A.L[7]) ,XIC(Z20_PSM_A.L[15]) ,XIC(Z20_PSM_A.L[16]) ,XIC(Z20_PSM_A.L[20]) ,XIC(Z20_PSM_A.L[21]) ,XIC(Z20_PSM_A.L[24]) ,XIC(Z20_PSM_A.L[25]) ,XIC(Z20_PSM_A.L[27]) ,XIC(Z20_PSM_A.L[28]) ,XIC(Z20_RESET_A.L[1]) ,XIC(Z20_RESET_A.L[2]) ,XIC(Z20_RESET_A.L[4]) ,XIC(Z20_RESET_A.L[5]) ,XIC(A05_02_Test_PB) XIC(PV_data17) ]XIC(A01_IN15)OTE(O_Z20_INDEX_O);
				N: [XIC(Z20_PSM_A.L[19]) ,XIC(Z20_PSM_A.L[20]) ,XIC(Z20_PSM_A.L[21]) ,XIC(Z20_PSM_A.L[22]) ,XIC(A05_03_Test_PB) XIC(PV_data17) ,XIC(A05_03_Test_PB) XIC(A01_IN02) XIO(A01_IN01_Z20_Home) ]XIC(A01_IN15)OTE(O_Z20_WELD_O);
				N: [XIC(Z20_PSM_A.L[13]) ,XIC(Z20_PSM_A.L[29]) ,XIC(Z20_RESET_A.L[6]) ,XIC(Z20_PSM_A.L[14]) ,XIC(Z20_PSM_A.L[15]) ,XIC(Z20_PSM_A.L[16]) ,XIC(Z20_PSM_A.L[17]) ,LIM(19,Z20_PSM_A.SP,27) ,XIC(A05_04_Test_PB) XIC(PV_data17) ]XIC(A01_IN15)OTE(O_Z20_WINDER_CLUCTH_CONTROL);
				N: [XIC(Z20_PSM_A.L[14]) ,XIC(Z20_PSM_A.L[15]) ,XIC(Z20_PSM_A.L[16]) ,XIC(Z20_PSM_A.L[17]) ,XIC(A05_06_Test_PB) XIC(PV_data17) ]XIC(A01_IN15)OTE(TENSION);
				N: [XIC(Z20_PSM_A.L[27]) ,XIC(Z20_PSM_A.L[19]) ,XIC(Z20_PSM_A.L[20]) ]OTE(WELD_COUNT_RESET);
				N: XIO(Flash_Off.DN)[TON(Flash_On,?,?) ,XIC(Flash_On.DN) TON(Flash_Off,?,?) ];
				N: XIO(Fast_Flash_Off.DN)[TON(Fast_Flash_On,?,?) ,XIC(Fast_Flash_On.DN) TON(Fast_Flash_Off,?,?) ];
				N: [XIC(A01_IN02) XIO(Fault_Bubble_Out) ,XIC(Fault_Bubble_Out) XIC(Fast_Flash_On.DN) ,XIC(Z20_WINDER_HOME) XIO(Fast_Flash_On.DN) ]EQU(0,Z20_PSM_A.SP)EQU(0,Z20_RESET_A.SP)OTE(O_HEAD_INDEX_LAMP);
				N: XIC(O_MACHINE_ON)OTE(A01_IN15);
				RC: "***************************************************$N"
				    "ENABLE SIGNAL TO TRAIC $N"
				    "***************************************************";
				N: [[XIC(O_Z20_FEED_O) ,XIC(O_Z20_TAKEUP_O) ] XIO(TENSION) ,XIC(TENSION) ]OTE(PWM_INPUT.0);
		END_ROUTINE

		ROUTINE File04_Z20_Index 
				N: [XIC(Z20_RESET_A.I00) XIO(Z20_RESET_A.I01) OTE(Z20_RESET_A.I00) ,XIC(Z20_RESET_A.I01) OTU(Z20_RESET_A.I01) ];
				N: OTE(Z20_RESET_A.L[0]);
				RC: "Initiate Head Index from Home Position";
				N: [XIC(Z20_RESET_A.L[0]) [[XIC(Manual_Mode_Selected) [XIC(MANUAL_A) ,XIC(HMI_INDEX) ] ,XIC(Service_Mode_Selected) XIC(SERVICE_INDEX_PB) ] XIO(A01_IN01_Z20_Home) XIO(Z20_RESET_A.I00) XIO(Z20_RESET_A.L[1]) MOV(1,Z20_RESET_A.SC) ,TON(Z20_RESET_A.T1[0],?,?) ,TON(Z20_RESET_A.T2[0],?,?) ,TON(Z20_RESET_A.TW[0],?,?) ] ,EQU(1,Z20_RESET_A.SP) OTE(Z20_RESET_A.L[1]) ];
				RC: "Moving to End Grip";
				N: [XIC(Z20_RESET_A.L[1]) [XIC(A01_IN02) XIO(Z20_RESET_A.I00) XIO(Z20_RESET_A.L[2]) MOV(2,Z20_RESET_A.SC) ,TON(Z20_RESET_A.T1[1],?,?) ,TON(Z20_RESET_A.T2[1],?,?) ,TON(Z20_RESET_A.TW[1],?,?) ] ,EQU(2,Z20_RESET_A.SP) OTE(Z20_RESET_A.L[2]) ];
				RC: "Reaches End Grip Position and Index is complete";
				N: [XIC(Z20_RESET_A.L[2]) [XIO(A01_IN02) XIO(Z20_RESET_A.I00) XIO(Z20_RESET_A.L[3]) MOV(3,Z20_RESET_A.SC) ,TON(Z20_RESET_A.T1[2],?,?) ,TON(Z20_RESET_A.T2[2],?,?) ,TON(Z20_RESET_A.TW[2],?,?) ] ,EQU(3,Z20_RESET_A.SP) OTE(Z20_RESET_A.L[3]) ];
				RC: "Start Single Head Index from not Home position";
				N: [XIC(Z20_RESET_A.L[0]) [[XIC(Manual_Mode_Selected) [XIC(MANUAL_A) ,XIC(HMI_INDEX) ] ,XIC(Service_Mode_Selected) XIC(SERVICE_INDEX_PB) ] XIC(A01_IN01_Z20_Home) XIO(Z20_RESET_A.I00) XIO(Z20_RESET_A.L[4]) MOV(4,Z20_RESET_A.SC) ,TON(Z20_RESET_A.T1[3],?,?) ,TON(Z20_RESET_A.T2[3],?,?) ,XIC(OFF) TON(Z20_RESET_A.TW[3],?,?) ] ,EQU(4,Z20_RESET_A.SP) OTE(Z20_RESET_A.L[4]) ];
				RC: "Single Indexing started";
				N: [XIC(Z20_RESET_A.L[4]) [XIC(A01_IN02) XIO(Z20_RESET_A.I00) XIO(Z20_RESET_A.L[5]) MOV(5,Z20_RESET_A.SC) ,TON(Z20_RESET_A.T1[4],?,?) ,TON(Z20_RESET_A.T2[4],?,?) ,TON(Z20_RESET_A.TW[4],?,?) ] ,EQU(5,Z20_RESET_A.SP) OTE(Z20_RESET_A.L[5]) ];
				RC: "Reaches Index Position from non home position";
				N: [XIC(Z20_RESET_A.L[5]) [[XIO(A01_IN02) ,XIO(A01_IN01_Z20_Home) ] XIO(Z20_RESET_A.I00) XIO(Z20_RESET_A.L[6]) MOV(6,Z20_RESET_A.SC) ,TON(Z20_RESET_A.T1[5],?,?) ,TON(Z20_RESET_A.T2[5],?,?) ,TON(Z20_RESET_A.TW[5],?,?) ] ,EQU(6,Z20_RESET_A.SP) OTE(Z20_RESET_A.L[6]) ];
				RC: "Fix High Tension Winder until it reaches home position";
				N: [XIC(Z20_RESET_A.L[6]) [XIO(A01_IN05) XIO(A01_IN01_Z20_Home) XIO(Z20_RESET_A.I00) XIO(Z20_RESET_A.L[7]) MOV(7,Z20_RESET_A.SC) ,TON(Z20_RESET_A.T1[6],?,?) ,TON(Z20_RESET_A.T2[6],?,?) ,TON(Z20_RESET_A.TW[6],?,?) ] ,EQU(7,Z20_RESET_A.SP) OTE(Z20_RESET_A.L[7]) ];
				RC: "Prefeed Strap after fixing winder";
				N: XIC(Z20_RESET_A.L[7])[XIC(Z20_RESET_A.T1[7].DN) XIO(Z20_RESET_A.I00) MOV(8,Z20_RESET_A.SC) ,TON(Z20_RESET_A.T1[7],?,?) ,TON(Z20_RESET_A.T2[7],?,?) ,TON(Z20_RESET_A.TW[7],?,?) ];
				N: [XIC(Z20_RESET_A.I03) ,XIC(Z20_RESET_A.L[3]) ,XIC(Z20_RESET_A.L[6]) XIC(A01_IN01_Z20_Home) ,GEQ(Z20_RESET_A.SP,8) ,XIO(A01_IN15) ,XIC(RESET_SEQ_A) ,XIC(PV_data17) ,NEQ(Z20_PSM_A.SP,0) ,XIC(SERVICE_INDEX_PB) XIC(Auto_Mode_Selected) ][CLR(Z20_RESET_A.SC) ,OTU(Z20_RESET_A.I03) ];
				N: MOV(Z20_RESET_A.SC,Z20_RESET_A.SP);
		END_ROUTINE

		ROUTINE File05_Z20_PSM 
				N: [XIC(Z20_PSM_A.I00) XIO(Z20_PSM_A.I01) OTE(Z20_PSM_A.I00) ,XIC(Z20_PSM_A.I01) OTU(Z20_PSM_A.I01) ];
				RC: "Do Nothing,";
				N: OTE(Z20_PSM_A.L[0]);
				RC: "Accept Initiating Signal";
				N: XIC(ESTOP_PILZ_OK)[XIC(Z20_PSM_A.L[0]) [XIC(AUTOMATIC_A) [XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) XIC(Single_Strap_Cycle_ON) XIO(A01_IN00) [XIC(Head_Cycle_Start_Signal) ,XIC(HMI_Single_Strap_PB) ] ,XIC(CYCLE_START_PB) XIC(Auto_Cycle_Start_ON_Latched) XIO(A01_IN00) XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) XIC(Always_Off) ] ONS(GEN_BOOL[41]) XIO(OUT_OFSTRAP_A.DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[1]) MOV(1,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[0],?,?) ,TON(Z20_PSM_A.T2[0],?,?) ,TON(Z20_PSM_A.TW[0],?,?) ] ,EQU(1,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[1]) ,OTL(Z32_Head_Step_0_HMI_display) ] ];
				RC: "Trigger other apparatus";
				N: [XIC(Z20_PSM_A.L[1]) [XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[2]) MOV(2,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[1],?,?) ,TON(Z20_PSM_A.T2[1],?,?) ,TON(Z20_PSM_A.TW[1],?,?) ,MOV(Z20_PSM_A.TW[1].ACC,Head_Step_1_Cycle_time) DIV(Head_Step_1_Cycle_time,1000,Head_Step_1_Cycle_time_sec) ] ,EQU(2,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[2]) ,OTL(Z32_Head_Step_1_HMI_display) ] ];
				RC: "Check winder is in Home Position, Check Sealer in Home Position";
				N: [XIC(Z20_PSM_A.L[2]) [XIO(A01_IN05) XIC(A01_IN02) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[3]) MOV(3,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[2],?,?) ,TON(Z20_PSM_A.T2[2],?,?) ,TON(Z20_PSM_A.TW[2],?,?) ,MOV(Z20_PSM_A.TW[2].ACC,Head_Step_2_Cycle_time) DIV(Head_Step_2_Cycle_time,1000,Head_Step_2_Cycle_time_sec) ] ,EQU(3,Z20_PSM_A.SP) XIC(BAYONET_EXTEND_POSITION_TIMER.DN) [OTE(Z20_PSM_A.L[3]) ,OTL(HMI_STATUS_ANVIL_CLOSED) ,OTL(Z32_Head_Step_2_HMI_display) ] ];
				RC: "High Speed Feed Strap";
				N: [XIC(Z20_PSM_A.L[3]) [[XIC(A01_IN00) ,XIC(FED_AUTOMATIC_A) ] XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[4]) MOV(4,Z20_PSM_A.SC) ,XIC(Backfeed_A) MOV(9,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[3],?,?) ,TON(Z20_PSM_A.T2[3],?,?) ,TON(Z20_PSM_A.TW[3],?,?) ,MOV(Z20_PSM_A.TW[3].ACC,MC_Step_4_Cycle_time) DIV(MC_Step_4_Cycle_time,1000,MC_Step_4_Cycle_time_in_sec) ,MOV(Z20_PSM_A.TW[3].ACC,Head_Step_3_Cycle_time) DIV(Head_Step_3_Cycle_time,1000,Head_Step_3_Cycle_time_sec) ] ,EQU(4,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[4]) ,OTL(HMI_STATUS_FAST_FEED) ,OTL(Z32_Head_Step_3_HMI_display) ] ];
				N: [XIC(Auto_Mode_Selected) ,XIC(Z20_PSM_A.L[3]) ]XIC(A01_IN00)OTL(FED_AUTOMATIC_A);
				N: [XIC(O_Z20_INDEX_O) ,[XIC(O_Z20_TAKEUP_O) XIO(Z20_PSM_A.L[5]) XIO(Z20_PSM_A.L[32]) XIO(Z20_PSM_A.L[33]) ,XIC(A01_IN05) ] ]OTU(FED_AUTOMATIC_A);
				RC: "Release Feed Contactor";
				N: [XIC(Z20_PSM_A.L[4]) [XIC(Z20_PSM_A.T1[4].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[5]) MOV(5,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[4],?,?) ,MOV(Z20_PSM_A.T1[4].PRE,Z20_PSM_A.T1[31].PRE) ,TON(Z20_PSM_A.T2[4],?,?) ,TON(Z20_PSM_A.TW[4],?,?) ,MOV(Z20_PSM_A.TW[4].ACC,MC_Step_5_Cycle_time) DIV(MC_Step_5_Cycle_time,1000,MC_Step_5_Cycle_time_in_sec) ,MOV(Z20_PSM_A.TW[4].ACC,Head_Step_4_Cycle_time) DIV(Head_Step_4_Cycle_time,1000,Head_Step_4_Cycle_time_sec) ] ,EQU(5,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[5]) ,OTL(HMI_STATUS_FEED_COMPLETE) ,OTL(Z32_Head_Step_4_HMI_display) ] ];
				RC: "Plug Feed Motor";
				N: [XIC(Z20_PSM_A.L[5]) [XIC(Z20_PSM_A.T1[5].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[6]) MOV(6,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[5],?,?) ,MOV(Z20_PSM_A.T1[5].PRE,Z20_PSM_A.T1[32].PRE) ,TON(Z20_PSM_A.T2[5],?,?) ,TON(Z20_PSM_A.TW[5],?,?) ,MOV(Z20_PSM_A.TW[5].ACC,Head_Step_5_Cycle_time) DIV(Head_Step_5_Cycle_time,1000,Head_Step_5_Cycle_time_sec) ] ,EQU(6,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[6]) ,OTL(Z32_Head_Step_5_HMI_display) ] ];
				RC: "Start End Grip";
				N: [XIC(Z20_PSM_A.L[6]) [XIC(A01_IN01_Z20_Home) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[7]) MOV(7,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[6],?,?) ,TON(Z20_PSM_A.T2[6],?,?) ,TON(Z20_PSM_A.TW[6],?,?) ,MOV(Z20_PSM_A.TW[6].ACC,MC_Step_6_Cycle_time) DIV(MC_Step_6_Cycle_time,1000,MC_Step_6_Cycle_time_in_sec) ,MOV(Z20_PSM_A.TW[6].ACC,Head_Step_6_Cycle_time) DIV(Head_Step_6_Cycle_time,1000,Head_Step_6_Cycle_time_sec) ] ,EQU(7,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[7]) ,OTL(Z32_Head_Step_6_HMI_display) ] ];
				RC: "End Grip";
				N: [XIC(Z20_PSM_A.L[7]) [XIO(A01_IN02) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[8]) MOV(8,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[7],?,?) ,TON(Z20_PSM_A.T2[7],?,?) ,TON(Z20_PSM_A.TW[7],?,?) ,MOV(Z20_PSM_A.TW[7].ACC,Head_Step_7_Cycle_time) DIV(Head_Step_7_Cycle_time,1000,Head_Step_7_Cycle_time_sec) ] ,EQU(8,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[8]) ,OTL(HMI_STATUS_END_GRIP) ,OTL(Z32_Head_Step_7_HMI_display) ] ];
				RC: "Wait for Take-up start instruction - No wait for this head";
				N: [XIC(Z20_PSM_A.L[8]) [XIC(Auto_Vert_Carriage_On_Bundle) XIC(Z20_PSM_A.T1[8].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[9]) MOV(12,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[8],?,?) ,TON(Z20_PSM_A.T2[8],?,?) ,TON(Z20_PSM_A.TW[8],?,?) ,MOV(Z20_PSM_A.TW[8].ACC,Head_Step_8_Cycle_time) DIV(Head_Step_8_Cycle_time,1000,Head_Step_8_Cycle_time_sec) ] ,EQU(9,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[9]) ,OTL(Z32_Head_Step_8_HMI_display) ] ];
				RC: "Stop Feed (Out of strap), wait for contactor to drop out";
				N: [XIC(Z20_PSM_A.L[9]) [XIC(Z20_PSM_A.T1[9].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[10]) MOV(10,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[9],?,?) ,TON(Z20_PSM_A.T2[9],?,?) ,TON(Z20_PSM_A.TW[9],?,?) ,MOV(Z20_PSM_A.TW[9].ACC,Head_Step_9_Cycle_time) DIV(Head_Step_9_Cycle_time,1000,Head_Step_9_Cycle_time_sec) ] ,EQU(10,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[10]) ,OTL(Z32_Head_Step_9_HMI_display) ] ];
				RC: "Back feed to get strap out of chutes";
				N: [XIC(Z20_PSM_A.L[10]) [XIC(Z20_PSM_A.T1[10].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[11]) MOV(31,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[10],?,?) ,TON(Z20_PSM_A.T2[10],?,?) ,TON(Z20_PSM_A.TW[10],?,?) ,MOV(Z20_PSM_A.TW[10].ACC,Head_Step_10_Cycle_time) DIV(Head_Step_10_Cycle_time,1000,Head_Step_10_Cycle_time_sec) ] ,EQU(11,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[11]) ,OTL(Z32_Head_Step_10_HMI_dsplay) ] ];
				RC: "Trigger Tension Cycle";
				N: [XIC(Z20_PSM_A.L[11]) [XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[12]) MOV(12,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[11],?,?) ,TON(Z20_PSM_A.T2[11],?,?) ,TON(Z20_PSM_A.TW[11],?,?) ,MOV(Z20_PSM_A.TW[11].ACC,Head_Step_11_Cycle_time) DIV(Head_Step_11_Cycle_time,1000,Head_Step_11_Cycle_time_sec) ] ,EQU(12,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[12]) ,OTL(Z32_Head_Step_11_HMI_dsplay) ] ];
				RC: "High Speed Take up Strap";
				N: [XIC(Z20_PSM_A.L[12]) [[XIC(Z20_PSM_A.T1[12].DN) ,XIC(Z20_PSM_A.T2[12].DN) ] XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[13]) MOV(13,Z20_PSM_A.SC) ,XIC(A01_IN04) XIC(GEN_COUNT[1].DN) TON(Z20_PSM_A.T1[12],?,?) ,XIO(A01_IN04) XIC(GEN_COUNT[1].DN) TON(Z20_PSM_A.T2[12],?,?) ,TON(Z20_PSM_A.TW[12],?,?) ,XIC(A01_IN04) CTU(GEN_COUNT[1],?,?) ,MOV(Z20_PSM_A.TW[12].ACC,MC_Step_8_Cycle_time) DIV(MC_Step_8_Cycle_time,1000,MC_Step_8_Cycle_time_in_sec) ,MOV(Z20_PSM_A.TW[12].ACC,Head_Step_12_Cycle_time) DIV(Head_Step_12_Cycle_time,1000,Head_Step_12_Cycle_time_sec) ] ,EQU(13,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[13]) ,OTL(HMI_STATUS_TAKE_UP) ,OTL(Z32_Head_Step_12_HMI_dsplay) ] ];
				N: [XIO(Z20_PSM_A.L[12]) ,XIO(A01_IN15) ]RES(GEN_COUNT[1]);
				RC: "Engage High Tension Clutch = Full Power";
				N: [XIC(Z20_PSM_A.L[13]) [XIC(A01_IN05) XIC(Z20_PSM_A.T1[13].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[14]) MOV(14,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[13],?,?) ,TON(Z20_PSM_A.T2[13],?,?) ,TON(Z20_PSM_A.TW[13],?,?) ,MOV(Z20_PSM_A.TW[13].ACC,MC_Step_9_Cycle_time) DIV(MC_Step_9_Cycle_time,1000,MC_Step_9_Cycle_time_in_sec) ,MOV(Z20_PSM_A.TW[13].ACC,Head_Step_13_Cycle_time) DIV(Head_Step_13_Cycle_time,1000,Head_Step_13_Cycle_time_sec) ] ,EQU(14,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[14]) ,OTL(Bayonet_To_Retrive) ,OTL(HMI_STATUS_STRAP_CUT_WELD) ,OTL(Z32_Head_Step_13_HMI_dsplay) ] ];
				RC: "Engage High Tension Clutch = Control Power";
				N: [XIC(Z20_PSM_A.L[14]) [XIC(Z20_PSM_A.T1[14].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[15]) MOV(15,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[14],?,?) ,TON(Z20_PSM_A.T2[14],?,?) ,TON(Z20_PSM_A.TW[14],?,?) ,MOV(Z20_PSM_A.TW[14].ACC,Head_Step_14_Cycle_time) DIV(Head_Step_14_Cycle_time,1000,Head_Step_14_Cycle_time_sec) ] ,EQU(15,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[15]) ,OTL(Z32_Head_Step_14_HMI_dsplay) ] ];
				RC: "Start Loop Grip";
				N: [XIC(Z20_PSM_A.L[15]) [XIC(A01_IN02) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[16]) MOV(16,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[15],?,?) ,TON(Z20_PSM_A.T2[15],?,?) ,TON(Z20_PSM_A.TW[15],?,?) ,MOV(Z20_PSM_A.TW[15].ACC,Head_Step_15_Cycle_time) DIV(Head_Step_15_Cycle_time,1000,Head_Step_15_Cycle_time_sec) ] ,EQU(16,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[16]) ,OTL(Z32_Head_Step_15_HMI_dsplay) ] ];
				RC: "At Loop Grip";
				N: [XIC(Z20_PSM_A.L[16]) [XIO(A01_IN02) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[17]) MOV(17,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[16],?,?) ,TON(Z20_PSM_A.T2[16],?,?) ,TON(Z20_PSM_A.TW[16],?,?) ,MOV(Z20_PSM_A.TW[16].ACC,Head_Step_16_Cycle_time) DIV(Head_Step_16_Cycle_time,1000,Head_Step_16_Cycle_time_sec) ] ,EQU(17,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[17]) ,OTL(Z32_Head_Step_16_HMI_dsplay) ] ];
				RC: "Loop Gripped Release Tension";
				N: [XIC(Z20_PSM_A.L[17]) [XIO(A01_IN02) XIC(Z20_PSM_A.T1[17].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[18]) MOV(18,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[17],?,?) ,TON(Z20_PSM_A.T2[17],?,?) ,TON(Z20_PSM_A.TW[17],?,?) ,MOV(Z20_PSM_A.TW[17].ACC,Head_Step_17_Cycle_time) DIV(Head_Step_17_Cycle_time,1000,Head_Step_17_Cycle_time_sec) ] ,EQU(18,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[18]) ,OTL(Z32_Head_Step_17_HMI_dsplay) ] ];
				RC: "Do Nothing";
				N: [XIC(Z20_PSM_A.L[18]) [XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[19]) MOV(19,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[18],?,?) ,TON(Z20_PSM_A.T2[18],?,?) ,TON(Z20_PSM_A.TW[18],?,?) ,MOV(Z20_PSM_A.TW[18].ACC,Head_Step_18_Cycle_time) DIV(Head_Step_18_Cycle_time,1000,Head_Step_18_Cycle_time_sec) ] ,EQU(19,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[19]) ,OTL(Z32_Head_Step_18_HMI_dsplay) ] ];
				RC: "Start Weld Motor";
				N: [XIC(Z20_PSM_A.L[19]) [XIC(Z20_PSM_A.T1[19].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[20]) MOV(20,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[19],?,?) ,TON(Z20_PSM_A.T2[19],?,?) ,TON(Z20_PSM_A.TW[19],?,?) ,MOV(Z20_PSM_A.TW[19].ACC,Head_Step_19_Cycle_time) DIV(Head_Step_19_Cycle_time,1000,Head_Step_19_Cycle_time_sec) ] ,EQU(20,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[20]) ,OTL(Z32_Head_Step_19_HMI_dsplay) ] ];
				RC: "Go to Weld Position";
				N: [XIC(Z20_PSM_A.L[20]) [XIC(A01_IN02) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[21]) MOV(21,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[20],?,?) ,TON(Z20_PSM_A.T2[20],?,?) ,TON(Z20_PSM_A.TW[20],?,?) ,MOV(Z20_PSM_A.TW[20].ACC,Head_Step_20_Cycle_time) DIV(Head_Step_20_Cycle_time,1000,Head_Step_20_Cycle_time_sec) ] ,EQU(21,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[21]) ,OTL(Z32_Head_Step_20_HMI_dsplay) ] ];
				RC: "At Weld Position";
				N: [XIC(Z20_PSM_A.L[21]) [XIO(A01_IN02) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[22]) MOV(22,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[21],?,?) ,TON(Z20_PSM_A.T2[21],?,?) ,TON(Z20_PSM_A.TW[21],?,?) ,MOV(Z20_PSM_A.TW[21].ACC,Head_Step_21_Cycle_time) DIV(Head_Step_21_Cycle_time,1000,Head_Step_21_Cycle_time_sec) ] ,EQU(22,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[22]) ,OTL(Z32_Head_Step_21_HMI_dsplay) ] ];
				RC: "Weld for Time or Count Value";
				N: [XIC(Z20_PSM_A.L[22]) [[GEQ(Local:5:I.Counter00.Count,500) ,XIC(Z20_PSM_A.T1[22].DN) ] XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[23]) MOV(23,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[22],?,?) ,TON(Z20_PSM_A.T2[22],?,?) ,TON(Z20_PSM_A.TW[22],?,?) ,MOV(Z20_PSM_A.TW[22].ACC,Head_Step_22_Cycle_time) DIV(Head_Step_22_Cycle_time,1000,Head_Step_22_Cycle_time_sec) ] ,EQU(23,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[23]) ,OTL(Z32_Head_Step_22_HMI_dsplay) ] ];
				N: XIC(Z20_PSM_A.L[22])MOV(Z20_PSM_A.T1[22].ACC,TIMETRAP);
				RC: "Cool for Time";
				N: [XIC(Z20_PSM_A.L[23]) [XIC(Z20_PSM_A.T1[23].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[24]) MOV(24,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[23],?,?) ,TON(Z20_PSM_A.T2[23],?,?) ,TON(Z20_PSM_A.TW[23],?,?) ,MOV(Z20_PSM_A.TW[23].ACC,Head_Step_23_Cycle_time) DIV(Head_Step_23_Cycle_time,1000,Head_Step_23_Cycle_time_sec) ] ,EQU(24,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[24]) ,OTL(Z32_Head_Step_23_HMI_dsplay) ] ];
				RC: "Start Anvil Open";
				N: [XIC(Z20_PSM_A.L[24]) [XIC(A01_IN02) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[25]) MOV(25,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[24],?,?) ,TON(Z20_PSM_A.T2[24],?,?) ,TON(Z20_PSM_A.TW[24],?,?) ,MOV(Z20_PSM_A.TW[24].ACC,MC_Step_11_Cycle_time) DIV(MC_Step_11_Cycle_time,1000,MC_Step_11_Cycle_time_in_sec) ,MOV(Z20_PSM_A.TW[24].ACC,Head_Step_24_Cycle_time) DIV(Head_Step_24_Cycle_time,1000,Head_Step_24_Cycle_time_sec) ] ,EQU(25,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[25]) ,OTL(HMI_STATUS_ANVIL_OPEN) ,OTL(Z32_Head_Step_24_HMI_dsplay) ] ];
				RC: "At Anvil Open Position";
				N: [XIC(Z20_PSM_A.L[25]) [XIO(A01_IN02) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[26]) MOV(26,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[25],?,?) ,TON(Z20_PSM_A.T2[25],?,?) ,TON(Z20_PSM_A.TW[25],?,?) ,MOV(Z20_PSM_A.TW[25].ACC,Head_Step_25_Cycle_time) DIV(Head_Step_25_Cycle_time,1000,Head_Step_25_Cycle_time_sec) ] ,EQU(26,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[26]) ,OTL(Head_To_Retrive_Permission) ,OTL(Z32_Head_Step_25_HMI_dsplay) ] ];
				RC: "Lift Head up";
				N: [XIC(Z20_PSM_A.L[26]) [XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) XIC(Z20_PSM_A.T1[26].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[27]) MOV(27,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[26],?,?) ,TON(Z20_PSM_A.T2[26],?,?) ,TON(Z20_PSM_A.TW[26],?,?) ,MOV(Z20_PSM_A.TW[26].ACC,Head_Step_26_Cycle_time) DIV(Head_Step_26_Cycle_time,1000,Head_Step_26_Cycle_time_sec) ] ,EQU(27,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[27]) ,OTL(Z32_Head_Step_26_HMI_dsplay) ] ];
				RC: "Start Close Anvil";
				N: [XIC(Z20_PSM_A.L[27]) [XIC(A01_IN02) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[28]) MOV(28,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[27],?,?) ,TON(Z20_PSM_A.T2[27],?,?) ,TON(Z20_PSM_A.TW[27],?,?) ,MOV(Z20_PSM_A.TW[27].ACC,MC_Step_13_Cycle_time) DIV(MC_Step_13_Cycle_time,1000,MC_Step_13_Cycle_time_in_sec) ,MOV(Z20_PSM_A.TW[27].ACC,Head_Step_27_Cycle_time) DIV(Head_Step_27_Cycle_time,1000,Head_Step_27_Cycle_time_sec) ] ,EQU(28,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[28]) ,OTL(HMI_STATUS_ANVIL_CLOSED_AT_END) ,OTL(Z32_Head_Step_27_HMI_dsplay) ] ];
				RC: "Anvil Closed, Home Position";
				N: [XIC(Z20_PSM_A.L[28]) [XIO(A01_IN01_Z20_Home) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[29]) MOV(29,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[28],?,?) ,TON(Z20_PSM_A.T2[28],?,?) ,TON(Z20_PSM_A.TW[28],?,?) ,MOV(Z20_PSM_A.TW[28].ACC,Head_Step_28_Cycle_time) DIV(Head_Step_28_Cycle_time,1000,Head_Step_28_Cycle_time_sec) ] ,EQU(29,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[29]) ,OTL(Z32_Head_Step_28_HMI_dsplay) ] ];
				RC: "Fix High Tension Winder to Home Position";
				N: [XIC(Z20_PSM_A.L[29]) [XIO(A01_IN05) XIC(Z20_PSM_A.T1[29].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[30]) MOV(30,Z20_PSM_A.SC) ,XIO(A01_IN05) TON(Z20_PSM_A.T1[29],?,?) ,TON(Z20_PSM_A.T2[29],?,?) ,TON(Z20_PSM_A.TW[29],?,?) ,MOV(Z20_PSM_A.TW[29].ACC,Head_Step_29_Cycle_time) DIV(Head_Step_29_Cycle_time,1000,Head_Step_29_Cycle_time_sec) ] ,EQU(30,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[30]) ,OTE(Prefeed_Bypass) ,OTL(Z32_Head_Step_29_HMI_dsplay) ] ];
				RC: "Prefeed Strap";
				N: [XIC(Z20_PSM_A.L[30]) [XIC(AUTOMATIC_A) [XIC(A01_IN00) ,XIC(Z20_PSM_A.L[30]) ] XIC(Z20_PSM_A.T1[30].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[31]) MOV(31,Z20_PSM_A.SC) ,XIC(Backfeed_A) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[9]) MOV(9,Z20_PSM_A.SC) ,[XIC(MANUAL_A) ,XIC(Manual_Mode_Selected) ] XIC(Z20_PSM_A.T1[30].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[33]) MOV(33,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[30],?,?) ,TON(Z20_PSM_A.T2[30],?,?) ,TON(Z20_PSM_A.TW[30],?,?) ,MOV(Z20_PSM_A.TW[30].ACC,Head_Step_30_Cycle_time) DIV(Head_Step_30_Cycle_time,1000,Head_Step_30_Cycle_time_sec) ] ,EQU(31,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[31]) ,OTL(Z32_Head_Step_30_HMI_dsplay) ] ];
				RC: "Release Feed Contactor";
				N: [XIC(Z20_PSM_A.L[31]) [XIC(Z20_PSM_A.T1[31].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[32]) MOV(32,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[31],?,?) ,TON(Z20_PSM_A.T2[31],?,?) ,TON(Z20_PSM_A.TW[31],?,?) ,MOV(Z20_PSM_A.TW[31].ACC,Head_Step_31_Cycle_time) DIV(Head_Step_31_Cycle_time,1000,Head_Step_31_Cycle_time_sec) ] ,EQU(32,Z20_PSM_A.SP) OTE(Z20_PSM_A.L[32]) ];
				RC: "Plug Feed Motor";
				N: [XIC(Z20_PSM_A.L[32]) [XIC(Z20_PSM_A.T1[32].DN) XIO(Z20_PSM_A.I00) XIO(Z20_PSM_A.L[33]) MOV(33,Z20_PSM_A.SC) ,TON(Z20_PSM_A.T1[32],?,?) ,TON(Z20_PSM_A.T2[32],?,?) ,TON(Z20_PSM_A.TW[32],?,?) ,MOV(Z20_PSM_A.TW[32].ACC,Head_Step_32_Cycle_time) DIV(Head_Step_32_Cycle_time,1000,Head_Step_32_Cycle_time_sec) ] ,EQU(33,Z20_PSM_A.SP) [OTE(Z20_PSM_A.L[33]) ,OTL(Head_Cycle_Complete) ] ];
				N: [XIC(Z20_PSM_A.I03) ,XIC(Z20_PSM_A.L[33]) ,XIO(A01_IN15) ,XIC(Z20_PSM_A.TW[3].DN) ,XIC(Z20_PSM_A.TW[13].DN) ,XIC(Z20_PSM_A.TW[29].DN) ,XIC(Z20_PSM_A.TW[30].DN) ,XIC(RESET_SEQ_A) ,XIC(PV_data17) ,[XIC(SERVICE_INDEX_PB) ,XIC(INTERLOCKS_IN[1].8) ] XIC(Auto_Mode_Selected) ,XIC(PV_Hdata[1].Fault_active) XIO(PV_Hdata[1].Fault_active) ,XIC(FAULT_RESET_ILPB) ][CLR(Z20_PSM_A.SC) ,OTU(Z20_PSM_A.I03) ];
				N: MOV(Z20_PSM_A.SC,Z20_PSM_A.SP);
				N: [XIC(Z20_PSM_A.L[3]) ,XIC(Z20_PSM_A.L[30]) ]TON(Feed_Time_A,?,?);
				N: LES(Feed_Time_A.ACC,Strap_Enough_Time[1])XIC(OUT_OFSTRAP_A.DN)XIC(Backfeed_A)OTE(Backfeed_A);
		END_ROUTINE

		ROUTINE File06_Bayonet 
				RC: "**********************************************$N"
				    "BAYONET POSITION STATUS$N"
				    "0 : Bayonet at Extend Postion$N"
				    "1 : Bayonet at Retract position$N"
				    "2 : Bayonet forward cmd on$N"
				    "3 : Bayonet Reverse cmd On $N"
				    "4 : Bayonet Fault present $N"
				    "************************************************";
				N: XIC(Always_On)[XIC(BAYONET_AT_EXTEND_POSITION) MOV(0,BAYONET_MODE_STATUS_WORD) ,XIC(BAYONET_AT_RETRACT_POSITION) MOV(1,BAYONET_MODE_STATUS_WORD) ,XIC(Bayonet:O.Forward) MOV(2,BAYONET_MODE_STATUS_WORD) ,XIC(Bayonet:O.Reverse) MOV(4,BAYONET_MODE_STATUS_WORD) ,XIC(Bayonet:I.Faulted) MOV(5,BAYONET_MODE_STATUS_WORD) ];
				RC: "  #########################################################  $N"
				    "BAYONET EXTEND SENSOR DELAY$N"
				    "#########################################################";
				N: XIC(BAYONET_AT_EXTEND_POSITION)TON(BAYONET_EXTEND_POSITION_TIMER,?,?);
				RC: "  #########################################################  $N"
				    "BAYONET RETRACT SENSOR DELAY$N"
				    "#########################################################";
				N: XIC(BAYONET_AT_RETRACT_POSITION)TON(BAYONET_RETRACT_POSITION_TIMER,?,?);
				RC: "  #########################################################  $N"
				    "BAYONET REVERSE INTERLOCK $N"
				    "#########################################################";
				N: XIC(BAYONET_MOTOR_HEALTHY)XIO(BAYONET_RETRACT_POSITION_TIMER.DN)XIC(BAYONET_LOCKPIN)XIO(Fault_Bayonet_REV_Action)OTE(Bayonet_REV_IL);
				RC: "  #########################################################  $N"
				    "BAYONET FORWARD INTERLOCK $N"
				    "#########################################################";
				N: XIC(BAYONET_MOTOR_HEALTHY)XIO(BAYONET_PATH_CLEAR_1_SENSOR)XIO(BAYONET_PATH_CLEAR_2_SENSOR)XIO(BAYONET_EXTEND_POSITION_TIMER.DN)XIC(BAYONET_LOCKPIN)XIC(Sunmetals_to_Signode_Conveyor_Stopped)[XIC(Horizontial_Carriage_At_Strap_Position_1) ,[XIC(Horizontial_Carriage_At_Strap_Position_2) ,XIC(Horizontial_Carriage_At_Strap_Position_3) ,XIC(Horizontial_Carriage_At_Strap_Position_4) ] ]XIO(Fault_Bayonet_Fwd_Action)OTE(Bayonet_FWD_IL);
				RC: "  #########################################################  $N"
				    "BAYONET MANUAL MODE FORWARD$N"
				    "#########################################################";
				N: [XIC(Manual_Mode_Selected) XIC(HMI_Bayonet_FWD_Key) ,XIC(Auto_Mode_Selected) XIC(Auto_Bayonet_FWD_CMD) ]XIO(Bayonet_REV_CMD_Bit)XIC(Bayonet_FWD_IL)OTE(Bayonet_Fwd_CMD_Bit);
				RC: "  #########################################################  $N"
				    "BAYONET MANUAL MODE REVERSE$N"
				    "#########################################################";
				N: [XIC(Manual_Mode_Selected) [XIC(HMI_Bayonet_REV_Key) ,XIC(Machine_Homing_Started) ] ,XIC(Auto_Mode_Selected) XIC(Auto_Bayonet_REV_CMD) ]XIO(Bayonet_Fwd_CMD_Bit)XIC(Bayonet_REV_IL)OTE(Bayonet_REV_CMD_Bit);
				RC: "  #########################################################  $N"
				    "AUTO BAYONET FWD CMD$N"
				    "#########################################################";
				N: XIC(Auto_Mode_Selected)XIC(Single_Strap_Cycle_ON)XIO(FAULT_BAYONET_PATH_NOT_CLEAR)XIO(Auto_Bayonet_AT_EXTEND_POSITION)[OTE(Auto_Bayonet_FWD_CMD) ,OTL(Auto_Bayonet_FWD_HMI_deplay) ,TON(MC_Step_3_cycle_timer,?,?) ,MOV(MC_Step_3_cycle_timer.ACC,MC_Step_3_Cycle_time) DIV(MC_Step_3_Cycle_time,1000,MC_Step_3_Cycle_time_in_sec) ];
				N: XIC(Auto_Mode_Selected)XIC(Single_Strap_Cycle_ON)XIC(BAYONET_EXTEND_POSITION_TIMER.DN)OTL(Auto_Bayonet_AT_EXTEND_POSITION);
				RC: "  #########################################################  $N"
				    "AUTO BAYONET REV CMD$N"
				    "#########################################################";
				N: XIC(Auto_Mode_Selected)XIC(Single_Strap_Cycle_ON)XIC(Auto_Bayonet_AT_EXTEND_POSITION)[XIC(Head_To_Retrive_Permission) ,XIC(Bayonet_To_Retrive) ][OTE(Auto_Bayonet_REV_CMD) ,TON(MC_Step_10_cycle_timer,?,?) ,MOV(MC_Step_10_cycle_timer.ACC,MC_Step_10_Cycle_time) DIV(MC_Step_10_Cycle_time,1000,MC_Step_10_Cycle_time_in_sec) ];
				RC: "  #########################################################  $N"
				    "BAYONET FWD SPEED CHANGE LOGIC$N"
				    "#########################################################";
				N: XIC(Bayonet_Fwd_CMD_Bit)XIC(BAYONET_FWD_SLOW_SPEED)OTL(Bayonet_FWD_Slow_Speed_Bit);
				N: [XIC(BAYONET_AT_EXTEND_POSITION) ,XIC(BAYONET_AT_RETRACT_POSITION) ,XIC(FAULT_RESET_ILPB) ]TON(Fwd_Slow_Speed_reset_timer,?,?)XIC(Fwd_Slow_Speed_reset_timer.DN)OTU(Bayonet_FWD_Slow_Speed_Bit);
				RC: "  #########################################################  $N"
				    "BAYONET REV SPEED CHANGE LOGIC$N"
				    "#########################################################";
				N: XIC(Bayonet_REV_CMD_Bit)XIC(BAYONET_REV_SLOW_SPEED)OTL(Bayonet_REV_Slow_Speed_Bit);
				N: [XIC(BAYONET_AT_EXTEND_POSITION) ,XIC(BAYONET_AT_RETRACT_POSITION) ,XIC(FAULT_RESET_ILPB) ]TON(Rev_Slow_Speed_reset_timer,?,?)XIC(Rev_Slow_Speed_reset_timer.DN)OTU(Bayonet_REV_Slow_Speed_Bit);
				RC: "#########################################################$N"
				    "BAYONET $N"
				    "OUTPUT BITS$N"
				    "#########################################################";
				N: XIC(Machine_Control_ON)XIC(Bayonet_Fwd_CMD_Bit)OTE(Bayonet:O.Forward);
				N: XIC(Machine_Control_ON)XIC(Bayonet_REV_CMD_Bit)OTE(Bayonet:O.Reverse);
				N: XIC(Machine_Control_ON)[XIC(Bayonet_Fwd_CMD_Bit) ,XIC(Bayonet_REV_CMD_Bit) ]OTE(Bayonet:O.Start);
				N: XIC(Machine_Control_ON)XIO(Bayonet:O.Start)OTE(Bayonet:O.Stop);
				N: XIC(Machine_Control_ON)[XIC(Bayonet:O.Start) XIC(Bayonet_Fwd_CMD_Bit) [XIO(Bayonet_FWD_Slow_Speed_Bit) MOV(2750,Bayonet:O.FreqCommand) ,XIC(Bayonet_FWD_Slow_Speed_Bit) MOV(200,Bayonet:O.FreqCommand) ] ,XIC(Bayonet:O.Start) XIC(Bayonet_REV_CMD_Bit) [XIO(Bayonet_REV_Slow_Speed_Bit) MOV(2400,Bayonet:O.FreqCommand) ,XIC(Bayonet_REV_Slow_Speed_Bit) MOV(300,Bayonet:O.FreqCommand) ] ];
				N: [XIC(Machine_Control_ON) XIC(Bayonet:I.Faulted) XIO(All_Cycle_Reset) ,XIC(CONTROL_ON_TIMER.TT) ]OTE(Bayonet:O.ClearFaults);
				RC: "#########################################################$N"
				    "ALARMS$N"
				    "#########################################################";
				N: [XIO(BAYONET_MOTOR_HEALTHY) ,XIC(FAULT_BAYONET_MOTOR_MPCB_TRIP) ]XIO(All_Cycle_Reset)OTE(FAULT_BAYONET_MOTOR_MPCB_TRIP);
				N: XIC(Machine_Control_ON)XIO(FAULT_SAFETY_DOOR_OPEN)XIO(Bayonet_REV_CMD_Bit)[XIC(Auto_Mode_Selected) XIC(Auto_Bayonet_FWD_CMD) ,XIC(Manual_Mode_Selected) ]XIO(BAYONET_AT_EXTEND_POSITION)[XIC(Horizontial_Carriage_At_Strap_Position_1) ,XIC(Horizontial_Carriage_At_Strap_Position_2) ,XIC(Horizontial_Carriage_At_Strap_Position_3) ,XIC(Horizontial_Carriage_At_Strap_Position_4) ][XIC(BAYONET_PATH_CLEAR_1_SENSOR) ,XIC(BAYONET_PATH_CLEAR_2_SENSOR) ]TON(Clear_delay_alarm,?,?)XIC(Clear_delay_alarm.DN)OTL(FAULT_BAYONET_PATH_NOT_CLEAR);
				N: [XIO(Horizontial_Carriage_At_Strap_Position_1) XIO(Horizontial_Carriage_At_Strap_Position_2) XIO(Horizontial_Carriage_At_Strap_Position_3) XIO(Horizontial_Carriage_At_Strap_Position_4) ,XIC(FAULT_RESET_ILPB) ]OTU(FAULT_BAYONET_PATH_NOT_CLEAR);
				N: [XIC(BAYONET_AT_RETRACT_POSITION) XIC(BAYONET_AT_EXTEND_POSITION) ,XIC(FAULT_BAYONET_SENSORS_FAULTY) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_BAYONET_SENSORS_FAULTY);
				N: [XIO(BAYONET_LOCKPIN) TON(time_7,?,?) ,XIC(FAULT_BAYONET_LOCKPIN_REMOVED) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)[OTE(FAULT_BAYONET_LOCKPIN_REMOVED) ,TON(Bayonet_Lockpin_Removed_Timer,?,?) ];
				N: [XIC(Bayonet:I.Faulted) ,XIC(Fault_Bayonet_Drive) ]XIO(All_Cycle_Reset)XIC(SAFESTOP_PILZ_FB)TON(Fault_bayonet_display_delay,?,?)XIC(Fault_bayonet_display_delay.DN)OTE(Fault_Bayonet_Drive);
				N: XIC(Machine_Control_ON)[XIC(Bayonet:O.Forward) XIO(BAYONET_AT_EXTEND_POSITION) ,XIC(Fault_Bayonet_Fwd_Action) ]XIO(All_Cycle_Reset)[TON(Bayonet_Fwd_Action_Sensor_Fault_Timer,?,?) ,XIC(Bayonet_Fwd_Action_Sensor_Fault_Timer.DN) OTE(Fault_Bayonet_Fwd_Action) ];
				N: XIC(Machine_Control_ON)[XIC(Bayonet:O.Reverse) XIO(BAYONET_AT_RETRACT_POSITION) ,XIC(Fault_Bayonet_REV_Action) ]XIO(All_Cycle_Reset)[TON(Bayonet_Rev_Action_Sensor_Fault_Timer,?,?) ,XIC(Bayonet_Rev_Action_Sensor_Fault_Timer.DN) OTE(Fault_Bayonet_REV_Action) ];
				RC: "  #########################################################  $N"
				    "BAYONET COMMON FAULT$N"
				    "#########################################################";
				N: [XIC(FAULT_BAYONET_MOTOR_MPCB_TRIP) ,XIC(Fault_Bayonet_Drive) ,XIC(Fault_Bayonet_Fwd_Action) ,XIC(Fault_Bayonet_REV_Action) ,XIC(FAULT_BAYONET_LOCKPIN_REMOVED) ]OTL(Bayonet_Fault);
				N: XIC(All_Cycle_Reset)OTU(Bayonet_Fault);
		END_ROUTINE

		ROUTINE File07_Dispenser_1 
				RC: "***********************************************************$N"
				    "DISPESNER BRAKE RELEASE TOGGLE $N"
				    "************************************************************";
				N: XIC(DISPENSER_1_SERVICE_SELECTION)XIC(DISPENSER_1_BRAKE_RELEASE)ONS(Break_Release_Temp_Ser_ONS_1)XIO(Break_Release_Ser)OTL(Break_Release_Temp_Ser);
				N: XIC(DISPENSER_1_SERVICE_SELECTION)XIC(DISPENSER_1_BRAKE_RELEASE)ONS(Break_Release_Temp_Ser_ONS_2)XIC(Break_Release_Ser)OTU(Break_Release_Temp_Ser);
				N: XIO(DISPENSER_1_SERVICE_SELECTION)OTU(Break_Release_Temp_Ser);
				N: XIC(Break_Release_Temp_Ser)OTE(Break_Release_Ser);
				RC: "***********************************************************$N"
				    "LOOPER AT TOP SET $N"
				    "************************************************************";
				N: XIC(Always_On)[XIC(LOOPER_AT_TOP) ,XIC(Z20_PSM_A.T1[14].DN) ,XIC(Manual_Mode_Selected) XIC(FAULT_RESET_ILPB) XIO(CYCLE_STOP_PB) ]OTL(Looper_At_Top_Bit);
				N: XIC(Looper_At_Top_Bit)XIC(LOOPER_AT_BOTTOM)OTU(Looper_At_Top_Bit);
				RC: "***********************************************************$N"
				    "DISPENSER CLUTCH OUTPUT $N"
				    "************************************************************";
				N: [XIC(Break_Release_Ser) ,XIC(Looper_At_Top_Bit) ][OTE(O_DISPENSER_BRAKE_RELEASE) ,OTE(Local:6:O.Pt06.Data) ];
				RC: "***********************************************************$N"
				    "LAMP : DISPENSER SERVICE SELECTION$N"
				    "************************************************************";
				N: XIC(DISPENSER_1_SERVICE_SELECTION)OTE(O_DISPENSER_SERVICE_SELECTION);
		END_ROUTINE

		ROUTINE File08_Horizontial_Carriage 
				RC: "***********************************************************$N"
				    "ENABLE SIGNAL TO DRIVE $N"
				    "************************************************************";
				N: XIC(Carriage_Interlock)OTE(enable_rapid_stop);
				RC: "***********************************************************$N"
				    "DRIVE BLOCK$N"
				    "************************************************************";
				N: AOI_140(Hori_Drive,enable_rapid_stop,reset,JOG_PLUS_MODE,JOG_MINUS_MODE,REF_TRAVEL_MODE,POSITIONING_MODE,SETPOINT_POS,setpoint_speed,4000,4000,Hori_Carriage:I.Data,Hori_Carriage:O.Data,fault_of_axis,WARNING_OF_AXIS,inverter_ready,REFERENCED,TARGET_POS_REACHED,AXIS_INTERLOCKED,axis_fault_no,ACTUAL_POSITION,actual_speed,ACTUAL_CURRENT,start_byte,fault_of_aoi,aoi_fault_no,COMMUNICATION_FAULT);
				RC: "***********************************************************$N"
				    "DRIVE REFERENCING$N"
				    "$N"
				    "When the Referencing bit is on , the carriage will move in anticlockwise direction ( reverse ) searching for the limit switch input , whenever the limit is activated the drive will get $N"
				    "referenced & then it moves again in clock wise direction ( forward ) till the lever of the limit swiitch is released .$N"
				    "May be around offset of 10 - 15 mm .$N"
				    "************************************************************";
				N: XIC(Machine_Control_ON)[XIC(Referancing_Drive) ,XIC(Always_On) ]XIC(CYCLE_STOP_PB)XIO(REFERENCED)XIO(Drive_Referancing_OK)XIC(BAYONET_AT_RETRACT_POSITION)XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY)OTE(Drive_referancing_on_bit);
				RC: "***********************************************************$N"
				    "REFERNENCE TRAVEL MODE SELECTED$N"
				    "************************************************************";
				N: XIC(Drive_referancing_on_bit)OTE(REF_TRAVEL_MODE);
				RC: "***********************************************************$N"
				    "DRIVE REFERENCING OK $N"
				    "************************************************************";
				N: XIC(REFERENCED)OTE(Drive_Referancing_OK);
				N: [XIC(Manual_Mode_Selected) [XIC(FAULT_RESET_ILPB) ,XIO(CYCLE_STOP_PB) ] ,XIC(CONTROL_ON_TIMER.TT) ]OTE(reset);
				RC: "#########################################################$N"
				    "ALARMS$N"
				    "#########################################################";
				N: [XIO(Drive_Referancing_OK) ,XIC(Fault_SEW_Referancing) ]XIO(FAULT_RESET_ILPB)XIO(REFERENCED)OTE(Fault_SEW_Referancing);
				RC: "***********************************************************$N"
				    "HORIZONTAL CARRIAGE DRIVE FAULT$N"
				    "************************************************************";
				N: [XIC(fault_of_axis) ,XIC(Fault_SEW_Axis) ,XIC(COMMUNICATION_FAULT) ]XIO(FAULT_RESET_ILPB)OTE(Fault_SEW_Axis);
				RC: "***********************************************************$N"
				    "HORIZONTAL CARRIAGE FWD MOVEMENT INTERLOCK$N"
				    "************************************************************";
				N: XIC(BAYONET_AT_RETRACT_POSITION)[XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) ,XIC(Auto_Cycle_ON) XIC(VERTICAL_CARRIAGE_NEAR_BUNDLE) ]XIC(HORIZONTIAL_CARRIAGE_FWD_SAFETY_LS)OTE(Horizontial_CarriAGE_FWD_IL);
				RC: "***********************************************************$N"
				    "HORIZONTAL CARRIAGE REV MOVEMENT INTERLOCK$N"
				    "************************************************************";
				N: XIC(BAYONET_AT_RETRACT_POSITION)[XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) ,XIC(Auto_Cycle_ON) XIC(VERTICAL_CARRIAGE_NEAR_BUNDLE) ]XIC(HORIZONTIAL_CARRIAGE_REV_SAFETY_LS)OTE(Horizontial_CarriAGE_REV_IL);
				N: XIC(Always_On)MOV(Position_1_Final_Value,Carriage_Home_Position_Value);
				RC: "#########################################################$N"
				    "$N"
				    "CARRIAGE AT POSITION 1 CONFIRMATION$N"
				    "$N"
				    "#########################################################";
				N: ADD(Carriage_Home_Position_Value,5,Home_Position_Temp_1)SUB(Carriage_Home_Position_Value,5,Home_Position_Temp_2)GRT(ACTUAL_POSITION,Home_Position_Temp_2)LES(ACTUAL_POSITION,Home_Position_Temp_1)OTE(Horizontial_Carriage_At_Home_POSITION);
				RC: "#########################################################$N"
				    "$N"
				    "LOAD STRAP POSITION VALUES FROM HMI$N"
				    "$N"
				    "### Based on the HMI Position No selected from the HMI the actual position can be moved to the particular $N"
				    "position value $N"
				    "$N"
				    "1 : Strap Position 1$N"
				    " 2 : Strap Position 2 $N"
				    "3 : Strap Position 3$N"
				    " 4 : Strap Position 4$N"
				    "$N"
				    "$N"
				    "#########################################################$N"
				    "$N"
				    "";
				N: XIC(Machine_Control_ON)XIC(HMI_Load_Position_Values)XIO(position_control_Start_Bit)ONS(Load_ONS)[EQU(HMI_Position_No,1) MOV(ACTUAL_POSITION,POSITON_1_CONSTANT_VALUE) ,EQU(HMI_Position_No,2) MOV(ACTUAL_POSITION,POSITON_2_CONSTANT_VALUE) ,EQU(HMI_Position_No,3) MOV(ACTUAL_POSITION,POSITON_3_CONSTANT_VALUE) ,EQU(HMI_Position_No,4) MOV(ACTUAL_POSITION,POSITON_4_CONSTANT_VALUE) ];
				RC: "#########################################################$N"
				    "$N"
				    "LOAD INITIAL ( DEFAULT ) POSITION VALUES FROM HMI$N"
				    "$N"
				    "### Load the start value to the position $N"
				    "$N"
				    "$N"
				    "#########################################################$N"
				    "$N"
				    "";
				N: XIC(Machine_Control_ON)XIC(HMI_Load_Start_Values)MOV(700,POSITON_1_CONSTANT_VALUE)MOV(55,POSITON_2_CONSTANT_VALUE)MOV(255,POSITON_3_CONSTANT_VALUE)MOV(490,POSITON_4_CONSTANT_VALUE);
				N: XIC(Machine_Control_ON)MOV(POSITON_1_CONSTANT_VALUE,Position_1_Final_Value)MOV(POSITON_2_CONSTANT_VALUE,Position_2_Final_Value)MOV(POSITON_3_CONSTANT_VALUE,Position_3_Final_Value)MOV(POSITON_4_CONSTANT_VALUE,Position_4_Final_Value);
				RC: "#########################################################$N"
				    "$N"
				    "CARRIAGE AT POSITION 1 CONFIRMATION$N"
				    "$N"
				    "#########################################################";
				N: ADD(Position_1_Final_Value,5,Position_1_Temp_1)SUB(Position_1_Final_Value,5,Position_1_Temp_2)GRT(ACTUAL_POSITION,Position_1_Temp_2)LES(ACTUAL_POSITION,Position_1_Temp_1)OTE(Horizontial_Carriage_At_Strap_Position_1);
				RC: "#########################################################$N"
				    "$N"
				    "CARRIAGE AT POSITION 2 CONFIRMATION$N"
				    "$N"
				    "#########################################################";
				N: ADD(Position_2_Final_Value,5,Position_2_Temp_1)SUB(Position_2_Final_Value,5,Position_2_Temp_2)GRT(ACTUAL_POSITION,Position_2_Temp_2)LES(ACTUAL_POSITION,Position_2_Temp_1)OTE(Horizontial_Carriage_At_Strap_Position_2);
				RC: "#########################################################$N"
				    "$N"
				    "CARRIAGE AT POSITION 3 CONFIRMATION$N"
				    "$N"
				    "#########################################################";
				N: ADD(Position_3_Final_Value,5,Position_3_Temp_1)SUB(Position_3_Final_Value,5,Position_3_Temp_2)GRT(ACTUAL_POSITION,Position_3_Temp_2)LES(ACTUAL_POSITION,Position_3_Temp_1)OTE(Horizontial_Carriage_At_Strap_Position_3);
				RC: "#########################################################$N"
				    "$N"
				    "CARRIAGE AT POSITION 4 CONFIRMATION$N"
				    "$N"
				    "#########################################################";
				N: ADD(Position_4_Final_Value,5,Position_4_Temp_1)SUB(Position_4_Final_Value,5,Position_4_Temp_2)GRT(ACTUAL_POSITION,Position_4_Temp_2)LES(ACTUAL_POSITION,Position_4_Temp_1)OTE(Horizontial_Carriage_At_Strap_Position_4);
				RC: "#########################################################$N"
				    "$N"
				    "MANUAL MODE CARRIAGE FWD MOVEMENT$N"
				    "$N"
				    "#########################################################";
				N: XIC(Machine_Control_ON)XIC(Manual_Mode_Selected)XIC(Carriage_Interlock)XIC(HMI_Carriage_FWD_Button)XIO(HMI_Carriage_REV_Button)XIC(HORIZONTIAL_CARRIAGE_FWD_SAFETY_LS)XIC(Horizontial_CarriAGE_FWD_IL)OTE(Manual_Mode_Carriage_FWD);
				RC: "#########################################################$N"
				    "$N"
				    "MANUAL MODE CARRIAGE REV MOVEMENT$N"
				    "$N"
				    "#########################################################";
				N: XIC(Machine_Control_ON)XIC(Manual_Mode_Selected)XIC(Carriage_Interlock)XIC(HMI_Carriage_REV_Button)XIO(HMI_Carriage_FWD_Button)XIC(HORIZONTIAL_CARRIAGE_REV_SAFETY_LS)XIC(Horizontial_CarriAGE_REV_IL)OTE(Manual_Mode_Carriage_REV);
				N: XIC(Manual_Mode_Selected)XIC(Manual_Mode_Carriage_FWD)XIC(Horizontial_CarriAGE_FWD_IL)OTE(JOG_PLUS_MODE);
				N: XIC(Manual_Mode_Carriage_REV)OTE(JOG_MINUS_MODE);
				N: [XIC(Manual_Carriage_Move_TO_Home_position) ,XIC(Machine_Homing_Started) ,XIC(All_Axis_Home_After_Cycle_Complete) ]ONS(Move_to_home_ons)MOV(Carriage_Home_Position_Value,SETPOINT_POS);
				N: XIC(Manual_Carriage_Move_TO_position_1)ONS(ons_10)MOV(Position_1_Final_Value,SETPOINT_POS);
				N: XIC(Manual_Carriage_Move_TO_position_2)ONS(ons_11)MOV(Position_2_Final_Value,SETPOINT_POS);
				N: XIC(Manual_Carriage_Move_TO_position_3)ONS(ons_12)MOV(Position_3_Final_Value,SETPOINT_POS);
				N: XIC(Manual_Carriage_Move_TO_position_4)ONS(ons_12_1)MOV(Position_4_Final_Value,SETPOINT_POS);
				N: XIC(Move_Carriage_to_Pos_1)ONS(ons_13)MOV(Position_1_Final_Value,SETPOINT_POS);
				N: XIC(Move_Carriage_to_Pos_2)ONS(ons_14)MOV(Position_2_Final_Value,SETPOINT_POS);
				N: XIC(Move_Carriage_to_Pos_3)ONS(ons_15)MOV(Position_3_Final_Value,SETPOINT_POS);
				N: XIC(Move_Carriage_to_Pos_4)ONS(ons_16)MOV(Position_4_Final_Value,SETPOINT_POS);
				RC: "************************************************************$N"
				    "POSTION CTR CARRIAGE MOVE TO HOME$N"
				    "***********************************************************";
				N: XIC(REFERENCED)XIO(Service_Mode_Selected)[[XIC(Manual_Carriage_Move_TO_Home_position) ,XIC(Position_Ctr_Carriage_Move_To_Home) ] ,XIC(Machine_Homing_Started) ,XIC(All_Axis_Home_After_Cycle_Complete) ]XIO(Position_Ctr_Carriage_Move_To_Pos_1)XIO(Position_Ctr_Carriage_Move_To_Pos_2)XIO(Position_Ctr_Carriage_Move_To_Pos_3)XIO(Horizontial_Carriage_At_Home_POSITION)XIO(FAULT_RESET_ILPB)OTE(Position_Ctr_Carriage_Move_To_Home);
				RC: "************************************************************$N"
				    "POSTION CTR CARRIAGE MOVE TO POSITION 1$N"
				    "***********************************************************";
				N: [XIC(REFERENCED) XIO(Service_Mode_Selected) [[XIC(Manual_Carriage_Move_TO_position_1) ,XIC(Position_Ctr_Carriage_Move_To_Pos_1) ] ,XIC(Move_Carriage_to_Pos_1) ] XIO(Position_Ctr_Carriage_Move_To_Home) ,XIC(REFERENCED) ONS(Push_Carriage_to_home) ]XIO(Position_Ctr_Carriage_Move_To_Pos_2)XIC(CYCLE_STOP_PB)XIO(Position_Ctr_Carriage_Move_To_Pos_3)XIO(Horizontial_Carriage_At_Strap_Position_1)XIO(FAULT_RESET_ILPB)OTE(Position_Ctr_Carriage_Move_To_Pos_1);
				RC: "************************************************************$N"
				    "POSTION CTR CARRIAGE MOVE TO POSITION 2$N"
				    "***********************************************************";
				N: XIC(REFERENCED)XIO(Service_Mode_Selected)[[XIC(Manual_Carriage_Move_TO_position_2) ,XIC(Position_Ctr_Carriage_Move_To_Pos_2) ] ,XIC(Move_Carriage_to_Pos_2) ]XIO(Position_Ctr_Carriage_Move_To_Home)XIO(Position_Ctr_Carriage_Move_To_Pos_1)XIO(Position_Ctr_Carriage_Move_To_Pos_3)XIO(Horizontial_Carriage_At_Strap_Position_2)XIC(CYCLE_STOP_PB)XIO(FAULT_RESET_ILPB)OTE(Position_Ctr_Carriage_Move_To_Pos_2);
				RC: "************************************************************$N"
				    "POSTION CTR CARRIAGE MOVE TO POSITION 3$N"
				    "***********************************************************";
				N: XIC(REFERENCED)XIO(Service_Mode_Selected)[[XIC(Manual_Carriage_Move_TO_position_3) ,XIC(Position_Ctr_Carriage_Move_To_Pos_3) ] ,XIC(Move_Carriage_to_Pos_3) ]XIO(Position_Ctr_Carriage_Move_To_Home)XIO(Position_Ctr_Carriage_Move_To_Pos_1)XIO(Position_Ctr_Carriage_Move_To_Pos_2)XIO(Horizontial_Carriage_At_Strap_Position_3)XIC(CYCLE_STOP_PB)XIO(FAULT_RESET_ILPB)OTE(Position_Ctr_Carriage_Move_To_Pos_3);
				RC: "************************************************************$N"
				    "POSTION CTR CARRIAGE MOVE TO POSITION 4$N"
				    "***********************************************************";
				N: XIC(REFERENCED)XIO(Service_Mode_Selected)[[XIC(Manual_Carriage_Move_TO_position_4) ,XIC(Position_Ctr_Carriage_Move_To_Pos_4) ] ,XIC(Move_Carriage_to_Pos_4) ]XIO(Position_Ctr_Carriage_Move_To_Home)XIO(Position_Ctr_Carriage_Move_To_Pos_1)XIO(Position_Ctr_Carriage_Move_To_Pos_2)XIO(Position_Ctr_Carriage_Move_To_Pos_3)XIO(Horizontial_Carriage_At_Strap_Position_4)XIC(CYCLE_STOP_PB)XIO(FAULT_RESET_ILPB)OTE(Position_Ctr_Carriage_Move_To_Pos_4);
				RC: "************************************************************$N"
				    "CARRIAGE AT EITHER OF THE POSITION$N"
				    "***********************************************************";
				N: [XIC(Horizontial_Carriage_At_Home_POSITION) ,XIC(Horizontial_Carriage_At_Strap_Position_1) ,XIC(Horizontial_Carriage_At_Strap_Position_2) ,XIC(Horizontial_Carriage_At_Strap_Position_3) ,XIC(Horizontial_Carriage_At_Strap_Position_4) ]XIO(JOG_MINUS_MODE)XIO(position_control_Start_Bit)XIO(JOG_PLUS_MODE)XIO(POSITIONING_MODE)OTE(CArriage_At_Either_OF_The_position);
				RC: "************************************************************$N"
				    "HORIZONTAL CARRIAGE POSITION STATUS$N"
				    "$N"
				    "0 : Horizontal Carriae at home position$N"
				    "1 : Horizontal Carriage at strap position 1$N"
				    "2 : Horizontal Carriage at strap position 2$N"
				    "3 : Horizontal Carriage at strap position 3$N"
				    "4 : Horizontal Carriage at strap position 4$N"
				    "***********************************************************";
				N: XIC(Always_On)[XIC(Horizontial_Carriage_At_Home_POSITION) MOV(0,Carriage_Position_HMI) ,XIC(Horizontial_Carriage_At_Strap_Position_1) MOV(1,Carriage_Position_HMI) ,XIC(Horizontial_Carriage_At_Strap_Position_2) MOV(2,Carriage_Position_HMI) ,XIC(Horizontial_Carriage_At_Strap_Position_3) MOV(3,Carriage_Position_HMI) ,XIC(Horizontial_Carriage_At_Strap_Position_4) MOV(4,Carriage_Position_HMI) ];
				RC: "************************************************************$N"
				    "POSITION START$N"
				    "***********************************************************";
				N: [XIC(Position_Ctr_Carriage_Move_To_Home) XIO(Position_Ctr_Carriage_Move_To_Pos_1) XIO(Position_Ctr_Carriage_Move_To_Pos_2) XIO(Position_Ctr_Carriage_Move_To_Pos_3) XIO(Position_Ctr_Carriage_Move_To_Pos_4) ,XIC(Position_Ctr_Carriage_Move_To_Pos_1) XIO(Position_Ctr_Carriage_Move_To_Home) XIO(Position_Ctr_Carriage_Move_To_Pos_2) XIO(Position_Ctr_Carriage_Move_To_Pos_3) XIO(Position_Ctr_Carriage_Move_To_Pos_4) ,XIC(Position_Ctr_Carriage_Move_To_Pos_2) XIO(Position_Ctr_Carriage_Move_To_Home) XIO(Position_Ctr_Carriage_Move_To_Pos_1) XIO(Position_Ctr_Carriage_Move_To_Pos_3) XIO(Position_Ctr_Carriage_Move_To_Pos_4) ,XIC(Position_Ctr_Carriage_Move_To_Pos_3) XIO(Position_Ctr_Carriage_Move_To_Home) XIO(Position_Ctr_Carriage_Move_To_Pos_1) XIO(Position_Ctr_Carriage_Move_To_Pos_2) XIO(Position_Ctr_Carriage_Move_To_Pos_4) ,XIC(Position_Ctr_Carriage_Move_To_Pos_4) XIO(Position_Ctr_Carriage_Move_To_Home) XIO(Position_Ctr_Carriage_Move_To_Pos_1) XIO(Position_Ctr_Carriage_Move_To_Pos_2) XIO(Position_Ctr_Carriage_Move_To_Pos_3) ]XIC(REFERENCED)OTE(position_control_Start_Bit);
				RC: "************************************************************$N"
				    "SPEED SETPOINT$N"
				    "***********************************************************";
				N: XIC(Machine_Control_ON)[[XIC(Position_Ctr_Carriage_Move_To_Pos_1) ,XIC(Position_Ctr_Carriage_Move_To_Pos_2) ,XIC(Position_Ctr_Carriage_Move_To_Pos_3) ,XIC(Position_Ctr_Carriage_Move_To_Pos_4) ,XIC(Position_Ctr_Carriage_Move_To_Home) ] XIO(JOG_PLUS_MODE) XIO(JOG_MINUS_MODE) MOV(1000,setpoint_speed) ,[XIC(JOG_PLUS_MODE) ,XIC(JOG_MINUS_MODE) ] MOV(150,setpoint_speed) ];
				RC: "************************************************************$N"
				    "POSITIONING MODE ON$N"
				    "***********************************************************";
				N: [XIC(Position_Ctr_Carriage_Move_To_Pos_1) ,XIC(Position_Ctr_Carriage_Move_To_Pos_2) ,XIC(Position_Ctr_Carriage_Move_To_Pos_3) ,XIC(Position_Ctr_Carriage_Move_To_Pos_4) ,XIC(Position_Ctr_Carriage_Move_To_Home) ]XIO(JOG_MINUS_MODE)XIO(JOG_PLUS_MODE)XIO(Position_reached)[OTE(POSITIONING_MODE) ,XIO(Position_Ctr_Carriage_Move_To_Home) OTL(Horiz_Carriage_Pos_Move_HMI_deplay) ];
				RC: "************************************************************$N"
				    "POSITION REACHED$N"
				    "***********************************************************";
				N: EQU(SETPOINT_POS,ACTUAL_POSITION)OTE(Position_reached);
				RC: "#########################################################$N"
				    "ALARMS$N"
				    "#########################################################";
				N: [XIO(HORIZONTIAL_CARRIAGE_MOTOR_BRAKE_HEALTHY) ,XIC(FAULT_HORIZ_CARRIAGE_MOTOR_MPCB_TRIP) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_HORIZ_CARRIAGE_MOTOR_MPCB_TRIP);
				N: [XIO(HORIZONTIAL_CARRIAGE_FWD_SAFETY_LS) ,XIC(FAULT_HORIZONTIAL_CRG_FWD_LS_ACTIVATED) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_HORIZONTIAL_CRG_FWD_LS_ACTIVATED);
				N: [XIO(HORIZONTIAL_CARRIAGE_REV_SAFETY_LS) XIO(REF_TRAVEL_MODE) ,XIC(FAULT_HORIZONTIAL_CRG_REV_LS_ACTIVATED) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_HORIZONTIAL_CRG_REV_LS_ACTIVATED);
				N: [XIC(Auto_Mode_Selected) XIC(POSITIONING_MODE) XIO(CArriage_At_Either_OF_The_position) ,XIC(Fault_Horizontial_CAR_Positioning) ]XIO(All_Cycle_Reset)[XIC(Hori_Pssitioning_Error.DN) OTE(Fault_Horizontial_CAR_Positioning) ,TON(Hori_Pssitioning_Error,?,?) ];
				N: [XIC(Position_Ctr_Carriage_Move_To_Pos_1) XIO(Horizontial_Carriage_At_Strap_Position_1) ,XIC(Position_Ctr_Carriage_Move_To_Pos_2) XIO(Horizontial_Carriage_At_Strap_Position_2) ,XIC(Position_Ctr_Carriage_Move_To_Pos_3) XIO(Horizontial_Carriage_At_Strap_Position_3) ,XIC(Position_Ctr_Carriage_Move_To_Pos_4) XIO(Horizontial_Carriage_At_Strap_Position_4) ,XIC(Position_Ctr_Carriage_Move_To_Home) XIO(Horizontial_Carriage_At_Home_POSITION) ,XIC(Fault_Hori_Carriage_Position_Ctr_Error) ]XIO(All_Cycle_Reset)[XIC(Fault_Hori_Carriage_Position_Ctr_Timer.DN) OTE(Fault_Hori_Carriage_Position_Ctr_Error) ,TON(Fault_Hori_Carriage_Position_Ctr_Timer,?,?) ];
				N: [XIO(Drive_Referancing_OK) ,XIC(FAULT_HORZ_CARRIAGE_NOT_REFERENCED) XIO(FAULT_RESET_ILPB) ]OTE(FAULT_HORZ_CARRIAGE_NOT_REFERENCED);
				RC: "************************************************************$N"
				    "COMMON ALARMS$N"
				    "***********************************************************";
				N: [XIC(FAULT_HORIZ_CARRIAGE_MOTOR_MPCB_TRIP) ,XIC(FAULT_HORIZONTIAL_CRG_FWD_LS_ACTIVATED) ,XIC(FAULT_HORIZONTIAL_CRG_REV_LS_ACTIVATED) ,XIC(Fault_Horizontial_CAR_Positioning) ,XIC(Fault_Hori_Carriage_Position_Ctr_Error) ]OTE(Hori_Carrige_Fault);
		END_ROUTINE

		ROUTINE File09_Machine_Main 
				RC: "#########################################################$N"
				    "ALWAYS ON /ALWAYS OFF BIT$N"
				    "#########################################################";
				N: [XIO(Always_On) ,XIC(Always_On) ]OTE(Always_On);
				N: XIO(Always_On)OTE(Always_Off);
				RC: "#########################################################$N"
				    "ON OFF TIMMER     /       FLASSHING TIMER$N"
				    "#########################################################";
				N: XIO(OFF_ON_TIMER.DN)TON(ON_OFF_TIMER500MS,?,?);
				N: XIC(ON_OFF_TIMER500MS.DN)TON(OFF_ON_TIMER,?,?);
				RC: "#########################################################$N"
				    "CONTROL ON BIT$N"
				    "#########################################################";
				N: XIC(ESTOP_PILZ_OK)[XIC(MACHINE_ON_PB) ,XIC(Machine_Control_ON) ]XIC(MACHINE_OFF_PB)XIC(Sunmetals_to_Signode_Line_Estop_Healthy)OTE(Machine_Control_ON);
				RC: "#########################################################$N"
				    "ALL BREAKER FEEDBACK HEALTHY$N"
				    "#########################################################";
				N: XIC(VERTICAL_CARRIAGE_MOTOR_HEALTHY)XIC(BAYONET_MOTOR_HEALTHY)XIC(HORIZONTIAL_CARRIAGE_MOTOR_BRAKE_HEALTHY)XIC(FEED_MOTOR_MPCB_HEALTHY)XIC(INDEX_MOTOR_TRANSFORMER_MPCB_HEALTHY)XIC(WELD_MOT_MPCB_HEALTHY)XIC(DISPENSER_1_CLUTCH_MCB_FB)XIC(DISPENSER_2_CLUTCH_MCB_FB)XIC(Z20_CLUTCH_MCB_FB)OTE(Machine_MPCB_Ok);
				RC: "#########################################################$N"
				    "MODE SELECTION$N"
				    "#########################################################";
				N: XIC(Machine_Control_ON)XIC(AUTO_MANUAL_SSW)XIO(Service_Mode_Selected)OTE(Auto_Mode_Selected);
				N: XIC(Machine_Control_ON)XIO(AUTO_MANUAL_SSW)XIO(Service_Mode_Selected)OTE(Manual_Mode_Selected);
				N: XIC(Machine_Control_ON)[XIC(HEAD_SERVICE_SELECTION) ,XIC(SERVICESTOP_PILZ_FB) ]OTE(Head_Service_Mode_Selected);
				N: XIC(Machine_Control_ON)[XIC(DISPENSER_1_SERVICE_SELECTION) ,XIC(DISPENSER_2_SERVICE_SELECTION) ]OTE(Dispenser_Service_Mode_Selected);
				N: XIC(Machine_Control_ON)[XIC(Head_Service_Mode_Selected) ,XIC(Dispenser_Service_Mode_Selected) ]OTE(Service_Mode_Selected);
				RC: "****************************************************$N"
				    "LOCAL / REMOTE SELECTION**Not Used $N"
				    "***************************************************";
				N: XIC(Machine_Control_ON)XIC(HMI_Local_Remote_Selection)ONS(local_temp)XIO(Remote_Mode_Selected)OTL(Remote_Mode_Selected_temp);
				RC: "****************************************************$N"
				    "LOCAL / REMOTE SELECTION$N"
				    "***************************************************";
				N: XIC(Machine_Control_ON)XIC(HMI_Local_Remote_Selection)ONS(local_temp_1)XIC(Remote_Mode_Selected)OTU(Remote_Mode_Selected_temp);
				RC: "****************************************************$N"
				    "LOCAL / REMOTE SELECTION$N"
				    "***************************************************";
				N: XIC(Remote_Mode_Selected_temp)OTE(Remote_Mode_Selected);
				RC: "****************************************************$N"
				    "DISPENSER 1 SELECTION**Not used in the logic $N"
				    "***************************************************";
				N: XIC(Machine_Control_ON)XIC(HMI_Dispenser_1_Selection)[OTL(Dispenser_1_Selected) ,OTU(Dispenser_2_Selected) ];
				RC: "****************************************************$N"
				    "DISPENSER 2 SELECTION**Not used in the logic$N"
				    "***************************************************";
				N: XIC(Machine_Control_ON)XIC(HMI_Dispenser_2_Selection)[OTL(Dispenser_2_Selected) ,OTU(Dispenser_1_Selected) ];
				RC: "****************************************************$N"
				    "MACHINE MODE STATUS$N"
				    "$N"
				    "0 : AUTO MODE SELECTED $N"
				    "1 : MANUAL MODE SELECTED $N"
				    "2 : SERVICE MODE SELECTED $N"
				    "3 : MACHINE IS OFF $N"
				    "4 : FAULT PRESENT $N"
				    "***************************************************";
				N: XIC(Always_On)[XIC(Auto_Mode_Selected) MOV(0,MACHINE_MODE_STATUS_WORD) ,XIC(Manual_Mode_Selected) MOV(1,MACHINE_MODE_STATUS_WORD) ,XIC(Service_Mode_Selected) MOV(2,MACHINE_MODE_STATUS_WORD) ,XIO(Machine_Control_ON) MOV(3,MACHINE_MODE_STATUS_WORD) ,XIC(Fault_Present) MOV(4,MACHINE_MODE_STATUS_WORD) ];
				RC: "****************************************************$N"
				    "MACHINE HOME$N"
				    "***************************************************";
				N: XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY)XIC(BAYONET_AT_RETRACT_POSITION)XIC(Horizontial_Carriage_At_Home_POSITION)XIC(S_I_7_4)XIC(B3[61].5)XIO(Slab1_AGV_In_Zone_PLC)OTE(Machine_Home);
				N: XIC(Machine_Control_ON)XIO(Machine_Home)OTE(Machine_Home_Not_Present);
				RC: "****************************************************$N"
				    "ALL AXIS HOME$N"
				    "***************************************************";
				N: XIC(Machine_Control_ON)XIO(Machine_Home)[XIC(Manual_Mode_Selected) [XIC(HMI_Homing_key) [XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) XIC(Z20_INDEX_POSITION) XIO(Z20_HOME_POSITION) ,XIO(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) XIO(Z20_INDEX_POSITION) XIC(Z20_HOME_POSITION) ] ,XIC(Machine_Homing_Started) ] ,XIC(Auto_Mode_Selected) XIC(Auto_Cycle_ON) [XIC(All_Axis_Home_After_Cycle_Complete) ,XIC(Machine_Homing_Started) ] ]XIO(Machine_Home_For_Auto_Cycle)XIC(CYCLE_STOP_PB)XIO(FAULT_RESET_ILPB)OTE(Machine_Homing_Started);
				RC: "****************************************************$N"
				    "MACHINE HOME FOR SINGLE STRAP$N"
				    "***************************************************";
				N: XIC(Machine_Control_ON)XIC(VERTICAL_CARRIAGR_ON_BUNDLE)XIC(BAYONET_AT_RETRACT_POSITION)XIC(Sunmetals_to_Signode_Conveyor_Stopped)[XIC(Horizontial_Carriage_At_Strap_Position_1) ,[XIC(Horizontial_Carriage_At_Strap_Position_2) ,XIC(Horizontial_Carriage_At_Strap_Position_3) ,XIC(Horizontial_Carriage_At_Strap_Position_4) ,XIC(Machine_Home_For_Single_strap) ] ]XIO(Vertical_Carriage:O.Start)OTE(Machine_Home_For_Single_strap);
				RC: "#########################################################$N"
				    "SIGNLE$N"
				    " CYCLE START$N"
				    "#########################################################";
				N: XIC(Auto_Mode_Selected)XIC(Machine_Control_ON)XIC(Machine_MPCB_Ok)XIC(PWM_Status_healthy)[[XIC(HMI_Single_Strap_PB) ,XIC(First_Strap_Cycle_Start_Bit) ,XIC(Second_Strap_Cycle_Start_Bit) ,XIC(third_Strap_Cycle_Start_Bit) ,XIC(Fourth_Strap_Cycle_Start_Bit) ] XIC(Z20_PSM_A.L[0]) XIC(Machine_Home_For_Single_strap) ,XIC(Auto_Cycle_Start_ON_Latched) XIC(CYCLE_START_PB) [XIC(First_Strap_Cycle_Completed) ,[XIC(A01_IN00) ,XIO(A01_IN00) [XIO(BAYONET_EXTEND_POSITION_TIMER.DN) ,XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) ] ] XIO(First_Strap_Cycle_Completed) ] ,XIC(Single_Strap_Cycle_ON) ]XIO(Machine_Cycle_Completed)XIC(CYCLE_STOP_PB)XIO(Alarm_Present)XIO(Single_Strap_Cycle_Complete)XIO(FAULT_BAYONET_PATH_NOT_CLEAR)OTE(Single_Strap_Cycle_ON);
				RC: "#########################################################$N"
				    "SIGNLE CYCLE COMPLETE / RESET ALL BITS$N"
				    "$N"
				    "Master reset can be performed by putting machine in manual mode & simultaneoulsy pressing fault reset + Cycle stop $N"
				    "#########################################################";
				N: [XIC(Machine_Control_ON) [XIC(Auto_Mode_Selected) XIC(Head_Cycle_Complete) XIC(VERTICAL_CARRIAGR_ON_BUNDLE) XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) XIC(BAYONET_AT_RETRACT_POSITION) ,XIC(Manual_Mode_Selected) [XIC(FAULT_RESET_ILPB) XIO(CYCLE_STOP_PB) ,XIO(Always_On) ] ] TOF(Single_Cycle_reset,?,?) ,XIC(Machine_Control_ON) XIC(Manual_Mode_Selected) ][OTE(Single_Strap_Cycle_Complete) ,TON(Single_Cycle_reset_1,?,?) ,XIC(Single_Cycle_reset_1.DN) [OTU(Head_Cycle_Complete) ,OTU(Auto_Vert_Carriage_Cycle_Start) ,OTU(Auto_Vert_Carriage_UP_Bit) ,OTU(Auto_Vert_Carriage_On_Bundle) ,OTU(Auto_Vert_Carriage_UP) ,OTU(Auto_Bayonet_AT_EXTEND_POSITION) ,OTU(Head_To_Retrive_Permission) OTU(Bayonet_To_Retrive) ,OTU(HMI_STATUS_FAST_FEED) OTU(HMI_STATUS_FEED_COMPLETE) OTU(HMI_Status_Vert_Carriage_Down) ,OTU(HMI_STATUS_STRAP_CUT_WELD) OTU(HMI_STATUS_TAKE_UP) OTU(HMI_STATUS_END_GRIP) ,OTU(HMI_STATUS_ANVIL_CLOSED) OTU(HMI_STATUS_ANVIL_CLOSED_AT_END) OTU(HMI_STATUS_ANVIL_OPEN) ,CLR(Z20_PSM_A.SC) ,OTU(Z20_PSM_A.I03) ,TOF(Off_dalay,?,?) OTU(Machine_Cycle_Completed) OTU(Auto_Cycle_Start_ON_Latched) ,OTU(Z32_Head_Step_0_HMI_display) OTU(Z32_Head_Step_1_HMI_display) OTU(Z32_Head_Step_2_HMI_display) OTU(Z32_Head_Step_3_HMI_display) ,OTU(Z32_Head_Step_4_HMI_display) OTU(Z32_Head_Step_5_HMI_display) OTU(Z32_Head_Step_6_HMI_display) OTU(Z32_Head_Step_7_HMI_display) ,OTU(Z32_Head_Step_8_HMI_display) OTU(Z32_Head_Step_9_HMI_display) OTU(Z32_Head_Step_10_HMI_dsplay) OTU(Z32_Head_Step_11_HMI_dsplay) ,OTU(Z32_Head_Step_12_HMI_dsplay) OTU(Z32_Head_Step_13_HMI_dsplay) OTU(Z32_Head_Step_14_HMI_dsplay) OTU(Z32_Head_Step_15_HMI_dsplay) ,OTU(Z32_Head_Step_16_HMI_dsplay) OTU(Z32_Head_Step_17_HMI_dsplay) OTU(Z32_Head_Step_18_HMI_dsplay) OTU(Z32_Head_Step_19_HMI_dsplay) ,OTU(Z32_Head_Step_20_HMI_dsplay) OTU(Z32_Head_Step_21_HMI_dsplay) OTU(Z32_Head_Step_22_HMI_dsplay) OTU(Z32_Head_Step_23_HMI_dsplay) ,OTU(Z32_Head_Step_24_HMI_dsplay) OTU(Z32_Head_Step_25_HMI_dsplay) OTU(Z32_Head_Step_26_HMI_dsplay) OTU(Z32_Head_Step_27_HMI_dsplay) ,OTU(Z32_Head_Step_28_HMI_dsplay) OTU(Z32_Head_Step_29_HMI_dsplay) OTU(Z32_Head_Step_30_HMI_dsplay) OTU(Z32_Head_Step_31_HMI_dsplay) ,OTU(Horiz_Carriage_Pos_Move_HMI_deplay) OTU(Auto_Bayonet_FWD_HMI_deplay) ] ];
				RC: "#########################################################$N"
				    "TWO STRAP CYCLE SELECTED$N"
				    "#########################################################";
				N: XIC(Always_On)[XIO(Remote_Mode_Selected) XIC(HMI_TWO_Strap_Cycle_Select) ,XIC(Remote_Mode_Selected) XIC(HMI_TWO_Strap_Cycle_Select) ]XIO(Auto_Cycle_Start_ON_Latched)[OTL(Two_Strap_Cycle_Selected) ,OTU(FOUR_Strap_Cycle_Selected) ];
				RC: "#########################################################$N"
				    "FOUR STRAP CYCLE SELECTED$N"
				    "#########################################################";
				N: XIC(Always_On)[XIO(Remote_Mode_Selected) XIC(HMI_Four_Strap_Cycle_Select) ,XIC(Remote_Mode_Selected) XIC(HMI_Four_Strap_Cycle_Select) ]XIO(Auto_Cycle_Start_ON_Latched)[OTL(FOUR_Strap_Cycle_Selected) ,OTU(Two_Strap_Cycle_Selected) ];
				RC: "#########################################################$N"
				    "MACHINE HOME CONDITION FOR AUTO CYCLE$N"
				    "#########################################################";
				N: XIC(Sunmetals_to_Signode_Conveyor_Stopped)XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY)XIC(BAYONET_AT_RETRACT_POSITION)[XIC(HORIZONTIAL_CARRIAGE_AT_HOME_POSITION_PR) ,XIC(Horizontial_Carriage_At_Home_POSITION) ]XIO(A01_IN05)XIC(A01_IN02)XIO(A01_IN01_Z20_Home)OTE(Machine_Home_For_Auto_Cycle);
				RC: "#########################################################$N"
				    "$N"
				    "CARRIAGE INTERLOCK$N"
				    "$N"
				    "#########################################################";
				N: XIC(Machine_Control_ON)[XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) ,XIC(VERTICAL_CARRIAGE_NEAR_BUNDLE) ]XIC(BAYONET_AT_RETRACT_POSITION)OTE(Carriage_Interlock);
				RC: "#########################################################$N"
				    "AUTO CYCLE START$N"
				    "#########################################################";
				N: XIC(Auto_Mode_Selected)XIC(Machine_MPCB_Ok)[[[XIC(CYCLE_START_PB) ,XIC(HMI_Cycle_Start) ] ,XIC(Sunmetals_to_Signode_Cycle_Start) XIC(Sunmetals_to_Signode_Product_Present) ] XIC(Machine_Home_For_Auto_Cycle) XIC(Z20_PSM_A.L[0]) ,XIC(Auto_Cycle_Start_ON_Latched) XIC(CYCLE_START_PB) XIC(Always_Off) ,XIC(Auto_Cycle_ON) ]XIO(Machine_Cycle_Completed)[XIC(Two_Strap_Cycle_Selected) ,XIC(FOUR_Strap_Cycle_Selected) ]XIC(CYCLE_STOP_PB)XIO(Alarm_Present)XIO(Auto_Cycle_Completed)XIO(FAULT_SAFETY_DOOR_OPEN)[[OTE(Auto_Cycle_ON) ,TON(control_on_delay_timer,?,?) ] ,XIC(control_on_delay_timer.DN) OTL(Auto_Cycle_Start_ON_Latched) ];
				N: XIC(Machine_Control_ON)XIC(Auto_Mode_Selected)XIC(Auto_Cycle_ON)EQU(Auto_Cycle_Step,0)MOV(15,Auto_Cycle_Step);
				RC: "#########################################################$N"
				    "$N"
				    "FIRST STRAP CYCLE START$N"
				    "$N"
				    "#########################################################";
				N: XIC(Auto_Cycle_ON)EQU(15,Auto_Cycle_Step)XIO(First_Strap_Cycle_Completed)[OTE(Move_Carriage_to_Pos_1) ,TON(MC_Step_2_cycle_timer,?,?) ,MOV(MC_Step_2_cycle_timer.ACC,MC_Step_2_Cycle_time) DIV(MC_Step_2_Cycle_time,1000,MC_Step_2_Cycle_time_in_sec) ];
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(15,Auto_Cycle_Step)XIC(Horizontial_Carriage_At_Strap_Position_1)MOV(20,Auto_Cycle_Step);
				RC: "******************************************************************************$N"
				    "AUTO SEQ : FIRST STRAP CYCLE START$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(20,Auto_Cycle_Step)XIO(First_Strap_Cycle_Completed)ONS(ons_1)[OTE(First_Strap_Cycle_Start_Bit) ,MOV(25,Auto_Cycle_Step) ];
				RC: "******************************************************************************$N"
				    "AUTO SEQ : FIRST STRAP CYCLE COMPLETED$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(25,Auto_Cycle_Step)[XIC(Single_Strap_Cycle_Complete) ,XIC(BAYONET_AT_RETRACT_POSITION) XIC(FAULT_BAYONET_PATH_NOT_CLEAR) ]ONS(ons_2)[OTL(First_Strap_Cycle_Completed) ,XIO(FAULT_BAYONET_PATH_NOT_CLEAR) OTL(First_Strap_Cycle_Completed_Indic) ,MOV(30,Auto_Cycle_Step) ];
				RC: "******************************************************************************$N"
				    "AUTO SEQ : MOVE CARRIAGE TO POSITION 2$N"
				    "*******************************************************************************";
				N: XIC(Auto_Cycle_ON)EQU(30,Auto_Cycle_Step)XIC(First_Strap_Cycle_Completed)XIO(Second_Strap_Cycle_Completed)OTE(Move_Carriage_to_Pos_2);
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(30,Auto_Cycle_Step)XIC(Horizontial_Carriage_At_Strap_Position_2)MOV(35,Auto_Cycle_Step);
				RC: "******************************************************************************$N"
				    "AUTO SEQ : SECOND STRAP CYCLE START$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(35,Auto_Cycle_Step)XIO(Second_Strap_Cycle_Completed)ONS(ons_3)[OTE(Second_Strap_Cycle_Start_Bit) ,MOV(40,Auto_Cycle_Step) ];
				RC: "******************************************************************************$N"
				    "AUTO SEQ : SECOND STRAP CYCLE COMPLETED$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(40,Auto_Cycle_Step)[XIC(Single_Strap_Cycle_Complete) ,XIC(BAYONET_AT_RETRACT_POSITION) XIC(FAULT_BAYONET_PATH_NOT_CLEAR) ]ONS(ons_4)[OTL(Second_Strap_Cycle_Completed) ,XIO(FAULT_BAYONET_PATH_NOT_CLEAR) OTL(Second_Strap_Cycle_Completed_Indic) ,MOV(45,Auto_Cycle_Step) ];
				RC: "******************************************************************************$N"
				    "AUTO SEQ : MOVE CARRIAGE TO POS 3$N"
				    "*******************************************************************************";
				N: XIC(Auto_Cycle_ON)EQU(45,Auto_Cycle_Step)XIO(Third_Strap_Cycle_Completed)XIO(Two_Strap_Cycle_Selected)OTE(Move_Carriage_to_Pos_3);
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(45,Auto_Cycle_Step)[XIC(Horizontial_Carriage_At_Strap_Position_3) ,XIC(Two_Strap_Cycle_Selected) ]MOV(50,Auto_Cycle_Step);
				RC: "******************************************************************************$N"
				    "AUTO SEQ : THIRD STRAP CYCLE START$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(50,Auto_Cycle_Step)XIO(Third_Strap_Cycle_Completed)ONS(ons_5)[XIO(Two_Strap_Cycle_Selected) OTE(third_Strap_Cycle_Start_Bit) ,MOV(55,Auto_Cycle_Step) ];
				RC: "******************************************************************************$N"
				    "AUTO SEQ : THIRD STRAP CYCLE COMPETED$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(55,Auto_Cycle_Step)[XIC(Single_Strap_Cycle_Complete) ,XIC(Two_Strap_Cycle_Selected) ,XIC(BAYONET_AT_RETRACT_POSITION) XIC(FAULT_BAYONET_PATH_NOT_CLEAR) ]ONS(ons_6)[XIO(Two_Strap_Cycle_Selected) [OTL(Third_Strap_Cycle_Completed) ,XIO(FAULT_BAYONET_PATH_NOT_CLEAR) OTL(Third_Strap_Cycle_Completed_Indic) ] ,MOV(60,Auto_Cycle_Step) ];
				RC: "******************************************************************************$N"
				    "AUTO SEQ : MOVE CARRIAGE TO POSITION 4$N"
				    "*******************************************************************************";
				N: XIC(Auto_Cycle_ON)EQU(60,Auto_Cycle_Step)XIO(Forth_Strap_Cycle_Completed)XIO(Two_Strap_Cycle_Selected)OTE(Move_Carriage_to_Pos_4);
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(60,Auto_Cycle_Step)[XIC(Horizontial_Carriage_At_Strap_Position_4) ,XIC(Two_Strap_Cycle_Selected) ]MOV(65,Auto_Cycle_Step);
				RC: "******************************************************************************$N"
				    "AUTO SEQ : FOURTH STRAP CYCLE START$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(65,Auto_Cycle_Step)XIO(Fourth_Strap_Cycle_Start_Bit)ONS(ons_7)[XIO(Two_Strap_Cycle_Selected) OTE(Fourth_Strap_Cycle_Start_Bit) ,MOV(70,Auto_Cycle_Step) ];
				RC: "******************************************************************************$N"
				    "AUTO SEQ : FIRST STRAP CYCLE COMPLETED$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(70,Auto_Cycle_Step)[XIC(Single_Strap_Cycle_Complete) ,XIC(Two_Strap_Cycle_Selected) ,XIC(BAYONET_AT_RETRACT_POSITION) XIC(FAULT_BAYONET_PATH_NOT_CLEAR) ]ONS(ons_8)[OTL(Forth_Strap_Cycle_Completed) ,XIO(FAULT_BAYONET_PATH_NOT_CLEAR) OTL(Forth_Strap_Cycle_Completed_Indic) ,MOV(75,Auto_Cycle_Step) ];
				RC: "******************************************************************************$N"
				    "AUTO SEQ : ALL AXIS HOME AFTER CYCLE COMPLETE$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(75,Auto_Cycle_Step)OTE(All_Axis_Home_After_Cycle_Complete);
				RC: "******************************************************************************$N"
				    "AUTO SEQ : ALL STRAP CYCLE COMPLETED$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)XIC(Auto_Cycle_ON)EQU(75,Auto_Cycle_Step)XIC(Machine_Home_For_Auto_Cycle)OTL(Auto_Cycle_Completed);
				N: XIC(Machine_Control_ON)[XIO(Sunmetals_to_Signode_Conveyor_Stopped) ,XIC(Auto_Cycle_Completed) ]TON(Customer_Conveyor_moved_Timer,?,?);
				RC: "******************************************************************************$N"
				    "AUTO SEQ : RESET SEQ AFTER CYCLE COMPLETE$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)[XIC(Customer_Conveyor_moved_Timer.DN) ,XIC(Manual_Mode_Selected) [XIC(FAULT_RESET_ILPB) XIO(CYCLE_STOP_PB) ,XIC(Always_On) ] ][OTU(Auto_Cycle_Start_ON_Latched) ,OTU(Head_Cycle_Complete) ,OTU(Horiz_Carriage_Pos_Move_HMI_deplay) ,OTU(Auto_Vert_Carriage_Cycle_Start) ,OTU(Auto_Vert_Carriage_UP_Bit) ,OTU(Auto_Vert_Carriage_On_Bundle) ,OTU(Auto_Vert_Carriage_UP) ,OTE(ALARM_FAULT_RST) ,OTU(Auto_Bayonet_AT_EXTEND_POSITION) ,OTU(Head_To_Retrive_Permission) OTU(Bayonet_To_Retrive) ,CLR(Z20_PSM_A.SC) ,OTU(Z20_PSM_A.I03) ,OTU(Machine_Cycle_Completed) ,OTU(First_Strap_Cycle_Completed) ,OTU(Second_Strap_Cycle_Completed) ,OTU(Third_Strap_Cycle_Completed) ,OTU(Forth_Strap_Cycle_Completed) ,OTU(Auto_Cycle_Completed) ,MOV(0,Auto_Cycle_Step) ];
				N: XIO(Sunmetals_to_Signode_Conveyor_Stopped)OTU(First_Strap_Cycle_Completed_Indic)OTU(Second_Strap_Cycle_Completed_Indic)OTU(Third_Strap_Cycle_Completed_Indic)OTU(Forth_Strap_Cycle_Completed_Indic);
				RC: "******************************************************************************$N"
				    "MACHINE CONTACTOR ON$N"
				    "*******************************************************************************";
				N: XIC(Machine_Control_ON)[OTE(O_MACHINE_ON) ,OTE(O_Z20_HEAD_POWER_SAFETY_CONTACTOR) ];
				RC: "******************************************************************************$N"
				    "LAMP : HEAD SERVICE SELECTION$N"
				    "*******************************************************************************";
				N: XIC(Head_Service_Mode_Selected)XIC(Flash_On.DN)OTE(O_HEAD_SERVICE_SELECTION);
				RC: "******************************************************************************$N"
				    "LAMP : AUTO MODE SELECTED$N"
				    "*******************************************************************************";
				N: XIC(Auto_Mode_Selected)OTE(Auto_Mode_selected_lamp);
				RC: "******************************************************************************$N"
				    "LAMP : CYCLE STARTED$N"
				    "*******************************************************************************";
				N: XIC(Auto_Mode_Selected)[XIC(Two_Strap_Cycle_Selected) ,XIC(FOUR_Strap_Cycle_Selected) ]XIC(Machine_MPCB_Ok)XIC(PWM_Status_healthy)XIO(Alarm_Present)[[XIC(Machine_Home_For_Single_strap) ,XIC(Machine_Home_For_Auto_Cycle) ] XIO(Auto_Cycle_Start_ON_Latched) XIO(Auto_Cycle_ON) XIC(A01_IN02) XIO(A01_IN01_Z20_Home) XIO(A01_IN05) ,[XIC(Single_Strap_Cycle_ON) ,XIC(Auto_Cycle_ON) ] XIC(Flash_On.DN) ]OTE(Cycle_started_lamp);
				RC: "*************************************************************$N"
				    "Fault Siren $N"
				    "*************************************************************";
				N: [XIC(Alarm_Present) ,XIC(B3[61].3) ]OTE(Local:7:O.Pt06.Data);
				RC: "*************************************************************$N"
				    "air Blow after welding  $N"
				    "*************************************************************";
				N: XIC(Auto_Vert_Carriage_UP_Bit)OTE(Local:7:O.Pt07.Data);
				N: XIO(Check_Timer.DN)TON(Check_Timer,?,?);
				RC: "*************************************$N"
				    "WARNING & INFO MSG DISPLAY$N"
				    "$N"
				    "0 : DISPENSER 1 ALMOST EMPTY$N"
				    "1 : DISPENSER 2 ALMSOT EMPTY$N"
				    "2 : REMOTE MODE SELECTED$N"
				    "3 : LOCAL MODE SELECTED$N"
				    "4 : INDEX HOME POSITION MISSING WHILE PERFORMING ALL AXIS HOME  $N"
				    "5 : CUSTOMER CONVEYOR MOVING $N"
				    "6 : CUSTOMER CONVEYOT STOPPED$N"
				    "7 : SAFETY DOOR OPEN$N"
				    "8 : MAINT REQUIRED ON  SEALER MODULE , CHECK MANUAL $N"
				    "9 : MAINTANENCE REQUIRED ON FEEDER MODULE , CHECK MANUAL$N"
				    "****************************************";
				N: XIC(Machine_Control_ON)XIC(DISP1_STRAP_ALMOST_EMPTY)EQU(1000,Check_Timer.ACC)MOV(0,Warn_Info_Msg_status_display);
				N: XIC(Machine_Control_ON)XIC(DISP2_STRAP_ALMOST_EMPTY)EQU(2000,Check_Timer.ACC)MOV(1,Warn_Info_Msg_status_display);
				N: XIC(Machine_Control_ON)XIC(Remote_Mode_Selected)XIC(Always_Off)MOV(2,Warn_Info_Msg_status_display);
				N: XIC(Machine_Control_ON)XIO(Remote_Mode_Selected)XIC(Always_Off)MOV(3,Warn_Info_Msg_status_display);
				N: XIC(Machine_Control_ON)XIC(HMI_Homing_key)[XIO(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) XIC(Z20_INDEX_POSITION) XIO(Z20_HOME_POSITION) ,XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) [XIO(Z20_INDEX_POSITION) XIC(Z20_HOME_POSITION) ,XIC(A01_IN05) ] ]MOV(4,Warn_Info_Msg_status_display);
				N: XIC(Machine_Control_ON)XIO(Sunmetals_to_Signode_Conveyor_Stopped)MOV(5,Warn_Info_Msg_status_display);
				N: XIC(Machine_Control_ON)XIC(Sunmetals_to_Signode_Conveyor_Stopped)[EQU(4000,Check_Timer.ACC) ,EQU(3000,Check_Timer.ACC) ]MOV(6,Warn_Info_Msg_status_display);
				N: XIC(Machine_Control_ON)XIC(FAULT_SAFETY_DOOR_OPEN)EQU(5000,Check_Timer.ACC)MOV(7,Warn_Info_Msg_status_display);
				N: XIC(Machine_Control_ON)GRT(CYCLES_COMPLETED,Sealer_Module_Count_from_HMI)EQU(5500,Check_Timer.ACC)MOV(8,Warn_Info_Msg_status_display);
				N: XIC(Machine_Control_ON)GRT(CYCLES_COMPLETED,Feeder_Module_Count_from_HMI)EQU(6000,Check_Timer.ACC)MOV(9,Warn_Info_Msg_status_display);
				RC: "*******************************************$N"
				    "MEASURING MAHCINE CYCLE TIME $N"
				    "******************************************";
				N: XIC(Auto_Cycle_ON)[TON(Machine_cycle_time,?,?) ,MOV(Machine_cycle_time.ACC,Total_cycle_time) DIV(Total_cycle_time,1000,Total_cycle_time_in_sec) ];
				RC: "*******************************************$N"
				    "SEALER & FEEDER MODULE CYCLE COUNT RESET$N"
				    "******************************************";
				N: XIC(Always_On)[XIC(HMI_Sealer_Count_Reset) MOV(0,Sealer_Module_Count_from_HMI) ,XIC(HMI_feeder_Count_Reset) MOV(0,Feeder_Module_Count_from_HMI) ];
		END_ROUTINE

		ROUTINE File10_Vertical_Carriage 
				RC: "******************************************************************************$N"
				    "VERTICAL CARRIGAE POSITION STATUS$N"
				    "$N"
				    "0 : VERTICAL CARRIAGE AT HOME POSITION $N"
				    "1 : VERTICAL CARRIAGE NEAR BUNDLE $N"
				    "2 : VERTICAL CARRIAGE ON BUNDLE$N"
				    "3 : VERTICAL CARRIAGE UP SAFETY LS ACTIVATED $N"
				    "4 : VERTICAL CARRIAGE DOWN SAFETY LS ACTIVATED $N"
				    "5 : VERTICAL CARRIAGE MOVING DOWN $N"
				    "6: VERTICAL CARRIAGE MOVING UP$N"
				    "7 : VERTICAL CARRIAGE DRIVE FAULTED$N"
				    "*******************************************************************************";
				N: XIC(Always_On)[XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY) MOV(0,VERTICAL_CAR_MODE_STATUS_WORD) ,XIO(VERTICAL_CARRIAGE_NEAR_BUNDLE) MOV(1,VERTICAL_CAR_MODE_STATUS_WORD) ,XIO(VERTICAL_CARRIAGR_ON_BUNDLE) MOV(2,VERTICAL_CAR_MODE_STATUS_WORD) ,XIO(VERTICAL_CARRIAGE_UP_SAFETY_LS) MOV(3,VERTICAL_CAR_MODE_STATUS_WORD) ,XIO(VERTICAL_CARRIAGE_DN_SAFETY_LS) MOV(4,VERTICAL_CAR_MODE_STATUS_WORD) ,XIC(Vertical_Carriage:O.Forward) MOV(5,VERTICAL_CAR_MODE_STATUS_WORD) ,XIC(Vertical_Carriage:O.Reverse) MOV(6,VERTICAL_CAR_MODE_STATUS_WORD) ,XIC(Vertical_Carriage:I.Faulted) MOV(7,VERTICAL_CAR_MODE_STATUS_WORD) ];
				RC: "#########################################################$N"
				    "CARRIAGE UP INTERLOCK$N"
				    "#########################################################";
				N: XIC(VERTICAL_CARRIAGE_MOTOR_HEALTHY)XIC(VERTICAL_CARRIAGE_COUNTER_WT_LOCKPIN)XIC(VERTICAL_CARRIAGE_LOCKPIN)XIC(VERTICAL_CARRIAGE_UP_SAFETY_LS)XIO(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY)XIC(Z20_HOME_POSITION)OTE(Vertical_Carriage_UP_IL);
				RC: "#########################################################$N"
				    "CARRIAGE DOWN INTERLOCK$N"
				    "#########################################################";
				N: XIC(VERTICAL_CARRIAGE_MOTOR_HEALTHY)XIC(VERTICAL_CARRIAGE_COUNTER_WT_LOCKPIN)XIC(VERTICAL_CARRIAGE_LOCKPIN)XIC(VERTICAL_CARRIAGE_DN_SAFETY_LS)XIC(Sunmetals_to_Signode_Conveyor_Stopped)[[XIC(Horizontial_Carriage_At_Strap_Position_1) ,XIC(Horizontial_Carriage_At_Strap_Position_2) ] ,XIC(Horizontial_Carriage_At_Strap_Position_3) ,XIC(Horizontial_Carriage_At_Strap_Position_4) ,XIC(Single_Strap_Cycle_ON) ,XIC(Manual_Mode_Selected) ]XIO(Vertical_Carriage_On_Bundle_delay.DN)[XIC(VERTICAL_CARRIAGR_ON_BUNDLE) ,XIC(Auto_Mode_Selected) ]OTE(Vertical_Carriage_DN_IL);
				RC: "#########################################################$N"
				    "CARRIAGE UP MANUAL $N"
				    "OUTPUT BITS$N"
				    "#########################################################";
				N: [XIC(Manual_Mode_Selected) [XIC(HMI_Vertical_Carrige_UP_Key) ,XIC(Machine_Homing_Started) ] ,XIC(Auto_Mode_Selected) [XIC(All_Axis_Home_After_Cycle_Complete) XIC(VERTICAL_CARRIAGE_NEAR_BUNDLE) ,XIC(Auto_Vert_Carriage_UP_Bit) ] ]XIO(HMI_Vertical_Carrige_DN_Key)XIO(Vertical_Carriage_DN_Bit)XIC(Vertical_Carriage_UP_IL)OTE(Vertical_Carriage_UP_CMD_Bit);
				RC: "#########################################################$N"
				    "CARRIAGE DN MANUAL $N"
				    "OUTPUT BITS$N"
				    "#########################################################";
				N: [XIC(Manual_Mode_Selected) XIC(HMI_Vertical_Carrige_DN_Key) XIO(HMI_Vertical_Carrige_UP_Key) XIO(Vertical_Carriage_UP_Bit) ,XIC(Auto_Mode_Selected) XIC(Auto_Vert_Carriage_Down) ]XIC(Vertical_Carriage_DN_IL)OTE(Vertical_Carriage_DN_CMD_Bit);
				RC: "#########################################################$N"
				    "CARRIAGE $N"
				    " AUTO $N"
				    "SEQUENCE$N"
				    "#########################################################";
				N: XIC(Auto_Mode_Selected)XIC(Single_Strap_Cycle_ON)XIO(Auto_Vert_Carriage_On_Bundle)[XIC(A01_IN00) ,EQU(8,Z20_PSM_A.SP) ][OTE(Auto_Vert_Carriage_Down) ,TON(Vertical_carriage_status_delay,?,?) XIC(Vertical_carriage_status_delay.DN) OTL(HMI_Status_Vert_Carriage_Down) ,TON(MC_Step_7_cycle_timer,?,?) ,MOV(MC_Step_7_cycle_timer.ACC,MC_Step_7_cycle_time) DIV(MC_Step_7_cycle_time,1000,MC_Step_7_Cycle_time_in_sec) ];
				RC: "#########################################################$N"
				    "HEAD CYCLE START SIGNAL$N"
				    "#########################################################";
				N: XIC(Auto_Mode_Selected)XIC(Single_Strap_Cycle_ON)XIC(CArriage_At_Either_OF_The_position)ONS(Head_Cycle_Start_ons)OTE(Head_Cycle_Start_Signal);
				N: XIC(Auto_Mode_Selected)XIC(Single_Strap_Cycle_ON)[XIO(VERTICAL_CARRIAGR_ON_BUNDLE) TON(Vertical_Carriage_On_Bundle_delay,?,?) XIC(Vertical_Carriage_On_Bundle_delay.DN) ,XIC(Vertical_Carriage:O.Forward) XIO(VERTICAL_CARRIAGE_NEAR_BUNDLE) TON(Vert_Carr_On_Bundle_force_detect,?,?) XIC(Vert_Carr_On_Bundle_force_detect.DN) ]OTL(Auto_Vert_Carriage_On_Bundle);
				RC: "#########################################################$N"
				    "AUTO VERTICAL CARRIAGE UP$N"
				    "#########################################################";
				N: XIC(Auto_Mode_Selected)XIC(Single_Strap_Cycle_ON)XIC(Head_To_Retrive_Permission)[OTL(Auto_Vert_Carriage_UP_Bit) ,TON(MC_Step_12_cycle_timer,?,?) ,MOV(MC_Step_12_cycle_timer.ACC,MC_Step_12_cycle_time) DIV(MC_Step_12_cycle_time,1000,MC_Step_12_Cycle_time_in_sec) ];
				N: XIC(Auto_Mode_Selected)XIC(Auto_Vert_Carriage_UP_Bit)XIC(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY)OTU(Auto_Vert_Carriage_UP_Bit);
				RC: "#########################################################$N"
				    "CARRIAGE $N"
				    "OUTPUT BITS$N"
				    "#########################################################";
				N: XIC(Machine_Control_ON)[XIC(Vertical_Carriage_DN_CMD_Bit) ,XIC(Vertical_Carriage_UP_CMD_Bit) ][XIC(Single_Strap_Cycle_ON) ,XIC(Manual_Mode_Selected) ]OTE(Vertical_Carriage:O.Start);
				N: XIC(Machine_Control_ON)XIC(Vertical_Carriage_DN_CMD_Bit)OTE(Vertical_Carriage:O.Forward);
				N: XIC(Machine_Control_ON)XIC(Vertical_Carriage_UP_CMD_Bit)OTE(Vertical_Carriage:O.Reverse);
				N: XIO(Vertical_Carriage:O.Start)OTE(Vertical_Carriage:O.Stop);
				RC: "#########################################################$N"
				    "CARRIAGE SPEEDS$N"
				    "#########################################################";
				N: XIC(Machine_Control_ON)XIC(Vertical_Carriage:O.Start)[XIC(Auto_Mode_Selected) [XIC(Vertical_Carriage:O.Forward) [XIC(Vertical_Carriage_DN_CMD_Bit) XIC(VERTICAL_CARRIAGE_NEAR_BUNDLE) MOV(2800,Vertical_Carriage:O.FreqCommand) ,XIC(Vertical_Carriage_DN_CMD_Bit) XIO(VERTICAL_CARRIAGE_NEAR_BUNDLE) MOV(400,Vertical_Carriage:O.FreqCommand) ] ,XIC(Vertical_Carriage:O.Reverse) [XIO(VERTICAL_CARRIAGE_SLOW_SPEED) MOV(2500,Vertical_Carriage:O.FreqCommand) ,XIC(VERTICAL_CARRIAGE_SLOW_SPEED) MOV(1950,Vertical_Carriage:O.FreqCommand) ] ] ,XIC(Manual_Mode_Selected) [XIC(Vertical_Carriage:O.Forward) MOV(1000,Vertical_Carriage:O.FreqCommand) ,XIC(Vertical_Carriage:O.Reverse) [XIO(VERTICAL_CARRIAGE_SLOW_SPEED) MOV(2500,Vertical_Carriage:O.FreqCommand) ,XIC(VERTICAL_CARRIAGE_SLOW_SPEED) MOV(1950,Vertical_Carriage:O.FreqCommand) ] ] ];
				N: XIC(Vertical_Carriage:O.Stop)MOV(0,Vertical_Carriage:O.FreqCommand);
				N: [XIC(Vertical_Carriage:I.Faulted) XIC(Machine_Control_ON) XIO(All_Cycle_Reset) ,XIC(CONTROL_ON_TIMER.TT) ]OTE(Vertical_Carriage:O.ClearFaults);
				RC: "#########################################################$N"
				    "ALARMS$N"
				    "#########################################################";
				N: [XIO(VERTICAL_CARRIAGE_MOTOR_HEALTHY) ,XIC(FAULT_VERTICAL_CARRIAGE_MOTOR_MPCB_TRIP) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_VERTICAL_CARRIAGE_MOTOR_MPCB_TRIP);
				N: [XIO(VERTICAL_CARRIAGE_UP_SAFETY_LS) ,XIC(FAULT_VERTICAL_CARRIAGE_UP_LS_ACTIVATED) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_VERTICAL_CARRIAGE_UP_LS_ACTIVATED);
				N: [XIO(VERTICAL_CARRIAGE_DN_SAFETY_LS) ,XIC(FAULT_VERTICAL_CARRIAGE_DN_LS_ACTIVATED) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_VERTICAL_CARRIAGE_DN_LS_ACTIVATED);
				N: [XIO(VERTICAL_CARRIAGE_LOCKPIN) ,XIC(FAULT_VERTICAL_CARRIAGE_LOCKPIN_REMOVED) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_VERTICAL_CARRIAGE_LOCKPIN_REMOVED);
				N: [XIO(VERTICAL_CARRIAGE_COUNTER_WT_LOCKPIN) ,XIC(FAULT_VERTICAL_CRG_CN_WT_LOCKPIN_REMOVED) ]XIO(All_Cycle_Reset)XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_VERTICAL_CRG_CN_WT_LOCKPIN_REMOVED);
				N: XIC(Machine_Home_For_Auto_Cycle)[XIO(VERTICAL_CARRIAGR_ON_BUNDLE) ,XIC(FAULT_VERTICAL_ON_BUNDLE_SENSOR_FAULTED) XIO(FAULT_RESET_ILPB) ]XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_VERTICAL_ON_BUNDLE_SENSOR_FAULTED);
				N: XIC(Machine_Home_For_Auto_Cycle)[XIO(VERTICAL_CARRIAGE_NEAR_BUNDLE) ,XIC(FAULT_VERT_NEAR_BUNDLE_SENSOR_FAULTED) XIO(FAULT_RESET_ILPB) ]XIO(FAULT_SAFETY_DOOR_OPEN)OTE(FAULT_VERT_NEAR_BUNDLE_SENSOR_FAULTED);
				RC: "#########################################################$N"
				    "CARRIAGE COMMON FAULTS$N"
				    "#########################################################";
				N: [XIC(FAULT_VERTICAL_CARRIAGE_MOTOR_MPCB_TRIP) ,XIC(FAULT_VERTICAL_CARRIAGE_UP_LS_ACTIVATED) ,XIC(FAULT_VERTICAL_CARRIAGE_DN_LS_ACTIVATED) ,XIC(FAULT_VERTICAL_CARRIAGE_LOCKPIN_REMOVED) ,XIC(FAULT_VERTICAL_CRG_CN_WT_LOCKPIN_REMOVED) ,XIC(FAULT_VERTICAL_ON_BUNDLE_SENSOR_FAULTED) ,XIC(FAULT_VERT_NEAR_BUNDLE_SENSOR_FAULTED) ]OTE(VERTICAL_CARRIAGE_FAULT);
		END_ROUTINE

		ROUTINE File11_HMI_Display 
				RC: "********************************************************$N"
				    "MACHINE HOME STATUS$N"
				    "$N"
				    "0 : MACHINE NOT AT HOME POSITION FOR AUTO CYCLE $N"
				    "1 : MACHINE AT HOME FOR AUTO CYCLE $N"
				    "**********************************************************";
				N: XIC(Machine_Control_ON)[XIO(Machine_Home_For_Auto_Cycle) XIO(Machine_Homing_Started) MOV(0,Machine_home_status) ,XIC(Machine_Home_For_Auto_Cycle) XIO(Machine_Homing_Started) MOV(1,Machine_home_status) ,XIC(Machine_Homing_Started) [XIC(Flash_On.DN) MOV(0,Machine_home_status) ,XIO(Flash_On.DN) MOV(1,Machine_home_status) ] ];
				RC: "********************************************************$N"
				    "MACHINE MISSING INTERLOCK FOR CYCLE START STATUS DISPLAY$N"
				    "$N"
				    "0 : AUTO MODE NOT SELECTED $N"
				    "1 : BAYONET NOT AT HOME POSITION $N"
				    "2 : HORIZONTAL CARRIAGE NOT AT HOME POSITION $N"
				    "3 : VERTICAL CARRIAGE NOT AT HOME $N"
				    "4 : Z20 HEAD INDEX NOT AT HOME $N"
				    "5 : AUTO CYCLE SEQUENCE STARTED $N"
				    "6 : MACHINE IS READY FOR STRAPPING $N"
				    "7 : MACHINE FAULTED WHILE STRAPPING $N"
				    "8 : MACHINE IS OFF$N"
				    "9 : ALARM PRESENT $N"
				    "10 : CYCLE STOPPED , PRESS CYCLE START TO RESUME CYCLE $N"
				    "**********************************************************";
				N: XIC(Machine_Control_ON)XIO(Auto_Mode_Selected)MOV(0,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIC(Machine_Control_ON)XIC(Auto_Mode_Selected)XIO(BAYONET_AT_RETRACT_POSITION)XIO(Auto_Cycle_Start_ON_Latched)MOV(1,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIC(Machine_Control_ON)XIC(Auto_Mode_Selected)XIO(Horizontial_Carriage_At_Home_POSITION)XIO(Auto_Cycle_Start_ON_Latched)MOV(2,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIC(Machine_Control_ON)XIC(Auto_Mode_Selected)XIO(VERTICAL_CARRIAGE_AT_HOME_POSITION_PROXY)XIO(Auto_Cycle_Start_ON_Latched)MOV(3,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIC(Machine_Control_ON)XIC(Auto_Mode_Selected)XIO(Z20_INDEX_POSITION)XIC(Z20_HOME_POSITION)XIO(Auto_Cycle_Start_ON_Latched)MOV(4,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIC(Machine_Control_ON)XIC(Auto_Mode_Selected)XIC(Auto_Cycle_ON)MOV(5,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIC(Machine_Control_ON)XIC(Auto_Mode_Selected)XIC(Machine_Home_For_Auto_Cycle)XIO(Auto_Cycle_Start_ON_Latched)XIO(Alarm_Present)MOV(6,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIC(Machine_Control_ON)XIC(Auto_Mode_Selected)XIC(Alarm_Present)XIC(Auto_Cycle_Start_ON_Latched)MOV(7,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIO(Machine_Control_ON)MOV(8,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIC(Machine_Control_ON)XIC(Alarm_Present)XIO(Auto_Cycle_Start_ON_Latched)MOV(9,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: XIC(Machine_Control_ON)XIO(Alarm_Present)XIC(Auto_Cycle_Start_ON_Latched)XIO(Auto_Cycle_ON)XIO(CYCLE_STOP_PB)MOV(10,Machine_IL_Missing_status_display)JMP(Jump_Label);
				N: LBL(Jump_Label)RET();
		END_ROUTINE

		ROUTINE File12_Diagnostics 
				RC: "*******************************************************************************$N"
				    "VERTICAL CARRIAGE DRIVE COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,Vertical_Carriage,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Vertical_Carriage_drive_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Vertical_Carriage_drive_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "HORIZONTAL CARRIAGE DRIVE COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,Hori_Carriage,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Horizontal_Carriage_drive_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Horizontal_Carriage_drive_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "BAYONET  DRIVE COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,Bayonet,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Bayonet_drive_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Bayonet_drive_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "INPUT MODULE 1 COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,IP_1,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Input_Module_1_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Input_Module_1_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "INPUT MODULE 2 COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,IP_2,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Input_Module_2_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Input_Module_2_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "INPUT MODULE 3 COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,IP_3,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Input_Module_3_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Input_Module_3_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "INPUT MODULE 4 COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,IP_4,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Input_Module_4_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Input_Module_4_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "INPUT MODULE 5 COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,IP_5,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Input_Module_5_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Input_Module_5_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "OUTPUT MODULE 1 COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,OP_1,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Output_Module_1_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Output_Module_1_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "OUTPUT MODULE 2 COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,OP_2,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Output_Module_2_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Output_Module_2_Comm_Fault);
				RC: "*******************************************************************************$N"
				    "OUTPUT MODULE 3 COMMUNICATION FAULT $N"
				    "*********************************************************************************$N"
				    "";
				N: [GSV(Module,OP_3,EntryStatus,Fault_Status) NEQ(Fault_Status,16384) ,XIC(Output_Module_3_Comm_Fault) XIO(FAULT_RESET_ILPB) ]XIC(Always_On)OTE(Output_Module_3_Comm_Fault);
				RC: "#########################################################$N"
				    "FAULT MODULE COMMUNICATION COMMON$N"
				    "#########################################################";
				N: XIC(Machine_Control_ON)[XIC(Vertical_Carriage_drive_Comm_Fault) ,XIC(Horizontal_Carriage_drive_Comm_Fault) ,XIC(Bayonet_drive_Comm_Fault) ,XIC(Input_Module_1_Comm_Fault) ,XIC(Input_Module_2_Comm_Fault) ,XIC(Input_Module_3_Comm_Fault) ,XIC(Input_Module_4_Comm_Fault) ,XIC(Input_Module_5_Comm_Fault) ,XIC(Output_Module_1_Comm_Fault) ,XIC(Output_Module_2_Comm_Fault) ,XIC(Output_Module_3_Comm_Fault) ]OTE(Fault_Module_communication);
		END_ROUTINE

		ROUTINE File13_Dispenser_2 
				RC: "***********************************************************$N"
				    "DISPESNER BRAKE RELEASE TOGGLE $N"
				    "************************************************************";
				N: XIC(DISPENSER_2_SERVICE_SELECTION)XIC(DISPENSER_2_BRAKE_RELEASE)ONS(Break_Release_Temp_Ser_ONS_3)XIO(Disp2_Break_Release_Ser)OTL(Disp2_Break_Release_Temp_Ser);
				N: XIC(DISPENSER_2_SERVICE_SELECTION)XIC(DISPENSER_2_BRAKE_RELEASE)ONS(Break_Release_Temp_Ser_ONS_4)XIC(Disp2_Break_Release_Ser)OTU(Disp2_Break_Release_Temp_Ser);
				N: XIO(DISPENSER_2_SERVICE_SELECTION)OTU(Disp2_Break_Release_Temp_Ser);
				N: XIC(Disp2_Break_Release_Temp_Ser)OTE(Disp2_Break_Release_Ser);
				RC: "***********************************************************$N"
				    "LOOPER AT TOP SET $N"
				    "************************************************************";
				N: XIC(Always_On)[XIC(I_DISPENSER_2_AT_TOP) ,XIC(Z20_PSM_A.T1[14].DN) ,XIC(Manual_Mode_Selected) XIC(FAULT_RESET_ILPB) XIO(CYCLE_STOP_PB) ]OTL(Accu2_Looper_At_Top_Bit);
				N: XIC(Accu2_Looper_At_Top_Bit)XIC(I_DISPENSER_2_AT_BOTTOM)OTU(Accu2_Looper_At_Top_Bit);
				RC: "***********************************************************$N"
				    "DISPENSER CLUTCH OUTPUT $N"
				    "************************************************************";
				N: [XIC(Disp2_Break_Release_Ser) ,XIC(Accu2_Looper_At_Top_Bit) ][OTE(O_DISP2_BRAKE_RELEASE_LAMP) ,OTE(O_DISP2_CLUTCH_OUTPUT) ];
				RC: "***********************************************************$N"
				    "LAMP : DISPENSER SERVICE SELECTION$N"
				    "************************************************************";
				N: XIC(DISPENSER_2_SERVICE_SELECTION)OTE(O_DISP2_SERVICE_SELECTION_LAMP);
		END_ROUTINE

		ROUTINE File14_Signal_Exchange 
				RC: "#########################################################$N"
				    "SIGNAL FROM CUSTOMER TO SIGNODE$N"
				    "#########################################################";
				N: NOP();
				N: MOV(Slab_1_M580:0:I.Data[50],Sunmetals_to_Signode)MOV(Signode_to_Sunmetals,Slab_1_M580:0:O.Data[50]);
				RC: "*********************************************************$N"
				    "SIGNAL CONVEYOR STOPPED$N"
				    "Note : Delete always On while commsisiong $N"
				    "$N"
				    "Note : Conditon to start a cycle from LIne PLC $N"
				    "1 . Machine should be in remote mode $N"
				    "2 : Auto mode selected $N"
				    "3 . No Faults $N"
				    "4 : Machine is ready for cycle bit $N"
				    "5 : E Stop healthy $N"
				    "*********************************************************";
				N: XIC(Sunmetals_to_Signode.0)OTE(Sunmetals_to_Signode_Conveyor_Stopped);
				RC: "*********************************************************$N"
				    "SIGNAL CYCLE START $N"
				    "*********************************************************";
				N: XIC(Sunmetals_to_Signode.1)XIC(Sunmetals_to_Signode_Product_Present)OTE(Sunmetals_to_Signode_Cycle_Start);
				RC: "*********************************************************$N"
				    "PRODUCT PRESENT IN THE CONVEYOR$N"
				    "*********************************************************";
				N: [XIC(Sunmetals_to_Signode.5) ,XIC(Bundle_Status1[0].5) XIC(Bundle_Status_Turnover_complete[0].5) ]OTE(Sunmetals_to_Signode_Product_Present);
				RC: "*********************************************************$N"
				    "TWO STRAP CYCLE$N"
				    "*********************************************************";
				N: AFI()XIC(Sunmetals_to_Signode.6)OTE(Sunmetals_to_Signode_Two_Strap_Cycle);
				RC: "*********************************************************$N"
				    "FOUR  STRAP CYCLE$N"
				    "*********************************************************";
				N: AFI()XIC(Sunmetals_to_Signode.2)OTE(Sunmetals_to_Signode_Four_Strap_Cycle);
				RC: "*********************************************************$N"
				    "LINE EMERGENCY HEALHTY$N"
				    "*********************************************************";
				N: XIC(Sunmetals_to_Signode.4)OTE(Sunmetals_to_Signode_Line_Estop_Healthy);
				RC: "*********************************************************$N"
				    "LINE PULSE TO CHECK COMMUNICATION HEALTHINESS$N"
				    "*********************************************************";
				N: XIC(Sunmetals_to_Signode.3)OTE(Sunmetals_to_Signode_Life_Pulse);
				RC: "#########################################################$N"
				    "SIGNAL FROM SIGNODE TO CUSTOMER$N"
				    "#########################################################";
				N: NOP();
				RC: "*********************************************************$N"
				    "MACHINE AT HOME POSITION$N"
				    "*********************************************************";
				N: XIC(Machine_Home)XIO(Vertical_Carriage:I.Active)XIO(Bayonet:I.Active)EQU(Hori_Drive.ACTUAL_CURRENT,0.0)OTE(Signode_to_Sunmetals_Machine_at_home_Pos);
				RC: "*********************************************************$N"
				    "STRAPPING FINISHED$N"
				    "*********************************************************";
				N: [XIC(Always_Off) XIC(Auto_Cycle_Completed) ,XIC(First_Strap_Cycle_Completed_Indic) XIC(Second_Strap_Cycle_Completed_Indic) XIC(Third_Strap_Cycle_Completed_Indic) XIC(Forth_Strap_Cycle_Completed_Indic) ]OTE(Signode_to_Sunmetals_Strapping_Finished);
				RC: "*********************************************************$N"
				    "MACHINE READY FOR CYCLE START$N"
				    "*********************************************************";
				N: XIC(Machine_Home_For_Auto_Cycle)XIC(Auto_Mode_Selected)OTE(Signode_to_Sunmetals_machine_ready_Cycle);
				RC: "*********************************************************$N"
				    "STRAPPING SEQUENCE IS ACTIVE $N"
				    "$N"
				    "Note : Use this bit as an interlock for conveyor or showing strapping active $N"
				    "status in the line PLC / HMI .$N"
				    "*********************************************************";
				N: [XIC(Auto_Cycle_Start_ON_Latched) ,XIC(Single_Strap_Cycle_ON) ]OTE(Signode_to_Sunmetals_strapp_Seq_active);
				RC: "*********************************************************$N"
				    "MACHINE FAULT$N"
				    "*********************************************************";
				N: XIC(Alarm_Present)OTE(Signode_to_Sunmetals_Machine_Faulted);
				RC: "*********************************************************$N"
				    "DISPENSER 1 STRAP ALMOST EMPTY$N"
				    "*********************************************************";
				N: XIC(FAULT_DISPENSER_1_EMPTY)OTE(Signode_to_Sunmetals_Disp_1_almost_empty);
				RC: "*********************************************************$N"
				    "DISPENSER 2 STRAP ALMOST EMPTY$N"
				    "*********************************************************";
				N: XIC(FAULT_DISPENSER_2_EMPTY)OTE(Signode_to_Sunmetals_Disp_2_almost_empty);
				RC: "*********************************************************$N"
				    "AUTO MODE SELECTED$N"
				    "*********************************************************";
				N: XIC(Auto_Mode_Selected)OTE(Signode_to_Sunmetals_Auto_Mode_On);
				RC: "*********************************************************$N"
				    "SERVICE MODE SELECTED$N"
				    "*********************************************************";
				N: XIC(Service_Mode_Selected)OTE(Signode_to_Sunmetals_Service_Mode_On);
				RC: "*********************************************************$N"
				    "REMOTE MODE SELECTED$N"
				    "*********************************************************";
				N: XIC(Remote_Mode_Selected)OTE(Signode_to_Sunmetals_Remote_Mode_On);
				RC: "*********************************************************$N"
				    "ESTOP HEALTHY$N"
				    "*********************************************************";
				N: XIC(ESTOP_PILZ_OK)OTE(Signode_to_Sunmetals_E_Stop_healthy);
				RC: "*********************************************************$N"
				    "LIFE PULSE$N"
				    "*********************************************************";
				N: XIC(Flash_On.DN)OTE(Signode_to_Sunmetals_Life_Pulse);
				N: XIC(Signode_to_Sunmetals_Auto_Mode_On)OTE(Signode_to_Sunmetals.0);
				N: XIC(Signode_to_Sunmetals_Disp_1_almost_empty)OTE(Signode_to_Sunmetals.1);
				N: XIC(Signode_to_Sunmetals_Disp_2_almost_empty)OTE(Signode_to_Sunmetals.2);
				N: XIC(Signode_to_Sunmetals_E_Stop_healthy)OTE(Signode_to_Sunmetals.3);
				N: XIC(Signode_to_Sunmetals_Life_Pulse)OTE(Signode_to_Sunmetals.4);
				N: XIC(Signode_to_Sunmetals_Machine_at_home_Pos)OTE(Signode_to_Sunmetals.5);
				N: XIC(Signode_to_Sunmetals_Machine_Faulted)OTE(Signode_to_Sunmetals.6);
				N: XIC(Signode_to_Sunmetals_machine_ready_Cycle)OTE(Signode_to_Sunmetals.7);
				N: XIC(Signode_to_Sunmetals_Remote_Mode_On)OTE(Signode_to_Sunmetals.8);
				N: XIC(Signode_to_Sunmetals_Service_Mode_On)OTE(Signode_to_Sunmetals.9);
				N: XIC(Signode_to_Sunmetals_Strapping_Finished)TOF(Delay_Reset,?,?);
				N: XIC(Delay_Reset.DN)OTE(Signode_to_Sunmetals.10);
				N: XIC(Signode_to_Sunmetals_strapp_Seq_active)OTE(Signode_to_Sunmetals.11);
				RC: "*********************************************************$N"
				    "STRAPPING FINISHED$N"
				    "*********************************************************";
				N: XIC(Auto_Cycle_ON)ONS(Attempt)[OTL(Strap_Good) ,CTU(Strapp_attempt,?,?) ];
				RC: "************************************************************$N"
				    "COOMMON FAULT $N"
				    "************************************************************";
				N: [XIC(FAULT_FEED_MOTOR_MPCB_TRIP) ,XIC(FAULT_INDEX_MOTOR_MPCB_TRIP) ,XIC(FAULT_INDEX_TRANSFORMER_MPCB_TRIP) ,XIC(FAULT_Z20_WELD_MOTOR_MPCB_TRIP) ,XIC(FAULT_ESTOP_PRESSED) ,XIC(FAULT_HEAD_LOCKPIN_REMOVED) ,XIC(FAULT_HEAD_NOT_IN_OPERATING_POSITION) ,XIC(FAULT_LOOPER_LS_FAULTY) ,XIC(FAULT_DISPENSER_2_LOOPER_LS_FAULTY) ,XIC(FAULT_DISPENSER_1_CLUTCH_MCB_TRIPPED) ,XIC(FAULT_DISPENSER_2_CLUTCH_MCB_TRIPPED) ,XIC(FAULT_Z20_HEAD_CLUTCH_MCB_TRIPPED) ,XIC(Bayonet_Fault) ,XIC(Fault_Feed_timedout) ,XIC(Hori_Carrige_Fault) ,XIC(Fault_SEW_Referancing) ,XIC(Fault_SEW_Axis) ,XIC(VERTICAL_CARRIAGE_FAULT) ,XIC(Fault_Bubble_Out) ,XIC(Fault_Control_ON_Absent) ,XIC(Fault_Module_communication) ,XIC(FAULT_HORZ_CARRIAGE_NOT_REFERENCED) ,XIC(FAULT_PROD_PRESENCE_MISSING_FROM_CUST) ]XIC(Strap_Good)OTU(Strap_Good);
				N: XIC(Signode_to_Sunmetals_Machine_at_home_Pos)XIC(Strap_Good)[CTU(Strapp_Goodh,?,?) ,OTU(Strap_Good) ];
				N: EQU(Wall_Clock.Hour,6)ONS(move)[ADD(Strapp_Good_Life,Strapp_Goodh.ACC,Strapp_Good_Life) ,ADD(Strapp_Attempt_Life,Strapp_attempt.ACC,Strapp_Attempt_Life) ,RES(Strapp_Goodh) RES(Strapp_attempt) ];
				N: GRT(Strapp_attempt.ACC,1)CPT(Strapper_Efficiency,(Strapp_Goodh.ACC/Strapp_attempt.ACC)*100);
				N: [MOV(Strapp_Goodh.ACC,STRAPP_MSG[0]) MOV(Strapp_attempt.ACC,STRAPP_MSG[1]) MOV(Strapp_Attempt_Life,STRAPP_MSG[2]) MOV(Strapp_Good_Life,STRAPP_MSG[3]) MOV(Strapper_Efficiency,STRAPP_MSG[4]) ,EQU(Wall_Clock.Second,30) MSG(Strap1_Stst_MSg) ];
		END_ROUTINE

		ROUTINE _00_Main (Description := "Jump to subroutines")
				N: JSR(File06_Bayonet,0);
				N: JSR(File09_Machine_Main,0);
				N: JSR(File10_Vertical_Carriage,0);
				N: JSR(File00_Alarms,0);
				N: JSR(File08_Horizontial_Carriage,0);
				N: JSR(File01_Head_Alarms,0);
				N: JSR(File02_Head_Efficiency,0);
				N: JSR(File03_Z20_Head_IO,0);
				N: JSR(File04_Z20_Index,0);
				N: JSR(File07_Dispenser_1,0);
				N: JSR(File13_Dispenser_2,0);
				N: JSR(File05_Z20_PSM,0);
				N: JSR(File11_HMI_Display,0);
				N: JSR(File12_Diagnostics,0);
				N: JSR(File14_Signal_Exchange,0);
		END_ROUTINE

		CHILD_PROGRAMS
		END_CHILD_PROGRAMS

	END_PROGRAM

	TASK MainTask (Type := CONTINUOUS,
	               Rate := 10,
	               Priority := 10,
	               Watchdog := 500,
	               DisableUpdateOutputs := No,
	               InhibitTask := No)
			Strapping_Machine;
			OLD_Strapping_Machine;
			KUKA_ROBOT;
	END_TASK

	TASK PWM_Task (Type := PERIODIC,
	               Rate := 10,
	               Priority := 10,
	               Watchdog := 500,
	               DisableUpdateOutputs := No,
	               InhibitTask := No)
			Channel1Program;
	END_TASK

CONFIG CST(SystemTimeMasterID := 0) END_CONFIG

CONFIG EthernetPort1(Label := "A1",
	                             PortEnabled := 1) END_CONFIG

CONFIG EthernetPort2(Label := "A2",
	                             PortEnabled := 1) END_CONFIG

CONFIG TimeSynchronize(Priority1 := 128,
	                                 Priority2 := 128,
	                                 PTPEnable := 1) END_CONFIG

CONFIG WallClockTime(LocalTimeAdjustment := 0,
	                     TimeZone := 0) END_CONFIG

END_CONTROLLER

