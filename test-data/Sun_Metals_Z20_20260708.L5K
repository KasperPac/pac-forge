			                      ExternalAccess := None,
			                      DefaultData := 0);
			PrevIndexing : BOOL (RADIX := Decimal,
			                       ExternalAccess := None,
			                       DefaultData := 0);
			IndexingStarted : BOOL (RADIX := Decimal,
			                          ExternalAccess := None,
			                          DefaultData := 0);
			ErrorDistance : DINT (RADIX := Decimal,
			                        ExternalAccess := None,
			                        DefaultData := 0);
			PrevReset : BOOL (RADIX := Decimal,
			                    ExternalAccess := None,
			                    DefaultData := 0);
		END_LOCAL_TAGS

		ST_ROUTINE Logic 
			'// --- First-time init ---
			'IF NOT Initialized THEN
			'    StackX := IdealOffset;
			'    Initialized := 1;
