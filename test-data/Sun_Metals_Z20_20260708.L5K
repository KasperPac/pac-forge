			L_AOI_Fault : BOOL (RADIX := Decimal,
			                      ExternalAccess := None,
			                      DefaultData := 0);
			L_bInit : BOOL (Description := "TRUE :=  Initialization of AOI completed",
			                  RADIX := Decimal,
			                  ExternalAccess := None,
			                  DefaultData := 0);
			L_AOI_Fault_No : INT (RADIX := Decimal,
			                         ExternalAccess := None,
			                         DefaultData := 0);
		END_LOCAL_TAGS

		ST_ROUTINE Logic 
			'//===================================================================================================================================================
			'//
			'//	SAFETY NOTES
			'//	------------
			'//	This sample program shows the basic approach only. 
			'//	For defective program functions and their consequences whether judical or any other accountability will be assumed.
			'//
			'//
			'//	PROGRAM DESCRIPTION
			'//	-------------------
			'//	This add on instruction (AOI) allows the user to control the extended bus positioning via single input bits. 
			'//	He only has to link the processdata input/output of the AOI to the ethernet input.data/output.data of the device.
			'//	The process data input is copied consitently (cps-command) into internal (local) variables. The local variables are processed
			'//	and copied consistently to the processdata output.
			'//
			'//	Due to the fact, that SINT (Byte) ist used as varaible type, it doesn't matter, if a generic ethernet device is used or the .eds file is used
			'//	directly. To run this sample, select SINT as datatype in the configuration.
			'//	The direct use of the .eds file is only possible, if the version of the controller and the RSLogiy software is newer the V19 (from V20 on).	
			'//	
			'//===================================================================================================================================================
			'if not(L_bInit) then
			'	L_ByteMod := START_BYTE mod 2;
			'	if L_ByteMod = 0 then
			'		L_AOI_Fault := 0;
			'		L_bInit := 1;
			'	else
			'		L_AOI_Fault := 1;
			'		L_AOI_Fault_No := 1;
			'		L_bInit := 0;
			'	end_if;
			'end_if;
			'
			'if L_bInit then
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Copying processdata input interface into local variables. 
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	CPS(PD_INPUT[0+START_BYTE], L_Status_Low, 1); 				//Statusword Low Byte
			'	CPS(PD_INPUT[1+START_BYTE], L_Status_High, 1);				//Statusword High Byte
			'	CPS(PD_INPUT[2+START_BYTE], L_Actual_Position_IN, 4);		//Actual Position
			'	CPS(PD_INPUT[6+START_BYTE], L_Actual_Speed, 2); 			//Actual Speed
			'	CPS(PD_INPUT[8+START_BYTE], L_Active_Current_IN, 2); 			//Active Current
			'	CPS(PD_INPUT[10+START_BYTE], L_Device_Utilisation, 2);		//Device utilisation
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Setting communication error
			'	//--------------------------------------------------------------------------------------------------------------------------------------------------
			'	if COMMUNICATION_FAULT then		//Communication Error
			'		L_AOI_Fault := 1;
			'		L_AOI_Fault_No := 2;
			'	else
			'		L_AOI_Fault := 0;
			'		L_AOI_Fault_No := 0;
			'	end_if;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Copying control data into local variables
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Setpoint_Speed := SETPOINT_SPEED;				//Setpoint Speed
			'	L_Setpoint_Position_IN := SETPOINT_POS;			//Setpoint Position
			'	L_Start_Ramp := START_RAMP;						//Start Ramp
			'	L_Stop_Ramp := STOP_RAMP;						//Stop Ramp
			'	L_Enable_Rapid_Stop := ENABLE_RAPID_STOP;		//Enable/Rapid Stop
			'	L_Jog_Plus_Mode := JOG_PLUS_MODE;				//Jog Plus Mode
			'	L_Jog_Minus_Mode := JOG_MINUS_MODE;				//Jog Minus Mode
			'	L_Position_Mode := POSITIONING_MODE;			//Positioning Mode
			'	L_Reference_Mode := REF_TRAVEL_MODE;			//Reference Mode
			'	L_Reset_Fault := RESET;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Deviding the Status word into the single status bits. 
			'	//	Getting the Error Code via BitShift operation.
			'	//	Storing the bits into local variables
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Motor_Turning := L_Status_Low.0;				//Bit "Motor Turning"
			'	L_Inverter_Ready := L_Status_Low.1;				//Bit "Inverter Ready"
			'	L_Referenced := L_Status_Low.2;					//Bit "IPOS Reference"
			'	L_Target_Position_Reached := L_Status_Low.3;	//Bit "Target Position Reached"	
			'	L_Brake_Released := L_Status_Low.4;				//Bit "Brake Released"
			'	L_Error := L_Status_Low.5;						//Bit "Error"
			'	L_LimitSwitch_CW := L_Status_Low.6;				//Bit "Limit Switch CW"
			'	L_LimitSwitch_CCW := L_Status_Low.7;			//Bit "Limit Switch CCW"
			'	L_Fault_No := L_Status_High;					//Fault No
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Generating a waring/error of the inverter.
			'	//	A warning is generated when the inverter is ready and the error bit is set
			'	//	Processing error number. --> setting L_Error_No to zero, if no error occures
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	if L_Inverter_Ready & L_Error then 			//Setting a warning
			'		L_Warning_of_Axis := 1;
			'	elsif not(L_Inverter_Ready) & L_Error then	//Setting an error
			'		L_Fault_of_Axis := 1;
			'	else										//No warning AND no error
			'		L_Warning_of_Axis := 0;
			'		L_Fault_of_Axis := 0;
			'	end_if;
			'
			'	if not(L_Error) then						//Generating Fault_No in case of Error
			'		L_Fault_No := 0;
			'	end_if;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Scaling values after converting INT to REAL
			'	//	--> it is possible this way, because INT := 16bit, non floating and REAl := 32bit, floating (the other way round would not work out)
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Active_Current_OUT := L_Active_Current_IN;
			'	L_Active_Current_OUT := L_Active_Current_OUT/10;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Switching Position Words
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	BitShift.Source := L_Setpoint_Position_IN;						//Switching setpoint position
			'	BitShift.SourceBit := 0;
			'	BitShift.Length := 16;
			'	BitShift.DestBit := 0;
			'	BTDT(BitShift);
			'	L_Setpoint_Position_High := BitShift.Dest;
			'
			'	BitShift.SourceBit := 16;
			'	BitShift.Length := 16;
			'	BitShift.DestBit := 0;
			'	BTDT(BitShift);
			'
			'	L_Setpoint_Position_Low := BitShift.Dest;
			'	L_Setpoint_Position_OUT[0] := L_Setpoint_Position_Low;
			'	L_Setpoint_Position_OUT[1] := L_Setpoint_Position_High;
			'
			'	BitShift.Source := L_Actual_Position_IN;						//Switching actual position
			'	BitShift.SourceBit := 0;
			'	BitShift.Length := 16;
			'	BitShift.DestBit := 0;
			'	BTDT(BitShift);
			'	L_Actual_Position_High := BitShift.Dest;
			'
			'	BitShift.SourceBit := 16;
			'	BitShift.Length := 16;
			'	BitShift.DestBit := 0;
			'	BTDT(BitShift);
			'	L_Actual_Position_Low := BitShift.Dest;
			'
			'	L_Actual_Position_OUT[0] := L_Actual_Position_Low;
			'	L_Actual_Position_OUT[1] := L_Actual_Position_High;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Processing the control/input bits
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	if L_Jog_Plus_Mode & not(L_Jog_Minus_Mode) & not(L_Reference_Mode) & not(L_Position_Mode) then						//Function "Jog Plus" chosen
			'		L_Control := 16#A00;		//Set bits for "Jog Plus" mode --> High Byte
			'		L_Control.2 := 1;			//Set bit "Enable/Stop"
			'		L_Axis_Interlocked := 0;	//Resetting bit "L_Axis_Interlocked"
			'	elsif L_Jog_Minus_Mode & not(L_Jog_Plus_Mode) & not(L_Reference_Mode) & not(L_Position_Mode) then					//Function "Jog Minus" chosen
			'		L_Control := 16#C00;		//Set bits for "Jog Minus" mode --> High Byte
			'		L_Control.2 := 1;			//Set bit "Enable/Stop"
			'		L_Axis_Interlocked := 0;	//Resetting bit "L_Axis_Interlocked"
			'	elsif L_Reference_Mode & not(L_Jog_Minus_Mode) & not(L_Jog_Plus_Mode) & not(L_Position_Mode) then					//Function "Reference" chosen
			'		L_Control := 16#1000;		//Set bits for "Refernce" mode --> High Byte
			'		L_Control.2 := 1;			//Set bit "Enable/Stop"
			'		L_Axis_Interlocked := 0;	//Resetting bit "L_Axis_Interlocked"
			'	elsif L_Position_Mode & not(L_Reference_Mode) & not(L_Jog_Minus_Mode) & not(L_Jog_Plus_Mode) & L_Referenced then	//Function "Position" chosen
			'	 	L_Control := 16#1800;		//Set bits for "Position" mode --> High Byte
			'		L_Control.2 := 1;			//Set bit "Enable/Stop"	
			'		L_Axis_Interlocked := 0;	//Resetting bit "L_Axis_Interlocked"
			'	else																												//Implausible mode chosen
			'		L_Control := 16#0;			//Resetting High Byte																													
			'		L_Axis_Interlocked := 1;	//Setting bit "L_Axis_Interlocked"
			'		//-----------------------------------------------------------------------------------------------------------------------------------------------
			'		// setting fault for implausible mode
			'		//-----------------------------------------------------------------------------------------------------------------------------------------------
			'		L_AOI_Fault := 1;
			'		L_AOI_Fault_No := 3;
			'	end_if;
			'
			'	if L_Brake_Released & not(L_Axis_Interlocked) then																							//Set bit "Start", if brake is released
			'		L_Control.8 := 1;
			'	end_if;
			'
			'	L_Control.1 := L_Enable_Rapid_Stop;																	//Set bit "Enable/Rapid stop" of control word
			'	L_Control.6 := L_Reset_Fault;																		//Set bit "Reset" of control word
			'																	
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Resetting all unused/unnecessary bits of the control word
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	L_Control.0 := 0;				//Controller Inhibit --> Controller always enabled
			'	L_Control.3 := 0;				//Halt regulation --> always disabled
			'	L_Control.4 := 0;				//Integrator 1
			'	L_Control.5 := 0;				//Parameterset switchover --> always disabled
			'	L_Control.13 := 0;				//Reserved --> always disabled
			'	L_Control.14 := 0;				//Ramp 2 --> always disabled
			'	L_Control.15 := 0;				//not(SEWS) --> always disabled			
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Setting Output variables
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	INVERTER_READY := L_Inverter_Ready;						//Inverter ready
			'	ACTUAL_CURRENT := L_Active_Current_OUT;						//Actual Current
			'	REFERENCED := L_Referenced;								//Referenced
			'	TARGET_POS_REACHED := L_Target_Position_Reached;		//Target Position Reached
			'	AXIS_FAULT_NO := L_Fault_No;									//Fault Number
			'	WARNING_OF_AXIS := L_Warning_of_Axis;					//Warning of Axis
			'	FAULT_OF_AXIS := L_Fault_of_Axis;						//Fault of Axis
			'	AXIS_INTERLOCKED := L_Axis_Interlocked;					//Axis Interlocked
			'	cop(L_Actual_Position_OUT[0], ACTUAL_POSITION, 2);		//Actual Position --> cop command needed because of word shifting
			'	ACTUAL_SPEED := L_Actual_Speed;							//Actual Speed
			'
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Resetting all processdata output variable to "0"
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	if L_AOI_Fault then
			'		L_Control := 0;
			'		L_Setpoint_Speed := 0;
			'		L_Setpoint_Position_OUT[0] := 0;
			'		L_Setpoint_Position_OUT[1] := 0;
			'		L_Start_Ramp := 0;
			'		L_Stop_Ramp := 0;
			'	end_if;
			'
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	//	Copying local variables to processdata output interface
			'	//---------------------------------------------------------------------------------------------------------------------------------------------------
			'	cps(L_Control, PD_OUTPUT[0+START_BYTE], 2);
			'	cps(L_Setpoint_Position_OUT[0], PD_OUTPUT[2+START_BYTE],4);	
			'	cps(L_Setpoint_Speed, PD_OUTPUT[6+START_BYTE], 2);
			'	cps(L_Start_Ramp, PD_OUTPUT[8+START_BYTE], 2);
			'	cps(L_Stop_Ramp, PD_OUTPUT[10+START_BYTE], 2);
			'end_if;
			'FAULT_OF_AOI := L_AOI_Fault;
			'AOI_FAULT_NO := L_AOI_Fault_No;
		END_ST_ROUTINE

	END_ADD_ON_INSTRUCTION_DEFINITION

	ENCODED_DATA (EncodedType := ADD_ON_INSTRUCTION_DEFINITION,
	              Name := "AOI_BNI006A_50_31_040",
	              Description := "BNI EIP-508-105-Z015",
