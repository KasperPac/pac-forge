				N: XIC(B3[18].0)ONS(B3[18].1)[XIO(N7[11].0) [OTL(N7[11].0) ,OTL(B3[18].10) ,COP(ST12[40],ST12[27],1) ] ,XIC(N7[11].0) XIO(B3[18].10) [OTU(N7[11].0) ,COP(ST12[39],ST12[27],1) ] ,[OTU(B3[18].10) ,OTU(B3[18].0) ] ];
				RC: "Weigher Position Manual reject Pass/Fail of the a bundle";
				N: XIC(B3[18].2)ONS(B3[18].3)[XIO(N7[11].1) [OTL(N7[11].1) ,OTL(B3[18].10) ,COP(ST12[40],ST12[28],1) ] ,XIC(N7[11].1) XIO(B3[18].10) [OTU(N7[11].1) ,COP(ST12[39],ST12[28],1) ] ,[OTU(B3[18].10) ,OTU(B3[18].2) ] ];
				RC: "LaserAx Position Manual reject Pass/Fail of the a bundle";
				N: XIC(B3[18].4)ONS(B3[18].5)[XIO(N7[11].2) [OTL(N7[11].2) ,OTL(B3[18].10) ,COP(ST12[40],ST12[29],1) ] ,XIC(N7[11].2) XIO(B3[18].10) [OTU(N7[11].2) ,COP(ST12[39],ST12[29],1) ] ,[OTU(B3[18].10) ,OTU(B3[18].4) ] ];
				RC: "Pos 1 Position Manual reject Pass/Fail of the a bundle";
				N: XIC(B3[18].6)ONS(B3[18].7)[XIC(Slab1_Load_in_Posn_1_PLC) XIO(N7[11].3) [OTL(N7[11].3) ,OTL(B3[18].10) ,XIO(Reject_Integer_changeover) COP(ST12[40],Slab1_Reject_Reason_Posn_1_PLC,1) ,MOV(1,N15[33]) ] ,XIC(Slab1_Load_in_Posn_1_PLC) XIC(N7[11].3) XIO(B3[18].10) [OTU(N7[11].3) ,XIO(Reject_Integer_changeover) COP(ST12[39],Slab1_Reject_Reason_Posn_1_PLC,1) ,MOV(0,N15[33]) ] ,[OTU(B3[18].10) ,OTU(B3[18].6) ] ];
				RC: "Pos 2 Position Manual reject Pass/Fail of the a bundle";
				N: XIC(B3[18].8)ONS(B3[18].9)[XIC(Slab1_Load_in_Posn_2_PLC) XIO(N7[11].4) [OTL(N7[11].4) ,OTL(B3[18].10) ,XIO(Reject_Integer_changeover) COP(ST12[40],Slab1_Reject_Reason_Posn_2_PLC,1) ,MOV(1,N15[32]) ] ,XIC(Slab1_Load_in_Posn_2_PLC) XIC(N7[11].4) XIO(B3[18].10) [OTU(N7[11].4) ,XIO(Reject_Integer_changeover) COP(ST12[39],Slab1_Reject_Reason_Posn_2_PLC,1) ,MOV(0,N15[32]) ] ,[OTU(B3[18].10) ,OTU(B3[18].8) ] ];
		END_ROUTINE

		ROUTINE MAIN_JSR (Description := "Jump to subroutines")
				N: GSV(WallClockTime,,LocalDateTime,PLC_Clock[0]);
				N: JSR(A_PLC_COMMS,0);
				N: JSR(B_LASERAX,0);
				N: JSR(C_A_WEIGHING,0);
				N: JSR(D_AGV,0);
				N: JSR(E_QA_CAMERA,0);
				N: JSR(R_B_UNSORTED,0);
				N: JSR(R_C_ROBOT,0);
				N: JSR(R_D_LAMP,0);
				N: JSR(R_E_FEED_STACK,0);
				N: JSR(R_F_STOPPER,0);
				N: JSR(Statistics,0);
				N: JSR(Statistics_2,0);
				N: JSR(Reject_Integer,0);
				N: GSV(WallClockTime,,LocalDateTime,Wall_Clock.Year);
		END_ROUTINE

		ROUTINE Reject_Integer 
				RC: "Incomplete build integer$N"
				    "works out if the robot has built a incomplete bundle, then indexes the integer down conveyor";
				N: XIO(Complete_Bundle)XIC(R_B3[2].0)GEQ(bundle_counter.ACC,1)OTL(Integer_Incomplete_build[0].0);
				N: [XIC(Complete_Bundle) XIC(R_B3[2].0) ,XIO(R_B3[2].0) ]OTU(Integer_Incomplete_build[0].0);
				N: XIO(B3[4].3)XIO(Complete_Bundle)XIO(R_B3[2].0)GEQ(bundle_counter.ACC,1)OTL(Integer_Incomplete_build[0].1);
				N: XIC(Complete_Bundle)XIO(R_B3[2].0)OTU(Integer_Incomplete_build[0].1);
				RC: "Not turned over integer$N"
				    "works out if the turnover was unsucessful, then indexes the integer down conveyor";
				N: XIC(Turn_Over_Flipper)[XIC(positive_sig_K1.DN) CTU(Turnover_counter_K1,?,?) ,TON(positive_sig_K1,?,?) ];
				N: XIC(R_I_3_9)[XIC(reset_delay_turnover_K1.DN) RES(Turnover_counter_K1) ,TON(reset_delay_turnover_K1,?,?) ];
				RC: "Successful turnover Integer$N"
				    "works out if the robot has successfully turned over the top ingots, then indexes the integer down conveyor";
				N: XIO(Turnover_counter_K1.DN)XIC(R_B3[2].0)GEQ(bundle_counter.ACC,1)OTL(Integer_Not_Turned_Over[0].0);
				N: [XIC(Turnover_counter_K1.DN) XIO(IngotCnt_Failed) XIC(R_B3[2].0) ,XIO(R_B3[2].0) ]OTU(Integer_Not_Turned_Over[0].0);
				N: XIO(B3[4].3)XIO(Turnover_counter_K1.DN)XIO(R_B3[2].0)GEQ(bundle_counter.ACC,1)OTL(Integer_Not_Turned_Over[0].1);
				N: XIC(Turnover_counter_K1.DN)XIO(IngotCnt_Failed)XIO(R_B3[2].0)OTU(Integer_Not_Turned_Over[0].1);
				RC: "Ingot Dropped Detect";
				N: XIC(Clamp1_Close)XIC(Clamp2_Close)[XIO(R_I_2_8) ,XIO(R_I_2_9) ]XIC(swap_position)XIC(R_I_2_13)XIO(Bitshift_delay_drop.DN)OTL(Integer_Dropped_Ingot[0].0);
				N: XIC(Clamp1_Close)XIC(Clamp2_Close)XIO(swap_position)XIC(R_I_2_13)OTU(Integer_Dropped_Ingot[0].0);
				N: XIC(Clamp1_Close)XIC(Clamp2_Close)[XIO(R_I_2_8) ,XIO(R_I_2_9) ]XIO(swap_position)XIC(R_I_2_13)[XIO(Bitshift_delay_drop.DN) ,XIC(Bitshift_delay_drop.DN) XIC(North_Drop) ][TON(Drop_delay_K1,?,?) ,XIC(Drop_delay_K1.DN) OTL(Integer_Dropped_Ingot[0].1) ];
				N: [XIC(Bitshift_delay_K1.TT) XIC(Integer_Dropped_Ingot[0].0) OTL(North_Drop) ,XIO(Bitshift_delay_K1.DN) XIO(Bitshift_delay_K1.EN) OTU(North_Drop) ];
				N: XIO(Signode_to_Sunmetals.10)OTL(Integer_Missing_Strap[0].5);
				N: XIC(Signode_to_Sunmetals.10)OTU(Integer_Missing_Strap[0].5);
				N: XIC(S_I_7_4)[GRT(N7[2],1050) ,LES(N7[2],950) ]ONS(Weight_ONS)OTL(Integer_Out_Of_Weight[0].7);
				N: XIO(B3[61].12)XIC(Conveyor_Ran)OTL(Integer_Failed_Laser_Etch[0].8);
				N: XIC(B3[61].12)OTU(Integer_Failed_Laser_Etch[0].8);
				RC: "Load reject from incomplete, not turned over or dropped ingot into spare position on total line integer";
				N: [XIC(Integer_Incomplete_build[0].2) ,XIC(Integer_Not_Turned_Over[0].2) ,XIC(Integer_Dropped_Ingot[0].2) ]XIO(R_B3[2].8)ONS(Total_ONS1)OTL(Integer_Total_Line[0].2);
				RC: "Load reject from Strap missing into QA position on total line integer";
				N: XIC(Integer_Missing_Strap[0].6)XIO(R_B3[2].8)ONS(Total_ONS2)OTL(Integer_Total_Line[0].6);
				RC: "Load reject reason from weigher into weigher position on total line integer";
				N: XIC(Integer_Out_Of_Weight[0].8)XIO(R_B3[2].8)ONS(Total_ONS3)OTL(Integer_Total_Line[0].8);
				RC: "Load reject reason from weigher into weigher position on total line integer";
				N: XIC(Integer_Failed_Laser_Etch[0].9)XIO(R_B3[2].8)ONS(Total_ONS4)OTL(Integer_Total_Line[0].9);
				N: XIO(B3[4].3)XIC(R_B3[2].8)XIC(Integer_Incomplete_build[0].9)ONS(String_ONS1)CONCAT(Reject_Reason[0],Reject_Reason[9],Reject_Reason[9]);
				N: XIO(B3[4].3)XIC(R_B3[2].8)XIC(Integer_Not_Turned_Over[0].9)ONS(String_ONS2)CONCAT(Reject_Reason[1],Reject_Reason[9],Reject_Reason[9]);
				N: XIO(B3[4].3)XIC(R_B3[2].8)XIC(Integer_Dropped_Ingot[0].9)ONS(String_ONS3)CONCAT(Reject_Reason[2],Reject_Reason[9],Reject_Reason[9]);
				N: XIO(B3[4].3)XIC(R_B3[2].8)XIC(Integer_Missing_Strap[0].9)ONS(String_ONS4)CONCAT(Reject_Reason[3],Reject_Reason[9],Reject_Reason[9]);
				N: XIO(B3[4].3)XIC(R_B3[2].8)XIC(Integer_Out_Of_Weight[0].9)ONS(String_ONS5)CONCAT(Reject_Reason[4],Reject_Reason[9],Reject_Reason[9]);
				N: XIO(B3[4].3)XIC(R_B3[2].8)XIC(Integer_Failed_Laser_Etch[0].9)ONS(String_ONS6)CONCAT(Reject_Reason[5],Reject_Reason[9],Reject_Reason[9]);
				N: XIO(B3[4].3)XIC(R_B3[2].8)XIC(Integer_Operator_Failed[0].9)ONS(String_ONS7)CONCAT(Reject_Reason[7],Reject_Reason[9],Reject_Reason[9]);
				N: XIC(Reject_Integer_changeover)XIO(Reject_Integer_Bypass)[MOV(Reject_Reason[9],Slab1_Reject_Reason_Posn_1_PLC) ,MOV(Reject_Reason[10],Slab1_Reject_Reason_Posn_2_PLC) ,MOV(Reject_Reason[11],Slab1_Reject_Reason_Posn_a_PLC) ];
				N: XIC(Reject_Integer_changeover)XIC(Reject_Integer_Bypass)[OTU(Integer_Total_Line[0].9) OTU(Integer_Total_Line[0].10) OTU(Integer_Total_Line[0].11) ,MOV(Reject_Reason[6],Reject_Reason[9]) ];
				RC: "Fault finding for Total Line integer Reject";
				N: XIC(Integer_Total_Line[0].0)XIC(Integer_Total_Line[0].1)XIC(Integer_Total_Line[0].2)XIC(Integer_Total_Line[0].3)XIC(Integer_Total_Line[0].4)XIC(Integer_Total_Line[0].5)XIC(Integer_Total_Line[0].6)XIC(Integer_Total_Line[0].7)XIC(Integer_Total_Line[0].8)XIC(Integer_Total_Line[0].9)XIC(Integer_Total_Line[0].10)XIC(Integer_Total_Line[0].11)OTE(Dummy);
				RC: "Fault finding for Incomplete Build Integer Reject";
				N: XIC(Integer_Incomplete_build[0].0)XIC(Integer_Incomplete_build[0].1)XIC(Integer_Incomplete_build[0].2)XIC(Integer_Incomplete_build[0].3)XIC(Integer_Incomplete_build[0].4)XIC(Integer_Incomplete_build[0].5)XIC(Integer_Incomplete_build[0].6)XIC(Integer_Incomplete_build[0].7)XIC(Integer_Incomplete_build[0].8)XIC(Integer_Incomplete_build[0].9)XIC(Integer_Incomplete_build[0].10)XIC(Integer_Incomplete_build[0].11)OTE(Dummy);
				RC: "Fault finding for Not Turned Over Integer Reject";
				N: XIC(Integer_Not_Turned_Over[0].0)XIC(Integer_Not_Turned_Over[0].1)XIC(Integer_Not_Turned_Over[0].2)XIC(Integer_Not_Turned_Over[0].3)XIC(Integer_Not_Turned_Over[0].4)XIC(Integer_Not_Turned_Over[0].5)XIC(Integer_Not_Turned_Over[0].6)XIC(Integer_Not_Turned_Over[0].7)XIC(Integer_Not_Turned_Over[0].8)XIC(Integer_Not_Turned_Over[0].9)XIC(Integer_Not_Turned_Over[0].10)XIC(Integer_Not_Turned_Over[0].11)OTE(Dummy);
				RC: "Fault finding for Dropped Ingot Integer Reject";
				N: XIC(Integer_Dropped_Ingot[0].0)XIC(Integer_Dropped_Ingot[0].1)XIC(Integer_Dropped_Ingot[0].2)XIC(Integer_Dropped_Ingot[0].3)XIC(Integer_Dropped_Ingot[0].4)XIC(Integer_Dropped_Ingot[0].5)XIC(Integer_Dropped_Ingot[0].6)XIC(Integer_Dropped_Ingot[0].7)XIC(Integer_Dropped_Ingot[0].8)XIC(Integer_Dropped_Ingot[0].9)XIC(Integer_Dropped_Ingot[0].10)XIC(Integer_Dropped_Ingot[0].11)OTE(Dummy);
				RC: "Fault finding for Missing Strap Integer Reject";
				N: XIC(Integer_Missing_Strap[0].0)XIC(Integer_Missing_Strap[0].1)XIC(Integer_Missing_Strap[0].2)XIC(Integer_Missing_Strap[0].3)XIC(Integer_Missing_Strap[0].4)XIC(Integer_Missing_Strap[0].5)XIC(Integer_Missing_Strap[0].6)XIC(Integer_Missing_Strap[0].7)XIC(Integer_Missing_Strap[0].8)XIC(Integer_Missing_Strap[0].9)XIC(Integer_Missing_Strap[0].10)XIC(Integer_Missing_Strap[0].11)OTE(Dummy);
				RC: "Fault finding for Out of Weight Integer Reject";
				N: XIC(Integer_Out_Of_Weight[0].0)XIC(Integer_Out_Of_Weight[0].1)XIC(Integer_Out_Of_Weight[0].2)XIC(Integer_Out_Of_Weight[0].3)XIC(Integer_Out_Of_Weight[0].4)XIC(Integer_Out_Of_Weight[0].5)XIC(Integer_Out_Of_Weight[0].6)XIC(Integer_Out_Of_Weight[0].7)XIC(Integer_Out_Of_Weight[0].8)XIC(Integer_Out_Of_Weight[0].9)XIC(Integer_Out_Of_Weight[0].10)XIC(Integer_Out_Of_Weight[0].11)OTE(Dummy);
				RC: "Fault finding for Out of Weight Integer Reject";
				N: XIC(Integer_Operator_Failed[0].0)XIC(Integer_Operator_Failed[0].1)XIC(Integer_Operator_Failed[0].2)XIC(Integer_Operator_Failed[0].3)XIC(Integer_Operator_Failed[0].4)XIC(Integer_Operator_Failed[0].5)XIC(Integer_Operator_Failed[0].6)XIC(Integer_Operator_Failed[0].7)XIC(Integer_Operator_Failed[0].8)XIC(Integer_Operator_Failed[0].9)XIC(Integer_Operator_Failed[0].10)XIC(Integer_Operator_Failed[0].11)OTE(Dummy);
				RC: "Fault finding for Operator Failed Integer Reject";
				N: XIC(Integer_Failed_Laser_Etch[0].0)XIC(Integer_Failed_Laser_Etch[0].1)XIC(Integer_Failed_Laser_Etch[0].2)XIC(Integer_Failed_Laser_Etch[0].3)XIC(Integer_Failed_Laser_Etch[0].4)XIC(Integer_Failed_Laser_Etch[0].5)XIC(Integer_Failed_Laser_Etch[0].6)XIC(Integer_Failed_Laser_Etch[0].7)XIC(Integer_Failed_Laser_Etch[0].8)XIC(Integer_Failed_Laser_Etch[0].9)XIC(Integer_Failed_Laser_Etch[0].10)XIC(Integer_Failed_Laser_Etch[0].11)OTE(Dummy);
				N: XIO(R_B3[2].8)XIC(B3[4].3)[TON(Bitshift_delay_K1,?,?) ,TON(Bitshift_delay_K2,?,?) ,XIC(Bitshift_delay_K1.DN) BSL(Integer_Incomplete_build,BSL_Control_K1,Integer_Incomplete_build[0].0,?) ,XIC(Bitshift_delay_K1.DN) BSL(Integer_Not_Turned_Over,BSL_Control_K2,Integer_Not_Turned_Over[0].0,?) ,XIC(Bitshift_delay_K1.DN) BSL(Integer_Dropped_Ingot,BSL_Control_K3,Integer_Dropped_Ingot[0].0,?) ,XIC(Bitshift_delay_K1.DN) BSL(Integer_Out_Of_Weight,BSL_Control_K4,Integer_Out_Of_Weight[0].0,?) ,XIC(Bitshift_delay_K1.DN) BSL(Integer_Missing_Strap,BSL_Control_K5,Integer_Missing_Strap[0].0,?) ,XIC(Bitshift_delay_K1.DN) BSL(Integer_Failed_Laser_Etch,BSL_Control_K6,Integer_Failed_Laser_Etch[0].0,?) ,XIC(Bitshift_delay_K1.DN) BSL(Integer_Operator_Failed,BSL_Control_K7,Integer_Operator_Failed[0].0,?) ,XIC(Bitshift_delay_K1.DN) BSL(Integer_Total_Line,BSL_Control_K8,Integer_Total_Line[0].0,?) ,XIC(Bitshift_delay_K1.DN) MOV(Reject_Reason[9],Reject_Reason[10]) ,XIC(Bitshift_delay_K1.DN) MOV(Reject_Reason[10],Reject_Reason[11]) ,XIC(Bitshift_delay_K1.DN) MOV(Reject_Reason[12],Reject_Reason[9]) ,XIC(Bitshift_delay_K2.DN) OTE(Conveyor_Ran) ];
				RC: "Operator Manual reject Fail/Pass$N"
				    "North Position Manual reject Pass/Fail of the a bundle";
				N: XIC(Manual_Reject_Toggle_North)ONS(Reject_ONS_North)[XIO(Integer_Total_Line[0].0) [OTL(Integer_Total_Line[0].0) ,OTL(Manual_Reject_Toggle_North_Flag) ,OTL(Integer_Operator_Failed[0].0) ] ,XIC(Integer_Total_Line[0].0) XIO(Manual_Reject_Toggle_North_Flag) [OTU(Integer_Total_Line[0].0) ,OTU(Integer_Operator_Failed[0].0) ] ,[OTU(Manual_Reject_Toggle_North_Flag) ,OTU(Manual_Reject_Toggle_North) ] ];
				RC: "Operator Manual reject Fail/Pass$N"
				    "South Position Manual reject Pass/Fail of the a bundle";
				N: XIC(Manual_Reject_Toggle_South)ONS(Reject_ONS_South)[XIO(Integer_Total_Line[0].1) [OTL(Integer_Total_Line[0].1) ,OTL(Manual_Reject_Toggle_South_Flag) ,OTL(Integer_Operator_Failed[0].1) ] ,XIC(Integer_Total_Line[0].1) XIO(Manual_Reject_Toggle_South_Flag) [OTU(Integer_Total_Line[0].1) ,OTU(Integer_Operator_Failed[0].1) ] ,[OTU(Manual_Reject_Toggle_South_Flag) ,OTU(Manual_Reject_Toggle_South) ] ];
				RC: "Operator Manual reject Fail/Pass$N"
				    "Spare Position Manual reject Pass/Fail of the a bundle";
				N: XIC(Manual_Reject_Toggle_Spare)ONS(Reject_ONS_Spare)[XIO(Integer_Total_Line[0].2) [OTL(Integer_Total_Line[0].2) ,OTL(Manual_Reject_Toggle_Spare_Flag) ,OTL(Integer_Operator_Failed[0].2) ] ,XIC(Integer_Total_Line[0].2) XIO(Manual_Reject_Toggle_Spare_Flag) [OTU(Integer_Total_Line[0].2) ,OTU(Integer_Operator_Failed[0].2) ] ,[OTU(Manual_Reject_Toggle_Spare_Flag) ,OTU(Manual_Reject_Toggle_Spare) ] ];
				RC: "Operator Manual reject Fail/Pass$N"
				    "Horizontal Compress Position Manual reject Pass/Fail of the a bundle";
				N: XIC(Manual_Reject_Toggle_Horizontal)ONS(Reject_ONS_Horizontal)[XIO(Integer_Total_Line[0].3) [OTL(Integer_Total_Line[0].3) ,OTL(Manual_Reject_Toggle_Horizontal_Flag) ,OTL(Integer_Operator_Failed[0].3) ] ,XIC(Integer_Total_Line[0].3) XIO(Manual_Reject_Toggle_Horizontal_Flag) [OTU(Integer_Total_Line[0].3) ,OTU(Integer_Operator_Failed[0].3) ] ,[OTU(Manual_Reject_Toggle_Horizontal_Flag) ,OTU(Manual_Reject_Toggle_Horizontal) ] ];
				RC: "Operator Manual reject Fail/Pass$N"
				    "Vertical Compress Position Manual reject Pass/Fail of the a bundle";
				N: XIC(Manual_Reject_Toggle_vertical)ONS(Reject_ONS_Vertical)[XIO(Integer_Total_Line[0].4) [OTL(Integer_Total_Line[0].4) ,OTL(Manual_Reject_Toggle_Vertical_Flag) ,OTL(Integer_Operator_Failed[0].4) ] ,XIC(Integer_Total_Line[0].4) XIO(Manual_Reject_Toggle_Vertical_Flag) [OTU(Integer_Total_Line[0].4) ,OTU(Integer_Operator_Failed[0].4) ] ,[OTU(Manual_Reject_Toggle_Vertical_Flag) ,OTU(Manual_Reject_Toggle_vertical) ] ];
				RC: "Operator Manual reject Fail/Pass$N"
				    "Strap Position Manual reject Pass/Fail of the a bundle";
				N: XIC(Manual_Reject_Toggle_Strap)ONS(Reject_ONS_Strap)[XIO(Integer_Total_Line[0].5) [OTL(Integer_Total_Line[0].5) ,OTL(Manual_Reject_Toggle_Strap_Flag) ,OTL(Integer_Operator_Failed[0].5) ] ,XIC(Integer_Total_Line[0].5) XIO(Manual_Reject_Toggle_Strap_Flag) [OTU(Integer_Total_Line[0].5) ,OTU(Integer_Operator_Failed[0].5) ] ,[OTU(Manual_Reject_Toggle_Strap_Flag) ,OTU(Manual_Reject_Toggle_Strap) ] ];
				RC: "Operator Manual reject Fail/Pass$N"
				    "QA Position Manual reject Pass/Fail of the a bundle";
				N: XIC(Manual_Reject_Toggle_QA)ONS(Reject_ONS_QA)[XIO(Integer_Total_Line[0].6) [OTL(Integer_Total_Line[0].6) ,OTL(Manual_Reject_Toggle_QA_Flag) ,OTL(Integer_Operator_Failed[0].6) ] ,XIC(Integer_Total_Line[0].6) XIO(Manual_Reject_Toggle_QA_Flag) [OTU(Integer_Total_Line[0].6) ,OTU(Integer_Operator_Failed[0].6) ] ,[OTU(Manual_Reject_Toggle_QA_Flag) ,OTU(Manual_Reject_Toggle_QA) ] ];
				RC: "Operator Manual reject Fail/Pass$N"
				    "Weigher Position Manual reject Pass/Fail of the a bundle";
				N: XIC(Manual_Reject_Toggle_Weigher)ONS(Reject_ONS_Weigher)[XIO(Integer_Total_Line[0].7) [OTL(Integer_Total_Line[0].7) ,OTL(Manual_Reject_Toggle_Weigher_Flag) ,OTL(Integer_Operator_Failed[0].7) ] ,XIC(Integer_Total_Line[0].7) XIO(Manual_Reject_Toggle_Weigher_Flag) [OTU(Integer_Total_Line[0].7) ,OTU(Integer_Operator_Failed[0].7) ] ,[OTU(Manual_Reject_Toggle_Weigher_Flag) ,OTU(Manual_Reject_Toggle_Weigher) ] ];
				RC: "Operator Manual reject Fail/Pass$N"
