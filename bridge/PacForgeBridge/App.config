<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Siemens.Engineering" culture="neutral"
                          publicKeyToken="d29ec89bac048f84"/>
        <!--
          Update the version and href to match your TIA Portal version.
          V17: version="17.0.0.0" href="...Portal V17\PublicAPI\V17\..."
          V18: version="18.0.0.0" href="...Portal V18\PublicAPI\V18\..."
          V19: version="19.0.0.0" href="...Portal V19\PublicAPI\V19\..."
          V20: version="20.0.0.0" href="...Portal V20\PublicAPI\V20\..."
        -->
        <codeBase version="20.0.0.0"
                  href="file:///C:/Program Files/Siemens/Automation/Portal V20/PublicAPI/V20/Siemens.Engineering.dll"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Siemens.Engineering.Hmi" culture="neutral"
                          publicKeyToken="d29ec89bac048f84"/>
        <codeBase version="20.0.0.0"
                  href="file:///C:/Program Files/Siemens/Automation/Portal V20/PublicAPI/V20/Siemens.Engineering.Hmi.dll"/>
      </dependentAssembly>
      <!--
        TIA Portal V21: Openness is split into per-product assemblies with a new
        public key token. Used by the PacForgeBridge.V21 build (port 5104).
      -->
      <dependentAssembly>
        <assemblyIdentity name="Siemens.Engineering.Base" culture="neutral"
                          publicKeyToken="29bfe5fdf4ba5d3b"/>
        <codeBase version="21.0.0.0"
                  href="file:///C:/Program Files/Siemens/Automation/Portal V21/PublicAPI/V21/net48/Siemens.Engineering.Base.dll"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Siemens.Engineering.Step7" culture="neutral"
                          publicKeyToken="29bfe5fdf4ba5d3b"/>
        <codeBase version="21.0.0.0"
                  href="file:///C:/Program Files/Siemens/Automation/Portal V21/PublicAPI/V21/net48/Siemens.Engineering.Step7.dll"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Siemens.Engineering.WinCC" culture="neutral"
                          publicKeyToken="29bfe5fdf4ba5d3b"/>
        <codeBase version="21.0.0.0"
                  href="file:///C:/Program Files/Siemens/Automation/Portal V21/PublicAPI/V21/net48/Siemens.Engineering.WinCC.dll"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Siemens.Engineering.WinCCUnified" culture="neutral"
                          publicKeyToken="29bfe5fdf4ba5d3b"/>
        <codeBase version="21.0.0.0"
                  href="file:///C:/Program Files/Siemens/Automation/Portal V21/PublicAPI/V21/net48/Siemens.Engineering.WinCCUnified.dll"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
