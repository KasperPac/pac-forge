<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PacForgeBridge</RootNamespace>
    <AssemblyName>PacForgeBridge</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Openness.Extensions" Version="20.*" />
    <PackageReference Include="Siemens.Collaboration.Net.TiaPortal.Openness.Hmi.Extensions" Version="20.*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
