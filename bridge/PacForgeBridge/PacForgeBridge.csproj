  <!--
    TIA Portal Openness reference.
    Update the HintPath to match your installed TIA Portal version:
      V17: Portal V17\PublicAPI\V17\
      V18: Portal V18\PublicAPI\V18\
      V19: Portal V19\PublicAPI\V19\
      V20: Portal V20\PublicAPI\V20\
  -->
  <ItemGroup>
    <Reference Include="Siemens.Engineering">
      <HintPath>C:\Program Files\Siemens\Automation\Portal V20\PublicAPI\V20\Siemens.Engineering.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="Siemens.Simatic.Simulation.Runtime.Api.x64">
      <HintPath>C:\Program Files (x86)\Common Files\Siemens\PLCSIMADV\API\6.0\Siemens.Simatic.Simulation.Runtime.Api.x64.dll</HintPath>
      <Private>true</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

</Project>
