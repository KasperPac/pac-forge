FUNCTION "MAP_Rotator_Drive" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.4
   VAR_TEMP
      ref_pct : Int;
   END_VAR

BEGIN
   // sensor feedback: conditioned input (IO_Cond: force/sim-aware) -> instance DB
   "EM_Rotator_Drive_DB".fb_BR2_Fault := NOT "IO_Cond".BR2_Fault;   // %I2.5 N/C fail-safe (TRUE=healthy), inverted 2026-07-07
   "EM_Rotator_Drive_DB".fb_M5_Therm := NOT "IO_Cond".M5_Therm;   // %I2.7 N/C fail-safe (TRUE=healthy), inverted 2026-07-07
   "EM_Rotator_Drive_DB".fb_VSD2_CB_Trip := NOT "IO_Cond".VSD2_CB_Trip;   // %I2.6 N/C fail-safe (TRUE=healthy), inverted 2026-07-07

   // --- SINAMICS G120 "horizontal_drive" via SINA_SPEED, Standard Telegram 1 ---
   // Setpoints are PERCENT of p2000 (signed: negative = rotate left). p2000
   // MUST be 1500.0 rpm in the drive to match RefSpeed below.
   #ref_pct := "EM_Rotator_Drive_DB".cmd_VSD2_Speed_Ref;
   "SinaSpeed_Rot_DB"(
      EnableAxis := #ref_pct <> 0,
      AckError := "IO_Cond".Reset_PB,   // %I2.3 conditioned (sim/force aware)
      SpeedSp := INT_TO_REAL(#ref_pct) * 15.0,   // percent -> rpm (1500/100)
      RefSpeed := 1500.0,                        // = p2000
      ConfigAxis := 16#003F,
      HWIDSTW := 323,   // 323
      HWIDZSW := 323
   );
   "EM_Rotator_Drive_DB".fb_VSD2_Speed_Fb := REAL_TO_INT("SinaSpeed_Rot_DB".ActVelocity / 15.0);
END_FUNCTION
