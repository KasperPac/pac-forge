FUNCTION_BLOCK "EM_Rotator_Brake"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT
      enable : Bool;
      mode : Int;
      cmd_start : Bool;
      cmd_stop : Bool;
      cmd_hold : Bool;
      cmd_reset : Bool;
      ilk_CMD_Reset : Bool;
      ilk_CMD_Start : Bool;
      ilk_CMD_Hold : Bool;
      ilk_CMD_Unhold : Bool;
      ilk_CMD_Stop : Bool;
      ilk_CMD_Clear : Bool;
      fb_Rot_Brake_Fault : Bool;
      fb_Rot_Brake_Open : Bool;
   END_VAR
   VAR_OUTPUT
      state : Int;
      step : Int;
      done : Bool;
      fault : Bool;
   END_VAR

BEGIN
   CASE #state OF
      0:   // Aborted (safe)
         IF (#ilk_CMD_Clear = TRUE) THEN #state := 1; #done := FALSE; #step := 1; END_IF;
      1:   // Clearing
         CASE #step OF
            1:
               // <ai-fill Rotator_Brake:clearing.1>
               // TODO (AI-fill): Step 10
               // </ai-fill Rotator_Brake:clearing.1>
               IF (#fb_Rot_Brake_Fault = FALSE) THEN #done := TRUE; END_IF;
         END_CASE;
         IF #done THEN #state := 2; #done := FALSE; END_IF;
      2:   // Stopped
         IF (#ilk_CMD_Reset = TRUE) AND (#fb_Rot_Brake_Fault = FALSE) THEN #state := 3; #done := FALSE; #step := 1; END_IF;
         IF (#fb_Rot_Brake_Fault = TRUE) THEN #state := 4; #done := FALSE; #step := 1; END_IF;
      3:   // Resetting
         CASE #step OF
            1:
               // <ai-fill Rotator_Brake:resetting.1>
               // TODO (AI-fill): Step 10
               // </ai-fill Rotator_Brake:resetting.1>
               IF (#fb_Rot_Brake_Fault = FALSE) THEN #done := TRUE; END_IF;
         END_CASE;
         IF #done THEN #state := 5; #done := FALSE; END_IF;
         IF (#fb_Rot_Brake_Fault = TRUE) THEN #state := 4; #done := FALSE; #step := 1; END_IF;
      4:   // Aborting
         CASE #step OF
            1:
               // <ai-fill Rotator_Brake:aborting.1>
               // TODO (AI-fill): Step 10
               // </ai-fill Rotator_Brake:aborting.1>
               IF (#fb_Rot_Brake_Open = FALSE) THEN #done := TRUE; END_IF;
         END_CASE;
         IF #done THEN #state := 0; #done := FALSE; END_IF;
      5:   // Idle
         IF (#ilk_CMD_Start = TRUE) THEN #state := 6; #done := FALSE; #step := 1; END_IF;
         IF (#ilk_CMD_Stop = TRUE) THEN #state := 7; #done := FALSE; #step := 1; END_IF;
         IF (#fb_Rot_Brake_Fault = TRUE) THEN #state := 4; #done := FALSE; #step := 1; END_IF;
      6:   // Execute
         CASE #step OF
            1:
               // <ai-fill Rotator_Brake:execute.1>
               // TODO (AI-fill): Step 10
               // </ai-fill Rotator_Brake:execute.1>
               IF (#fb_Rot_Brake_Open = TRUE) THEN #step := 2; END_IF;
            2:
               // <ai-fill Rotator_Brake:execute.2>
               // TODO (AI-fill): Step 20
               // </ai-fill Rotator_Brake:execute.2>
               IF (#fb_Rot_Brake_Open = FALSE) THEN #done := TRUE; END_IF;
         END_CASE;
         IF #done THEN #state := 5; #done := FALSE; END_IF;
         IF (#ilk_CMD_Hold = TRUE) THEN #state := 8; #done := FALSE; #step := 1; END_IF;
         IF (#ilk_CMD_Stop = TRUE) THEN #state := 7; #done := FALSE; #step := 1; END_IF;
         IF (#fb_Rot_Brake_Fault = TRUE) THEN #state := 4; #done := FALSE; #step := 1; END_IF;
      7:   // Stopping
         CASE #step OF
            1:
               // <ai-fill Rotator_Brake:stopping.1>
               // TODO (AI-fill): Step 10
               // </ai-fill Rotator_Brake:stopping.1>
               IF (#fb_Rot_Brake_Open = FALSE) THEN #done := TRUE; END_IF;
         END_CASE;
         IF #done THEN #state := 2; #done := FALSE; END_IF;
         IF (#fb_Rot_Brake_Fault = TRUE) THEN #state := 4; #done := FALSE; #step := 1; END_IF;
      8:   // Holding
         CASE #step OF
            1:
               // <ai-fill Rotator_Brake:holding.1>
               // TODO (AI-fill): Step 10
               // </ai-fill Rotator_Brake:holding.1>
               IF (#fb_Rot_Brake_Open = FALSE) THEN #done := TRUE; END_IF;
         END_CASE;
         IF #done THEN #state := 9; #done := FALSE; END_IF;
         IF (#fb_Rot_Brake_Fault = TRUE) THEN #state := 4; #done := FALSE; #step := 1; END_IF;
      9:   // Held
         IF (#ilk_CMD_Unhold = TRUE) THEN #state := 10; #done := FALSE; #step := 1; END_IF;
         IF (#ilk_CMD_Stop = TRUE) THEN #state := 7; #done := FALSE; #step := 1; END_IF;
         IF (#fb_Rot_Brake_Fault = TRUE) THEN #state := 4; #done := FALSE; #step := 1; END_IF;
      10:   // Unholding
         CASE #step OF
            1:
               // <ai-fill Rotator_Brake:unholding.1>
               // TODO (AI-fill): Step 10
               // </ai-fill Rotator_Brake:unholding.1>
               IF (#fb_Rot_Brake_Open = TRUE) THEN #done := TRUE; END_IF;
         END_CASE;
         IF #done THEN #state := 6; #done := FALSE; #step := 1; END_IF;
         IF (#fb_Rot_Brake_Fault = TRUE) THEN #state := 4; #done := FALSE; #step := 1; END_IF;
   END_CASE;
END_FUNCTION_BLOCK
