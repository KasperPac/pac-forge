FUNCTION_BLOCK "SIM_Input_Guard"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR
      wd_last : Int;
      wd_timer {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
   END_VAR
   VAR_TEMP
      kick_changed : Bool;
   END_VAR

BEGIN
   // Dashboard simulated-input dead-man guard — MUST be the FIRST call in OB1
   // so a stale dashboard clears the sim bits before any consumer reads them
   // this scan. The dashboard bumps Sim_CMD.watchdog_kick ~every 0.4 s while
   // armed; if it stops (browser closed, server dead, network gone) the timer
   // expires at 1.5 s and everything simulated drops. Physical inputs are
   // untouched — sim bits are OR-ed in at the consumers (UC_*/MAP_*), so all
   // envelope/two-detent/horn/safety gating applies to simulated presses too.
   #kick_changed := #wd_last <> "Sim_CMD".watchdog_kick;
   #wd_last := "Sim_CMD".watchdog_kick;
   // timer resets for one scan whenever the kick advances, then re-arms
   #wd_timer(IN := NOT #kick_changed, PT := T#1S_500MS);
   IF #wd_timer.Q THEN
      "Sim_CMD".sim_enable := FALSE;
   END_IF;
   IF NOT "Sim_CMD".sim_enable THEN
      "Sim_CMD".sim_Fwd_Carriage := FALSE;
      "Sim_CMD".sim_Fwd_Fast_Carriage := FALSE;
      "Sim_CMD".sim_Rev_Carriage := FALSE;
      "Sim_CMD".sim_Rev_Fast_Carriage := FALSE;
      "Sim_CMD".sim_Rotate_Left := FALSE;
      "Sim_CMD".sim_Rotate_Left_Fast := FALSE;
      "Sim_CMD".sim_Rot_Right := FALSE;
      "Sim_CMD".sim_Rot_Right_Fast := FALSE;
      "Sim_CMD".sim_Reset_PB := FALSE;
   END_IF;
END_FUNCTION_BLOCK
